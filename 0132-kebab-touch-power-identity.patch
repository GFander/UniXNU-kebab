+/*
+ * Identify.  The payload is the vendor driver's syna_tcm_identification, which
+ * the S3908 firmware implements:
+ *
+ *   [0]      TouchComm version
+ *   [1]      mode           TCM_MODE_*
+ *   [2..17]  part number    ASCII, NUL padded
+ *   [18..21] build id       little endian packrat number
+ *   [22..23] max write size little endian
+ *
+ * There is no status byte in this payload: identify is answered with a
+ * REPORT_IDENTIFY report, not with a command status.  The bytes are printed
+ * before the decode, so a part that answers with a different layout says so in
+ * the raw dump instead of the decode quietly inventing a part number.
+ */
+static int
 kt_identify(void)
 {
