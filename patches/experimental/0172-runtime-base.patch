diff --git a/libkern/c++/OSKext.cpp b/libkern/c++/OSKext.cpp
index b32d804..c16de04 100644
--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -578,6 +578,33 @@ osdata_kmem_free(void * ptr, unsigned int length)
 void
 osdata_phys_free(void * ptr, unsigned int length)
 {
+#if defined(KEBAB)
+	/*
+	 * On this port the prelinked kexts are the only copy: there is no
+	 * MH_FILESET collection and no boot kext cache, so nothing copies their
+	 * segments into a private VM region.  Freeing them here - which happens as
+	 * soon as the OSData holding a kext executable is released - erases the
+	 * component headers while OSKext::start still has to walk them, and every
+	 * kext then fails with "module start pointer is outside of kext range".
+	 * Their classes never initialise, so an IOKit match against one of them
+	 * faults in OSMetaClass::addInstance.
+	 *
+	 * Keep the prelinked range.  A few megabytes stay allocated, which is
+	 * nothing on a 12 GB device, and the alternative is a kernel that cannot
+	 * load a single prelinked kext.
+	 */
+	{
+		kernel_segment_command_t *prelink =
+		    getsegbyname(kPrelinkTextSegment);
+
+		if (prelink && (vm_offset_t)ptr >= prelink->vmaddr &&
+		    (vm_offset_t)ptr < prelink->vmaddr + prelink->vmsize) {
+			printf("KEBAB PRELINK: keeping %p+%u inside %s\n",
+			    ptr, length, kPrelinkTextSegment);
+			return;
+		}
+	}
+#endif
 	ml_static_mfree((vm_offset_t)ptr, length);
 	return;
 }
