+/* Only a validated real frame may take the screen from normal logging.
+ * serial_console.c tees to USB before this flag and bypasses it for panic. */
+static void
+kebab_fb_handoff_console(bool *paused, uint32_t format, uint32_t planes, bool full)
+{
+    if (*paused || panic_active() || format != KEBAB_FB_FORMAT_BGRA || planes != 0 || !full) return;
+    int quiet = 0;
+    if (!PE_parse_boot_argn("kebabfb_noconsole", &quiet, sizeof(quiet))) {
+        PE_parse_boot_argn("-cf", &quiet, sizeof(quiet));
+    }
+    if (!quiet) return;
+    OSMemoryBarrier();
+    kebab_console_muted = 1;
+    *paused = true;
+    OSMemoryBarrier();
+    IOLog("KEBAB FB CONSOLE: normal-screen=0 usb-tee=1 panic-screen=1; validated full BGRA frame takes GOP\n");
+}
