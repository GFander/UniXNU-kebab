+/*
+ * qpnp_pon_reset_config() with the Gen2 register pair.  The two registers are
+ * read before they are written and every write is read back; old_ctl and
+ * old_ctl2 are returned so a rehearsal can put the PMIC back.
+ */
+static int
+kebab_spmi_pon_config_seq(uint32_t apid, uint32_t type, uint8_t *old_ctl,
+    uint8_t *old_ctl2)
+{
+	uint8_t ctl, ctl2, want, value;
+
+	if (kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL, &ctl) != 0 ||
+	    kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL2, &ctl2) != 0) {
+		printf("KEBAB PON: could not read PS_HOLD_RST_CTL/CTL2; not configuring a reset\n");
+		return -1;
+	}
+	*old_ctl = ctl;
+	*old_ctl2 = ctl2;
+	printf("KEBAB PON: PS_HOLD_RST_CTL 0x%04x old 0x%02x (type 0x%x), PS_HOLD_RST_CTL2 0x%04x old 0x%02x (reset_en %u)\n",
+	    KEBAB_SPMI_PON_PS_HOLD_CTL, ctl, ctl & KEBAB_SPMI_PON_POWER_OFF_MASK,
+	    KEBAB_SPMI_PON_PS_HOLD_CTL2, ctl2,
+	    (ctl2 & KEBAB_SPMI_PON_RESET_EN) ? 1u : 0u);
+
+	/* 1. Disable the PS_HOLD reset path before changing its type. */
+	want = ctl2 & ~KEBAB_SPMI_PON_RESET_EN;
+	if (want != ctl2) {
+		if (kebab_spmi_rw_write(apid, KEBAB_SPMI_PON_SID,
+		    KEBAB_SPMI_PON_PS_HOLD_CTL2, want) != 0) {
+			return -1;
+		}
+		if (kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL2,
+		    &value) != 0 || value != want) {
+			printf("KEBAB PON: FAIL: CTL2 read back 0x%02x, expected 0x%02x after clearing reset_en\n",
+			    value, want);
+			return -1;
+		}
+	} else {
+		printf("KEBAB PON: reset_en already clear; no write needed\n");
+	}
+
+	/* 2. The vendor waits ten sleep-clock cycles (plus tolerance). */
+	delay(500);
+
+	/* 3. Program the power-off type in the low nibble. */
+	want = (ctl & ~KEBAB_SPMI_PON_POWER_OFF_MASK) |
+	    (type & KEBAB_SPMI_PON_POWER_OFF_MASK);
+	if (kebab_spmi_rw_write(apid, KEBAB_SPMI_PON_SID,
+	    KEBAB_SPMI_PON_PS_HOLD_CTL, want) != 0) {
+		return -1;
+	}
+	if (kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL, &value) != 0 ||
+	    value != want) {
+		printf("KEBAB PON: FAIL: CTL read back 0x%02x, expected 0x%02x\n",
+		    value, want);
+		return -1;
+	}
+
+	/* 4. Re-enable the PS_HOLD reset path. */
+	want = ctl2 | KEBAB_SPMI_PON_RESET_EN;
+	if (kebab_spmi_rw_write(apid, KEBAB_SPMI_PON_SID,
+	    KEBAB_SPMI_PON_PS_HOLD_CTL2, want) != 0) {
+		return -1;
+	}
+	if (kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL2, &value) != 0 ||
+	    value != want) {
+		printf("KEBAB PON: FAIL: CTL2 read back 0x%02x, expected 0x%02x after setting reset_en\n",
+		    value, want);
+		return -1;
+	}
+	printf("KEBAB PON: reset type 0x%02x (%s) configured and read back, reset_en set\n",
+	    type, type == KEBAB_SPMI_PON_HARD_RESET ? "hard reset" : "warm reset");
+	return 0;
+}
+
+/*
+ * Arm the PS_HOLD reset path for real.  Called by FASTBOOT-PMIC/FASTBOOT-WARM
+ * before the reason and the IMEM cookie are written, in the vendor order:
+ * qpnp_pon_system_pwr_off() -> qpnp_pon_set_restart_reason() -> IMEM ->
+ * deassert_ps_hold().
+ */
+int
+kebab_spmi_pon_reset_config(bool warm)
+{
+	uint32_t apid, type;
+	uint8_t old_ctl, old_ctl2;
+
+	if (!kebab_spmi_pon_writes_enabled()) {
+		printf("KEBAB PON: kebab_pon_write is off; refusing to arm a PMIC reset\n");
+		return -1;
+	}
+	if (kebab_spmi_pon_apid(&apid) != 0) {
+		return -1;
+	}
+	type = warm ? KEBAB_SPMI_PON_WARM_RESET : KEBAB_SPMI_PON_HARD_RESET;
+	printf("KEBAB PON: arming the PS_HOLD %s reset path\n",
+	    warm ? "warm" : "hard");
+	return kebab_spmi_pon_config_seq(apid, type, &old_ctl, &old_ctl2);
+}
+
+/*
+ * PON-RST: write the same two registers the real reset uses, read them back,
+ * then restore the exact old values.  This is the last chance to see the
+ * reset configuration work while the board can still answer: the real arm is
+ * followed by a PS_HOLD deassert, after which only the next boot can report.
+ */
+int
+kebab_spmi_pon_reset_rehearsal(bool warm)
+{
+	uint32_t apid, type;
+	uint8_t old_ctl = 0, old_ctl2 = 0, value;
+
+	if (!kebab_spmi_pon_writes_enabled()) {
+		printf("KEBAB PON: kebab_pon_write is off; refusing the reset rehearsal\n");
+		return -1;
+	}
+	if (kebab_spmi_pon_apid(&apid) != 0) {
+		return -1;
+	}
+	type = warm ? KEBAB_SPMI_PON_WARM_RESET : KEBAB_SPMI_PON_HARD_RESET;
+	printf("KEBAB PON: === reset-config rehearsal (%s), old values will be restored ===\n",
+	    warm ? "warm" : "hard");
+	if (kebab_spmi_pon_config_seq(apid, type, &old_ctl, &old_ctl2) != 0) {
+		printf("KEBAB PON: rehearsal FAIL: the reset registers did not verify\n");
+		return -1;
+	}
+
+	/*
+	 * Put the PMIC back exactly as it was: disable, restore, re-enable.
+	 * Every write is attempted even if one fails, because returning with
+	 * reset_en still set would leave a rehearsed hard reset armed.
+	 */
+	{
+		int restore_rc = 0;
+
+		if (kebab_spmi_rw_write(apid, KEBAB_SPMI_PON_SID,
+		    KEBAB_SPMI_PON_PS_HOLD_CTL2,
+		    old_ctl2 & ~KEBAB_SPMI_PON_RESET_EN) != 0) {
+			restore_rc = -1;
+		}
+		if (kebab_spmi_rw_write(apid, KEBAB_SPMI_PON_SID,
+		    KEBAB_SPMI_PON_PS_HOLD_CTL, old_ctl) != 0) {
+			restore_rc = -1;
+		}
+		if (kebab_spmi_rw_write(apid, KEBAB_SPMI_PON_SID,
+		    KEBAB_SPMI_PON_PS_HOLD_CTL2, old_ctl2) != 0) {
+			restore_rc = -1;
+		}
+		if (restore_rc != 0) {
+			printf("KEBAB PON: rehearsal FAIL: restoring CTL/CTL2 failed\n");
+			return -1;
+		}
+	}
+	if (kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL, &value) != 0 ||
+	    value != old_ctl) {
+		printf("KEBAB PON: rehearsal FAIL: CTL restored to 0x%02x, expected 0x%02x\n",
+		    value, old_ctl);
+		return -1;
+	}
+	if (kebab_spmi_pon_read(apid, KEBAB_SPMI_PON_PS_HOLD_CTL2, &value) != 0 ||
+	    value != old_ctl2) {
+		printf("KEBAB PON: rehearsal FAIL: CTL2 restored to 0x%02x, expected 0x%02x\n",
+		    value, old_ctl2);
+		return -1;
+	}
+	printf("KEBAB PON: PASS: reset registers wrote and verified, then restored to CTL 0x%02x / CTL2 0x%02x\n",
+	    old_ctl, old_ctl2);
+	return 0;
+}
+
+/*
+ * deassert_ps_hold(): the vendor calls SCM first when that call is available
+ * and always falls through to a zero write of the TCSR PS_HOLD register.  This
+ * port has no SCM layer, so it does the documented fallback.  The register is
+ * read first and printed, then the line is flushed through the console before
+ * the write that can take the machine down.
+ */
+void
+kebab_spmi_pon_deassert_pshold(void)
+{
+	uint32_t before, after;
+
+	if (!kebab_spmi_pon_writes_enabled()) {
+		printf("KEBAB PON: kebab_pon_write is off; refusing to touch PS_HOLD\n");
+		return;
+	}
+	if (spmi.pshold == 0) {
+		printf("KEBAB PON: PS_HOLD at 0x%x is not mapped; no reset issued\n",
+		    KEBAB_PSHOLD_PA);
+		return;
+	}
+	before = kebab_spmi_rd(spmi.pshold, 0);
+	printf("KEBAB PON: PS_HOLD 0x%x reads 0x%08x; writing 0 to deassert it\n",
+	    KEBAB_PSHOLD_PA, before);
+	kebab_usb_log_flush();
+	delay(300000);
+	kebab_spmi_wr(spmi.pshold, 0, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(1000000);
+	after = kebab_spmi_rd(spmi.pshold, 0);
+	printf("KEBAB PON: PS_HOLD write returned, register now 0x%08x, the SoC did not reset\n",
+	    after);
+}
+
 /* ------------------------------------------------------------------- probe */
 
 void
@@ -621,6 +845,15 @@ kebab_spmi_init(void)
 	} else {
 		printf("KEBAB SPMI: arbiter is not v5; the write path is not implemented for it\n");
 	}
+	spmi.pshold = ml_io_map(KEBAB_PSHOLD_PA, KEBAB_PSHOLD_SIZE);
+	if (spmi.pshold == 0) {
+		printf("KEBAB SPMI: cannot map PS_HOLD 0x%x; the PMIC reset path will refuse\n",
+		    KEBAB_PSHOLD_PA);
+	} else {
+		printf("KEBAB SPMI: PS_HOLD 0x%08x+0x%x mapped, reads 0x%08x\n",
+		    KEBAB_PSHOLD_PA, KEBAB_PSHOLD_SIZE,
+		    kebab_spmi_rd(spmi.pshold, 0));
+	}
 }
 
