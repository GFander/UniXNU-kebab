+/*
+ * Apply one slide value to the whole plan.  This mirrors what
+ * shared_region_map_and_slide_2_np() does before it calls
+ * vm_shared_region_map_file(): every mapping address moves by the slide and
+ * every non-zero sms_slide_start moves with it.  srfmp->slide is what the
+ * kernel records as shared_region->sr_slide (the value the pager adds to
+ * rebased pointers), so the two must be the same number.
+ */
+static int
+kebab_dsc_apply_slide(struct kebab_dsc_plan *plan, uint64_t slide)
+{
+	uint32_t i, j;
+
+	if (slide == 0) {
+		plan->slide = 0;
+		return 0;
+	}
+	if (kebab_dsc_slide_requested && plan->max_slide == 0) {
+		printf("KEBAB DSC: slide 0x%llx requested but the cache maxSlide "
+		    "is 0\n", (unsigned long long)slide);
+		return EINVAL;
+	}
+	if ((slide & (KEBAB_DSC_PAGE_SIZE - 1)) != 0) {
+		printf("KEBAB DSC: slide 0x%llx is not 0x%x-byte aligned\n",
+		    (unsigned long long)slide, KEBAB_DSC_PAGE_SIZE);
+		return EINVAL;
+	}
+	if (plan->max_slide == 0 || slide >= plan->max_slide) {
+		printf("KEBAB DSC: slide 0x%llx is not below maxSlide 0x%llx\n",
+		    (unsigned long long)slide, (unsigned long long)plan->max_slide);
+		return EINVAL;
+	}
+	if (plan->slide_mappings == 0) {
+		printf("KEBAB DSC: slide 0x%llx requested but no mapping carries "
+		    "slide info\n", (unsigned long long)slide);
+		return EINVAL;
+	}
+	if (slide > 0xffffffffULL) {
+		printf("KEBAB DSC: slide 0x%llx does not fit the kernel's 32-bit "
+		    "slide field\n", (unsigned long long)slide);
+		return EINVAL;
+	}
+	if (plan->region_start < KEBAB_DSC_REGION_BASE ||
+	    plan->region_start >= KEBAB_DSC_REGION_END) {
+		printf("KEBAB DSC: cache sharedRegionStart 0x%llx is outside the "
+		    "kernel shared region [0x%llx, 0x%llx)\n",
+		    (unsigned long long)plan->region_start,
+		    (unsigned long long)KEBAB_DSC_REGION_BASE,
+		    (unsigned long long)KEBAB_DSC_REGION_END);
+		return EINVAL;
+	}
+
+	for (i = 0; i < plan->file_count; i++) {
+		struct kebab_dsc_file *f = &plan->files[i];
+
+		for (j = 0; j < f->mapping_count; j++) {
+			struct shared_file_mapping_slide_np *m = &f->mappings[j];
+			uint64_t slid = m->sms_address + slide;
+			uint64_t end = slid + m->sms_size;
+
+			if (slid < m->sms_address || end < slid ||
+			    slid < KEBAB_DSC_REGION_BASE ||
+			    end > KEBAB_DSC_REGION_END) {
+				printf("KEBAB DSC: slide 0x%llx pushes %s mapping %u "
+				    "[0x%llx, 0x%llx) outside [0x%llx, 0x%llx)\n",
+				    (unsigned long long)slide, f->name, j,
+				    (unsigned long long)slid, (unsigned long long)end,
+				    (unsigned long long)KEBAB_DSC_REGION_BASE,
+				    (unsigned long long)KEBAB_DSC_REGION_END);
+				return EINVAL;
+			}
+			if (m->sms_slide_size != 0 &&
+			    (m->sms_slide_start + slide < m->sms_slide_start ||
+			    m->sms_slide_start + slide + m->sms_slide_size > KEBAB_DSC_REGION_END)) {
+				printf("KEBAB DSC: slide 0x%llx pushes %s mapping %u "
+				    "slide info outside the shared region\n",
+				    (unsigned long long)slide, f->name, j);
+				return EINVAL;
+			}
+		}
+	}
+
+	for (i = 0; i < plan->file_count; i++) {
+		struct kebab_dsc_file *f = &plan->files[i];
+
+		for (j = 0; j < f->mapping_count; j++) {
+			struct shared_file_mapping_slide_np *m = &f->mappings[j];
+
+			m->sms_address += slide;
+			if (m->sms_slide_size != 0) {
+				m->sms_slide_start += slide;
+				/*
+				 * This is the flag vm_shared_region_map_file()
+				 * counts to decide which mappings get the lazy
+				 * rebase pager and srfmp->slide.
+				 */
+				m->sms_max_prot |= VM_PROT_SLIDE;
+			}
+		}
+	}
+	plan->slide = slide;
+	return 0;
+}
