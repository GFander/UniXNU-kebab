+/*
+ * The kernel's slide pager supports dyld slide-info versions 1 through 4
+ * (vm_shared_region_slide_page()).  The iOS 16 split cache uses version 2
+ * with 4 KiB pages, so that is what this module validates and logs before it
+ * lets the mapping proceed.  A cache with another version is rejected here
+ * instead of failing later inside vm_shared_region_slide().
+ */
+static int
+kebab_dsc_validate_slide_info(vnode_t vp, const char *name, uint32_t index,
+    uint64_t offset, uint64_t size, uint64_t mapping_size)
+{
+	struct kebab_dsc_slide_info_v2 si;
+	uint64_t required;
+	uint64_t starts_end;
+	uint64_t extras_end;
+	uint32_t slide_version = 0;
+	int error;
+
+	if (size < sizeof(slide_version)) {
+		printf("KEBAB DSC: %s: mapping %u slide info 0x%llx+0x%llx is "
+		    "shorter than a version field\n", name, index,
+		    (unsigned long long)offset, (unsigned long long)size);
+		return EINVAL;
+	}
+	error = kebab_dsc_read_at(vp, &slide_version, sizeof(slide_version), offset);
+	if (error != 0) {
+		printf("KEBAB DSC: %s: mapping %u reading slide info version failed "
+		    "(error %d)\n", name, index, error);
+		return error;
+	}
+	if (slide_version != 2) {
+		printf("KEBAB DSC: %s: mapping %u slide info version %u is not "
+		    "supported by this parser (the cache uses v2)\n",
+		    name, index, slide_version);
+		return EINVAL;
+	}
+	if (size < sizeof(si)) {
+		printf("KEBAB DSC: %s: mapping %u slide info v2 is 0x%llx bytes, "
+		    "shorter than the 0x%lx-byte header\n", name, index,
+		    (unsigned long long)size, (unsigned long)sizeof(si));
+		return EINVAL;
+	}
+	error = kebab_dsc_read_at(vp, &si, sizeof(si), offset);
+	if (error != 0) {
+		printf("KEBAB DSC: %s: mapping %u reading slide info failed "
+		    "(error %d)\n", name, index, error);
+		return error;
+	}
+	if (si.page_size != KEBAB_DSC_SLIDE_PAGE_SIZE) {
+		printf("KEBAB DSC: %s: mapping %u slide info page_size 0x%x, "
+		    "want 0x%x (PAGE_SIZE_FOR_SR_SLIDE)\n", name, index,
+		    si.page_size, KEBAB_DSC_SLIDE_PAGE_SIZE);
+		return EINVAL;
+	}
+	if (si.page_starts_count == 0 ||
+	    (uint64_t)si.page_starts_count * si.page_size != mapping_size) {
+		printf("KEBAB DSC: %s: mapping %u slide info has %u pages of 0x%x "
+		    "bytes, but the mapping is 0x%llx bytes\n", name, index,
+		    si.page_starts_count, si.page_size,
+		    (unsigned long long)mapping_size);
+		return EINVAL;
+	}
+	if (si.delta_mask == 0 || (si.delta_mask & 0x3) != 0 ||
+	    (si.delta_mask >> 32) == 0) {
+		printf("KEBAB DSC: %s: mapping %u slide info delta_mask 0x%llx "
+		    "is not a usable 64-bit delta mask\n", name, index,
+		    (unsigned long long)si.delta_mask);
+		return EINVAL;
+	}
+	required = sizeof(si) +
+	    ((uint64_t)si.page_starts_count + si.page_extras_count) * 2;
+	if (required < sizeof(si) || required > size) {
+		printf("KEBAB DSC: %s: mapping %u slide info needs 0x%llx bytes "
+		    "for %u starts and %u extras, only 0x%llx present\n",
+		    name, index, (unsigned long long)required,
+		    si.page_starts_count, si.page_extras_count,
+		    (unsigned long long)size);
+		return EINVAL;
+	}
+	starts_end = (uint64_t)si.page_starts_offset +
+	    (uint64_t)si.page_starts_count * 2;
+	extras_end = (uint64_t)si.page_extras_offset +
+	    (uint64_t)si.page_extras_count * 2;
+	if (si.page_starts_offset < sizeof(si) || starts_end > size ||
+	    (si.page_extras_count != 0 &&
+	    (si.page_extras_offset < sizeof(si) || extras_end > size))) {
+		printf("KEBAB DSC: %s: mapping %u slide info tables at "
+		    "0x%x/0x%x escape 0x%llx bytes\n", name, index,
+		    si.page_starts_offset, si.page_extras_offset,
+		    (unsigned long long)size);
+		return EINVAL;
+	}
+	printf("KEBAB DSC: %s: mapping %u slide info v2 at file 0x%llx+0x%llx: "
+	    "page_size=0x%x pages=%u extras=%u deltaMask=0x%llx valueAdd=0x%llx\n",
+	    name, index, (unsigned long long)offset, (unsigned long long)size,
+	    si.page_size, si.page_starts_count, si.page_extras_count,
+	    (unsigned long long)si.delta_mask, (unsigned long long)si.value_add);
+	return 0;
+}
