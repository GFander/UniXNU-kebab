+	    spmi.version < 0x50000000u) {
+		return -1;
+	}
+	for (i = 0; i < 4; i++) {
+		uint32_t ppid = (KEBAB_SPMI_PON_SID << 8) | (addr[i] >> 8);
+		uint32_t apid;
