+        vinfo.v_depth!=32 || vinfo.v_rowbytes<1080*4) return;
+    prepared=TRUE;
+    for(unsigned y=0;y<vinfo.v_height;y++) {
+        if (panic_active()) return;
+        volatile uint32_t *row=(volatile uint32_t *)(vinfo.v_baseaddr+(uintptr_t)y*vinfo.v_rowbytes);
+        for(unsigned x=0;x<vinfo.v_width;x++)row[x]=0xff000000;
+    }
+    DTEntry chosen;const void *property=NULL;unsigned size=0;uint32_t h[8]={};boolean_t logo=FALSE;
+    if (SecureDTLookupEntry(NULL,"/chosen",&chosen)==kSuccess &&
+        SecureDTGetProperty(chosen,"hios-boot-logo",&property,&size)==kSuccess && size>=sizeof(h)) {
+        memcpy(h,property,sizeof(h));
+        if(h[0]==0x314c424b && h[1] && h[2] && h[1]<=512 && h[2]<=512 &&
+            h[3]==h[1]*4 && h[6]==vinfo.v_width && h[7]==vinfo.v_height &&
+            h[4]<h[6] && h[5]<h[7] && h[1]<=h[6]-h[4] && h[2]<=h[7]-h[5] &&
+            size==sizeof(h)+h[3]*h[2]) {
+            for(unsigned y=0;y<h[2];y++) {
+                if (panic_active()) return;
+                void *to=(void *)(vinfo.v_baseaddr+(uintptr_t)(h[5]+y)*vinfo.v_rowbytes+(uintptr_t)h[4]*4);
+                memcpy(to,(const uint8_t *)property+sizeof(h)+(uintptr_t)y*h[3],h[3]);
+            }
+            logo=TRUE;
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    printf("KEBAB BOOT ART: debug background cleared; original-logo=%u ui-scale=%u canvas=%ux%u\n",logo,vc_uiscale,vinfo.v_width,vinfo.v_height);
+    kebab_early_flush();
+}
