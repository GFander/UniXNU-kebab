+/* BSP-only checkpoints are retained without allocator, locks or a USB call
+ * before CPU/console initialization. Replay later through the original tee. */
+static struct {unsigned stage;char label[80];} early_records[64];
+static unsigned early_record_count,early_record_dropped;
+static unsigned early_records_flushed;
+static void
+kebab_early_record(unsigned stage,const char *label)
+{
+    if (!label) return;
+    if (early_record_count>=64) {early_record_dropped++;return;}
+    unsigned i=early_record_count++,n=0;early_records[i].stage=stage;
+    while(label[n] && n<sizeof(early_records[i].label)-1){early_records[i].label[n]=label[n];n++;}
+    early_records[i].label[n]=0;
+}
+void
+kebab_early_flush(void)
+{
+    if(early_records_flushed)return;
+    early_records_flushed=1;
+    printf("KEBAB EARLY USB: replay %u checkpoints, overflow=%u\n",early_record_count,early_record_dropped);
+    for(unsigned i=0;i<early_record_count;i++)printf("KEBAB EARLY %u: %s\n",early_records[i].stage,early_records[i].label);
+}
