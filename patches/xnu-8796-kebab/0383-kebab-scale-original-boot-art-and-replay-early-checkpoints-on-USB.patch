+/* Keep the original Apple progress-meter shape at the board's actual3x UI
+ * scale. Original art only contains1x/2x tables: expand2x alpha bytes safely
+ * rather than indexing a2x bitmap with a3x stride. Called under progress lock. */
+#if defined(KEBAB) && defined(XNU_TARGET_OS_OSX)
+static unsigned char kebab_progress_left[2][kProgressBarCapWidth*3*kProgressBarHeight*3];
+static unsigned char kebab_progress_right[2][kProgressBarCapWidth*3*kProgressBarHeight*3];
+static unsigned char kebab_progress_middle[2][kProgressBarHeight*3];
+static boolean_t kebab_progress_art_ready;
+static void
+kebab_progress_art3x(void)
+{
+    if (kebab_progress_art_ready) return;
+    for (unsigned state=0;state<2;state++) {
+        for (unsigned y=0;y<kProgressBarHeight*3;y++) {
+            unsigned sy=y*2/3;
+            kebab_progress_middle[state][y]=progressmeter_middle[1][state][sy];
+            for(unsigned x=0;x<kProgressBarCapWidth*3;x++) {
+                unsigned to=y*kProgressBarCapWidth*3+x;
+                unsigned from=sy*kProgressBarCapWidth*2+x*2/3;
+                kebab_progress_left[state][to]=progressmeter_leftcap[1][state][from];
+                kebab_progress_right[state][to]=progressmeter_rightcap[1][state][from];
+            }
+        }
+    }
+    kebab_progress_art_ready=TRUE;
+}
+#endif
