 	 */
+	printf("KEBAB RPMH: drv irq_en 0x%08x irq_status 0x%08x irq_clear 0x%08x prnt_chld 0x%08x\n",
+	    kebab_spmi_rd(drv, KEBAB_RSC_IRQ_ENABLE),
+	    kebab_spmi_rd(drv, KEBAB_RSC_IRQ_STATUS),
+	    kebab_spmi_rd(drv, KEBAB_RSC_IRQ_CLEAR),
+	    kebab_spmi_rd(drv, KEBAB_RSC_PRNT_CHLD));
 	for (i = 0; i < KEBAB_RSC_TCS_TOTAL; i++) {
 		vm_offset_t t = base + i * KEBAB_RSC_TCS_STRIDE;
 
-		printf("KEBAB RPMH: tcs %u: enable 0x%08x msgid 0x%08x addr 0x%08x data 0x%08x status 0x%08x resp 0x%08x\n",
