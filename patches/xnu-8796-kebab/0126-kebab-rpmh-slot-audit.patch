-		    kebab_spmi_rd(t, KEBAB_RSC_CMD_MSGID),
-		    kebab_spmi_rd(t, KEBAB_RSC_CMD_ADDR),
-		    kebab_spmi_rd(t, KEBAB_RSC_CMD_DATA),
-		    kebab_spmi_rd(t, KEBAB_RSC_CMD_STATUS),
-		    kebab_spmi_rd(t, KEBAB_RSC_RESP_DATA));
+		printf("KEBAB RPMH: tcs %u: wait 0x%08x control 0x%08x status 0x%08x enable 0x%08x\n",
+		    i, kebab_spmi_rd(t, KEBAB_RSC_CMD_WAIT),
+		    kebab_spmi_rd(t, KEBAB_RSC_CONTROL),
+		    kebab_spmi_rd(t, KEBAB_RSC_STATUS),
+		    kebab_spmi_rd(t, KEBAB_RSC_CMD_ENABLE));
+		for (c = 0; c < 2; c++) {
+			vm_offset_t slot = t + c * KEBAB_RSC_CMD_STRIDE;
+			uint32_t msgid = kebab_spmi_rd(slot, KEBAB_RSC_CMD_MSGID);
+			uint32_t addr = kebab_spmi_rd(slot, KEBAB_RSC_CMD_ADDR);
+			uint32_t data = kebab_spmi_rd(slot, KEBAB_RSC_CMD_DATA);
+			uint32_t status = kebab_spmi_rd(slot, KEBAB_RSC_CMD_STATUS);
