+/* Returns false if firmware may still own the shared page. */
+static bool
+qsee_keymaster_version(vm_offset_t page, uint64_t pa, uint32_t app)
+{
+	int enabled=0;
+	PE_parse_boot_argn("kebab_keymaster_version",&enabled,sizeof(enabled));
+	if (enabled!=1) return true;
+	int available=qsee_available(0x30000001);
+	if (available<0) return false; /* Do not issue another SMC after an uncertain query. */
+	if (available!=1) return true;
+	/* QSEE five-argument SMC ABI: arg3 onward occupy seven LE64 slots. */
+	bzero((void *)page,PAGE_SIZE);
+	*(uint32_t *)(page+0x100)=0x200; /* KEYMASTER_GET_VERSION. */
+	memset((void *)(page+0x200),0xa5,20);
+	uint64_t *extended=(uint64_t *)(page+0x300);
+	extended[0]=pa+0x200; extended[1]=20;
+	qsee_cache(page,true);
+	struct qsee_result r=qsee_call(0x70000001,0x885,app,pa+0x100,4,pa+0x300);
+	printf("KEBAB QSEE: keymaster GET_VERSION status=%d result=0x%llx type=0x%llx attempts=%u\n",
+	    r.status,r.value,r.type,r.attempts);
+	if (r.status==1 || (!r.status && r.value!=0 && r.value!=UINT32_MAX)) return false;
+	qsee_cache(page,false);
+	if (r.status || r.value) return true;
+	const uint32_t *reply=(const uint32_t *)(page+0x200);
+	printf("KEBAB QSEE: keymaster reply status=%d protocol=%u.%u app=%u.%u\n",
+	    (int32_t)reply[0],reply[1],reply[2],reply[3],reply[4]);
+	if (!reply[0] && reply[1]>=2 && reply[1]<256 && reply[2]<65536 && reply[3]<65536 && reply[4]<65536)
+		printf("KEBAB QSEE: keymaster GET_VERSION validated; no key operations\n");
+	return true;
+}
+
 void kebab_qsee_probe(void);
 void
