+ if(!error&&write)error=VNOP_FSYNC(file,MNT_WAIT,context);
+ if(!error){
+  int residual=0;error=vn_rdwr(UIO_READ,file,(caddr_t)back,KDP_BYTES,0,UIO_SYSSPACE,
+      IO_NOCACHE,vfs_context_ucred(context),&residual,NULL);
+  if(!error&&(residual||memcmp(plain,back,KDP_BYTES)))error=EAUTH;
