--- /dev/null
+++ b/iokit/Kernel/arm/KebabTouchEdge.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* S3908 provides contact positions, not Apple contact-shape edge metadata.
+ * Classify only the real first down; keep its origin until the real lift.
+ * D22 logical points:375x812. This does not recognize a completed gesture. */
+#pragma once
+#ifdef KERNEL
+#include <sys/types.h>
+#else
+#include <stdint.h>
+#endif
+struct kebab_touch_edge_state { uint16_t active, edge; };
+static inline int
+kebab_touch_edge_update(struct kebab_touch_edge_state *state, unsigned id,
+    int touch, int in_range, int32_t x, int32_t y)
+{
+    if (!state || id>=10) return 0;
+    uint16_t bit=(uint16_t)(1u<<id);
+    if (touch && !(state->active&bit)) {
+        int valid=in_range && x>=0 && x<=65536 && y>=0 && y<=65536;
+        int edge=valid && ((int64_t)x*375<16LL*65536 ||
+            (int64_t)(65536-x)*375<16LL*65536 ||
+            (int64_t)y*812<16LL*65536 ||
+            (int64_t)(65536-y)*812<34LL*65536);
+        state->edge=(uint16_t)((state->edge&~bit)|(edge?bit:0));
+    }
+    int from_edge=!!(state->edge&bit);
+    if (touch) state->active|=bit;
+    else { state->active&=(uint16_t)~bit;state->edge&=(uint16_t)~bit; }
+    return from_edge;
+}
