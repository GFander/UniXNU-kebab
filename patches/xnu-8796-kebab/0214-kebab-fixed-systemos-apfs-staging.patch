+/* Fixed, immutable source identity for the 20H392 SystemOS staging slot. */
+#ifndef KEBAB_CRYPTEX_STAGE_H
+#define KEBAB_CRYPTEX_STAGE_H
+#define KEBAB_CRYPTEX_STAGE_PATH "/private/preboot/.hios-systemos-v1.apfs"
+#define KEBAB_CRYPTEX_STAGE_BYTES 2743074816ULL
+static const unsigned char kebab_cryptex_stage_sha256[32] = {
+ 0x9c,0xd7,0x38,0xf3,0xb0,0x16,0x90,0x55,0x54,0x9d,0xf8,0x4a,0xd6,0xd8,0xd1,0x3e,
+ 0x50,0xa2,0xda,0x39,0xaf,0x61,0x8c,0xe0,0x52,0x2c,0xa4,0xe0,0x6d,0xf8,0x68,0x49
+};
+static bool
+kebab_cryptex_stage_contract(const char *path, uint64_t size, uint64_t wire,
+    unsigned mode, unsigned flags, const uint8_t *sha)
+{
+ return !strcmp(path, KEBAB_CRYPTEX_STAGE_PATH) && size == KEBAB_CRYPTEX_STAGE_BYTES &&
+     wire == size && mode == 0600 && flags == 0 && !memcmp(sha, kebab_cryptex_stage_sha256, 32);
+}
+#endif
