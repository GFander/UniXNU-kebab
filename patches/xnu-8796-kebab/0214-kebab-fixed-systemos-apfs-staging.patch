+/* Uploads go to one non-live staging slot, never the nonce record or System. */
+static bool ki_cryptex;
+static vnode_t ki_cryptex_mount_root;
+
+static bool
+ki_cryptex_requested(void)
+{
+ uint32_t on = 0;
+ return PE_parse_boot_argn("kebab_install_cryptex", &on, sizeof(on)) && on == 1;
+}
+
+static int
+ki_cryptex_check_vnode(vnode_t file)
+{
+ struct kebab_volume_identity system, preboot;
+ int error = kebab_lookup_apfs_preboot(&system, &preboot);
+ if (error) return error;
+ mount_t root = vnode_mount(rootvnode), target = vnode_mount(file);
+ if (!root || !target || root == target || !(vfs_flags(root) & MNT_RDONLY) ||
+     strcmp(vfs_statfs(root)->f_fstypename, "apfs") || strcmp(vfs_statfs(target)->f_fstypename, "apfs")) return EINVAL;
+ vnode_t device = vfs_devvp(root);
+ dev_t actual = device ? vnode_specrdev(device) : NODEV;
+ if (device) vnode_put(device);
+ if (actual != makedev(system.major_number, system.minor_number)) return EINVAL;
+ device = vfs_devvp(target);actual = device ? vnode_specrdev(device) : NODEV;
+ if (device) vnode_put(device);
+ return actual == makedev(preboot.major_number, preboot.minor_number) ? 0 : EINVAL;
+}
+
+static int
+ki_cryptex_pin_mount(void)
+{
+ uint32_t rw = 0;
+ PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+ if (rw != 1) return EROFS;
+ vnode_t anchor = NULLVP;
+ int error = vnode_lookup("/private/preboot", VNODE_LOOKUP_NOFOLLOW, &anchor, vfs_context_current());
+ if (error) return error;
+ error = ki_cryptex_check_vnode(anchor);
+ if (!error && (!vnode_isdir(anchor) || (vfs_flags(vnode_mount(anchor)) & MNT_RDONLY))) error = EROFS;
+ if (error) { vnode_put(anchor);return error; }
+ ki_cryptex_mount_root = anchor;
+ return 0;
+}
