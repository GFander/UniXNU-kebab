-		while (pos + sizeof(struct dirent) <= used) {
-			struct dirent *dp = (struct dirent *)(void *)(buf + pos);
-			uint32_t reclen = dp->d_reclen;
+		/*
+		 * Walk every complete record in the window.  The bound used to be
+		 * `pos + sizeof(struct dirent) <= used`, which is the size of the
+		 * largest record HFS+ can emit (d_name[1024]) and therefore never a
+		 * lower bound: STD_DIRENT_LEN(namlen) is 792 + align4(namlen + 1),
+		 * i.e. 816-836 bytes for this directory.  The old bound stopped as
+		 * soon as less than 1048 bytes remained, leaving the last complete
+		 * record of every 8 KiB window unread, and because the next
+		 * VNOP_READDIR resumed from the offset the driver reported, that
+		 * name was never offered to the resolver at all -- and never
+		 * reported either.
+		 *
+		 * Instead, require only the fixed header, then trust (and
+		 * bounds-check) d_reclen.  A window that cannot be consumed whole
+		 * is a hard error: a partial candidate list is what silently
+		 * dropped a subcache, so it must not be mistaken for success.
+		 */
+		while (pos < used) {
+			struct dirent *dp;
+			uint32_t reclen;
 
-			if (reclen == 0 || pos + reclen > used) {
-				break;
+			if (used - pos < KEBAB_DSC_DIRENT_MIN) {
+				printf("KEBAB DSC: directory scan: %u trailing byte(s) at "
+				    "offset %u of %u are shorter than a dirent header; "
+				    "refusing a partial scan\n", used - pos, pos, used);
+				error = EIO;
+				goto out;
 			}
+			dp = (struct dirent *)(void *)(buf + pos);
+			reclen = dp->d_reclen;
+			if (reclen < KEBAB_DSC_DIRENT_MIN || reclen > used - pos) {
+				printf("KEBAB DSC: directory scan: record at offset %u "
+				    "claims d_reclen %u but %u byte(s) remain in the "
+				    "%u-byte window (readdir offset %lld); refusing a "
+				    "partial scan\n", pos, reclen, used - pos, used,
+				    (long long)offset);
+				error = EIO;
+				goto out;
+			}
+			/*
+			 * d_namlen is what the name copy trusts, so it has to fit
+			 * inside the record that was just validated.
+			 */
 			if (dp->d_ino != 0 && dp->d_namlen > 0 &&
-			    dp->d_namlen < KEBAB_DSC_NAME_MAX) {
+			    dp->d_namlen < KEBAB_DSC_NAME_MAX &&
+			    (uint32_t)dp->d_namlen + 1 <=
+			    reclen - KEBAB_DSC_DIRENT_MIN) {
 				char name[KEBAB_DSC_NAME_MAX];
 
 				memcpy(name, dp->d_name, dp->d_namlen);
@@ -516,11 +571,13 @@
 					count++;
 				}
 			}
+			entries++;
 			pos += reclen;
 		}
 	}
 
 	*candidate_count = count;
+	*entry_count = entries;
 	error = 0;
 
