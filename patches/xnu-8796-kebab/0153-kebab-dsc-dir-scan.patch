 	boolean_t eofflag = FALSE;
 	int error = 0;
@@ -488,18 +498,63 @@
 		used = KEBAB_DSC_DIRBUF - (uint32_t)uio_resid(auio);
 		offset = uio_offset(auio);
 		if (used == 0) {
+			if (!eofflag) {
+				printf("KEBAB DSC: directory scan: readdir returned no "
+				    "records at offset %lld without setting EOF; refusing "
+				    "a partial scan\n", (long long)offset);
