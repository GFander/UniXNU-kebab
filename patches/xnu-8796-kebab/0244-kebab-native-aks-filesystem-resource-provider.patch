+IOReturn
+KebabKeyStore::callPlatformFunction(const OSSymbol *name,bool wait,void *a,void *b,void *c,void *d)
+{
+ (void)wait;
+ if(!name || !name->isEqualTo("AKSFileSystemKeyServices"))return kIOReturnUnsupported;
+ if(!a || ((uintptr_t)a&7) || b || c || d)return kIOReturnBadArgument;
+ if(!kebab_file_keys_available())return kIOReturnNotReady;
+ const void *table=&kfk_services;memcpy(a,&table,sizeof(table));return kIOReturnSuccess;
+}
