+extern "C" int
+kebab_aks_fs_publish_test(void)
+{
+#if DEVELOPMENT || DEBUG
+ if(!kebab_file_keys_available())return EPERM;
+ IOService *platform=IOService::getPlatform();if(!platform)return ENXIO;
+ if(!kfk_provider) {
+  const void *existing=nullptr;
+  IOReturn result=platform->callPlatformFunction("AKSFileSystemKeyServices",false,&existing,nullptr,nullptr,nullptr);
+  if(result!=kIOReturnUnsupported)return EEXIST;
+  KebabKeyStore *service=new KebabKeyStore;
+  if(!service)return ENOMEM;
+  if(!service->init(nullptr)){service->release();return ENOMEM;}
+  if(!service->attach(platform)){service->release();return EIO;}
+  if(!service->start(platform)){service->detach(platform);service->release();return EIO;}
+  service->registerService();kfk_provider=service;
+  IOService::publishResource("AKSFileSystemKeyServices",service);
+ }
+ const KebabAKSFileSystemTable *table=nullptr;
+ IOReturn result=platform->callPlatformFunction("AKSFileSystemKeyServices",false,&table,nullptr,nullptr,nullptr);
+ int error=result==kIOReturnSuccess && table==&kfk_services?0:EIO;
+ if(!error)error=kfk_service_roundtrip(table);
+ IOLog("KEBAB AKS FS: native platform/table184B metadata14/classD new/unwrap/rewrap %s (%d); unsupported slots NULL; no Data mount\n",error?"FAIL":"PASS",error);
+ return error;
+#else
+ return EPERM;
+#endif
+}
