+static_assert(sizeof(KebabAKSFileSystemTable)==184,"target23-slot table");
+static_assert(offsetof(KebabAKSFileSystemTable,metadata_unwrap)==0x38,"target metadata unwrap");
+static_assert(offsetof(KebabAKSFileSystemTable,metadata_wrap)==0x48,"target metadata wrap");
+static const KebabAKSFileSystemTable kfk_services={kebab_file_key_unwrap,kebab_file_key_rewrap,
