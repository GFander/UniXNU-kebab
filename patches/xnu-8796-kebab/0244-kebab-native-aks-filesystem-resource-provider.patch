+#if DEVELOPMENT || DEBUG
+static int
+kfk_service_roundtrip(const KebabAKSFileSystemTable *table)
+{
+ struct Work { uint8_t bag[88],sealed[128],rewrapped[128],key[64],iv[16],back[64],back_iv[16]; };
+ Work *work=static_cast<Work *>(IOMalloc(sizeof(Work)));
+ if(!work)return ENOMEM;
+ bzero(work,sizeof(Work));struct kebab_aks_credential cred={};
+ for(unsigned i=0;i<16;++i)cred.bytes[22+i]=(uint8_t)(0x80+i);
+ for(unsigned i=0;i<64;++i)work->key[i]=(uint8_t)i;
+ for(unsigned i=0;i<16;++i)work->iv[i]=(uint8_t)(0x90+i);
+ struct kebab_aks_raw_key raw={work->key,32,work->iv,16,0};
+ struct kebab_aks_raw_key output={work->back,64,work->back_iv,16,0};
+ struct kebab_aks_wrapped_key wrapped={work->sealed,128,0},rewrapped={work->rewrapped,128,0};
+ int error=table->metadata_wrap(&cred,14,&raw,&wrapped);
+ if(!error)error=table->metadata_unwrap(&cred,&wrapped,&output);
+ if(!error && (output.key_len!=32 || output.iv_key_len!=16 ||
+     memcmp(work->key,work->back,32) || memcmp(work->iv,work->back_iv,16)))error=EIO;
+ if(!error) {
+  wrapped.key_len=128;
+  if(table->metadata_wrap(&cred,3,&raw,&wrapped)!=(int)kIOReturnUnsupported)error=EIO;
+ }
+ if(!error)error=kebab_keybag_d_create(cred.bytes+22,work->bag,88);
+ if(!error)error=kebab_keybag_d_open(cred.bytes+22,work->bag,88);
+ cred.bytes[0]=1;cred.bytes[20]=1;raw.key_len=64;wrapped.key_len=128;
+ if(!error)error=table->new_key(&cred,4,&raw,&wrapped);
+ output.key_len=64;output.iv_key_len=16;
+ if(!error)error=table->unwrap(&cred,&wrapped,&output);
+ if(!error && (output.key_len!=32 || output.iv_key_len!=16 ||
+     memcmp(work->key,work->back,32) || memcmp(work->iv,work->back_iv,16)))error=EIO;
+ if(!error)error=table->rewrap(&cred,4,&wrapped,&rewrapped);
+ if(!error && (rewrapped.key_len!=wrapped.key_len || rewrapped.dp_class!=4 ||
+     memcmp(rewrapped.key,wrapped.key,wrapped.key_len)))error=EIO;
+ if(!error) {
+  raw.key_len=64;raw.iv_key_len=16;wrapped.key_len=128;
+  if(table->new_key(&cred,3,&raw,&wrapped)!=(int)kIOReturnUnsupported)error=EIO;
+ }
