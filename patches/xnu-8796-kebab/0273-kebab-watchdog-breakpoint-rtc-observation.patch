+#if defined(KEBAB)
+/* Read-only PM8150 RTC observation: mainline pm8150.dtsi identifies SID0,
+ * qcom,pm8941-rtc at 0x6000. Never enable or adjust the PMIC counter here. */
+extern "C" void kebab_rtc_probe(void)
+{
+ kebab_spmi_init();
+ uint32_t apid=0,raw=0; uint8_t ctrl=0,bytes[4]={},low=0;
+ int error=-1;
+ kebab_spmi_bus_lock();
+ if(kebab_spmi_bus_ready() && kebab_spmi_reader(0x060,&apid)==0) {
+  error=kebab_spmi_obs_read_ex(apid,0,0x6046,kebab_spmi_bus_next_attempt(),false,false,&ctrl);
+  for(unsigned retry=0;!error && retry<3;retry++) {
+   for(unsigned i=0;i<4 && !error;i++)error=kebab_spmi_obs_read_ex(apid,0,0x6048+i,kebab_spmi_bus_next_attempt(),false,false,&bytes[i]);
+   if(!error)error=kebab_spmi_obs_read_ex(apid,0,0x6048,kebab_spmi_bus_next_attempt(),false,false,&low);
+   if(error || low>=bytes[0])break;
+   if(retry==2)error=-2;
+  }
+  for(unsigned i=0;i<4;i++)raw|=(uint32_t)bytes[i]<<(8*i);
+ }
+ kebab_spmi_bus_unlock();
+ clock_sec_t secs=0;clock_usec_t usecs=0;clock_get_calendar_microtime(&secs,&usecs);
+ IOLog("KEBAB RTC PROBE: PM8150 sid0 ppID060 apid=%u ctrl=0x%02x seconds=%u rc=%d calendar=%llu.%06u; read-only/no offset applied\n",apid,ctrl,raw,error,(unsigned long long)secs,usecs);
+}
+#endif
