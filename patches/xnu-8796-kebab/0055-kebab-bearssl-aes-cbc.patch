+	const void *key, size_t len)
+{
+	ctx->vtable = &kebab_br_aes_ct_cbcenc_vtable;
+	ctx->num_rounds = kebab_br_aes_ct_keysched(ctx->skey, key, len);
+}
+
+/* see bearssl_block.h */
+void
+kebab_br_aes_ct_cbcenc_run(const kebab_br_aes_ct_cbcenc_keys *ctx,
+	void *iv, void *data, size_t len)
+{
+	unsigned char *buf, *ivbuf;
+	uint32_t q[8];
+	uint32_t iv0, iv1, iv2, iv3;
+	uint32_t sk_exp[120];
+
+	q[1] = 0;
+	q[3] = 0;
+	q[5] = 0;
+	q[7] = 0;
+	kebab_br_aes_ct_skey_expand(sk_exp, ctx->num_rounds, ctx->skey);
+	ivbuf = iv;
+	iv0 = kebab_br_dec32le(ivbuf);
+	iv1 = kebab_br_dec32le(ivbuf + 4);
+	iv2 = kebab_br_dec32le(ivbuf + 8);
+	iv3 = kebab_br_dec32le(ivbuf + 12);
+	buf = data;
+	while (len > 0) {
+		q[0] = iv0 ^ kebab_br_dec32le(buf);
+		q[2] = iv1 ^ kebab_br_dec32le(buf + 4);
+		q[4] = iv2 ^ kebab_br_dec32le(buf + 8);
+		q[6] = iv3 ^ kebab_br_dec32le(buf + 12);
+		kebab_br_aes_ct_ortho(q);
+		kebab_br_aes_ct_bitslice_encrypt(ctx->num_rounds, sk_exp, q);
+		kebab_br_aes_ct_ortho(q);
+		iv0 = q[0];
+		iv1 = q[2];
+		iv2 = q[4];
+		iv3 = q[6];
+		kebab_br_enc32le(buf, iv0);
+		kebab_br_enc32le(buf + 4, iv1);
+		kebab_br_enc32le(buf + 8, iv2);
+		kebab_br_enc32le(buf + 12, iv3);
+		buf += 16;
+		len -= 16;
+	}
+	kebab_br_enc32le(ivbuf, iv0);
+	kebab_br_enc32le(ivbuf + 4, iv1);
+	kebab_br_enc32le(ivbuf + 8, iv2);
+	kebab_br_enc32le(ivbuf + 12, iv3);
+}
+
+/* see bearssl_block.h */
+const kebab_br_block_cbcenc_class kebab_br_aes_ct_cbcenc_vtable = {
+	sizeof(kebab_br_aes_ct_cbcenc_keys),
+	16,
+	4,
+	(void (*)(const kebab_br_block_cbcenc_class **, const void *, size_t))
+		&kebab_br_aes_ct_cbcenc_init,
+	(void (*)(const kebab_br_block_cbcenc_class *const *, void *, void *, size_t))
+		&kebab_br_aes_ct_cbcenc_run
+};
