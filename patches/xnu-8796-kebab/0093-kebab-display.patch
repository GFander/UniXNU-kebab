+
+bool
+AppleCLCD::start(IOService *provider)
+{
+	PE_Video video;
+	int native = 0;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fVsyncCount = 0;
+	fSwapID = 0;
+	fQueuedID = 0;
+	fCompletedID = 0;
+	fCompletedTime = 0;
+	fPendingValid = false;
+	fHaveFrame = false;
+	fPendingID = 0;
+	fConsolePaused = false;
+	fPowerOff = false;
+	fBlanked = false;
+	fDebugFlags = 0;
+	fDisplayDevice = 0;
+	fColorRemapMode = 0;
+	fPowerSavings = 0;
+	for (uint32_t i = 0; i < KEBAB_FB_LAYERS; i++) {
+		fLayerSurface[i] = 0;
+	}
+	PE_current_console(&video);
+	fPhys = video.v_baseAddr;
+	fWidth = (uint32_t)video.v_width;
+	fHeight = (uint32_t)video.v_height;
+	fRowBytes = (uint32_t)video.v_rowBytes;
+	if (fPhys == 0 || fWidth == 0 || fHeight == 0 || fRowBytes < fWidth * 4) {
+		IOLog("KEBAB FB: no boot framebuffer\n");
+		return false;
+	}
+	/*
+	 * Present the iPhone X display the identity describes, not the panel:
+	 * see the top of the file. kebabfb_native=1 is the escape hatch that
+	 * presents the raw panel size instead, for bring-up on a userland that
+	 * has no iPhone X layout.
+	 */
+	fLogicalW = fWidth;
+	fLogicalH = fHeight;
+	PE_parse_boot_argn("kebabfb_native", &native, sizeof(native));
+	if (native == 0 && fWidth <= KEBAB_FB_LOGICAL_W && fHeight <= KEBAB_FB_LOGICAL_H) {
+		fLogicalW = KEBAB_FB_LOGICAL_W;
+		fLogicalH = KEBAB_FB_LOGICAL_H;
+	}
+	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
+	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+	fLock = IOLockAlloc();
+	fClients = OSArray::withCapacity(4);
+	fSurface = kebab_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, KEBAB_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
+		IOLog("KEBAB FB: setup failed\n");
+		OSSafeReleaseNULL(fSurface);    /* stays published: also held by the table */
+		OSSafeReleaseNULL(fWorkLoop);
+		return false;
+	}
+	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
+		IOLog("KEBAB FB: no vsync timer\n");
+		return false;
+	}
+	fVsync->setTimeoutUS(KEBAB_FB_VSYNC_US);
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	setProperty("external", false);
+	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	registerService();
+	IOLog("KEBAB FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, "
+	    "presented as %ux%u (panel origin %d,%d)\n",
+	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH, fOffX, fOffY);
+	return true;
+}
+
+void
+AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint64_t now = mach_absolute_time();
+	uint64_t values[6] = {
+		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)now, (uint32_t)(now >> 32),
+		0, 0,
+	};
+	uint8_t rec[KEBAB_FB_SWAP_REC_SIZE];
+	bool present = false;
+	uint32_t id = 0;
+
+	fb->fVsyncCount++;
+	IOLockLock(fb->fLock);
+	for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
+		IOMobileFramebufferUserClient *client =
+		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+		client->notify(KEBAB_FB_NOTIFY_VSYNC, values, 6);
+	}
+	if (!fb->fPowerOff && fb->fPendingValid) {
+		memcpy(rec, fb->fPending, sizeof(rec));
+		id = fb->fPendingID;
+		fb->fPendingValid = false;
+		present = true;
+	}
+	IOLockUnlock(fb->fLock);
+
+	if (fb->fPowerOff) {
+		/* The panel is self-scan and has no backlight control: "off" is a
+		 * black buffer, done once instead of copying frames nobody sees. */
+		if (!fb->fBlanked) {
+			fb->blank();
+			fb->fBlanked = true;
+		}
+	} else if (present) {
+		fb->present(rec, id);
+		IOLockLock(fb->fLock);
+		if (id > fb->fCompletedID) {
+			fb->fCompletedID = id;
+		}
+		fb->fCompletedTime = now;
+		IOLockWakeup(fb->fLock, &fb->fCompletedID, false);
+		IOLockUnlock(fb->fLock);
+	}
+	sender->setTimeoutUS(KEBAB_FB_VSYNC_US);
+}
+
+void
+AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	fClients->setObject(client);
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::removeClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	unsigned int i = fClients->getNextIndexOfObject(client, 0);
+	if (i != (unsigned int)-1) {
+		fClients->removeObject(i);
+	}
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::blank()
+{
+	memset((void *)fPixels, 0, (size_t)fRowBytes * fHeight);
+}
+
+static uint32_t
+get32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+	memcpy(&v, p + off, 4);
+	return v;
+}
+
+static uint32_t kebab_fb_swaps_logged;
+
+/*
+ * Queue the frame. The copy itself happens on the vsync timer (present), so
+ * SwapEnd's cost is one 0x46c memcpy no matter what the backend is; a DPU
+ * flip backend will make present() a register write and this ABI stays.
+ */
+void
+AppleCLCD::swap(const uint8_t *rec)
+{
+	uint32_t id = get32(rec, 0x50);
+
+	IOLockLock(fLock);
+	if (id == 0) {
+		id = fSwapID;
+	}
+	memcpy(fPending, rec, KEBAB_FB_SWAP_REC_SIZE);
+	fPendingID = id;
+	fPendingValid = true;
+	fHaveFrame = true;
+	fQueuedID = id;
+	IOLockUnlock(fLock);
+}
+
+/* Copy each enabled layer's surface into the panel memory (CPU backend). */
+void
+AppleCLCD::present(const uint8_t *rec, uint32_t swapID)
+{
+	uint32_t mask = get32(rec, 0x104);
+	uint32_t displayed[KEBAB_FB_LAYERS] = { 0, 0, 0, 0 };
+
+	if (!fConsolePaused) {
+		int quiet = 0;
+		fConsolePaused = true;
+		if (PE_parse_boot_argn("kebabfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			/* Not PE_initialize_console(kPEDisableScreen): its console switch
+			 * writes the read-only-late cons_ops_index and panics on arm64. */
+			kebab_console_muted = 1;
+		}
+	}
+
+	for (uint32_t layer = 0; layer < KEBAB_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		KebabSurface *s = kebab_surface_copy(id);
+		if (s != NULL) {
+			displayed[layer] = id;
+		}
+		if ((fDebugFlags & 1) || kebab_fb_swaps_logged < 16) {
+			kebab_fb_swaps_logged++;
+			IOLog("KEBAB FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    swapID, layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		/* Logical (presented) display coordinates -> panel coordinates. */
+		dx -= fOffX;
+		dy -= fOffY;
+		if (dx < 0) {
+			sx -= dx;
+			w += dx;
+			dx = 0;
+		}
+		if (dy < 0) {
+			sy -= dy;
+			h += dy;
+			dy = 0;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fWidth - dx) {
+			w = (int32_t)fWidth - dx;
+		}
+		if (h > (int32_t)fHeight - dy) {
+			h = (int32_t)fHeight - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (src != 0 && bpe == 4) {
+			for (int32_t y = 0; y < h; y++) {
+				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
+				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
+				    (size_t)w * 4);
+			}
+		}
+		s->release();
+	}
+
+	IOLockLock(fLock);
+	for (uint32_t layer = 0; layer < KEBAB_FB_LAYERS; layer++) {
+		fLayerSurface[layer] = displayed[layer];
+	}
+	IOLockUnlock(fLock);
+}
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fFB = OSDynamicCast(AppleCLCD, provider);
+	if (fFB == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fFB->addClient(this);
+	return true;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fFB != NULL) {
+		fFB->removeClient(this);
+		IOLockLock(fFB->fLock);
+		mach_port_t old = fPort;
+		fPort = MACH_PORT_NULL;
+		IOLockUnlock(fFB->fLock);
+		if (old != MACH_PORT_NULL) {
+			releaseNotificationPort(old);
+		}
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, __unused UInt32 type,
+    __unused io_user_reference_t refCon)
+{
+	mach_port_t old;
+	IOLockLock(fFB->fLock);
+	old = fPort;
+	fPort = port;
+	IOLockUnlock(fFB->fLock);
+	if (old != MACH_PORT_NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Called with the framebuffer lock held. */
+void
+IOMobileFramebufferUserClient::notify(uint32_t type, const uint64_t *values, uint32_t count)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= KEBAB_FB_NOTIFY_TYPES || fFunc[type] == 0 || fPort == MACH_PORT_NULL) {
+		return;
+	}
+	bzero(ref, sizeof(ref));
+	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
+	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
+	    kIOUserNotifyOptionCanDrop);
+}
+
+/* Fill a structure output buffer from buf, zeroing any tail the client owns. */
+static IOReturn
+kebab_fb_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount size = args->structureOutputDescriptor->getLength();
+		if (size < len) {
+			return kIOReturnNoSpace;
+		}
+		if (args->structureOutputDescriptor->writeBytes(0, buf, len) != len) {
+			return kIOReturnVMError;
+		}
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || args->structureOutputSize < len) {
+		return kIOReturnNoSpace;
+	}
+	bzero(args->structureOutput, args->structureOutputSize);
+	memcpy(args->structureOutput, buf, len);
+	return kIOReturnSuccess;
+}
+
+/* Like kebab_fb_struct_out, but a client buffer smaller than the definition
+ * still gets the prefix it asked for instead of a hard failure. */
+static IOReturn
+kebab_fb_struct_out_partial(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	uint8_t *dst;
+	uint32_t avail;
+
+	if (args->structureOutputDescriptor != NULL) {
+		avail = (uint32_t)args->structureOutputDescriptor->getLength();
+		if (avail < 1) {
+			return kIOReturnNoSpace;
+		}
+		dst = (uint8_t *)IOMallocData(avail);
+		if (dst == NULL) {
+			return kIOReturnNoMemory;
+		}
+		bzero(dst, avail);
+		memcpy(dst, buf, avail < len ? avail : len);
+		IOReturn ret = args->structureOutputDescriptor->writeBytes(0, dst, avail) == avail ?
+		    kIOReturnSuccess : kIOReturnVMError;
+		IOFreeData(dst, avail);
+		if (ret == kIOReturnSuccess) {
+			args->structureOutputDescriptorSize = avail;
+		}
+		return ret;
+	}
+	if (args->structureOutput == NULL) {
+		return kIOReturnBadArgument;
+	}
+	avail = args->structureOutputSize;
+	if (avail == 0) {
+		return kIOReturnNoSpace;
+	}
+	bzero(args->structureOutput, avail);
+	memcpy(args->structureOutput, buf, avail < len ? avail : len);
+	return kIOReturnSuccess;
+}
+
+static uint64_t kebab_fb_logged;        /* selectors 0..63 already logged */
+static uint64_t kebab_fb_logged_hi;     /* selectors 64..127 already logged */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+
+	switch (selector) {
+	case kKebabFBGetLayerDefaultSurface:
+		out[0] = kebab_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kKebabFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
+	case kKebabFBSwapEnd: {
+		uint8_t rec[KEBAB_FB_SWAP_REC_SIZE];
+		if (args->structureInputDescriptor != NULL) {
+			if (args->structureInputDescriptor->getLength() < sizeof(rec) ||
+			    args->structureInputDescriptor->readBytes(0, rec, sizeof(rec)) != sizeof(rec)) {
+				ret = kIOReturnBadArgument;
+				break;
+			}
+		} else if (args->structureInput != NULL && args->structureInputSize >= sizeof(rec)) {
+			memcpy(rec, args->structureInput, sizeof(rec));
+		} else {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		fFB->swap(rec);
+		break;
+	}
+	case kKebabFBSwapWait: {
+		uint32_t swapID = args->scalarInputCount > 0 ? (uint32_t)args->scalarInput[0] : 0;
+		uint32_t timeout = args->scalarInputCount > 1 ? (uint32_t)args->scalarInput[1] : 0;
+		if (args->scalarInputCount > 1 && (int32_t)args->scalarInput[1] < 0) {
+			timeout = 0;
+		}
+		if (timeout > KEBAB_FB_SWAP_WAIT_MAX_MS) {
+			timeout = KEBAB_FB_SWAP_WAIT_MAX_MS;
+		}
+		IOLockLock(fFB->fLock);
+		if (swapID == 0 || swapID > fFB->fQueuedID) {
+			/* SwapBegin without SwapEnd, or a bogus id: nothing will ever
+			 * complete it. A defined error, not a zeroed success. */
+			IOLockUnlock(fFB->fLock);
+			ret = kIOReturnNotFound;
+			break;
+		}
+		if (swapID <= fFB->fCompletedID) {
+			IOLockUnlock(fFB->fLock);
+			break;
+		}
+		if (timeout > 0) {
+			uint64_t deadline = 0;
+			clock_interval_to_deadline(timeout, kMillisecondScale, &deadline);
+			while (swapID > fFB->fCompletedID) {
+				int result = IOLockSleepDeadline(fFB->fLock, &fFB->fCompletedID,
+				    deadline, THREAD_ABORTSAFE);
+				if (result == THREAD_TIMED_OUT || result == THREAD_INTERRUPTED) {
+					break;
+				}
+			}
+		}
+		/* Three outcomes: completed (success), timed out, or the swap was
+		 * never queued (not found, above). */
+		ret = swapID <= fFB->fCompletedID ? kIOReturnSuccess : kIOReturnTimeout;
+		IOLockUnlock(fFB->fLock);
+		break;
+	}
+	case kKebabFBGetID:
+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kKebabFBGetDisplaySize:
+		out[0] = fFB->fLogicalW;
+		out[1] = fFB->fLogicalH;
+		outCount = 2;
+		break;
+	case kKebabFBRequestPowerChange:
+		if (args->scalarInputCount < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		{
+			bool off = args->scalarInput[0] == 0;
+			IOLockLock(fFB->fLock);
+			if (off != fFB->fPowerOff) {
+				fFB->fPowerOff = off;
+				fFB->fPendingValid = !off && fFB->fHaveFrame;
+				fFB->fBlanked = false;
+			}
+			IOLockUnlock(fFB->fLock);
+			IOLog("KEBAB FB: display %s\n", off ? "off" : "on");
+		}
+		break;
+	case kKebabFBSetDebugFlags:
+		if (args->scalarInputCount < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		fFB->fDebugFlags = (uint32_t)args->scalarInput[0];
+		out[0] = fFB->fDebugFlags;
+		outCount = 1;
+		break;
+	case kKebabFBSetGammaTable:
+	case kKebabFBGetGammaTable:
+	case kKebabFBSetBrightnessCorrection:
+	case kKebabFBSetMatrix:
+	case kKebabFBSetParameter:
+	case kKebabFBGetBlock:
+	case kKebabFBSetContrast:
+		/* There is no DPU, backlight, gamma pipeline or parameter block in
+		 * this port. Accepting these would tell userland the panel had been
+		 * configured when the pixels are a straight CPU copy. */
+		ret = kIOReturnUnsupported;
+		break;
+	case kKebabFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kKebabFBSetDisplayDevice:
+		if (args->scalarInputCount < 1 || args->scalarInput[0] != 0) {
+			/* Only the built-in panel exists. */
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		fFB->fDisplayDevice = 0;
+		break;
+	case kKebabFBGetDotPitch:
+		out[0] = KEBAB_FB_DOT_PITCH;
+		outCount = 1;
+		break;
+	case kKebabFBGetDisplayArea: {
+		int32_t area[4] = { 0, 0, (int32_t)fFB->fLogicalW, (int32_t)fFB->fLogicalH };
+		ret = kebab_fb_struct_out(args, area, (uint32_t)sizeof(area));
+		break;
+	}
+	case kKebabFBVideoPowerSavings:
+		if (args->scalarInputCount < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		/* Recorded only: the CPU copy path has no power-saving mode. */
+		fFB->fPowerSavings = (uint32_t)args->scalarInput[0];
+		break;
+	case kKebabFBGetColorRemapMode:
+		out[0] = fFB->fColorRemapMode;
+		outCount = 1;
+		break;
+	case kKebabFBSupportedFrameInfo: {
+		struct kebab_frame_info info;
+		bzero(&info, sizeof(info));
+		info.version = 1;
+		info.size = (uint32_t)sizeof(info);
+		info.width = fFB->fLogicalW;
+		info.height = fFB->fLogicalH;
+		info.scale = fFB->fLogicalW == KEBAB_FB_LOGICAL_W ? 3 : 1;
+		info.refresh = 60;
+		info.gamut = KEBAB_FB_GAMUT_SRGB;
+		info.hdr = 0;
+		info.rotation = 0;
+		info.pixelFormat = KEBAB_FB_FORMAT_BGRA;
+		ret = kebab_fb_struct_out_partial(args, &info, (uint32_t)sizeof(info));
+		break;
+	}
+	case kKebabFBCopyDisplayedSurface: {
+		uint32_t layer = args->scalarInputCount > 0 ? (uint32_t)args->scalarInput[0] : 0;
+		uint32_t id;
+		KebabSurface *s;
+		if (layer >= KEBAB_FB_LAYERS) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		IOLockLock(fFB->fLock);
+		id = fFB->fLayerSurface[layer];
+		IOLockUnlock(fFB->fLock);
+		if (id == 0) {
+			ret = kIOReturnNoDevice;        /* nothing presented on it yet */
+			break;
+		}
+		s = kebab_surface_copy(id);
+		if (s == NULL) {
+			ret = kIOReturnNotFound;
+			break;
+		}
+		out[0] = kebab_surface_port_in_task(s, fTask);
+		outCount = 1;
+		s->release();
+		break;
+	}
+	case kKebabFBNotifications:
+		if (args->scalarInputCount >= 3 && args->scalarInput[2] < KEBAB_FB_NOTIFY_TYPES) {
+			uint32_t type = (uint32_t)args->scalarInput[2];
+			IOLockLock(fFB->fLock);
+			fFunc[type] = args->scalarInput[0];
+			fRefcon[type] = args->scalarInput[1];
+			IOLockUnlock(fFB->fLock);
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("KEBAB FB: %s notifications type %u %s\n", name, type,
+			    args->scalarInput[0] ? "on" : "off");
+		} else {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	default:
+		/* Nothing is known about this selector. Success with zeroed outputs
+		 * is worse than an error: userland would believe it got an answer. */
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL &&
+	    selector != kKebabFBGetDisplayArea && selector != kKebabFBSupportedFrameInfo) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	uint64_t *logged = selector < 64 ? &kebab_fb_logged : &kebab_fb_logged_hi;
+	uint64_t bit = 1ULL << (selector & 63);
+	if (!(*logged & bit)) {
+		*logged |= bit;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("KEBAB FB: %s sel %u in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize, ret);
+	}
+	return ret;
+}
+#endif /* KEBAB */
+
+/*
+ * Called by the platform expert once the device tree has been published: create
+ * the framebuffer, attach it to the expert and start it, which is everything the
+ * nub would otherwise have done.
+ */
+extern "C" int
+kebab_display_start(IOService *provider)
+{
+	AppleCLCD *fb = new AppleCLCD;
+
+	if (fb == NULL) {
+		return -1;
+	}
+	if (!fb->init()) {
+		fb->release();
+		return -1;
+	}
+	if (!fb->attach(provider)) {
+		fb->release();
+		return -1;
+	}
+	if (!fb->start(provider)) {
+		fb->detach(provider);
+		fb->release();
+		return -1;
+	}
+	/* canvas is the physical panel; GetDisplaySize is the logical display. */
+	kebab_publish_canvas(provider, (uint32_t)fb->fWidth, (uint32_t)fb->fHeight);
+	IOLog("KEBAB FB: started %ux%u, presenting %ux%u\n",
+	    (uint32_t)fb->fWidth, (uint32_t)fb->fHeight, fb->fLogicalW, fb->fLogicalH);
+	return 0;
+}
+
+/*
+ * The framework reads canvas-width/canvas-height from the service's parent in the
+ * IOService plane as four-byte data, so put them on the platform expert. These
+ * are the physical panel's size; the logical display size comes from selector 8.
+ */
+static void
+kebab_publish_canvas(IOService *provider, uint32_t width, uint32_t height)
+{
+	if (provider == NULL) {
+		return;
+	}
+	OSData *w = OSData::withBytes(&width, sizeof(width));
+	OSData *h = OSData::withBytes(&height, sizeof(height));
+	if (w != NULL) {
+		provider->setProperty("canvas-width", w);
+		w->release();
+	}
+	if (h != NULL) {
+		provider->setProperty("canvas-height", h);
+		h->release();
+	}
+}
