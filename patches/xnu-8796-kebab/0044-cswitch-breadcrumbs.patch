+	msr		TPIDR_EL1, x0
+	ldr		x1, [x0, ACT_CPUDATAP]
+	str		x0, [x1, CPU_ACTIVE_THREAD]
+	ldrsh	x2, [x1, CPU_NUMBER_GS]
+	msr		TPIDR_EL0, x2
+	ldr		x1, [x0, TH_CTH_SELF]
+	msr		TPIDRRO_EL0, x1
+	ldr		x1, [x0, TH_THREAD_ID]
