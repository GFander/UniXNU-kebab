+// 3105942 - Coalesce writes to the same block on journal replay
+//
+
+typedef struct bucket {
+	off_t     block_num;
+	uint32_t  jnl_offset;
+	uint32_t  block_size;
+	int32_t   cksum;
+} bucket;
+
+#define STARTING_BUCKETS 256
