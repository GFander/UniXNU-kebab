+// cnode must be locked
+static inline __attribute__((pure))
+bool hfs_has_rsrc(const cnode_t *cp)
+{
+	if (cp->c_rsrcfork)
+		return cp->c_rsrcfork->ff_blocks > 0;
+	else
+		return cp->c_datafork && cp->c_blocks > cp->c_datafork->ff_blocks;
+}
