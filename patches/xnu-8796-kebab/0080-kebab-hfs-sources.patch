+				goto ExUndo2aPlus;
+			}
+			
+		}
+		else if ( numSrcExtentBlocks )	//	just the source file has extents
+		{
+			err = MoveExtents( vcb, srcData.hfsPlusFile.fileID, destData.hfsPlusFile.fileID, 0, 0, isHFSPlus );
+			if ( err != noErr )
+			{
+				if ( err != dskFulErr )
+					return( err );
