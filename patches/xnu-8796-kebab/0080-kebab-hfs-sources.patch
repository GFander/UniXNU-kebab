+#define c_hint		c_desc.cd_hint
+#define c_parentcnid	c_desc.cd_parentcnid
+#define c_encoding	c_desc.cd_encoding
+
+#define c_fileid	c_attr.ca_fileid
+#define c_mode		c_attr.ca_mode
