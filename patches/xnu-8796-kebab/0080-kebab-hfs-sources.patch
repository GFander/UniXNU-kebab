+ * Initialization of an FSBufferDescriptor structure.
+ */
+#define BDINIT(bd, addr) { \
+	(bd).bufferAddress = (addr); \
+	(bd).itemSize = sizeof(*(addr)); \
+	(bd).itemCount = 1; \
+}
