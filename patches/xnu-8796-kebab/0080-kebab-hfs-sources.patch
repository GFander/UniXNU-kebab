+	CatalogRecord	srcData;	// 520 bytes
+	CatalogRecord	destData;	// 520 bytes
+	CatalogRecord	swapData;	// 520 bytes
+	int16_t		numSrcExtentBlocks;
+	int16_t		numDestExtentBlocks;
+	OSErr		err;
