+/********************************************************************************
+
+	Special values in C
+	
+		NULL		The C standard for an impossible pointer value
+		nil			A carry over from pascal, NULL is prefered for C
+		
+*********************************************************************************/
+#ifndef NULL
+	#define	NULL 0
+#endif
+
+#ifndef nil
+	#define nil NULL
+#endif
+
