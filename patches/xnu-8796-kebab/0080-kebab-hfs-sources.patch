+union HFSPlusRecord {
+	HFSPlusCatalogFolder folder_record;
+	HFSPlusCatalogFile file_record;
+	HFSPlusCatalogThread thread_record;
+	HFSPlusExtentRecord extent_record;
+	HFSPlusAttrRecord attr_record;
