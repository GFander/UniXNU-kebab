@@ -1526,6 +1529,33 @@
 	return -1;
 }
 
+/*
+ * Abort a command that stopped making progress.  Linux calls
+ * geni_cancel_m_cmd() and then geni_abort_m_cmd() and waits up to a second
+ * for the abort interrupt; this driver has no interrupt handler, so it polls
+ * the same status bits with a bounded loop and then clears them.
+ */
+static void
+kt_se_abort(const char *why)
+{
+	uint32_t status = 0;
+	uint32_t i;
+
+	kt_trace("KEBAB TOUCH: aborting the active command (%s)\n", why);
+	kt_se_wr(SE_GENI_M_CMD_CTRL_REG, M_CMD_ABORT);
+	for (i = 0; i < 100; i++) {
+		status = kt_se_rd(SE_GENI_M_IRQ_STATUS);
+		if ((status & (M_CMD_ABORT | M_CMD_DONE | M_CMD_FAILURE)) != 0) {
+			break;
+		}
+		delay(100);
+	}
+	kt_se_wr(SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	kt_se_wr(SE_GENI_TX_WATERMARK_REG, 0);
+	kt_trace("KEBAB TOUCH: abort done: status 0x%08x GENI_STATUS 0x%08x\n",
+	    status, kt_se_rd(SE_GENI_STATUS));
+}
+
 static int
 kt_i2c_write(const uint8_t *buf, uint32_t len)
 {
@@ -1543,6 +1573,13 @@
 	kt_se_wr(SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
 	kt_se_wr(SE_I2C_TX_TRANS_LEN, len);
 	kt_se_wr(SE_GENI_M_CMD0, (I2C_WRITE << M_OPCODE_SHFT) | kt_i2c_param());
+	/*
+	 * Arm one word of TX watermark.  Qualcomm's FIFO path writes 1 here
+	 * right after the command word (i2c-qcom-geni.c, "Get FIFO IRQ");
+	 * without it the sequencer never raises the watermark interrupt and
+	 * this driver waits for a status bit that cannot arrive.
+	 */
+	kt_se_wr(SE_GENI_TX_WATERMARK_REG, 1);
 
 	/* The sequencer asks for data by raising the TX watermark. */
 	for (i = 0; i < 100; i++) {
@@ -1558,6 +1595,7 @@
 	if (i == 100) {
 		printf("KEBAB TOUCH: write watermark timeout, status 0x%08x\n",
 		    status);
+		kt_se_abort("write watermark timeout");
 		return -1;
 	}
 
@@ -1585,6 +1623,7 @@
 		delay(100);
 	}
 	printf("KEBAB TOUCH: write did not complete, status 0x%08x\n", status);
+	kt_se_abort("write completion timeout");
 	return -1;
 }
 
