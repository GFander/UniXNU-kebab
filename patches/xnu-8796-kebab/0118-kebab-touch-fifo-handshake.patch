 	kt_trace("KEBAB TOUCH: probe DMA_MODE_EN 0x%08x CGC_CTRL 0x%08x\n",
 	    kt_se_rd(SE_GENI_DMA_MODE_EN), kt_se_rd(GENI_CGC_CTRL));
+	kt_trace("KEBAB TOUCH: probe TX_WATERMARK 0x%08x M_IRQ_EN 0x%08x\n",
