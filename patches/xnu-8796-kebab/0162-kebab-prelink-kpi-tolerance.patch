 void ml_static_mfree(
+	vm_offset_t,
+	vm_size_t);
+
+/*
+ * Boot-time prelink teardown only: like ml_static_mfree(), but rounds an
+ * unaligned start down and the end up to page boundaries instead of asserting.
+ * The strict ml_static_mfree() keeps its alignment assert for every other
+ * caller, so an alignment bug outside the prelink path still fails hard.
+ */
+void ml_static_mfree_rounded(
 	vm_offset_t,
 	vm_size_t);
 
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1824,6 +1824,42 @@
 #if     DEBUG
 	kprintf("ml_static_mfree: Released 0x%x pages at VA %p, size:0x%llx, last ppn: 0x%x, +%d bad\n", freed_pages, (void *)vaddr, (uint64_t)size, ppn, bad_page_cnt);
 #endif
+}
+
+/*
+ *	Routine:        ml_static_mfree_rounded
+ *	Function:       Prelink teardown variant of ml_static_mfree().
+ *
+ *	The emitter lays __PRELINK_TEXT/__PRELINK_INFO out on 4 KiB boundaries,
+ *	while this kernel's PAGE_SIZE is 16 KiB.  A segment edge can therefore be
+ *	aligned for the emitter but not for ml_static_mfree().  Expand the range
+ *	out to the containing pages and report the adjustment.  This entry point is
+ *	used only by the boot-time prelink teardown; ml_static_mfree() itself keeps
+ *	its hard alignment assert.
+ */
+void
+ml_static_mfree_rounded(
+	vm_offset_t vaddr,
+	vm_size_t   size)
+{
+	vm_offset_t start;
+	vm_offset_t end;
+	vm_offset_t unrounded_end;
+
+	if (size == 0) {
+		return;
+	}
+
+	start = trunc_page_64(vaddr);
+	unrounded_end = vaddr + size;
+	end = round_page_64(unrounded_end);
+
+	if (start != vaddr || end != unrounded_end) {
+		kprintf("ml_static_mfree: rounding prelink range %p..%p to %p..%p\n",
+		    (void *)vaddr, (void *)unrounded_end, (void *)start, (void *)end);
+	}
+
+	ml_static_mfree(start, end - start);
 }
 
