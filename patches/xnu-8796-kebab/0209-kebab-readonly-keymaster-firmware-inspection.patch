+/* One-shot public firmware extraction for ABI inspection, not a key dump.
+ * BSD boot thread prints paced lines so the independent USB worker drains TX.
+ * No normal/panic USB command can select another partition or invoke this.
+ */
+extern int kebab_ufs_keymaster_firmware(void *, uint32_t);
+static void
+qsee_firmware_readback(void)
+{
+	int enabled=0;
+	PE_parse_boot_argn("kebab_keymaster_firmware",&enabled,sizeof(enabled));
+	if (enabled!=1) return;
+	uint8_t *image=kalloc_data(0x80000,Z_WAITOK|Z_ZERO);
+	if (!image) { printf("KEBAB KMFW: allocation failed\n"); return; }
+	int error=kebab_ufs_keymaster_firmware(image,0x80000);
+	if (!error) {
+		printf("KEBAB KMFW: begin keymaster_b size=524288 readonly=1\n");
+		static const char hex[]="0123456789abcdef";
+		for (unsigned off=0; off<0x80000; off+=64) {
+			char line[129];
+			for (unsigned i=0; i<64; i++) {
+				line[2*i]=hex[image[off+i]>>4]; line[2*i+1]=hex[image[off+i]&15];
+			}
+			line[128]=0; printf("KEBAB KMFW: %06x %s\n",off,line);
+			delay(2000);
+		}
+		printf("KEBAB KMFW: end\n");
+	} else printf("KEBAB KMFW: read refused/error=%d\n",error);
+	kfree_data(image,0x80000);
+}
