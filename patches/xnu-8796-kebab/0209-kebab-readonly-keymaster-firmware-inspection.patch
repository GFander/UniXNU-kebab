+/* Inspection is deliberately limited to the public executable keymaster_b.
+ * The device's saved GPT places it on LU4. Never expose arbitrary LU/LBA reads,
+ * RPMB, keystore or other partitions. All state is restored under the same
+ * mutex that serializes the mounted root's transfers, including error paths.
+ */
+static uint32_t
+ufs_inspect_crc32(const uint8_t *bytes, uint32_t size)
+{
+	uint32_t crc=UINT32_MAX;
+	for (uint32_t i=0; i<size; i++) {
+		crc^=bytes[i];
+		for (unsigned j=0; j<8; j++) crc=(crc>>1)^(0xedb88320u & (0u-(crc&1)));
+	}
+	return ~crc;
+}
+
+int kebab_ufs_keymaster_firmware(void *output, uint32_t size);
+int
+kebab_ufs_keymaster_firmware(void *output, uint32_t size)
+{
+	if (!output || size!=0x80000) return EINVAL;
+	if (panic_active() || ml_at_interrupt_context() || get_preemption_level() || !ml_get_interrupts_enabled()) return EBUSY;
+	lck_mtx_lock(&kebab_ufs_lock);
+	int error=ENXIO;
+	uint8_t saved_lun=su.lun;
+	uint64_t saved_capacity=su.device_blocks,saved_first=su.first_block,saved_blocks=su.nblocks;
+	if (!su.ready || su.failed || saved_lun!=0 || su.writable) goto restore;
+	su.lun=4;
+	error=ufs_read_capacity(); if (error) goto restore;
+	error=ufs_read_blocks(1,1); if (error) goto restore;
+	uint8_t *b=(uint8_t *)(su.dma+DMA_BOUNCE);
+	uint32_t header_size,header_crc,table_crc,nent,esz;
+	uint64_t entry_lba,current_lba;
+	memcpy(&header_size,b+12,4); memcpy(&header_crc,b+16,4);
+	memcpy(&current_lba,b+24,8); memcpy(&entry_lba,b+72,8);
+	memcpy(&nent,b+80,4); memcpy(&esz,b+84,4); memcpy(&table_crc,b+88,4);
+	if (memcmp(b,"EFI PART",8) || current_lba!=1 || header_size<92 || header_size>UFS_BLOCK ||
+	    esz!=128 || !nent || nent>BOUNCE_SIZE/esz) { error=EINVAL; goto restore; }
+	bzero(b+16,4);
+	if (ufs_inspect_crc32(b,header_size)!=header_crc) { error=EINVAL; goto restore; }
+	error=ufs_read_blocks(entry_lba,(nent*esz+UFS_BLOCK-1)/UFS_BLOCK); if (error) goto restore;
+	if (ufs_inspect_crc32(b,nent*esz)!=table_crc) { error=EINVAL; goto restore; }
+	error=ufs_find_partition("keymaster_b"); if (error) goto restore;
+	if (su.nblocks!=size/UFS_BLOCK) { error=EINVAL; goto restore; }
+	error=ufs_read_blocks(su.first_block,(uint32_t)su.nblocks); if (error) goto restore;
+	/* Only an ARM64 little-endian ELF executable is eligible for extraction. */
+	if (memcmp(b,"\177ELF\002\001\001",7) || b[18]!=0xb7 || b[19]!=0) { error=EINVAL; goto restore; }
+	memcpy(output,b,size);
+restore:
+	su.lun=saved_lun; su.device_blocks=saved_capacity;
+	su.first_block=saved_first; su.nblocks=saved_blocks;
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return error;
 }
 
