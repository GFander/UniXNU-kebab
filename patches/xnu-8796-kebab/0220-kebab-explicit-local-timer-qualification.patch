+
+/* Apple XNU 8796 timer_call.h: LOCAL prevents queue migration; the xcall
+ * places it on its target PE without programming timer sysregs here. */
+void
+KebabCPU::armTimerProbe(void *arg)
+{
+	KebabCPU *cpu = static_cast<KebabCPU *>(arg);
+	if (cpu_number() != (int)cpu->getCPUNumber()) {
+		__atomic_store_n(&cpu->timerProbeCPU, UINT32_MAX, __ATOMIC_RELEASE);
+		return;
+	}
+	uint64_t deadline;
+	nanoseconds_to_deadline(NSEC_PER_MSEC, &deadline);
+	(void)timer_call_enter(&cpu->timerProbe, deadline, TIMER_CALL_SYS_CRITICAL | TIMER_CALL_LOCAL);
+}
+
+void
+KebabCPU::timerProbeFired(timer_call_param_t arg, timer_call_param_t unused __unused)
+{
+	KebabCPU *cpu = static_cast<KebabCPU *>(arg);
+	__atomic_store_n(&cpu->timerProbeCPU, (uint32_t)cpu_number() + 1, __ATOMIC_RELEASE);
