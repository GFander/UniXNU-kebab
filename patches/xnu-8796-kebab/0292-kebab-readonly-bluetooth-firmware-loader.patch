+  uint32_t probe=first;
+  for(uint32_t i=0;;++i){
+   uint32_t next;if(i>=f->clusters||kbf_next(f,probe,&next))return EINVAL;
+   if(kbf_eoc(f,next))break;
+   probe=next;
+  }
+ }
