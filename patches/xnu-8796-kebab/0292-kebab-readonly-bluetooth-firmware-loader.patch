+  error=kbf_init(&fat,image,KBF_IMAGE_BYTES);
+ }
+ if(!error){
+  printf("KEBAB BTFW: validated FAT%u; clusters=%u clusterbytes=%u\n",fat.bits,fat.clusters,fat.cluster_bytes);
+  for(unsigned i=0;i<4;++i){
+   struct kbf_file file;int result=kbf_find(&fat,kbf_names[i],&file);
+   if(!result){
+    uint8_t *copy=(uint8_t *)kalloc_data(file.bytes,Z_WAITOK);if(!copy)result=ENOMEM;
+    else{
+     result=kbf_copy(&fat,&file,copy,file.bytes);
+     if(!result){
+      uint8_t hash[32],repeat[32];uint32_t actual=0;char hex[65];static const char digits[]="0123456789abcdef";SHA256_CTX ctx;
+      SHA256_Init(&ctx);SHA256_Update(&ctx,copy,file.bytes);SHA256_Final(hash,&ctx);
+      result=kebab_bluetooth_firmware_read(i,copy,file.bytes,&actual);
+      if(!result&&actual!=file.bytes)result=EIO;
+      if(!result){
+       SHA256_Init(&ctx);SHA256_Update(&ctx,copy,actual);SHA256_Final(repeat,&ctx);
+       if(memcmp(hash,repeat,32))result=EIO;
+      }
+      if(!result){
+       for(unsigned j=0;j<32;++j){hex[j*2]=digits[hash[j]>>4];hex[j*2+1]=digits[hash[j]&15];}hex[64]=0;
+       printf("KEBAB BTFW: image/%s bytes=%u sha256=%s API-repeat=PASS; not downloaded to controller\n",kbf_display[i],file.bytes,hex);
+       valid|=1u<<i;
+      }
+     }
+     kfree_data(copy,file.bytes);
+    }
+   }
+   if(result){printf("KEBAB BTFW: image/%s error=%d\n",kbf_display[i],result);if(result!=ENOENT)file_error=result;}
+  }
+  if(file_error)error=file_error;
+  else if((valid&3)!=3&&(valid&12)!=12)error=ENOENT;
+ }
+ printf("KEBAB BTFW: loader error=%d; no firmware/UFS write, no radio enable or scan claim\n",error);
+ kfree_data(image,KBF_IMAGE_BYTES);
+}
