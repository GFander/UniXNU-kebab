+  const uint8_t *e=b+i*128;static const char name[]="bluetooth_b";bool match=true;unsigned nonzero=0;
+  for(unsigned j=0;j<36;++j)if(kbf_u16(e+56+2*j)!=(j<sizeof(name)-1?(uint8_t)name[j]:0))match=false;
+  if(!match)continue;
