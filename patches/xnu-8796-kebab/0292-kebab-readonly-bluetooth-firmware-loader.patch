+ if(!error)error=kbf_find(&fat,kbf_names[family],&file);
+ if(!error)error=kbf_copy(&fat,&file,output,capacity);
+ if(!error)*actual=file.bytes;
+ kfree_data(image,KBF_IMAGE_BYTES);return error;
+}
