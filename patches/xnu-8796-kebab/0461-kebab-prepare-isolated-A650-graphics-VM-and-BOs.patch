+int kebab_a650_gpu_backing_publish(KebabA650GpuBackingToken *);
+int kebab_a650_gpu_backing_end(KebabA650GpuBackingToken *);
+int kebab_a650_gpu_backing_release_unpublished(void);
+#ifdef __cplusplus
+}
+#endif
