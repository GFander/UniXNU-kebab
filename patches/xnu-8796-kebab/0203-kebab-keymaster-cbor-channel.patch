+/* Minimal definite CBOR for this audited scalar request and one-byte-string
+ * response. No generic encoder/parser is exposed to a user or TA command.
+ */
+static unsigned
+qsee_cbor_header(uint8_t *out, unsigned major, uint32_t value)
+{
+	unsigned type=major<<5;
+	if (value<24) { out[0]=type|value; return 1; }
+	if (value<=0xff) { out[0]=type|24; out[1]=value; return 2; }
+	if (value<=0xffff) { out[0]=type|25; out[1]=value>>8; out[2]=value; return 3; }
+	out[0]=type|26;
+	for (unsigned i=0; i<4; i++) out[i+1]=(uint8_t)(value>>(24-i*8));
+	return 5;
+}
+
+static bool
+qsee_cbor_read(const uint8_t *data, unsigned bytes, unsigned *cursor, unsigned major, uint32_t *value)
+{
+	if (*cursor>=bytes) return false;
+	unsigned header=data[(*cursor)++];
+	if ((header>>5)!=major) return false;
+	unsigned ai=header & 31;
+	if (ai<24) { *value=ai; return true; }
+	unsigned count=ai==24 ? 1 : ai==25 ? 2 : ai==26 ? 4 : 0;
+	if (!count || count>bytes-*cursor) return false;
+	*value=0;
+	for (unsigned i=0; i<count; i++) *value=(*value<<8)|data[(*cursor)++];
+	return true;
+}
+
+static bool
+qsee_export_blob(const uint8_t *data, unsigned bytes, unsigned *offset, unsigned *size)
+{
+	unsigned cursor=0; uint32_t count,label,length;
+	if (!qsee_cbor_read(data,bytes,&cursor,5,&count) || count!=1 ||
+	    !qsee_cbor_read(data,bytes,&cursor,0,&label) || label!=36 ||
+	    !qsee_cbor_read(data,bytes,&cursor,2,&length) ||
+	    length<=64 || length>0x800 || length!=bytes-cursor) return false;
+	*offset=cursor; *size=length;
+	return true;
 }
 
