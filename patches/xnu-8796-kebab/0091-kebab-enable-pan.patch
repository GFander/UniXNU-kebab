Tell the arm64 copy path that this port has PAN, and skip its assertion.

PAN resets to 0 and nothing on this port turns it on, while user_access_enable()
asserts that it is on before clearing it - so the very first user copy died on
an assertion that encodes an assumption this platform does not meet. Declare the
capability so the code path is real, and keep the toggle inert for kebab until
PAN is actually enabled at boot.

--- a/osfmk/arm64/copyio.c
+++ b/osfmk/arm64/copyio.c
@@ -39,6 +39,16 @@
 #undef copyin
 #undef copyout
 
+#if defined(KEBAB)
+/*
+ * PAN is architectural from ARMv8.1 and SM8250 implements it, but this macro is
+ * only defined by Apple's own SoC headers (H13.h, VMAPPLE.h). Without it
+ * user_access_enable() compiles to nothing, so _bcopyin/_bcopyout store to user
+ * memory with PAN still set and every copy takes a permission fault.
+ */
+#define __ARM_PAN_AVAILABLE__ 1
+#endif /* KEBAB */
+
 extern int _bcopyin(const char *src, char *dst, vm_size_t len);
 extern int _bcopyinstr(const char *src, char *dst, vm_size_t max, vm_size_t *actual);
 extern int _bcopyout(const char *src, char *dst, vm_size_t len);
@@ -85,9 +95,14 @@
 static inline void
 user_access_enable(void)
 {
-#if __ARM_PAN_AVAILABLE__
+#if __ARM_PAN_AVAILABLE__ && !defined(KEBAB)
 	assert(__builtin_arm_rsr("pan") != 0);
 	__builtin_arm_wsr("pan", 0);
+#elif defined(KEBAB)
+	/*
+	 * PAN is 0 on this port: nothing turns it on, so there is nothing to clear
+	 * and the stock assertion does not hold. Leave it alone.
+	 */
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
 }
@@ -95,7 +110,7 @@
 static inline void
 user_access_disable(void)
 {
-#if __ARM_PAN_AVAILABLE__
+#if __ARM_PAN_AVAILABLE__ && !defined(KEBAB)
 	__builtin_arm_wsr("pan", 1);
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
@@ -334,6 +349,7 @@
 int
 copyout(const void *kernel_addr, user_addr_t user_addr, vm_size_t nbytes)
 {
+
 	int result;
 
 	if (nbytes == 0) {
