Declare and use PAN on this port.

__ARM_PAN_AVAILABLE__ is only defined by Apple's own SoC headers, so
user_access_enable() compiled to nothing here. With SCTLR_EL1.SPAN=0 the CPU
sets PAN automatically on every exception entry, so each syscall reached the
copy routines with PAN already set and every user store faulted. Declare the
capability, drop the assertion that assumes PAN is already set (it is not, for
kernel-thread context), and keep the real msr toggles.

--- a/osfmk/arm64/copyio.c
+++ b/osfmk/arm64/copyio.c
@@ -39,6 +39,16 @@
 #undef copyin
 #undef copyout
 
+#if defined(KEBAB)
+/*
+ * PAN is architectural from ARMv8.1 and SM8250 implements it, but this macro is
+ * only defined by Apple's own SoC headers (H13.h, VMAPPLE.h). Without it
+ * user_access_enable() compiles to nothing, so _bcopyin/_bcopyout store to user
+ * memory with PAN still set and every copy takes a permission fault.
+ */
+#define __ARM_PAN_AVAILABLE__ 1
+#endif /* KEBAB */
+
 extern int _bcopyin(const char *src, char *dst, vm_size_t len);
 extern int _bcopyinstr(const char *src, char *dst, vm_size_t max, vm_size_t *actual);
 extern int _bcopyout(const char *src, char *dst, vm_size_t len);
@@ -86,7 +96,14 @@
 user_access_enable(void)
 {
 #if __ARM_PAN_AVAILABLE__
+#if !defined(KEBAB)
 	assert(__builtin_arm_rsr("pan") != 0);
+#endif
+	/*
+	 * PAN must be cleared for real: with SCTLR_EL1.SPAN=0 the hardware sets PAN
+	 * on every exception entry, so a syscall arrives with PAN already set and the
+	 * copy would fault without this.
+	 */
 	__builtin_arm_wsr("pan", 0);
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
@@ -334,6 +351,7 @@
 int
 copyout(const void *kernel_addr, user_addr_t user_addr, vm_size_t nbytes)
 {
+
 	int result;
 
 	if (nbytes == 0) {
