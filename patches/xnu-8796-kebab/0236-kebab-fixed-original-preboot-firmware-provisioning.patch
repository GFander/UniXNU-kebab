+/* Bounded owner-OS firmware subtree provisioning. Included after kcm helpers. */
+#include <sys/dirent.h>
+#include <sys/xattr.h>
+#include <pexpert/device_tree.h>
+#include "kebab_boot_firmware_contract.h"
+_Static_assert(KEBAB_BOOT_FW_ENTRY_COUNT <= 32, "firmware child bitmap width");
+_Static_assert(sizeof(kebab_boot_fw_entries) / sizeof(kebab_boot_fw_entries[0]) == KEBAB_BOOT_FW_ENTRY_COUNT,
+    "firmware entry count");
+
+static int
+kfw_namespace(void)
+{
+ DTEntry chosen;
+ const void *value = NULL;
+ unsigned size = 0;
+ if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+     SecureDTGetProperty(chosen, "boot-manifest-hash", &value, &size) != kSuccess ||
+     size != sizeof(kebab_boot_fw_namespace) || !value ||
+     memcmp(value, kebab_boot_fw_namespace, size)) return EAUTH;
+ return 0;
+}
+
+static int
+kfw_mounts(mount_t preboot, bool writing)
+{
+ struct kebab_volume_identity system, target;
+ int error = kebab_lookup_apfs_preboot(&system, &target);
+ if (error) return error;
+ if (!rootvnode || !preboot || !kcm_mount_readonly(vnode_mount(rootvnode)) ||
+     vnode_mount(rootvnode) == preboot ||
+     kcm_device(vnode_mount(rootvnode)) != makedev(system.major_number, system.minor_number) ||
+     kcm_device(preboot) != makedev(target.major_number, target.minor_number) ||
+     strcmp(vfs_statfs(preboot)->f_fstypename, "apfs") ||
+     (((vfs_flags(preboot) & MNT_RDONLY) != 0) == writing)) return EROFS;
+ return kfw_namespace();
+}
+
+static int
+kfw_maintenance_allowed(void)
+{
+#if DEVELOPMENT || DEBUG
+ uint32_t value = 0;
+ PE_parse_boot_argn("ufsrw", &value, sizeof(value));
+ if (value != 1) return EROFS;
+ value = 0;
+ PE_parse_boot_argn("kebab_boot_firmware", &value, sizeof(value));
+ if (value != 1) return EINVAL;
+ value = 0;
+ PE_parse_boot_argn("kebab_apfs_probe", &value, sizeof(value));
+ if (value != 7) return EINVAL;
+ static const char *const disabled[] = { "rootrw", "kebab_owner_fast", "kebab_install",
+     "kebab_owner_startup", "kebab_owner_dsc", "kebab_owner_os", "kebab_cryptex_media", "kebab_nonce_root" };
+ for (unsigned i = 0; i < sizeof(disabled) / sizeof(disabled[0]); ++i) {
+  value = 0;
+  PE_parse_boot_argn(disabled[i], &value, sizeof(value));
+  if (value) return EPERM;
+ }
+ return 0;
+#else
+ return EPERM;
+#endif
+}
+
+static int
+kfw_path(char *path, size_t capacity, const char *relative)
+{
+ int length = snprintf(path, capacity, "%s%s", KEBAB_BOOT_FW_ROOT, relative);
+ return length < 0 || (size_t)length >= capacity ? ENAMETOOLONG : 0;
+}
+
+static int
+kfw_metadata(vnode_t file, mount_t expected, const struct kebab_boot_fw_entry *entry,
+    bool destination, vfs_context_t context)
+{
+ if (!file || vnode_mount(file) != expected ||
+     (entry->directory ? !vnode_isdir(file) : !vnode_isreg(file))) return EAUTH;
+ struct vnode_attr attributes;
+ VATTR_INIT(&attributes);
+ VATTR_WANTED(&attributes, va_data_size);
+ VATTR_WANTED(&attributes, va_mode);
+ VATTR_WANTED(&attributes, va_uid);
+ VATTR_WANTED(&attributes, va_gid);
+ VATTR_WANTED(&attributes, va_flags);
+ VATTR_WANTED(&attributes, va_nlink);
+ int error = vnode_getattr(file, &attributes, context);
+ if (!error && (!VATTR_IS_SUPPORTED(&attributes, va_data_size) ||
+     !VATTR_IS_SUPPORTED(&attributes, va_mode) || !VATTR_IS_SUPPORTED(&attributes, va_uid) ||
+     !VATTR_IS_SUPPORTED(&attributes, va_gid) || !VATTR_IS_SUPPORTED(&attributes, va_flags) ||
+     !VATTR_IS_SUPPORTED(&attributes, va_nlink) || attributes.va_uid || attributes.va_gid ||
+     attributes.va_flags || (attributes.va_mode & 07777) != entry->mode ||
+     (!entry->directory && (attributes.va_data_size != entry->size ||
+     (destination && attributes.va_nlink != 1))))) error = EAUTH;
+ size_t bytes = 0;
+ if (!error) error = vn_listxattr(file, NULL, &bytes,
+     XATTR_NODEFAULT | XATTR_NOSECURITY | XATTR_NOFOLLOW, context);
+ return !error && bytes ? EAUTH : error;
+}
+
+static int
+kfw_hash(vnode_t file, uint64_t size, uint8_t *buffer, uint8_t digest[32], vfs_context_t context)
+{
+ SHA256_CTX hash;
+ SHA256_Init(&hash);
+ int error = 0;
+ for (uint64_t offset = 0; !error && offset < size; offset += KCM_CHUNK) {
+  int count = (int)MIN(size - offset, KCM_CHUNK), residual = 0;
+  error = vn_rdwr(UIO_READ, file, (caddr_t)buffer, count, (off_t)offset,
+      UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(context), &residual, NULL);
+  if (!error && residual) error = EIO;
+  if (!error) SHA256_Update(&hash, buffer, (size_t)count);
+ }
+ SHA256_Final(digest, &hash);
+ return error;
+}
+
+static bool
+kfw_child(unsigned child, const char *parent)
+{
+ const char *path = kebab_boot_fw_entries[child].relative;
+ const char *slash = strrchr(path, '/');
+ return slash && (size_t)(slash - path) == strlen(parent) &&
+     !memcmp(path, parent, (size_t)(slash - path));
+}
+
+static int
+kfw_children(vnode_t directory, const char *relative, uint8_t *buffer, vfs_context_t context)
+{
+ uint32_t expected = 0, seen = 0;
+ for (unsigned i = 0; i < KEBAB_BOOT_FW_ENTRY_COUNT; ++i)
+  if (kfw_child(i, relative)) expected |= 1u << i;
+ uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+ if (!uio) return ENOMEM;
+ int error = VNOP_OPEN(directory, FREAD, context);
+ if (error) { uio_free(uio); return error; }
+ int eof = 0;
+ off_t offset = 0;
+ unsigned batches = 0;
+ while (!error && !eof) {
+  if (++batches > KEBAB_BOOT_FW_ENTRY_COUNT) { error = EIO; break; }
+  off_t previous = offset;
+  int count = 0;
+  uio_reset(uio, offset, UIO_SYSSPACE, UIO_READ);
+  error = uio_addiov(uio, (uintptr_t)buffer, KCM_CHUNK);
+  if (!error) error = VNOP_READDIR(directory, uio, 0, &eof, &count, context);
+  if (error) break;
+  if (uio_resid(uio) < 0 || uio_resid(uio) > KCM_CHUNK) { error = EIO; break; }
+  size_t used = KCM_CHUNK - (size_t)uio_resid(uio);
+  offset = uio_offset(uio);
+  if (!eof && (!used || previous == offset)) { error = EIO; break; }
+  for (size_t at = 0; !error && at < used;) {
+   size_t header = offsetof(struct dirent, d_name);
+   if (used - at < header) { error = EIO; break; }
+   struct dirent entry;
+   memcpy(&entry, buffer + at, header);
+   const char *name = (const char *)buffer + at + header;
+   if (entry.d_reclen < header || entry.d_reclen > used - at || !entry.d_namlen ||
+       entry.d_namlen > MAXNAMLEN || entry.d_namlen + header >= entry.d_reclen ||
+       name[entry.d_namlen] || strnlen(name, entry.d_namlen) != entry.d_namlen ||
+       memchr(name, '/', entry.d_namlen)) { error = EIO; break; }
+   at += entry.d_reclen;
+   if (!strcmp(name, ".") || !strcmp(name, "..")) continue;
+   uint32_t found = 0;
+   for (unsigned i = 0; i < KEBAB_BOOT_FW_ENTRY_COUNT; ++i) {
+    if (!(expected & (1u << i))) continue;
+    if (!strcmp(strrchr(kebab_boot_fw_entries[i].relative, '/') + 1, name)) found = 1u << i;
+   }
+   if (!found || (seen & found)) error = EAUTH;
+   else seen |= found;
+  }
+ }
+ int closed = VNOP_CLOSE(directory, FREAD, context);
+ uio_free(uio);
+ if (!error) error = closed;
+ return !error && seen != expected ? EAUTH : error;
+}
+
+static int
+kfw_verify_all(mount_t preboot, uint8_t *buffer, vfs_context_t context)
+{
+ char path[MAXPATHLEN];
+ for (unsigned i = 0; i < KEBAB_BOOT_FW_ENTRY_COUNT; ++i) {
+  const struct kebab_boot_fw_entry *entry = &kebab_boot_fw_entries[i];
+  vnode_t file = NULLVP;
+  int error = kfw_path(path, sizeof(path), entry->relative);
+  if (!error) error = vnode_open(path, O_NOFOLLOW | FREAD, 0, 0, &file, context);
+  if (!error) error = kfw_metadata(file, preboot, entry, true, context);
+  if (!error && entry->directory) error = kfw_children(file, entry->relative, buffer, context);
+  if (!error && !entry->directory) {
+   uint8_t digest[32];
+   error = kfw_hash(file, entry->size, buffer, digest, context);
+   if (!error && memcmp(digest, entry->sha256, sizeof(digest))) error = EAUTH;
+  }
+  if (file) {
+   int closed = vnode_close(file, FREAD, context);
+   if (!error) error = closed;
+  }
+  if (error) return error;
+ }
+ return 0;
+}
+
+static int
+kfw_nonce_digest(mount_t preboot, uint8_t *buffer, uint8_t digest[32], vfs_context_t context)
+{
+ vnode_t file = NULLVP;
+ const struct kebab_boot_fw_entry entry = { .size = 4096, .mode = 0600 };
+ int error = vnode_open("/private/preboot/.hios-nonce-root-v1", O_NOFOLLOW | FREAD, 0, 0, &file, context);
+ if (!error) error = kfw_metadata(file, preboot, &entry, true, context);
+ if (!error) error = kfw_hash(file, 4096, buffer, digest, context);
+ if (file) { int closed = vnode_close(file, FREAD, context); if (!error) error = closed; }
+ return error;
+}
+
+int kebab_boot_firmware_prepare(mount_t);
+int
+kebab_boot_firmware_prepare(mount_t preboot)
+{
+ int error = kfw_maintenance_allowed();
+ if (!error) error = kfw_mounts(preboot, true);
+ if (error) return error;
+ vfs_context_t context = vfs_context_current();
+ uint8_t *buffer = kalloc_data(KCM_CHUNK, Z_WAITOK);
+ if (!buffer) return ENOMEM;
+ uint8_t nonce_before[32], nonce_after[32];
+ error = kfw_nonce_digest(preboot, buffer, nonce_before, context);
+ vnode_t existing = NULLVP;
+ if (!error) {
+  error = vnode_lookup(KEBAB_BOOT_FW_ROOT, VNODE_LOOKUP_NOFOLLOW, &existing, context);
+  if (!error) {
+   vnode_put(existing);
+   /* Idempotence is read-only. Any partial/foreign tree is preserved/rejected. */
+   error = kfw_verify_all(preboot, buffer, context);
+   goto done;
+  }
+  if (error != ENOENT) goto done;
+  error = 0;
+ }
+ for (unsigned i = 0; !error && i < KEBAB_BOOT_FW_ENTRY_COUNT; ++i) {
+  const struct kebab_boot_fw_entry *entry = &kebab_boot_fw_entries[i];
+  char path[MAXPATHLEN];
+  error = kfw_mounts(preboot, true);
+  if (!error) error = kfw_path(path, sizeof(path), entry->relative);
+  if (error) break;
+  if (entry->directory) { error = kcm_mkdir_fixed(path, preboot, context); continue; }
+  vnode_t source = NULLVP, destination = NULLVP;
+  error = vnode_open(entry->relative, O_NOFOLLOW | FREAD, 0, 0, &source, context);
+  if (!error) error = kfw_metadata(source, vnode_mount(rootvnode), entry, false, context);
+  uint8_t digest[32];
+  if (!error) error = kfw_hash(source, entry->size, buffer, digest, context);
+  if (!error && memcmp(digest, entry->sha256, sizeof(digest))) error = EAUTH;
+  if (!error) error = vnode_open(path, O_CREAT | O_EXCL | O_NOFOLLOW | FWRITE,
+      entry->mode, 0, &destination, context);
+  if (!error && (!vnode_isreg(destination) || vnode_mount(destination) != preboot)) error = EAUTH;
+  for (uint64_t offset = 0; !error && offset < entry->size; offset += KCM_CHUNK) {
+   int count = (int)MIN(entry->size - offset, KCM_CHUNK), residual = 0;
+   error = vn_rdwr(UIO_READ, source, (caddr_t)buffer, count, (off_t)offset,
+       UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(context), &residual, NULL);
+   if (!error && residual) error = EIO;
+   residual = 0;
+   if (!error) error = vn_rdwr(UIO_WRITE, destination, (caddr_t)buffer, count, (off_t)offset,
+       UIO_SYSSPACE, IO_SYNC | IO_NOCACHE, vfs_context_ucred(context), &residual, NULL);
+   if (!error && residual) error = EIO;
+  }
+  if (source) { int closed = vnode_close(source, FREAD, context); if (!error) error = closed; }
+  if (destination) { int closed = vnode_close(destination, FWRITE, context); if (!error) error = closed; }
+ }
+ if (!error) error = kfw_verify_all(preboot, buffer, context);
+done:
+ if (!error) error = kfw_mounts(preboot, true);
+ if (!error) error = kfw_nonce_digest(preboot, buffer, nonce_after, context);
+ if (!error && memcmp(nonce_before, nonce_after, sizeof(nonce_before))) error = EAUTH;
+ bzero(nonce_before, sizeof(nonce_before));
+ bzero(nonce_after, sizeof(nonce_after));
+ bzero(buffer, KCM_CHUNK);
+ kfree_data(buffer, KCM_CHUNK);
+ printf("KEBAB OWNER FW: provision %s (%d), nodes=%u bytes=%u nonce-record-preserved=%u\n",
+     error ? "FAIL" : "PASS", error, KEBAB_BOOT_FW_ENTRY_COUNT, KEBAB_BOOT_FW_FILE_BYTES, !error);
+ return error;
+}
+
+static int
+kfw_boot_verify(void)
+{
+ uint32_t enabled = 0;
+ PE_parse_boot_argn("kebab_boot_firmware", &enabled, sizeof(enabled));
+ if (!enabled) return 0;
+ if (enabled != 2) return EINVAL;
+ int error = kfw_mounts(kcm_backing, false);
+ if (error) return error;
+ uint8_t *buffer = kalloc_data(KCM_CHUNK, Z_WAITOK);
+ if (!buffer) return ENOMEM;
+ error = kfw_verify_all(kcm_backing, buffer, vfs_context_current());
+ kfree_data(buffer, KCM_CHUNK);
+ if (!error) error = kfw_mounts(kcm_backing, false);
+ printf("KEBAB OWNER FW: original firmware subtree SHA/metadata/topology/RO %s (%d)\n",
+     error ? "FAIL" : "PASS", error);
+ return error;
+}
