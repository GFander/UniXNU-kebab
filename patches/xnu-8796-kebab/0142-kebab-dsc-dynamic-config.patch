+/*
+ * dyld does not map only the cache files.  mapSplitCacheSystemWide() appends
+ * one extra "file" with fd == -1: a single page at
+ *
+ *     sharedRegionStart + header.dynamicDataOffset
+ *
+ * holding struct dyld_cache_dynamic_data_header (magic, fsId, fsObjId), and it
+ * puts it at the *end* of the mapping list so it is slid with everything else.
+ * Both readers of that page are unconditional once shared_region_check_np()
+ * succeeds:
+ *
+ *     SyscallDelegate::hasExistingDyldCache()   dyldMain, before anything else
+ *     reuseExistingCache()                      SharedCacheRuntime
+ *
+ * do `strncmp((char*)(base + header.dynamicDataOffset), magic, 16)`.  A cache
+ * that the kernel pre-mapped without that page therefore faults inside dyld on
+ * its first cache access instead of falling back to the filesystem.
+ *
+ * The port cannot supply the contents (dyld writes them itself, for its own
+ * process), but it must supply the mapping: read-only, anonymous, so it reads
+ * as zeros and dyld takes its "does not contain dynamic config data" branch
+ * and carries on.  On the real cache dynamicDataOffset is 0xaade4000 and
+ * dynamicDataMaxSize 0x4000, i.e. exactly the one-page gap between the plan's
+ * extent (0xaade4000) and sharedRegionSize (0xaade8000).
+ */
+static int
+kebab_dsc_add_dynamic_config(struct kebab_dsc_plan *plan,
+    const struct kebab_dsc_header *h)
+{
+	struct kebab_dsc_file *main_file = &plan->files[0];
+	struct shared_file_mapping_slide_np *m;
+	uint64_t addr;
+	uint64_t size;
+	uint64_t region_end;
+	uint32_t i, j;
+
+	if (h->dynamic_data_offset == 0) {
+		printf("KEBAB DSC: dynamicDataOffset is 0; no dynamic config page "
+		    "to map\n");
+		return 0;
+	}
+	if ((h->dynamic_data_offset & (KEBAB_DSC_PAGE_SIZE - 1)) != 0) {
+		printf("KEBAB DSC: dynamicDataOffset 0x%llx is not 0x%x-byte "
+		    "aligned\n", (unsigned long long)h->dynamic_data_offset,
+		    KEBAB_DSC_PAGE_SIZE);
+		return EINVAL;
+	}
+	size = h->dynamic_data_max_size;
+	if (size == 0) {
+		/* dyld maps round_page(sizeof(dyld_cache_dynamic_data_header)) */
+		size = KEBAB_DSC_PAGE_SIZE;
+	}
+	if ((size & (KEBAB_DSC_PAGE_SIZE - 1)) != 0) {
+		size = (size + KEBAB_DSC_PAGE_SIZE - 1) &
+		    ~(uint64_t)(KEBAB_DSC_PAGE_SIZE - 1);
+	}
+	addr = plan->region_start + h->dynamic_data_offset;
+	region_end = plan->region_start + plan->region_size;
+	if (addr < plan->region_start || addr + size < addr ||
+	    addr + size > region_end) {
+		printf("KEBAB DSC: dynamic config page [0x%llx, 0x%llx) is outside "
+		    "the declared region [0x%llx, 0x%llx)\n",
+		    (unsigned long long)addr, (unsigned long long)(addr + size),
+		    (unsigned long long)plan->region_start,
+		    (unsigned long long)region_end);
+		return EINVAL;
+	}
+	if (main_file->mapping_count >= KEBAB_DSC_MAX_MAPPINGS) {
+		printf("KEBAB DSC: no room for the dynamic config page in the main "
+		    "cache's %u mappings\n", KEBAB_DSC_MAX_MAPPINGS);
+		return E2BIG;
+	}
+
+	/* It must not collide with anything the cache itself maps. */
+	for (i = 0; i < plan->file_count; i++) {
+		const struct kebab_dsc_file *f = &plan->files[i];
+
+		for (j = 0; j < f->mapping_count; j++) {
+			const struct shared_file_mapping_slide_np *o =
+			    &f->mappings[j];
+
+			if (addr < o->sms_address + o->sms_size &&
+			    o->sms_address < addr + size) {
+				printf("KEBAB DSC: dynamic config page [0x%llx, "
+				    "0x%llx) overlaps %s mapping %u\n",
+				    (unsigned long long)addr,
+				    (unsigned long long)(addr + size),
+				    f->name, j);
+				return EINVAL;
+			}
+		}
+	}
+
+	m = &main_file->mappings[main_file->mapping_count];
+	m->sms_address = addr;
+	m->sms_size = size;
+	m->sms_file_offset = 0;
+	m->sms_slide_size = 0;
+	m->sms_slide_start = 0;
+	m->sms_max_prot = VM_PROT_READ;
+	/*
+	 * VM_PROT_ZF is what makes vm_shared_region_map_file() create an
+	 * anonymous zero-filled object instead of a file mapping.  It is masked
+	 * off with VM_PROT_ALL before it reaches the VM map entry.
+	 */
+	m->sms_init_prot = VM_PROT_READ | VM_PROT_ZF;
+	main_file->mapping_count++;
+	plan->dynamic_config_addr = addr;
+	plan->dynamic_config_size = size;
+	return 0;
+}
