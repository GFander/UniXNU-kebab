+/* Fixed, default-off QSEE application lookup. No app loading or key command.
+ * Protocol references: Linux v6.12 qcom_scm.c/qcom_tzmem.c and this board's
+ * qseecomi.h. Independently implemented; no Linux implementation is included.
+ * A single permanent wired page is retained until reset, even after errors.
+ */
+#if defined(KEBAB)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/debug.h>
+#include <mach/vm_param.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <arm/machine_routines.h>
+#include <pexpert/pexpert.h>
+extern int get_preemption_level(void);
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+
+struct qsee_regs { uint64_t x[8]; };
+struct qsee_result { int32_t status; uint64_t value, type, data; unsigned attempts; };
+
+static void
+qsee_raw(struct qsee_regs *r)
+{
+	register uint64_t x0 __asm__("x0") = r->x[0];
+	register uint64_t x1 __asm__("x1") = r->x[1];
+	register uint64_t x2 __asm__("x2") = r->x[2];
+	register uint64_t x3 __asm__("x3") = r->x[3];
+	register uint64_t x4 __asm__("x4") = r->x[4];
+	register uint64_t x5 __asm__("x5") = r->x[5];
+	register uint64_t x6 __asm__("x6") = r->x[6];
+	register uint64_t x7 __asm__("x7") = r->x[7];
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+	    "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	r->x[0]=x0; r->x[1]=x1; r->x[2]=x2; r->x[3]=x3;
+	r->x[4]=x4; r->x[5]=x5; r->x[6]=x6; r->x[7]=x7;
+}
+
+/* Standard SMC64 for operations that can yield; INFO is a fast query.
+ * Preserve the A6 cookie, restore every original argument, never busy-retry.
+ * A firmware call that never returns cannot be timed out by this bound.
+ */
+static struct qsee_result
+qsee_call(uint32_t function, uint32_t info, uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	uint64_t cookie=0;
+	struct qsee_result result={};
+	for (unsigned i=0; i<32; i++) {
+		struct qsee_regs r={ .x={i ? 1 : function, info, a, b, c, d, cookie, 0} };
+		qsee_raw(&r);
+		result.status=(int32_t)r.x[0]; result.value=r.x[1];
+		result.type=r.x[2]; result.data=r.x[3]; result.attempts=i+1;
+		if (result.status != 1) break;
+		cookie=r.x[6];
+	}
+	return result;
+}
+
+static int
+qsee_available(uint32_t target)
+{
+	struct qsee_result r=qsee_call(0xc2000601,1,target,0,0,0);
+	printf("KEBAB QSEE: capability=0x%x status=%d available=%llu attempts=%u\n",
+	    target,r.status,r.value,r.attempts);
+	if (r.status || r.value>1) return -1;
+	return (int)r.value;
+}
+
+/* Noncoherent private page; no CPU access between submit and return. */
+static void
+qsee_cache(vm_offset_t page, bool submit)
+{
+	uint64_t ctr;
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	vm_size_t line=(vm_size_t)4 << ((ctr >> 16) & 15);
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (vm_offset_t va=page; va<page+PAGE_SIZE; va+=line) {
+		if (submit) __asm__ volatile("dc civac, %0" : : "r"(va) : "memory");
+		else __asm__ volatile("dc ivac, %0" : : "r"(va) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void kebab_qsee_probe(void);
+void
+kebab_qsee_probe(void)
+{
+	int enabled=0;
+	PE_parse_boot_argn("kebab_qsee_probe",&enabled,sizeof(enabled));
+	if (enabled!=1) return;
+	if (panic_active() || ml_at_interrupt_context() || get_preemption_level() || !ml_get_interrupts_enabled()) {
+		printf("KEBAB QSEE: refused unsafe context\n"); return;
+	}
+	static bool attempted;
+	if (attempted) { printf("KEBAB QSEE: already attempted\n"); return; }
+	attempted=true;
+	printf("KEBAB QSEE: fixed lookup begin; no app load, send, key or RPMB operation\n");
+	if (PAGE_SIZE!=0x4000 || qsee_available(0x02000601)!=1 || qsee_available(0x32000103)!=1) return;
+
+	vm_offset_t page=0;
+	if (kmem_alloc_contig(kernel_map,&page,PAGE_SIZE,PAGE_MASK,0,0,
+	    KMA_DATA|KMA_ZERO|KMA_PERMANENT,VM_KERN_MEMORY_IOKIT)!=KERN_SUCCESS) {
+		printf("KEBAB QSEE: no private wired page\n"); return;
+	}
+	ppnum_t pn=pmap_find_phys(kernel_pmap,(addr64_t)page);
+	uint64_t pa=ptoa_64(pn);
+	if (!pn || (page & PAGE_MASK) || (pa & PAGE_MASK)) {
+		printf("KEBAB QSEE: invalid private page mapping\n"); return;
+	}
+	uint64_t handle=0;
+	bool bridged=false;
+	int bridge=qsee_available(0x02000c1c);
+	if (bridge<0) return;
+	if (bridge==1) {
+		struct qsee_result r=qsee_call(0x42000c1c,0,0,0,0,0);
+		printf("KEBAB QSEE: bridge-enable status=%d result=%llu\n",r.status,r.value);
+		if (r.status) return;
+		if (r.value==0) {
+			if (qsee_available(0x02000c1e)!=1 || qsee_available(0x02000c1d)!=1) return;
+			/* Read/write, no execute; one HLOS VMID (3), page-aligned size. */
+			r=qsee_call(0x42000c1e,4,pa|6,pa|6,PAGE_SIZE|0x200,3);
+			printf("KEBAB QSEE: bridge-create status=%d result=%llu\n",r.status,r.value);
+			if (r.status || r.value) return;
+			handle=r.type; bridged=true;
+		} else if (r.value!=4) return; /* Documented not-supported result. */
+	}
+	static const char *const names[]={"keymaster","keymaster64","km4","keymint","hios-no-such-app"};
+	bool outstanding=false;
+	for (unsigned i=0; i<sizeof(names)/sizeof(names[0]); i++) {
+		bzero((void *)page,PAGE_SIZE);
+		strlcpy((char *)page,names[i],64);
+		qsee_cache(page,true);
+		/* QSEE owner50, app-manager1, lookup3; buffer RW + length. */
+		struct qsee_result r=qsee_call(0x72000103,0x22,pa,strlen(names[i]),0,0);
+		printf("KEBAB QSEE: app=%s status=%d result=0x%llx type=0x%llx data=0x%llx attempts=%u\n",
+		    names[i],r.status,r.value,r.type,r.data,r.attempts);
+		if (r.status==1 || (!r.status && r.value!=0 && r.value!=UINT32_MAX)) {
+			outstanding=true; break; /* Incomplete/listener/callback/unknown. */
+		}
+		qsee_cache(page,false);
+		/* Success requires QSEE success, APP_ID tag and a nonzero 32-bit ID. */
+		if (!r.status && !r.value && r.type==0xee01 && r.data && r.data<=UINT32_MAX)
+			printf("KEBAB QSEE: found app=%s id=%llu; command ABI still unqualified\n",names[i],r.data);
+		if (r.status) break; /* No retry after transport errors. */
+	}
+	if (outstanding) {
+		printf("KEBAB QSEE: incomplete call; page and bridge retained until reset\n"); return;
+	}
+	bzero((void *)page,PAGE_SIZE); qsee_cache(page,true);
+	if (bridged) {
+		struct qsee_result r=qsee_call(0x42000c1d,1,handle,0,0,0);
+		printf("KEBAB QSEE: bridge-delete status=%d result=%llu; page retained\n",r.status,r.value);
+	}
+	printf("KEBAB QSEE: fixed lookup end; no hardware key qualification\n");
+}
+#endif /* KEBAB */
