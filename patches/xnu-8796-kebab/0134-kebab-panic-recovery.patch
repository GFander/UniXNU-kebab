diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -439,6 +439,24 @@
 			kdp_explicitly_requested = TRUE;
 		}
 	}
+
+	/*
+	 * This port's only debugger transport is the USB CDC-ACM console, so the
+	 * stock arm64 panic-debugging default is a trap.  debug=0x14e contains
+	 * DB_NMI, which sets panicDebugging and makes a panic stop before
+	 * panic_spin_forever(): it either waits for KDP on the same port or
+	 * spins with nothing servicing it.  Without a debugger attached that is
+	 * indistinguishable from a hang, and this board has no watchdog reset.
+	 *
+	 * Keep the stock behaviour only when a debugger was actually asked for
+	 * (kebabkdp=1 or kdp_match_name); otherwise the panic path is allowed to
+	 * reach the reboot decision.  halt_in_debugger is deliberately not
+	 * touched: DB_HALT still stops at an explicit Debugger() entry, and
+	 * kebabkdp=1 still restores the KDP attach path.
+	 */
+	if (!kdp_explicitly_requested) {
+		panicDebugging = FALSE;
+	}
 #endif /* defined(KEBAB) */
 
 #endif /* MACH_KDP */
diff --git a/iokit/Kernel/arm/KebabPlatformExpert.cpp b/iokit/Kernel/arm/KebabPlatformExpert.cpp
--- a/iokit/Kernel/arm/KebabPlatformExpert.cpp
+++ b/iokit/Kernel/arm/KebabPlatformExpert.cpp
@@ -202,7 +202,20 @@
 	    type == kPEPanicRestartCPU || type == kPEPanicRestartCPUNoCallouts)) {
 		kebab_usb_panic_spin();          /* does not return */
 	}
-	if (type == kPERestartCPU) {
+	/*
+	 * A panic restart that did not take the console loop above has no
+	 * console to keep.  The stock path would return -1 without touching the
+	 * hardware and halt_all_cpus() would then park the board until a power
+	 * cycle, so reset here instead.  This is the "cannot be serviced" arm of
+	 * the panic policy: the console pump is the only reason to stay alive
+	 * after a panic, and it is unavailable.
+	 */
+	if (type == kPERestartCPU ||
+	    type == kPEPanicRestartCPU ||
+	    type == kPEPanicRestartCPUNoCallouts) {
+		if (panic_active() && !kebab_usb_console_ready()) {
+			printf("KEBAB PANIC: no console to service; rebooting via PSCI SYSTEM_RESET\n");
+		}
 		return kebab_psci_system_reset();
 	}
 	return IODTPlatformExpert::haltRestart(type);
