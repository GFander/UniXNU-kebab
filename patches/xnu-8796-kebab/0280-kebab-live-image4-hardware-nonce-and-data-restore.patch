+/* Read-only restore of both already provisioned roots; no generation route.
+ * Publish nonce AES only after BOTH witnesses and shared-page cleanup pass.
+ * Data callbacks still use their existing separate commit/publish lifecycle. */
+bool
+kebab_qsee_live_roots_record(uint8_t *data, uint8_t *nonce, unsigned size)
+{
+ if (!data || !nonce || data==nonce || size!=4096 || !kebab_image4_live_nonce_profile() ||
+     qsee_data_record || qsee_nonce_record || qsee_live_roots ||
+     !qsee_data_layout(data,size) || !qsee_nonce_layout(nonce,size) ||
+     panic_active() || ml_at_interrupt_context() || get_preemption_level() || !ml_get_interrupts_enabled()) return false;
+ qsee_data_record=data;qsee_data_mode=2;qsee_data_ok=false;
+ qsee_nonce_record=nonce;qsee_nonce_mode=2;qsee_nonce_ok=false;qsee_live_roots=true;
+ kebab_qsee_probe();
+ bool ok=qsee_nonce_ok && qsee_data_ok;
+ if (ok) ok=kebab_aes_nonce_publish();
+ if (!ok) { kebab_aes_nonce_cancel(); kebab_file_keys_cancel(); }
+ qsee_data_record=NULL;qsee_data_mode=0;qsee_data_ok=false;
+ qsee_nonce_record=NULL;qsee_nonce_mode=0;qsee_nonce_ok=false;qsee_live_roots=false;
+ printf("KEBAB LIVE ROOTS: existing nonce+Data hardware restore %s; generation disabled\n",ok?"PASS":"FAIL");
+ return ok;
+}
