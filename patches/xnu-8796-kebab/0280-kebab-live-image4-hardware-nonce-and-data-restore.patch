+/* Restore independent existing records in the same one-shot QSEE session.
+ * A true transport result alone is NOT authentication. Never proceed to Data
+ * after an uncertain transport or failed nonce witness/preparation. */
+static bool
+qsee_storage_roots(vm_offset_t page, uint64_t pa, uint32_t app)
+{
+ if (!qsee_live_roots) return qsee_storage_probe(page,pa,app);
+ uint8_t *data=qsee_data_record,*nonce=qsee_nonce_record;
+ qsee_data_record=NULL;qsee_data_mode=0;
+ bool safe=qsee_storage_probe(page,pa,app);
+ qsee_data_record=data;qsee_data_mode=2;
+ qsee_nonce_record=NULL;qsee_nonce_mode=0;
+ if (safe && qsee_nonce_ok) safe=qsee_storage_probe(page,pa,app);
+ qsee_nonce_record=nonce;qsee_nonce_mode=2;
+ return safe;
