+#ifndef KEBAB_LOW_DMA_OBSERVATION_H
+#define KEBAB_LOW_DMA_OBSERVATION_H
+#include <stdint.h>
+#define KEBAB_LOW_DMA_MAGIC 0x3142534f444c424bULL /* KBLDOSB1 */
+#define KEBAB_LOW_DMA_SCHEMA 1u
+enum { KLDC_NOT_RUN, KLDC_CAPTURED, KLDC_BUSY, KLDC_DONE };
+enum { KLDC_MEASURED_RETAINED, KLDC_ABSENT, KLDC_DISABLED, KLDC_ALLOC_FAILED,
+ KLDC_BAD_ARGS, KLDC_BAD_TREE, KLDC_BAD_POLICY, KLDC_BAD_BINDING, KLDC_BAD_CLAIM,
+ KLDC_BAD_MAP, KLDC_OVERLAP, KLDC_MEASUREMENT_MISSING, KLDC_MEASUREMENT_MISMATCH,
+ KLDC_RANGE_UNMEASURED, KLDC_CRYPTO_NOT_READY, KLDC_CAPTURE_NOT_RUN, KLDC_MEASUREMENT_NOT_READY };
+enum { KLDC_F_CAPTURED=1u, KLDC_F_POLICY=2u, KLDC_F_LOADER_BINDING=4u,
+ KLDC_F_RANGE=8u, KLDC_F_RETAINED=16u, KLDC_F_MEASUREMENT=32u,
+ KLDC_F_NC_MAPPED=64u, KLDC_F_PAS_READY=128u };
+/* All fields describe a receipt; neither PA observation nor a matching
+ * development owner measurement is PAS support, NC mapping or DMA proof. */
+struct kebab_low_dma_observation {
+ uint64_t magic;
+ uint32_t schema,bytes,state,result,flags,reserved0;
+ uint64_t raw,raw_bytes,image,image_bytes,metadata,metadata_bytes;
+ uint64_t allocate_status,free_status;
+ uint32_t loader_claim_state,loader_claim_error,efi_records,managed_banks;
+ uint8_t loader_sha256[32],policy_sha256[32],measured_adt_sha256[32],firmware_prefix_sha256[32];
+ uint64_t reserved[2];
+};
