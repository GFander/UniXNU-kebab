+extern "C" {
+#endif
+struct boot_args;
+/* Boot CPU only, before const_boot_args copy. Map/owned pointers reference
+ * the existing validated KBM arrays; no physical address is accepted here. */
+void kebab_low_dma_capture(const struct boot_args *,const void *map,uint32_t count,
+ const void *owned,uint32_t owned_count,uint32_t kbm_status);
+/* Normal-context, fixed-length immutable snapshot. No PA/mapping API. */
+int kebab_low_dma_snapshot(struct kebab_low_dma_observation *,uint32_t bytes);
+#ifdef __cplusplus
+}
+#endif
+#endif
