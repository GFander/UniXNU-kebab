+    int path_size = sizeof(path);
+    if (!error) error = vn_getpath(vnode, path, &path_size);
+    if (!error) strlcpy(mount_path, stats->f_mntonname, sizeof(mount_path));
+    uint32_t length = error ? 0 : (uint32_t)before.va_data_size;
+    void *data = NULL, *check = NULL;
+    if (!error) {
