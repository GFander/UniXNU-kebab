 	exec_prefault_data(p, imgp, &load_result);
 
+#if defined(KEBAB)
+	/*
+	 * The new address space and its shared region are current here (the
+	 * switch to the old map is the next statement), which is the first
+	 * point at which the dyld shared cache can be mapped into it.  Only
+	 * pid 1, and only when kebab_dsc_map=1.
+	 */
+	kebab_dsc_exec_hook(p);
+#endif /* KEBAB */
+
 	vm_map_switch(old_map);
 
