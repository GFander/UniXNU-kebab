+    * any user message. CONFIG_SERVICE_PORT_INFO is a real build option. */
+   if(port->ip_service_port&&port->ip_splabel!=NULL){
+    ipc_service_port_label_t label=(ipc_service_port_label_t)port->ip_splabel;
+    state->service_present=1;state->launchd_name=label->ispl_launchd_name;
+    state->label_flags=label->ispl_flags;
+#if CONFIG_SERVICE_PORT_INFO
+    state->service_info=1;state->domain=label->ispl_domain;
+    const char *name=label->ispl_service_name;
+    if(name!=NULL){
+     unsigned i=0;
+     for(;i+1<sizeof(state->service_name)&&name[i]!=0;i++){
+      unsigned char c=(unsigned char)name[i];
+      state->service_name[i]=(c>=0x21&&c<=0x7e)?(char)c:'?';
+      if(c<0x21||c>0x7e)state->name_changed=1;
+     }
+     state->name_truncated=name[i]!=0;
+    }
+#endif
+   }
    next=ip_get_destination(port);state->destination=(uint64_t)(uintptr_t)next;
   }
