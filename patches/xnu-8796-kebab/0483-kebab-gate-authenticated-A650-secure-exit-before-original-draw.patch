+{
+ return !p || p->epoch!=1 || !p->gmu_generation || !p->gpu_generation || !p->cp_generation ||
+  p->auth_completed!=1 || p->metadata_frozen!=1 || p->image_frozen!=1 || p->CP_baseline_valid!=1?95:0;
+}
