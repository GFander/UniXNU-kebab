+ void *cookie;
+ uint64_t (*now_us)(void *);
+ int (*gate)(void *);
+ int (*authority)(void *,KZEAuthProof *);
+ int (*sample)(void *,KZESample *);
+ int (*prepare)(void *,const uint32_t *,uint32_t);
+ int (*publish)(void *,uint32_t);
+ int (*complete_guard)(void *);
