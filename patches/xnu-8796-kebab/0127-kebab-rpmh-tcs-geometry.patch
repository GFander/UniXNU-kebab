+/*
+ * R5-C: the only code that would ever write a TCS.
+ *
+ * It is compiled out unless KEBAB_RPMH_WRITES is set at build time; in this
+ * build no console command, boot argument or runtime flag can reach it.
+ *
+ * When enabled it follows the vendor sequence, with one deliberate change:
+ * every readback wait is bounded.  Linux' write_tcs_reg_sync() spins until the
+ * value matches, which is exactly the kind of loop an experimental kernel must
+ * not borrow.
+ *
+ * State is reported in three steps the caller has to keep apart: submitted,
+ * completed by the hardware, and only then a rail that may be up.
+ */
+#define KEBAB_RPMH_WRITES 0
+
+#if KEBAB_RPMH_WRITES
+static bool kebab_rpmh_tcs_dead;
+
+static int
+kebab_rpmh_tcs_wr_wait(vm_offset_t t, uint32_t off, uint32_t val)
+{
+	uint32_t i;
+
+	kebab_spmi_wr(t, off, val);
+	for (i = 0; i < 100; i++) {
+		if (kebab_spmi_rd(t, off) == val) {
+			return 0;
+		}
+		delay(100);
+	}
+	return -1;
+}
+
+static int
+kebab_rpmh_tcs_send(const kebab_rpmh_cmd *cmd)
+{
+	vm_offset_t drv, base, t;
+	uint32_t i, status = 0, control;
+
+	if (kebab_rpmh_tcs_dead) {
+		return -1;
+	}
+	drv = ml_io_map(KEBAB_RSC_DRV2_PA, KEBAB_RSC_SIZE);
+	if (drv == 0) {
+		kebab_rpmh_tcs_dead = true;
+		return -1;
+	}
+	/* Only the active TCS1; TCS0 keeps another owner's requests. */
+	base = drv + KEBAB_RSC_TCS_OFF;
+	t = base + 1 * KEBAB_RSC_TCS_STRIDE;
+	control = kebab_spmi_rd(t, KEBAB_RSC_CONTROL);
+	if (kebab_spmi_rd(t, KEBAB_RSC_CMD_ENABLE) != 0 ||
+	    kebab_spmi_rd(t, KEBAB_RSC_CMD_WAIT) != 0 ||
+	    (control & KEBAB_RSC_AMC_TRIGGER) != 0) {
+		kebab_rpmh_tcs_dead = true;
+		return -1;
+	}
+	/* Slot 0 only, with the vendor register offsets. */
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_MSGID, cmd->msgid);
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_ADDR, cmd->addr);
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_DATA, cmd->data);
+	if (kebab_rpmh_tcs_wr_wait(t, KEBAB_RSC_CMD_WAIT, 1u) != 0) {
+		goto fail;
+	}
+	if (kebab_rpmh_tcs_wr_wait(t, KEBAB_RSC_CMD_ENABLE, 1u) != 0) {
+		goto fail;
+	}
+	if (kebab_rpmh_tcs_wr_wait(t, KEBAB_RSC_CONTROL,
+	    control | KEBAB_RSC_AMC_ENABLE) != 0) {
+		goto fail;
+	}
+	if (kebab_rpmh_tcs_wr_wait(t, KEBAB_RSC_CONTROL,
+	    control | KEBAB_RSC_AMC_ENABLE | KEBAB_RSC_AMC_TRIGGER) != 0) {
+		goto fail;
+	}
+	for (i = 0; i < 1000; i++) {
+		status = kebab_spmi_rd(t, KEBAB_RSC_CMD_STATUS);
+		if ((status & KEBAB_RSC_CMD_COMPL) != 0) {
+			break;
+		}
+		delay(100);
+	}
+	if ((status & KEBAB_RSC_CMD_COMPL) == 0) {
+		goto fail;
+	}
+	/* Release the slot the way Linux does, then keep the channel shut. */
+	kebab_spmi_wr(t, KEBAB_RSC_CONTROL, control);
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_ENABLE, 0);
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_WAIT, 0);
+	kebab_rpmh_tcs_dead = true;     /* one request per boot until reviewed */
+	return 0;
+
+fail:
+	kebab_spmi_wr(t, KEBAB_RSC_CONTROL, control);
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_ENABLE, 0);
+	kebab_spmi_wr(t, KEBAB_RSC_CMD_WAIT, 0);
+	kebab_rpmh_tcs_dead = true;
+	return -1;
+}
+#endif /* KEBAB_RPMH_WRITES */
+
 void
 kebab_rpmh_report(void)
 {
