+static int
+ki_read_attrs(vnode_t vp, vfs_context_t ctx, uint32_t *uidp, uint32_t *gidp,
+    uint16_t *modep)
+{
+	struct vnode_attr va;
+	int error;
+
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	VATTR_WANTED(&va, va_mode);
+	error = vnode_getattr(vp, &va, ctx);
+	if (error) {
+		return error;
+	}
