+		printf("OK %s 0 dir mode 0%o uid %u gid %u\n", e->path, mode, uid,
+		    gid);
+	} else if (e->is_link) {
+		printf("OK %s %llu link -> %s mode 0%o uid %u gid %u\n", e->path,
+		    (unsigned long long)e->size, e->link, mode, uid, gid);
