+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	VATTR_SET(&va, va_mode, mode & KI_MODE_MASK);
+	return vnode_setattr(vp, &va, ctx);
