+ * SOFTWARE.
+ */
+
+#include "kebab_bearssl.h"
+
+/* see inner.h */
+void
+kebab_br_range_dec32be(uint32_t *v, size_t num, const void *src)
+{
+	const unsigned char *buf;
+
+	buf = src;
+	while (num -- > 0) {
+		*v ++ = kebab_br_dec32be(buf);
+		buf += 4;
+	}
+}
