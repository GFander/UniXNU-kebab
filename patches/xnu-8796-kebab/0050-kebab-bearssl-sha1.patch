+ * included in all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
+ * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+ * MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+ * NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+ * BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
+ * ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ */
+
+
+/* BearSSL 0.6 primitive-only subset. No TLS, X.509, heap or libc dependency.
+ * kebab_br_* identifiers are prefixed to avoid collisions with kexts/other imports.
+ * The original algorithm bodies are unchanged; endian accesses are portable.
+ */
+#ifndef KEBAB_BEARSSL_H
+#define KEBAB_BEARSSL_H
+#include <stddef.h>
+#include <stdint.h>
+#include <libkern/libkern.h>
+
+typedef struct kebab_br_hash_class_ kebab_br_hash_class;
+struct kebab_br_hash_class_ {
+
+	size_t context_size;
+
+	uint32_t desc;
+
+	void (*init)(const kebab_br_hash_class **ctx);
+
+	void (*update)(const kebab_br_hash_class **ctx, const void *data, size_t len);
+
+	void (*out)(const kebab_br_hash_class *const *ctx, void *dst);
+
+	uint64_t (*state)(const kebab_br_hash_class *const *ctx, void *dst);
+
+	void (*set_state)(const kebab_br_hash_class **ctx,
+		const void *stb, uint64_t count);
+};
+
+#ifndef BR_DOXYGEN_IGNORE
+#define BR_HASHDESC_ID(id)           ((uint32_t)(id) << BR_HASHDESC_ID_OFF)
+#define BR_HASHDESC_ID_OFF           0
+#define BR_HASHDESC_ID_MASK          0xFF
+
+#define BR_HASHDESC_OUT(size)        ((uint32_t)(size) << BR_HASHDESC_OUT_OFF)
+#define BR_HASHDESC_OUT_OFF          8
+#define BR_HASHDESC_OUT_MASK         0x7F
+
+#define BR_HASHDESC_STATE(size)      ((uint32_t)(size) << BR_HASHDESC_STATE_OFF)
+#define BR_HASHDESC_STATE_OFF        15
+#define BR_HASHDESC_STATE_MASK       0xFF
+
+#define BR_HASHDESC_LBLEN(ls)        ((uint32_t)(ls) << BR_HASHDESC_LBLEN_OFF)
+#define BR_HASHDESC_LBLEN_OFF        23
+#define BR_HASHDESC_LBLEN_MASK       0x0F
+
+#define BR_HASHDESC_MD_PADDING       ((uint32_t)1 << 28)
+#define BR_HASHDESC_MD_PADDING_128   ((uint32_t)1 << 29)
+#define BR_HASHDESC_MD_PADDING_BE    ((uint32_t)1 << 30)
+#endif
+
+
+#define kebab_br_md5_ID     1
+
+#define kebab_br_md5_SIZE   16
+
+extern const kebab_br_hash_class kebab_br_md5_vtable;
+
+typedef struct {
+
+	const kebab_br_hash_class *vtable;
+#ifndef BR_DOXYGEN_IGNORE
+	unsigned char buf[64];
+	uint64_t count;
+	uint32_t val[4];
+#endif
+} kebab_br_md5_context;
+
+void kebab_br_md5_init(kebab_br_md5_context *ctx);
+
+void kebab_br_md5_update(kebab_br_md5_context *ctx, const void *data, size_t len);
+
+void kebab_br_md5_out(const kebab_br_md5_context *ctx, void *out);
+
+uint64_t kebab_br_md5_state(const kebab_br_md5_context *ctx, void *out);
+
+void kebab_br_md5_set_state(kebab_br_md5_context *ctx, const void *stb, uint64_t count);
+
+#define kebab_br_sha1_ID     2
+
+#define kebab_br_sha1_SIZE   20
+
+extern const kebab_br_hash_class kebab_br_sha1_vtable;
+
+typedef struct {
+
+	const kebab_br_hash_class *vtable;
+#ifndef BR_DOXYGEN_IGNORE
+	unsigned char buf[64];
+	uint64_t count;
+	uint32_t val[5];
+#endif
+} kebab_br_sha1_context;
+
+void kebab_br_sha1_init(kebab_br_sha1_context *ctx);
+
+void kebab_br_sha1_update(kebab_br_sha1_context *ctx, const void *data, size_t len);
+
+void kebab_br_sha1_out(const kebab_br_sha1_context *ctx, void *out);
+
+uint64_t kebab_br_sha1_state(const kebab_br_sha1_context *ctx, void *out);
+
+void kebab_br_sha1_set_state(kebab_br_sha1_context *ctx, const void *stb, uint64_t count);
+
+
+#define kebab_br_sha384_ID     5
+
+#define kebab_br_sha384_SIZE   48
+
+extern const kebab_br_hash_class kebab_br_sha384_vtable;
+
+typedef struct {
+
+	const kebab_br_hash_class *vtable;
+#ifndef BR_DOXYGEN_IGNORE
+	unsigned char buf[128];
+	uint64_t count;
+	uint64_t val[8];
+#endif
+} kebab_br_sha384_context;
+
+void kebab_br_sha384_init(kebab_br_sha384_context *ctx);
+
+void kebab_br_sha384_update(kebab_br_sha384_context *ctx, const void *data, size_t len);
+
+void kebab_br_sha384_out(const kebab_br_sha384_context *ctx, void *out);
+
+uint64_t kebab_br_sha384_state(const kebab_br_sha384_context *ctx, void *out);
+
+void kebab_br_sha384_set_state(kebab_br_sha384_context *ctx,
+	const void *stb, uint64_t count);
+
+#define kebab_br_sha512_ID     6
+
+#define kebab_br_sha512_SIZE   64
+
+extern const kebab_br_hash_class kebab_br_sha512_vtable;
+
+#ifdef BR_DOXYGEN_IGNORE
+
+typedef struct {
+
+	const kebab_br_hash_class *vtable;
+} kebab_br_sha512_context;
+#else
+typedef kebab_br_sha384_context kebab_br_sha512_context;
+#endif
+
+void kebab_br_sha512_init(kebab_br_sha512_context *ctx);
+
+#ifdef BR_DOXYGEN_IGNORE
+
+void kebab_br_sha512_update(kebab_br_sha512_context *ctx, const void *data, size_t len);
+#else
+#define kebab_br_sha512_update   kebab_br_sha384_update
+#endif
+
+void kebab_br_sha512_out(const kebab_br_sha512_context *ctx, void *out);
+
+#ifdef BR_DOXYGEN_IGNORE
+
+uint64_t kebab_br_sha512_state(const kebab_br_sha512_context *ctx, void *out);
+#else
+#define kebab_br_sha512_state   kebab_br_sha384_state
+#endif
+
+#ifdef BR_DOXYGEN_IGNORE
+
+void kebab_br_sha512_set_state(kebab_br_sha512_context *ctx,
+	const void *stb, uint64_t count);
+#else
+#define kebab_br_sha512_set_state   kebab_br_sha384_set_state
+#endif
+
+
+static inline void
+kebab_br_enc32le(void *dst, uint32_t x)
+{
+	unsigned char *buf;
+
+	buf = dst;
+	buf[0] = (unsigned char)x;
+	buf[1] = (unsigned char)(x >> 8);
+	buf[2] = (unsigned char)(x >> 16);
+	buf[3] = (unsigned char)(x >> 24);
+
+}
+
+static inline uint32_t
+kebab_br_dec32le(const void *src)
+{
+	const unsigned char *buf;
+
+	buf = src;
+	return (uint32_t)buf[0]
+		| ((uint32_t)buf[1] << 8)
+		| ((uint32_t)buf[2] << 16)
+		| ((uint32_t)buf[3] << 24);
+
+}
+
+static inline void
+kebab_br_enc32be(void *dst, uint32_t x)
+{
+	unsigned char *buf;
+
+	buf = dst;
+	buf[0] = (unsigned char)(x >> 24);
+	buf[1] = (unsigned char)(x >> 16);
+	buf[2] = (unsigned char)(x >> 8);
+	buf[3] = (unsigned char)x;
+
+}
+
+static inline uint32_t
+kebab_br_dec32be(const void *src)
+{
+	const unsigned char *buf;
+
+	buf = src;
+	return ((uint32_t)buf[0] << 24)
+		| ((uint32_t)buf[1] << 16)
+		| ((uint32_t)buf[2] << 8)
+		| (uint32_t)buf[3];
+
+}
+
+static inline void
+kebab_br_enc64le(void *dst, uint64_t x)
+{
+	unsigned char *buf;
+
+	buf = dst;
+	kebab_br_enc32le(buf, (uint32_t)x);
+	kebab_br_enc32le(buf + 4, (uint32_t)(x >> 32));
+
+}
+
+static inline void
+kebab_br_enc64be(void *dst, uint64_t x)
+{
+	unsigned char *buf;
+
+	buf = dst;
+	kebab_br_enc32be(buf, (uint32_t)(x >> 32));
+	kebab_br_enc32be(buf + 4, (uint32_t)x);
+
+}
+
+static inline uint64_t
+kebab_br_dec64be(const void *src)
+{
+	const unsigned char *buf;
+
+	buf = src;
+	return ((uint64_t)kebab_br_dec32be(buf) << 32)
+		| (uint64_t)kebab_br_dec32be(buf + 4);
+
+}
+
+void kebab_br_range_dec32be(uint32_t *v, size_t num, const void *src);
+void kebab_br_range_enc32be(void *dst, const uint32_t *v, size_t num);
+
+void kebab_br_range_dec32le(uint32_t *v, size_t num, const void *src);
+void kebab_br_range_enc32le(void *dst, const uint32_t *v, size_t num);
+
+void kebab_br_range_dec64be(uint64_t *v, size_t num, const void *src);
+void kebab_br_range_enc64be(void *dst, const uint64_t *v, size_t num);
+
+extern const uint32_t kebab_br_sha1_IV[5];
+extern const uint32_t kebab_br_md5_IV[4];
+void kebab_br_sha1_round(const unsigned char *buf, uint32_t *val);
+void kebab_br_md5_round(const unsigned char *buf, uint32_t *val);
+#endif /* KEBAB_BEARSSL_H */
