+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * Compatibility symbols that the iOS 16.7.16 kexts import but this kernel does
+ * not define.  They exist so the native prelink can bind the storage stack; the
+ * IOMMU and DART entries belong to drivers this port does not run, so they are
+ * stubs that complain once if anything actually calls them.
+ */
+#include <sys/param.h>
+#include <sys/mount.h>
+#include <sys/mount_internal.h>
+#include <sys/vnode.h>
+#include <sys/systm.h>
+
+static void
+kebab_prelink_unexpected(const char *name)
+{
+	static int warned;
+	if (!warned) {
+		warned = 1;
+		printf("KEBAB PRELINK: %s called but not implemented\n", name);
+	}
+}
+
+/* Real: return the mount with this fsid whose vfsops match. */
+struct mount *
+vfs_getvfs_with_vfsops(fsid_t *fsid, const struct vfsops *ops)
+{
+	struct mount *mp = vfs_getvfs(fsid);
+	return (mp != NULL && mp->mnt_op == ops) ? mp : NULL;
+}
