+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * Compatibility symbols the iOS 16.7.16 kexts import but this kernel does not
+ * define.  The C identifiers deliberately omit the Mach-O leading underscore, so
+ * a definition of `tty_trylock` produces the symbol `_tty_trylock` the donors
+ * import.  Naming them with the underscore would yield `__tty_trylock`.
+ *
+ * vfs_getvfs_with_vfsops() is real, because APFS calls it.  The rest are stubs;
+ * the reviewed apfs closure imports none of them, but they exist so a future
+ * closure binds instead of failing at link time.
+ */
+#include <sys/param.h>
+#include <sys/mount.h>
+#include <sys/mount_internal.h>
+#include <sys/vnode.h>
+#include <sys/systm.h>
+
+static void
+kebab_prelink_unexpected(const char *name)
+{
+	printf("KEBAB PRELINK: %s called but not implemented\n", name);
+}
+
+/* Real: return the mount with this fsid whose vfsops match. */
+struct mount *
+vfs_getvfs_with_vfsops(fsid_t *fsid, const struct vfsops *ops)
+{
+	struct mount *mp = vfs_getvfs(fsid);
+	return (mp != NULL && mp->mnt_op == ops) ? mp : NULL;
+}
