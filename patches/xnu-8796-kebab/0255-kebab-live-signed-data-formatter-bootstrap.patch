+{
+#if DEVELOPMENT || DEBUG
+ static const char *const names[]={"kebab_apfs_tool","ufsrw","rootrw","ufsmedia_root","cpus",
+  "kebab_apfs_probe","kebab_data_root","kebab_file_keys_test","kebab_aks_fs","kebab_aks_fv","kebab_cpx_xts",
