+++ b/bsd/kern/kebab_data_target_impl.h
@@ -0,0 +1,26 @@
+/* Formatter target is the one original empty Data volume, never the container.
+ * After recreation changes its UUID this precondition intentionally stops reuse. */
+#define KDF_DEVICE "/dev/disk1s2"
+static int
+kdf_target_check(void)
+{
+ struct kebab_volume_identity system,preboot,other,data;
+ int error=kebab_lookup_apfs_preboot(&system,&preboot);
+ if(!error)error=kebab_lookup_apfs_data(&other,&data);
+ if(error)return error;
+ if(memcmp(&system,&other,sizeof(system))||data.backing_id!=system.backing_id||
+     data.backing_id!=preboot.backing_id||data.major_number!=1||data.minor_number!=3||
+     strcmp(data.bsd_name,"disk1s2")||!strcmp(data.bsd_name,system.bsd_name)||
+     !strcmp(data.bsd_name,preboot.bsd_name)||!rootvnode||
+     !(vfs_flags(vnode_mount(rootvnode))&MNT_RDONLY))return EAUTH;
+ vnode_t device=vfs_devvp(vnode_mount(rootvnode));
+ dev_t actual=device?vnode_specrdev(device):NODEV;if(device)vnode_put(device);
+ if(actual!=makedev(system.major_number,system.minor_number))return EAUTH;
+ vnode_t node=NULLVP;error=vnode_lookup(KDF_DEVICE,VNODE_LOOKUP_NOFOLLOW,&node,vfs_context_current());
+ if(error)return error;
+ if(vnode_vtype(node)!=VBLK||vnode_specrdev(node)!=makedev(data.major_number,data.minor_number))error=EAUTH;
+ vnode_put(node);
+ if(!error)printf("KEBAB DATA FORMAT: target UUID4C56203C-CFE8-4DFF-BF8E-BB48D852C936 %s dev=%u/%u backing=%llx; System/Preboot distinct, System RO\n",
+     KDF_DEVICE,data.major_number,data.minor_number,(unsigned long long)data.backing_id);
+ return error;
+}
