+/* Only the owner-created, incomplete fixed scratch file may be discarded.
+ * A complete image, hard link, foreign owner or unexpected mode is refused. */
+static bool
+kebab_cryptex_partial_contract(uint64_t bytes, unsigned mode, unsigned uid,
+    unsigned gid, uint64_t links)
+{
+ return bytes < KEBAB_CRYPTEX_STAGE_BYTES && (mode & 07777) == 0600 &&
+     uid == 0 && gid == 0 && links == 1;
+}
