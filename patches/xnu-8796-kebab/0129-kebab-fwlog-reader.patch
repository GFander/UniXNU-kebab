diff --git a/bsd/dev/kebab_fwlog.c b/bsd/dev/kebab_fwlog.c
new file mode 100644
index 0000000..014ab6b
--- /dev/null
+++ b/bsd/dev/kebab_fwlog.c
@@ -0,0 +1,226 @@
+/*
+ * KEBAB FWLOG: read the firmware's ring buffer from the kernel.
+ *
+ * The UEFI side reserves one fixed physical region at 0xF44C0000 (64 pages,
+ * 256 KiB) and appends every byte its framebuffer serial port renders to a
+ * byte ring behind a 16-byte header:
+ *
+ *   +0x00  u32 magic   'KFLG' = 0x474c464b
+ *   +0x04  u32 size    data bytes, 1 .. 0x40000 - 16
+ *   +0x08  u64 head    total bytes ever written (monotonic)
+ *   +0x10  u8  data[]  ring; absolute offset p lives at data[p % size]
+ *
+ * KebabFwLogDxe reserves the region with EfiReservedMemoryType, so it shows
+ * up in the kernel's memory map as reserved memory and can be mapped here.
+ * The page is mapped at most once: the arm io_map submap is only 8 MiB and
+ * the ring is 256 KiB, so a second mapping would be a leak.  A missing or
+ * implausible header is logged once and every later reader is a no-op.
+ *
+ * This file only reads.  It never writes the ring, the header or any MMIO.
+ */
+#if defined(KEBAB)
+
+#include <sys/systm.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+
+/* Declared in arm/machine_routines.h, behind a guard this build does not
+ * satisfy; the other kebab drivers spell it out for the same reason. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define KEBAB_FWLOG_PA          0xf44c0000ull
+#define KEBAB_FWLOG_MAP_SIZE    0x40000u
+#define KEBAB_FWLOG_MAGIC       0x474c464bu
+#define KEBAB_FWLOG_HEADER      16u
+#define KEBAB_FWLOG_DATA_MAX    (KEBAB_FWLOG_MAP_SIZE - KEBAB_FWLOG_HEADER)
+#define KEBAB_FWLOG_CHUNK       192u
+
+/*
+ * The USB console keeps at most LOG_RING_SIZE - 1 = 16383 bytes, and a burst
+ * that fills it silently drops bytes.  A whole-ring dump is therefore capped
+ * with 4 KiB of headroom instead of being fed to the console untruncated.
+ */
+#define KEBAB_FWLOG_CONSOLE_MAX 12288u
+
+static vm_offset_t kebab_fwlog_va;
+static uint32_t    kebab_fwlog_size;
+static boolean_t   kebab_fwlog_probed;
+static boolean_t   kebab_fwlog_ready;
+
+/* Consumers declare these too (bsd_init.c, kebab_usb.c); the prototypes here
+ * keep the definitions checked against the declarations the kernel uses. */
+void kebab_fwlog_attach(void);
+void kebab_fwlog_boot_summary(void);
+void kebab_fwlog_report(uint32_t max_bytes);
+
+static inline uint32_t
+kebab_fwlog_u32(vm_offset_t va, uint32_t off)
+{
+	return *(volatile uint32_t *)(va + off);
+}
+
+static inline uint64_t
+kebab_fwlog_u64(vm_offset_t va, uint32_t off)
+{
+	return *(volatile uint64_t *)(va + off);
+}
+
+static inline uint8_t
+kebab_fwlog_data(uint32_t index)
+{
+	return *(volatile uint8_t *)(kebab_fwlog_va + KEBAB_FWLOG_HEADER + index);
+}
+
+/*
+ * Map and validate the firmware ring.  Idempotent: the first call either
+ * caches a usable mapping or records that there is nothing to read, and no
+ * later call maps the page again.
+ */
+void
+kebab_fwlog_attach(void)
+{
+	vm_offset_t va;
+	uint32_t magic, size;
+
+	if (kebab_fwlog_probed) {
+		return;
+	}
+	kebab_fwlog_probed = TRUE;
+
+	va = ml_io_map((vm_offset_t)KEBAB_FWLOG_PA, KEBAB_FWLOG_MAP_SIZE);
+	if (va == 0) {
+		printf("KEBAB FWLOG: absent: cannot map 0x%llx\n",
+		    (unsigned long long)KEBAB_FWLOG_PA);
+		return;
+	}
+
+	magic = kebab_fwlog_u32(va, 0);
+	size = kebab_fwlog_u32(va, 4);
+	if (magic != KEBAB_FWLOG_MAGIC) {
+		printf("KEBAB FWLOG: absent: no 'KFLG' magic at 0x%llx "
+		    "(read 0x%08x, expected 0x%08x)\n",
+		    (unsigned long long)KEBAB_FWLOG_PA, magic,
+		    KEBAB_FWLOG_MAGIC);
+		return;
+	}
+	if (size == 0 || size > KEBAB_FWLOG_DATA_MAX) {
+		printf("KEBAB FWLOG: implausible ring size %u at 0x%llx "
+		    "(valid 1..%u); ignoring the page\n", size,
+		    (unsigned long long)KEBAB_FWLOG_PA, KEBAB_FWLOG_DATA_MAX);
+		return;
+	}
+
+	kebab_fwlog_va = va;
+	kebab_fwlog_size = size;
+	kebab_fwlog_ready = TRUE;
+}
+
+/*
+ * One line at boot, right after the USB console has been brought up.
+ * A failure is already explained by kebab_fwlog_attach(), so there is
+ * nothing to repeat here.
+ */
+void
+kebab_fwlog_boot_summary(void)
+{
+	uint64_t head;
+
+	kebab_fwlog_attach();
+	if (!kebab_fwlog_ready) {
+		return;
+	}
+
+	head = kebab_fwlog_u64(kebab_fwlog_va, 8);
+	printf("KEBAB FWLOG: ring %u bytes, written %llu bytes\n",
+	    kebab_fwlog_size, (unsigned long long)head);
+}
+
+/*
+ * Print the most recent max_bytes of the ring, oldest first.  The first line
+ * of the dump starts at a line boundary: the start is advanced to just past
+ * the first newline, but only within the first half of the window, so a ring
+ * with no newline at all still prints something.  Carriage returns are
+ * dropped and output is batched into ~192-byte console writes instead of one
+ * write per character.
+ *
+ * max_bytes == 0 asks for the whole ring; the console cannot take that, so it
+ * is capped at KEBAB_FWLOG_CONSOLE_MAX and the header says so.
+ */
+void
+kebab_fwlog_report(uint32_t max_bytes)
+{
+	uint64_t head, start;
+	uint32_t avail, want, skip, index, i, printed, used;
+	boolean_t capped;
+	char chunk[KEBAB_FWLOG_CHUNK + 1];
+
+	kebab_fwlog_attach();
+	if (!kebab_fwlog_ready) {
+		printf("KEBAB FWLOG: no firmware log attached\n");
+		return;
+	}
+
+	head = kebab_fwlog_u64(kebab_fwlog_va, 8);
+	avail = head < kebab_fwlog_size ? (uint32_t)head : kebab_fwlog_size;
+	want = (max_bytes == 0 || max_bytes > avail) ? avail : max_bytes;
+
+	capped = FALSE;
+	if (max_bytes == 0 && want > KEBAB_FWLOG_CONSOLE_MAX) {
+		want = KEBAB_FWLOG_CONSOLE_MAX;
+		capped = TRUE;
+	}
+
+	if (head == 0 || want == 0) {
+		printf("KEBAB FWLOG: ring=%u written=%llu dump=0\n",
+		    kebab_fwlog_size, (unsigned long long)head);
+		printf("KEBAB FWLOG: ---- empty ----\n");
+		return;
+	}
+
+	start = head - want;
+	skip = 0;
+	for (i = 0; i < want / 2; i++) {
+		if (kebab_fwlog_data((uint32_t)((start + i) %
+		    kebab_fwlog_size)) == '\n') {
+			skip = i + 1;
+			break;
+		}
+	}
+	start += skip;
+	want -= skip;
+
+	printf("KEBAB FWLOG: ring=%u written=%llu dump=%u%s\n",
+	    kebab_fwlog_size, (unsigned long long)head, want,
+	    capped ? " (whole ring capped at 12288 for the 16384-byte "
+	    "console ring)" : "");
+
+	index = (uint32_t)(start % kebab_fwlog_size);
+	printed = 0;
+	used = 0;
+	for (i = 0; i < want; i++) {
+		uint8_t c = kebab_fwlog_data(index);
+
+		index++;
+		if (index == kebab_fwlog_size) {
+			index = 0;
+		}
+		if (c == '\r') {
+			continue;
+		}
+		chunk[used++] = (char)c;
+		printed++;
+		if (used == KEBAB_FWLOG_CHUNK) {
+			chunk[used] = '\0';
+			printf("%s", chunk);
+			used = 0;
+		}
+	}
+	if (used != 0) {
+		chunk[used] = '\0';
+		printf("%s", chunk);
+	}
+
+	printf("\nKEBAB FWLOG: ---- end (%u bytes) ----\n", printed);
+}
+
+#endif /* KEBAB */
diff --git a/bsd/dev/kebab_usb.c b/bsd/dev/kebab_usb.c
index 74e5ab1..a53f94c 100644
--- a/bsd/dev/kebab_usb.c
+++ b/bsd/dev/kebab_usb.c
@@ -89,6 +89,10 @@ extern void kebab_spmi_power_report(void);
 
 /* bsd/dev/kebab_spmi.c: read-only RPMh discovery. */
 extern void kebab_rpmh_report(void);
+
+/* bsd/dev/kebab_fwlog.c: read-only reader of the firmware's ring. */
+extern void kebab_fwlog_report(uint32_t max_bytes);
+
 extern bool kebab_spmi_pon_writes_enabled(void);
 extern int kebab_spmi_pon_reason_write(void);
 
@@ -257,6 +261,8 @@ extern int kebab_spmi_pon_reason_write(void);
 #define UD_REBOOT_TOUCH_PING    13u
 #define UD_REBOOT_PWR_REPORT    14u
 #define UD_REBOOT_RPMH_REPORT   15u
+#define UD_REBOOT_FWLOG_REPORT  16u
+#define UD_REBOOT_FWLOG_ALL     17u
 
 struct ud_endpoint {
 	uint32_t trb, length, ctl, resource;
@@ -1176,6 +1182,15 @@ ud_reboot_command(const char *buf, uint32_t received)
 		if (ud_command_seen(buf, received, "PON?\n", sizeof("PON?\n") - 1)) {
 			return UD_REBOOT_PON_REPORT;
 		}
+		/* "FWLOG? all\n" must be tried before the bare form. */
+		if (ud_command_seen(buf, received, "FWLOG? all\n",
+		    sizeof("FWLOG? all\n") - 1)) {
+			return UD_REBOOT_FWLOG_ALL;
+		}
+		if (ud_command_seen(buf, received, "FWLOG?\n",
+		    sizeof("FWLOG?\n") - 1)) {
+			return UD_REBOOT_FWLOG_REPORT;
+		}
 		return 0;
 	}
 	if (received >= sizeof("REBOOT\n") - 1 &&
@@ -1238,6 +1253,14 @@ ud_reboot_command(const char *buf, uint32_t received)
 	    !memcmp(buf, "RPMH?\n", sizeof("RPMH?\n") - 1)) {
 		return UD_REBOOT_RPMH_REPORT;
 	}
+	if (received >= sizeof("FWLOG? all\n") - 1 &&
+	    !memcmp(buf, "FWLOG? all\n", sizeof("FWLOG? all\n") - 1)) {
+		return UD_REBOOT_FWLOG_ALL;
+	}
+	if (received >= sizeof("FWLOG?\n") - 1 &&
+	    !memcmp(buf, "FWLOG?\n", sizeof("FWLOG?\n") - 1)) {
+		return UD_REBOOT_FWLOG_REPORT;
+	}
 	return 0;
 }
 
@@ -1476,6 +1499,10 @@ ud_run_reboot_command(uint32_t command)
 		kebab_spmi_power_report();
 	} else if (command == UD_REBOOT_RPMH_REPORT) {
 		kebab_rpmh_report();
+	} else if (command == UD_REBOOT_FWLOG_REPORT) {
+		kebab_fwlog_report(4096);
+	} else if (command == UD_REBOOT_FWLOG_ALL) {
+		kebab_fwlog_report(0);
 	}
 }
 
