@@ -2463,6 +2463,44 @@
 #if defined(KEBAB)
 /* A bounded private original-logo bitmap is supplied in the measured ADT,
  * not compiled into public kernel source. No synthesized desktop content. */
+/* Read-only boot-owner check. Only the exact measured boot logo on black is
+ * public boot branding. Any UI pixel, invalid asset/map or panic fails closed. */
+int
+kebab_boot_logo_matches_framebuffer(uintptr_t base, uint32_t width,
+    uint32_t height, uint32_t rowbytes)
+{
+    if (panic_active() || !base || (base & 3) || (rowbytes & 3) ||
+        width != 1080 || height != 2400 || rowbytes < width * 4) return 0;
+    DTEntry chosen;
+    const void *property = NULL;
+    unsigned size = 0;
+    uint32_t h[8] = {};
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTGetProperty(chosen, "hios-boot-logo", &property, &size) != kSuccess ||
+        size < sizeof(h)) return 0;
+    memcpy(h, property, sizeof(h));
+    if (h[0] != 0x314c424b || !h[1] || !h[2] || h[1] > 512 || h[2] > 512 ||
+        h[3] != h[1] * 4 || h[6] != width || h[7] != height ||
+        h[4] >= width || h[5] >= height || h[1] > width - h[4] ||
+        h[2] > height - h[5] || size != sizeof(h) + h[3] * h[2]) return 0;
+    int nonblack = 0;
+    for (uint32_t y = 0; y < height; y++) {
+        if (panic_active()) return 0;
+        const volatile uint32_t *row = (const volatile uint32_t *)(base + (uintptr_t)y * rowbytes);
+        for (uint32_t x = 0; x < width; x++) {
+            uint32_t expected = 0;
+            if (x >= h[4] && x - h[4] < h[1] && y >= h[5] && y - h[5] < h[2]) {
+                const uint8_t *pixel = (const uint8_t *)property + sizeof(h) +
+                    (uintptr_t)(y - h[5]) * h[3] + (uintptr_t)(x - h[4]) * 4;
+                memcpy(&expected, pixel, sizeof(expected));
+                nonblack |= (expected & 0xffffff) != 0;
+            }
+            if ((row[x] & 0xffffff) != (expected & 0xffffff)) return 0;
+        }
+    }
+    return nonblack && !panic_active();
+}
