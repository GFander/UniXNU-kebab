--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -99,6 +99,7 @@
 #include <kern/restartable.h>
 #include <kern/sched.h>
 #include <kern/sched_prim.h>
+extern void kebab_early_breadcrumb(unsigned int index);
 #include <kern/sfi.h>
 #include <kern/syscall_subr.h>
 #include <kern/task.h>
@@ -6563,12 +6564,14 @@
 	thread_t                thread;
 
 	simple_lock_init(&sched_vm_group_list_lock, 0);
+	kebab_early_breadcrumb(8);      /* sched_startup entered */
 
 	result = kernel_thread_start_priority((thread_continue_t)sched_init_thread,
 	    NULL, MAXPRI_KERNEL, &thread);
 	if (result != KERN_SUCCESS) {
 		panic("sched_startup");
 	}
+	kebab_early_breadcrumb(9);      /* sched_init_thread created */
 
 	thread_deallocate(thread);
 
@@ -6582,7 +6585,9 @@
 	 * The current thread is the only other thread
 	 * active at this point.
 	 */
+	kebab_early_breadcrumb(10);     /* about to block for the first time */
 	thread_block(THREAD_CONTINUE_NULL);
+	kebab_early_breadcrumb(11);     /* switched back */
 
 	result = kernel_thread_start_priority((thread_continue_t)sched_update_powered_cores_continue,
 	    NULL, MAXPRI_KERNEL, &thread);
