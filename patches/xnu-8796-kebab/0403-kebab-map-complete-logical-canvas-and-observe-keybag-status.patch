+/* Pixel centres select the same normalized canvas position used by HID.
+ * Bounds are established before arithmetic or any framebuffer store. */
+static int32_t
+kebab_fb_panel_edge(int32_t edge, uint32_t physical, uint32_t logical)
+{
+    int64_t n = (int64_t)edge * physical * 2 - logical;
+    int64_t d = (int64_t)logical * 2;
+    int64_t value = n > 0 ? (n + d - 1) / d : n / d;
+    return value < 0 ? 0 : value > physical ? (int32_t)physical : (int32_t)value;
+}
+static bool
+kebab_fb_panel_rect(int32_t x, int32_t y, int32_t w, int32_t h,
+    uint32_t lw, uint32_t lh, uint32_t pw, uint32_t ph,
+    int32_t *left, int32_t *top, int32_t *right, int32_t *bottom)
+{
+    if (!lw || !lh || !pw || !ph || lw > 16384 || lh > 16384 ||
+        pw > 16384 || ph > 16384 || w <= 0 || h <= 0 || w > 16384 || h > 16384 ||
+        x < -16384 || y < -16384 || x > 16384 || y > 16384) return false;
+    *left = kebab_fb_panel_edge(x, pw, lw);
+    *right = kebab_fb_panel_edge(x + w, pw, lw);
+    *top = kebab_fb_panel_edge(y, ph, lh);
+    *bottom = kebab_fb_panel_edge(y + h, ph, lh);
+    return *left < *right && *top < *bottom;
+}
+static uint32_t
+kebab_fb_sample(int32_t pixel, uint32_t physical, uint32_t logical,
+    int32_t origin, int32_t span, int32_t source_span)
+{
+    uint64_t numerator = ((int64_t)(2 * pixel + 1) * logical -
+        (int64_t)2 * origin * physical) * source_span;
+    uint64_t denominator = (uint64_t)2 * physical * span;
+    uint64_t index = numerator / denominator;
+    return index < (uint32_t)source_span ? (uint32_t)index : (uint32_t)source_span - 1;
+}
