+/* Original20H392 SBFMobileKeyBag singleton. Read only the two boolean
+ * caches used by the original getters, never call a getter or unlock API.
+ * An initialized singleton is not proof its asynchronous update has run. */
+static int
+kebab_passcode_observe(vm_map_t map, uint8_t state[2])
+{
+    uint64_t code, once, instance, isa, again_once, again_instance;
+    uint32_t passcode_offset, unlock_offset;
+    uint8_t again[2];
+    if (!kebab_ca_u64(map, 0x18e60b08cULL, &code) || code != 0x3940c108a9422408ULL ||
+        !kebab_ca_u32(map, 0x1dd020f88ULL, &passcode_offset) || passcode_offset != 0x30 ||
+        !kebab_ca_u32(map, 0x1dd020f8cULL, &unlock_offset) || unlock_offset != 0x31) return 1;
+    if (!kebab_ca_u64(map, 0x1dd025c08ULL, &once) || once != UINT64_MAX ||
+        !kebab_ca_u64(map, 0x1dd025c00ULL, &instance) || !instance || (instance & 7)) return 2;
+    if (!kebab_ca_u64(map, instance, &isa) || !kebab_shell_isa(isa, 0x1dd021d40ULL)) return 3;
+    if (!kebab_plugin_user_copy(map, instance + 0x30, state, 2) || state[0] > 1 || state[1] > 1 ||
+        !kebab_plugin_user_copy(map, instance + 0x30, again, 2) || memcmp(state, again, 2) ||
+        !kebab_ca_u64(map, 0x1dd025c08ULL, &again_once) || again_once != once ||
+        !kebab_ca_u64(map, 0x1dd025c00ULL, &again_instance) || again_instance != instance) return 4;
+    return 0;
+}
+static void
+kebab_passcode_report(vm_map_t map)
+{
+    uint8_t state[2] = {};
+    int error = kebab_passcode_observe(map, state);
+    if (error) printf("KEBAB PASSCODE SBF: result=%d; singleton caches unavailable/changed, no inferred answer\n",error);
+    else printf("KEBAB PASSCODE SBF: result=0 PasscodeSet=%u FirstUnlock=%u; original SBFMobileKeyBag boolean caches, readonly best effort, asynchronous initialization possible\n",state[0],state[1]);
+}
