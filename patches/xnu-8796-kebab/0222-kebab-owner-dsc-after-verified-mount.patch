+int
+kebab_cryptex_vnode_recheck(vnode_t file)
+{
+ if (!__atomic_load_n(&kcm_owned_ready, __ATOMIC_ACQUIRE) || file == NULLVP ||
+     rootvnode != kcm_owned_root || vnode_mount(rootvnode) != kcm_system ||
+     vnode_mount(file) != kcm_owned_mount || !kcm_mount_readonly(kcm_owned_mount) ||
+     !kcm_mount_readonly(kcm_system) || !kcm_mount_readonly(kcm_backing) ||
+     kcm_device(kcm_owned_mount) != kcm_owned_device ||
+     kebab_cryptex_media_bytes() != KEBAB_CRYPTEX_STAGE_BYTES) return EAUTH;
+ return 0;
+}
+
+int
+kebab_cryptex_mount_recheck(void)
+{
+ vnode_t root = NULLVP;
+ int error = vnode_lookup(KEBAB_CRYPTEX_MOUNT_PATH, VNODE_LOOKUP_NOFOLLOW,
+     &root, vfs_context_current());
+ if (error) return error;
+ error = vnode_isdir(root) ? kebab_cryptex_vnode_recheck(root) : EAUTH;
+ vnode_put(root);
+ return error;
+}
+
+static int
+kcm_verify_boot_file(const char *path, off_t bytes, const uint8_t expected[32])
+{
+ vnode_t file = NULLVP;
+ vfs_context_t context = vfs_context_current();
+ int error = vnode_open(path, O_NOFOLLOW | FREAD, 0, 0, &file, context);
+ if (error) return error;
+ uint8_t *buffer = NULL, digest[32];
+ if (!vnode_isreg(file) || vnode_mount(file) != kcm_system ||
+     !kcm_mount_readonly(kcm_system) || ubc_getsize(file) != bytes) error = EAUTH;
+ if (!error) buffer = kalloc_data(KCM_CHUNK, Z_WAITOK);
+ if (!error && !buffer) error = ENOMEM;
+ SHA256_CTX hash;
+ SHA256_Init(&hash);
+ for (off_t offset = 0; !error && offset < bytes; ) {
+  int count = bytes - offset > (off_t)KCM_CHUNK ? KCM_CHUNK : (int)(bytes - offset);
+  int residual = 0;
+  error = vn_rdwr(UIO_READ, file, (caddr_t)buffer, count, offset, UIO_SYSSPACE,
+      IO_NOCACHE, vfs_context_ucred(context), &residual, NULL);
+  if (!error && residual) error = EIO;
+  if (!error) SHA256_Update(&hash, buffer, count);
+  offset += count;
+ }
+ SHA256_Final(digest, &hash);
+ if (!error && memcmp(digest, expected, 32)) error = EAUTH;
+ if (buffer) kfree_data(buffer, KCM_CHUNK);
+ int closed = vnode_close(file, FREAD, context);
+ if (!error) error = closed;
+ return error;
+}
