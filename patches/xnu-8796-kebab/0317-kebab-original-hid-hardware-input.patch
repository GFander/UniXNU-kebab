+    bool start(IOService *) override;
+    void stop(IOService *) override;
+    void free() override;
+    IOWorkLoop *getWorkLoop() const override {return loop;}
+    OSString *newTransportString() const override {return OSString::withCString(role==KEBAB_HID_KEYS?"SPMI":"I2C");}
+    OSString *newManufacturerString() const override {return OSString::withCString(role==KEBAB_HID_KEYS?"Qualcomm":"Synaptics");}
+    OSString *newProductString() const override {return OSString::withCString(role==KEBAB_HID_KEYS?"PM8150 physical keys":"S3908 touchscreen");}
