+    0x05,0x01,0x09,0x30,0x15,0x00,0x26,0x64,0x04,0x75,0x10,0x95,0x01,0x81,0x02, \
+    0x09,0x31,0x26,0x83,0x09,0x81,0x02, \
+    0x05,0x0d,0x09,0x30,0x15,0x00,0x26,0xff,0x00,0x75,0x08,0x95,0x01,0x81,0x02,0xc0,
+static const uint8_t kebab_hid_touch_descriptor[]={
