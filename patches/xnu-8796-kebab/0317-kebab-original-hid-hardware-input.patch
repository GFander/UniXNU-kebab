+    KEBAB_HID_FINGER KEBAB_HID_FINGER KEBAB_HID_FINGER KEBAB_HID_FINGER KEBAB_HID_FINGER
+    0x09,0x54,0x15,0x00,0x25,0x0a,0x75,0x08,0x95,0x01,0x81,0x02,
+    0x85,KEBAB_HID_CONTACT_FEATURE,0x09,0x55,0x15,0x00,0x25,0x0a,
+    0x75,0x08,0x95,0x01,0xb1,0x02,0xc0
+};
+#undef KEBAB_HID_FINGER
+/* prev is the last successfully submitted physical snapshot. Preserve IDs;
+ * vanished contacts get a real lift at their last known coordinates. */
+static inline unsigned
+kebab_hid_encode(unsigned role, const struct kebab_hid_frame *f,
+    const struct kebab_hid_frame *prev, uint8_t *out, unsigned cap)
+{
+    if (!out || !kebab_hid_frame_valid(role,f) || (prev && !kebab_hid_frame_valid(role,prev))) return 0;
+    if (role==KEBAB_HID_KEYS) {
+        if (cap<2) return 0;out[0]=KEBAB_HID_KEYS_REPORT;out[1]=(uint8_t)f->keys;return 2;
+    }
+    if (cap<KEBAB_HID_TOUCH_BYTES) return 0;
+    memset(out,0,KEBAB_HID_TOUCH_BYTES);out[0]=KEBAB_HID_TOUCH_REPORT;
+    unsigned slot=0;
+    uint16_t was=prev?prev->active:0;
+    for (unsigned id=0;id<KEBAB_HID_CONTACTS;id++) {
+        int down=!!(f->active&(1u<<id));
+        if (!down && !(was&(1u<<id))) continue;
+        const struct kebab_hid_frame *p=down?f:prev;
+        uint8_t *dst=out+1+7*slot++;
+        dst[0]=down?3:2;dst[1]=(uint8_t)id;
+        dst[2]=(uint8_t)p->x[id];dst[3]=(uint8_t)(p->x[id]>>8);
+        dst[4]=(uint8_t)p->y[id];dst[5]=(uint8_t)(p->y[id]>>8);
+        dst[6]=down?p->pressure[id]:0;
+    }
+    out[KEBAB_HID_TOUCH_BYTES-1]=(uint8_t)slot;
+    return KEBAB_HID_TOUCH_BYTES;
+}
