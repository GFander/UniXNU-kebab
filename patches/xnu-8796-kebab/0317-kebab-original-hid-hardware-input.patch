+{
+    stopInput();if (originalStarted) {IOHIDDevice::stop(provider);originalStarted=false;}
+}
+void KebabHIDDevice::free()
+{
+    stopInput();
+    OSSafeReleaseNULL(timer);OSSafeReleaseNULL(loop);
+    IOHIDDevice::free();
