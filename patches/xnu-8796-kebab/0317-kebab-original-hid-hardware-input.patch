+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Actual complete hardware snapshots; caller serializes every operation. */
+#ifndef KEBAB_HID_QUEUE_H
+#define KEBAB_HID_QUEUE_H
+#ifdef KEBAB_HID_KERNEL
+#include <libkern/libkern.h>
+#else
+#include <stdint.h>
+#include <string.h>
+#endif
+#include "kebab_hid_bridge.h"
+#define KEBAB_HID_QUEUE_LENGTH 64u
+struct kebab_hid_queue {
+    struct kebab_hid_frame frames[KEBAB_HID_QUEUE_LENGTH], latest;
+    uint64_t produced, dropped;
+    uintptr_t owner;
+    unsigned head, count, latest_valid;
+};
+static inline int
+kebab_hid_frame_valid(unsigned role, const struct kebab_hid_frame *f)
+{
+    if (!f || !f->timestamp_ns || (role!=KEBAB_HID_KEYS && role!=KEBAB_HID_TOUCH)) return 0;
+    if (role==KEBAB_HID_KEYS) return !(f->keys & ~7u) && f->active==0;
+    if (f->keys || (f->active & ~1023u)) return 0;
+    for (unsigned i=0;i<KEBAB_HID_CONTACTS;i++)
+        if ((f->active & (1u<<i)) && (f->x[i]>=1125 || f->y[i]>=2436)) return 0;
+    return 1;
+}
+static inline int
+kebab_hid_frame_equal(unsigned role, const struct kebab_hid_frame *a,
+    const struct kebab_hid_frame *b)
+{
+    if (role==KEBAB_HID_KEYS) return a->keys==b->keys;
+    if (a->active!=b->active) return 0;
+    for (unsigned i=0;i<KEBAB_HID_CONTACTS;i++)
+        if ((a->active & (1u<<i)) && (a->x[i]!=b->x[i] || a->y[i]!=b->y[i] || a->pressure[i]!=b->pressure[i])) return 0;
+    return 1;
+}
+/* Returns 0 for malformed/rollback; 1 for a valid unchanged snapshot; 2 queued.
+ * Overflow drops are explicit and never count as successful HID delivery. */
+static inline int
+kebab_hid_queue_push(struct kebab_hid_queue *q, unsigned role,
+    const struct kebab_hid_frame *f)
+{
+    if (!kebab_hid_frame_valid(role,f) || (q->latest_valid && f->timestamp_ns<q->latest.timestamp_ns)) return 0;
+    int changed=!q->latest_valid || !kebab_hid_frame_equal(role,f,&q->latest);
+    q->latest=*f; q->latest_valid=1;
+    if (!changed) return 1;
+    q->produced++;
+    if (q->count==KEBAB_HID_QUEUE_LENGTH) {
+        q->head=(q->head+1)%KEBAB_HID_QUEUE_LENGTH; q->count--; q->dropped++;
+    }
+    unsigned at=(q->head+q->count)%KEBAB_HID_QUEUE_LENGTH;
+    q->frames[at]=*f; q->count++; return 2;
+}
+static inline int
+kebab_hid_queue_claim(struct kebab_hid_queue *q, uintptr_t owner)
+{
+    if (!owner || q->owner) return 0;
+    q->owner=owner; q->head=q->count=0;
+    if (q->latest_valid) {q->frames[0]=q->latest; q->count=1;}
+    return 1;
+}
+static inline int
+kebab_hid_queue_pop(struct kebab_hid_queue *q, uintptr_t owner,
+    struct kebab_hid_frame *out)
+{
+    if (!out || !owner || owner!=q->owner || !q->count) return 0;
+    *out=q->frames[q->head];q->head=(q->head+1)%KEBAB_HID_QUEUE_LENGTH;q->count--;return 1;
+}
+static inline int
+kebab_hid_queue_release(struct kebab_hid_queue *q, uintptr_t owner)
+{
+    if (!owner || owner!=q->owner) return 0;
+    q->owner=0;q->head=q->count=0;return 1;
+}
+#endif
