+/* Actual read-only sysctl handlers, not expected ADT values. This does not
+ * execute MobileGestalt queries in userland; those require separate evidence. */
+extern int kernel_sysctlbyname(const char *, void *, size_t *, void *, size_t);
+static void
+kebab_identity_sysctl_report(void)
+{
+    static const char * const names[] = {"hw.product", "hw.machine", "hw.target"};
+    for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        char value[65] = {};
+        size_t size = sizeof(value);
+        int error = kernel_sysctlbyname(names[i], value, &size, NULL, 0);
+        value[sizeof(value) - 1] = 0;
+        printf("KEBAB IDENTITY: %s error=%d bytes=%lu value=%s; kernel read-only query\n",
+            names[i], error, (unsigned long)size, error ? "<unavailable>" : value);
+    }
+}
