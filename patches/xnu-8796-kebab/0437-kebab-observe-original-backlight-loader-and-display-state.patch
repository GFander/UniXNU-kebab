+/* Fixed original20H392 brightness-loader state, normal BBOARD observer only.
+ * No user invocation, suspension, write, variable address or task selection. */
+static void
+kebab_brightness_loader_report(vm_map_t map)
+{
+    static const uint8_t expected[16] = {0x8f,0x97,0x04,0x52,0xc9,0xe3,0x3e,0x88,0xb1,0x14,0xfe,0xb1,0x86,0x4b,0xc9,0xe0};
+    uint8_t uuid[16], ready = 0, again_ready = 0;
+    uint64_t slots[9] = {}, again_slots[9] = {}, library = 0, once = 0, again_library = 0, again_once = 0;
+    uint32_t displays = 0, again_displays = 0;
+    if (!kebab_plugin_user_copy(map, 0x180000058ULL, uuid, sizeof(uuid)) || memcmp(uuid, expected, sizeof(uuid))) {
+        printf("KEBAB BACKLIGHT LOADER: refused cache UUID; no inferred state\n"); return;
+    }
+    if (!kebab_plugin_user_copy(map, 0x1ddc85550ULL, slots, sizeof(slots)) ||
+        !kebab_plugin_user_copy(map, 0x1ddc85598ULL, &ready, 1) ||
+        !kebab_ca_u64(map, 0x1ddc855a0ULL, &library) || !kebab_ca_u64(map, 0x1ddc855a8ULL, &once) ||
+        !kebab_ca_u32(map, 0x1e20ef638ULL, &displays) || displays > 16 ||
+        !kebab_plugin_user_copy(map, 0x1ddc85550ULL, again_slots, sizeof(again_slots)) ||
+        !kebab_plugin_user_copy(map, 0x1ddc85598ULL, &again_ready, 1) ||
+        !kebab_ca_u64(map, 0x1ddc855a0ULL, &again_library) || !kebab_ca_u64(map, 0x1ddc855a8ULL, &again_once) ||
+        !kebab_ca_u32(map, 0x1e20ef638ULL, &again_displays) ||
+        memcmp(slots, again_slots, sizeof(slots)) || ready != again_ready || library != again_library || once != again_once || displays != again_displays) {
+        printf("KEBAB BACKLIGHT LOADER: unreadable or changed; no inferred state\n"); return;
+    }
+    uint32_t functions = 0;
+    for (unsigned i = 0; i < 9; i++) if (slots[i]) functions |= 1u << i;
+    printf("KEBAB BACKLIGHT LOADER: ready=%u library=%u once=%llx functions=%x display-infos=%u; original IOMFB globals, readonly two-read agreement\n", ready, !!library, once, functions, displays);
+}
+static void
+kebab_brightness_display_report(vm_map_t map, uint64_t context)
+{
+    uint64_t code = 0, first[9] = {}, second[9] = {};
+    uint32_t type = 0, again_type = 0, port = 0, again_port = 0;
+    /* Original _kern_SwapSetBrightness reads the ready byte at context+b39.
+     * The caller obtained context from the pinned IOMFBDisplay member318. */
+    if (!context || (context & 7) || context > UINT64_MAX - 0xb78 ||
+        !kebab_ca_u64(map, 0x1af227568ULL, &code) || code != 0x34000208396ce688ULL ||
+        !kebab_ca_u32(map, context + 0x14, &port) ||
+        !kebab_ca_u32(map, context + 0x660, &type) ||
+        !kebab_plugin_user_copy(map, context + 0xb30, first, sizeof(first)) ||
+        !kebab_plugin_user_copy(map, context + 0xb30, second, sizeof(second)) ||
+        !kebab_ca_u32(map, context + 0x660, &again_type) ||
+        !kebab_ca_u32(map, context + 0x14, &again_port) ||
+        memcmp(first, second, sizeof(first)) || type != again_type || port != again_port) {
+        printf("KEBAB BACKLIGHT DISPLAY: context absent/unreadable/changed or original code refused\n"); return;
+    }
+    printf("KEBAB BACKLIGHT DISPLAY: type=%u port=%u ready=%u capabilities=%llx max-nits-bits=%llx min-nits-bits=%llx control=%u; original context fields, readonly two-read agreement\n",
+        type, !!port, (unsigned)((first[1] >> 8) & 255), first[2], first[3], first[4], !!first[8]);
+}
