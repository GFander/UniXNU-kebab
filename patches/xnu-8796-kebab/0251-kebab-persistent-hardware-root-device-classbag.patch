+/* One fixed owner bag on the independently identified Preboot filesystem.
+ * O_EXCL creation; restore never repairs or regenerates an invalid record. */
+#include <IOKit/IOReturn.h>
+#define KDB_PATH "/private/preboot/.hios-device-classbag-v1"
+static const uint8_t kdb_container_uuid[16]={0x0e,0x25,0xf3,0x31,0x62,0x79,0x45,0x8a,0x9c,0xfe,0xf3,0x95,0x98,0xda,0x17,0xaa};
+static const uint8_t kdb_system_uuid[16]={0xda,0xdd,0x93,0xf8,0xdb,0xbf,0x4b,0x17,0xa1,0xdf,0x0f,0x11,0xe6,0x41,0x72,0xf7};
+
+static int
+kdb_file(mount_t expected,bool create)
+{
+ if(kdr_policy(2)||!expected||!rootvnode||expected==vnode_mount(rootvnode)||
+     !(vfs_flags(vnode_mount(rootvnode))&MNT_RDONLY)||strcmp(vfs_statfs(expected)->f_fstypename,"apfs")||
+     (((vfs_flags(expected)&MNT_RDONLY)!=0)==create))return EROFS;
+ struct Work{uint8_t record[4096],readback[4096];};
+ struct Work *w=kalloc_data(sizeof(*w),Z_WAITOK|Z_ZERO);if(!w)return ENOMEM;
+ vfs_context_t context=vfs_context_current();vnode_t file=NULLVP;
+ uint8_t before[32]={0},after[32]={0};bool measured=false;
+ int error=kfp_preservation(expected,w->readback,before);if(error)goto done;measured=true;
+ if(create){
+  error=vnode_open(KDB_PATH,O_NOFOLLOW|FREAD,0,0,&file,context);
+  if(!error){int ignored=vnode_close(file,FREAD,context);(void)ignored;file=NULLVP;error=EEXIST;goto done;}
+  if(error!=ENOENT)goto done;
+  error=kebab_device_classbag_create(kdb_container_uuid,kdb_system_uuid,w->record,4096);if(error)goto done;
+  error=vnode_open(KDB_PATH,O_CREAT|O_EXCL|O_NOFOLLOW|FWRITE,0600,0,&file,context);if(error)goto done;
+  if(!vnode_isreg(file)||vnode_mount(file)!=expected)error=EAUTH;
+  if(!error){
+   int residual=0;
+   error=vn_rdwr(UIO_WRITE,file,(caddr_t)w->record,4096,0,UIO_SYSSPACE,IO_SYNC|IO_NOCACHE,
+       vfs_context_ucred(context),&residual,NULL);
+   if(!error&&residual)error=EIO;
+   int sync_error=VNOP_FSYNC(file,MNT_WAIT,context);if(!error)error=sync_error;
+  }
+  int close_error=vnode_close(file,FWRITE,context);file=NULLVP;if(!error)error=close_error;
+  if(error)goto done;
+ }
+ error=kdr_read(KDB_PATH,expected,w->readback,context);
+ if(!error&&create&&memcmp(w->record,w->readback,4096))error=EAUTH;
+ if(!error)error=kebab_device_classbag_open(kdb_container_uuid,kdb_system_uuid,w->readback,4096);
+ if(!error&&!kebab_device_classbag_available())error=EAUTH;
+ if(!error){
+  /* Failed authentication must revoke cached class material, then valid
+   * durable bytes must restore it. Never touch the stored record. */
+  w->readback[129]^=1;
+  int rejected=kebab_device_classbag_open(kdb_container_uuid,kdb_system_uuid,w->readback,4096);
+  w->readback[129]^=1;
+  if(rejected!=(int)kIOReturnNotPermitted||kebab_device_classbag_available())error=EAUTH;
+  if(!error)error=kebab_device_classbag_open(kdb_container_uuid,kdb_system_uuid,w->readback,4096);
+ }
+done:
+ if(measured){int preserve=kfp_preservation(expected,w->readback,after);
+  if(!preserve&&memcmp(before,after,32))preserve=EAUTH;
+  printf("KEBAB DEVICE BAG: original nonce/Root records preserved=%u\n",!preserve);if(!error)error=preserve;}
+ printf("KEBAB DEVICE BAG: %s %s (%d); C/D random independent keys, factory no-passcode, no Data mount\n",
+     create?"exclusive durable readback":"cold authenticated restore",error?"FAIL":"PASS",error);
+ volatile uint8_t *bytes=(volatile uint8_t*)w;
+ for(size_t i=0;i<sizeof(*w);++i)bytes[i]=0;
+ bytes=before;for(unsigned i=0;i<32;++i)bytes[i]=0;
+ bytes=after;for(unsigned i=0;i<32;++i)bytes[i]=0;
+ kfree_data(w,sizeof(*w));return error;
+}
