+/* SPDX-License-Identifier: MIT */
+#ifndef KEBAB_SCM_TRANSACTION_CORE_H
+#define KEBAB_SCM_TRANSACTION_CORE_H
+#include <stdint.h>
+#include <stddef.h>
+/* No SMC/MMIO, allocation, spinlock, IRQ changes, timeout or busy retry.
+ * One sleepable mutex serializes standard SIP/QSEE transactions. GCC/Clang
+ * acquire/release builtins keep the pre-lock recursion check data-race free.
+ * Initialize once in single-threaded startup, before publishing any client. */
+enum { KST_OK, KST_ARGUMENT, KST_NOT_READY, KST_CONTEXT, KST_LOCK,
+ KST_RECURSIVE_BEGIN, KST_OWNER, KST_TOKEN, KST_DEPTH, KST_INFLIGHT,
+ KST_FUNCTION, KST_PENDING, KST_QUARANTINED, KST_UNRESOLVED };
+enum { KST_QSEE=1, KST_PAS13=2 };
+enum { KST_CLEAR, KST_LISTENER, KST_INTERRUPTED, KST_UNKNOWN };
+typedef struct {
+ void *cookie;
+ int (*safe_context)(void *);
+ uintptr_t (*current_owner)(void *); /* unique current thread, never CPU ID */
+ int (*lock)(void *);               /* blocking, sleepable, no fake EBUSY */
+ void (*unlock)(void *);
+} KebabScmTransactionOps;
+typedef struct {
+ uintptr_t owner;
+ uint64_t sequence;
+ uint32_t active,depth,client,inflight,pending,calls,function;
+} KebabScmTransaction;
+typedef struct {
+ KebabScmTransactionOps ops;
+ uintptr_t owner;
+ KebabScmTransaction *token;
+ uint64_t sequence;
+ uint32_t online,quarantine;
+} KebabScmTransactionDomain;
+/* New PAS adapters preserve all x0 bits here (int64_t is just its signed
+ * representation). Legacy QSEE supplies its existing sign-extended int32
+ * status without changing the legacy transport body. Never truncate PAS x0. */
+typedef struct {int64_t status;uint64_t value,type,data;unsigned attempts;} KebabScmTransportResult;
+static inline int KebabScmDomainOnline(const KebabScmTransactionDomain *d)
+{return d && __atomic_load_n(&d->online,__ATOMIC_ACQUIRE);}
+static inline int KebabScmDomainInit(KebabScmTransactionDomain *d,const KebabScmTransactionOps *ops)
+{
+ if(!d || !ops || !ops->safe_context || !ops->current_owner || !ops->lock || !ops->unlock)return KST_ARGUMENT;
+ if(KebabScmDomainOnline(d))return KST_NOT_READY;
+ d->ops=*ops;d->owner=0;d->token=NULL;d->sequence=0;d->quarantine=0;
+ __atomic_store_n(&d->online,1,__ATOMIC_RELEASE);return KST_OK;
+}
+static inline int KebabScmTransactionBegin(KebabScmTransactionDomain *d,KebabScmTransaction *t,unsigned client)
+{
+ if(!d || !t || t->active || (client!=KST_QSEE && client!=KST_PAS13))return KST_ARGUMENT;
+ if(!KebabScmDomainOnline(d))return KST_NOT_READY;
+ if(!d->ops.safe_context(d->ops.cookie))return KST_CONTEXT;
+ uintptr_t owner=d->ops.current_owner(d->ops.cookie);
+ if(!owner)return KST_CONTEXT;
+ if(__atomic_load_n(&d->owner,__ATOMIC_ACQUIRE)==owner)return KST_RECURSIVE_BEGIN;
+ if(d->ops.lock(d->ops.cookie))return KST_LOCK;
+ if(!d->ops.safe_context(d->ops.cookie) || d->ops.current_owner(d->ops.cookie)!=owner) {
+  d->ops.unlock(d->ops.cookie);return KST_CONTEXT;
+ }
+ if(d->quarantine){d->ops.unlock(d->ops.cookie);return KST_QUARANTINED;}
+ if(d->sequence==UINT64_MAX){d->quarantine=KST_TOKEN;d->ops.unlock(d->ops.cookie);return KST_QUARANTINED;}
+ *t=(KebabScmTransaction){owner,++d->sequence,1,1,client,0,KST_CLEAR,0,0};
+ d->token=t;
+ __atomic_store_n(&d->owner,owner,__ATOMIC_RELEASE);return KST_OK;
+}
+static inline int KebabScmTransactionOwned(KebabScmTransactionDomain *d,KebabScmTransaction *t)
+{
+ if(!d || !t)return KST_ARGUMENT;
+ if(!KebabScmDomainOnline(d))return KST_NOT_READY;
+ if(!d->ops.safe_context(d->ops.cookie))return KST_CONTEXT;
+ uintptr_t owner=d->ops.current_owner(d->ops.cookie);
+ /* Check atomic owner before reading any protected mutable/token fields. */
+ if(!owner || __atomic_load_n(&d->owner,__ATOMIC_ACQUIRE)!=owner)return KST_OWNER;
+ if(d->token!=t || !t->active || t->owner!=owner || t->sequence!=d->sequence)return KST_TOKEN;
+ return KST_OK;
+}
+static inline int KebabScmTransactionJoin(KebabScmTransactionDomain *d,KebabScmTransaction *t)
+{
+ int e=KebabScmTransactionOwned(d,t);if(e)return e;
+ if(t->depth>=16)return KST_DEPTH;
+ ++t->depth;return KST_OK;
+}
+static inline int KebabScmTransactionLeave(KebabScmTransactionDomain *d,KebabScmTransaction *t)
+{
+ int e=KebabScmTransactionOwned(d,t);if(e)return e;
+ if(t->depth<=1)return KST_DEPTH;
+ if(t->inflight)return KST_INFLIGHT;
+ --t->depth;return KST_OK;
+}
+static inline int kst_function_allowed(unsigned client,uint32_t fid)
+{
+ if(client==KST_PAS13)
+  return fid==0x42000201 || fid==0x42000202 || fid==0x42000205 || fid==0x42000206 || fid==0x42000207;
+ if(client==KST_QSEE)
+  return fid==0x42000c1c || fid==0x42000c1d || fid==0x42000c1e || fid==0x42001007 ||
+         fid==0x72000103 || fid==0x72000106 || fid==0x72000201 || fid==0x72000203 || fid==0x70000001;
+ return 0;
+}
+static inline int KebabScmTransactionCallBegin(KebabScmTransactionDomain *d,KebabScmTransaction *t,uint32_t fid)
+{
+ int e=KebabScmTransactionOwned(d,t);if(e)return e;
+ if(t->inflight)return KST_INFLIGHT;
+ if(!kst_function_allowed(t->client,fid))return KST_FUNCTION;
+ /* Only the original same-thread, recognized listener can continue a
+  * pending QSEE request. Generic new SMCs or cleanup are forbidden here. */
+ if(t->pending && !(t->pending==KST_LISTENER && t->client==KST_QSEE && fid==0x72000203))return KST_PENDING;
+ if(t->calls==UINT32_MAX)return KST_TOKEN;
+ t->function=fid;t->inflight=1;++t->calls;return KST_OK;
+}
+static inline int KebabScmTransactionCallFinish(KebabScmTransactionDomain *d,KebabScmTransaction *t,
+ const KebabScmTransportResult *r)
+{
+ int e=KebabScmTransactionOwned(d,t);if(e)return e;
+ if(!r || !t->inflight)return KST_INFLIGHT;
+ t->inflight=0;
+ /* Preserve the transport tuple exactly; status=1 after the legacy 32-step
+  * resume bound is unresolved. Unsupported WAITQ/positive transport results
+  * are not completion. No attempt is made to guess a WAITQ resume ABI. */
+ if(r->status>0)t->pending=r->status==1?KST_INTERRUPTED:KST_UNKNOWN;
+ else if(r->status<0 && t->pending)t->pending=KST_UNKNOWN;
+ /* SIP bridge/derive x1 is a terminal peripheral result, including
+  * bridge-enable value4. QSEE owner48/50 x1 uses incomplete/listener ABI. */
+ else if(t->client==KST_QSEE && (t->function==0x70000001 ||
+  t->function==0x72000103 || t->function==0x72000106 ||
+  t->function==0x72000201 || t->function==0x72000203) &&
+  !r->status && r->value && r->value!=UINT32_MAX)
+  t->pending=(r->value==1 && r->type==0xee02 && r->data==0xb)?KST_LISTENER:KST_UNKNOWN;
+ else t->pending=KST_CLEAR;
+ return KST_OK;
+}
+static inline int KebabScmTransactionCanTouchShared(KebabScmTransactionDomain *d,KebabScmTransaction *t)
+{return !KebabScmTransactionOwned(d,t) && !t->inflight && !t->pending;}
+static inline int KebabScmTransactionEnd(KebabScmTransactionDomain *d,KebabScmTransaction *t)
+{
+ int e=KebabScmTransactionOwned(d,t);if(e)return e;
+ if(t->depth!=1)return KST_DEPTH;
+ if(t->inflight)return KST_INFLIGHT;
+ int unresolved=t->pending!=KST_CLEAR;
+ if(unresolved)d->quarantine=t->pending;
+ t->active=0;d->token=NULL;
+ __atomic_store_n(&d->owner,0,__ATOMIC_RELEASE);
+ d->ops.unlock(d->ops.cookie);
+ /* Release the kernel mutex even for an unresolved returned call, retain
+  * all secure-shared resources, and refuse further standard transactions
+  * until a new boot. Never clear quarantine on a timer or a busy result. */
+ return unresolved?KST_UNRESOLVED:KST_OK;
+}
+#endif
