+/* Captured while the original loader-owned argument page is still available.
+ * These descriptors are never fed to pmap or admitted as free pages here. */
+static kebab_memory_record kebab_boot_memory[KBM_MAX_RECORDS];
+static unsigned int kebab_boot_memory_count;
+static unsigned int kebab_boot_memory_status;
+
+static void
+kebab_boot_memory_capture(const boot_args *args)
+{
+	kebab_memory_handoff h;
+	if (((uintptr_t)args & 0xfff) != 0 || sizeof(*args) > KBM_OFFSET) {
+		kebab_boot_memory_status = 1;
+		return;
+	}
+	__builtin_memcpy(&h, (const char *)args + KBM_OFFSET, sizeof(h));
+	if (!kebab_memory_handoff_valid(&h, args->physBase, args->topOfKernelData) ||
+	    args->topOfKernelData < args->physBase ||
+	    args->topOfKernelData - args->physBase > args->memSize ||
+	    args->virtBase > UINT64_MAX - (h.physical - args->physBase)) {
+		kebab_boot_memory_status = 2;
+		return;
+	}
+	__builtin_memcpy(kebab_boot_memory,
+	    (const void *)(args->virtBase + (h.physical - args->physBase)), h.bytes);
+	kebab_boot_memory_count = h.count;
+	kebab_boot_memory_status = 3;
+}
 
 boot_args const_boot_args __attribute__((section("__DATA, __const")));
 boot_args      *BootArgs __attribute__((section("__DATA, __const")));
