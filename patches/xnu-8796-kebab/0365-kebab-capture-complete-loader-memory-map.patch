+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef KEBAB_BOOT_MEMORY_H
+#define KEBAB_BOOT_MEMORY_H
+/* Diagnostic handoff in the loader-owned boot-argument page padding.
+ * The official Darwin22 boot_args structure and primary RAM stay unchanged.
+ * No descriptor conveyed here grants RAM ownership to XNU. */
+#define KBM_MAGIC 0x3150414d4d42454bULL /* KEBMMAP1 */
+#define KBM_OFFSET 0x300
+#define KBM_MAX_RECORDS 512
+typedef struct {
+    unsigned long long magic;
+    unsigned int version;
+    unsigned int count;
+    unsigned long long physical;
+    unsigned long long bytes;
+} kebab_memory_handoff;
+typedef struct {
+    unsigned long long physical;
+    unsigned long long bytes;
+    unsigned long long attributes;
+    unsigned int type;
+    unsigned int reserved;
+} kebab_memory_record;
+typedef char kbm_header_size[(sizeof(kebab_memory_handoff) == 32) ? 1 : -1];
+typedef char kbm_record_size[(sizeof(kebab_memory_record) == 32) ? 1 : -1];
+/* Keep all arithmetic bounded before converting a physical pointer to KVA. */
+static inline int
+kebab_memory_handoff_valid(const kebab_memory_handoff *h,
+    unsigned long long base, unsigned long long used_end)
+{
+    if (h->magic != KBM_MAGIC || h->version != 1 || !h->count ||
+        h->count > KBM_MAX_RECORDS || h->bytes != h->count * sizeof(kebab_memory_record) ||
+        (h->physical & 0x3fff) || used_end < base ||
+        h->physical < base || h->physical > used_end ||
+        h->bytes > used_end - h->physical) {
+        return 0;
+    }
+    return 1;
+}
+#endif
