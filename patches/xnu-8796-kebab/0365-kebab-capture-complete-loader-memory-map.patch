+/* Normal-context diagnostic entry; no allocator or hardware side effects. */
+void kebab_boot_memory_dump(void);
+void
+kebab_boot_memory_dump(void)
+{
+	printf("KEBAB MEMMAP begin status=%u count=%u measurement_only=1\n",
+	    kebab_boot_memory_status, kebab_boot_memory_count);
+	for (unsigned int i = 0; i < kebab_boot_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_boot_memory[i];
+		printf("KEBAB MEMMAP %u type=%u start=0x%llx bytes=0x%llx attr=0x%llx\n",
+		    i, d->type, d->physical, d->bytes, d->attributes);
+	}
+	printf("KEBAB MEMMAP end\n");
+}
+
