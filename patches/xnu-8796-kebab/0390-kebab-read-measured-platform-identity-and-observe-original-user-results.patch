+/* Exact20H392 BSPlatform getters return these once-initialized globals.
+ * This observes their real state; it invokes no user code and writes none.
+ * Matching rereads are best effort, not process suspension or ABA proof. */
+static void
+kebab_identity_user_report(vm_map_t map)
+{
+    static const uint8_t expected[16] = {0x8f,0x97,0x04,0x52,0xc9,0xe3,0x3e,0x88,0xb1,0x14,0xfe,0xb1,0x86,0x4b,0xc9,0xe0};
+    uint8_t uuid[16];
+    uint64_t class_once, home_once, home, again_class_once, again_home_once, again_home;
+    uint32_t device_class, again_class;
+    if (!kebab_plugin_user_copy(map, 0x180000058ULL, uuid, sizeof(uuid)) || memcmp(uuid, expected, sizeof(uuid)) ||
+        !kebab_ca_u64(map, 0x1e1d80040ULL, &class_once) ||
+        !kebab_ca_u64(map, 0x1e1d80050ULL, &home_once) ||
+        class_once != UINT64_MAX || home_once != UINT64_MAX ||
+        !kebab_ca_u32(map, 0x1e1d7ffccULL, &device_class) ||
+        !kebab_ca_u64(map, 0x1e1d80048ULL, &home) ||
+        !kebab_ca_u64(map, 0x1e1d80040ULL, &again_class_once) ||
+        !kebab_ca_u64(map, 0x1e1d80050ULL, &again_home_once) ||
+        !kebab_ca_u32(map, 0x1e1d7ffccULL, &again_class) ||
+        !kebab_ca_u64(map, 0x1e1d80048ULL, &again_home) ||
+        class_once != again_class_once || home_once != again_home_once ||
+        device_class != again_class || home != again_home || home > 2) {
+        printf("KEBAB IDENTITY USER: BSPlatform unavailable/uninitialized/changed; no inferred answer\n");
+        return;
+    }
+    printf("KEBAB IDENTITY USER: BSPlatform device-class=%d home-button-type=%llu; initialized original getter storage; read-only best effort\n",
+        (int32_t)device_class, home);
+}
