+/* Software identity comes from the measured root ADT. Board-compatible
+ * strings and all peripheral match properties remain unchanged. */
+static bool
+kebab_platform_identity(IOService *provider, const char *key, char *name, int maxLength)
+{
+    if (!provider || !name || maxLength <= 0) return false;
+    OSData *data = OSDynamicCast(OSData, provider->getProperty(key));
+    if (!data || !data->getLength() || data->getLength() > 64) return false;
+    const char *value = static_cast<const char *>(data->getBytesNoCopy());
+    size_t length = data->getLength();
+    if (!value || value[length - 1] || strnlen(value, length) != length - 1 ||
+        length > static_cast<size_t>(maxLength)) return false;
+    memcpy(name, value, length);
+    return true;
+}
