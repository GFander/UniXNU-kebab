+{
+ if(!g_crypto_funcs||!g_crypto_funcs->ccsha256_di||!g_crypto_funcs->ccdigest_fn)return 0;
+ g_crypto_funcs->ccdigest_fn(g_crypto_funcs->ccsha256_di,(unsigned long)bytes,input,output);return 1;
