+/* X25519 math primitive for the pending real classB backend.
+ * No key generation, storage, class policy or AKS registration occurs here.
+ * Inputs are RFC7748 little-endian32. Output is committed only for a nonzero
+ * shared value; exact/partial input aliasing is supported via stack copies. */
+#define br_ccopy kebab_x25519_ccopy
+#define br_ec_c25519_m31 kebab_x25519_m31
+#include "inner.h"
+int kebab_x25519(uint8_t[32],const uint8_t[32],const uint8_t[32]);
+typedef int (*kebab_class_b_sha256_fn)(const uint8_t*,size_t,uint8_t[32]);
+int kebab_class_b_concat_kdf(uint8_t[32],const uint8_t[32],const uint8_t[32],const uint8_t[32],kebab_class_b_sha256_fn);
+#if defined(KEBAB_X25519_WIPE_AUDIT)
+void kebab_x25519_wipe_observed(const void*,size_t);
+#endif
+static void
+kebab_x25519_wipe(void *memory,size_t bytes)
+{
+ size_t count=bytes;volatile uint8_t *p=memory;
+ while(bytes--)*p++=0;
+ __asm__ volatile("" ::: "memory");
+#if defined(KEBAB_X25519_WIPE_AUDIT)
+ kebab_x25519_wipe_observed(memory,count);
+#else
+ (void)count;
+#endif
+}
+#include "ccopy.c"
+#include "ec_c25519_m31.c"
+int
+kebab_x25519(uint8_t output[32],const uint8_t scalar[32],const uint8_t point[32])
+{
+ if(!output||!scalar||!point)return 0;
+ uint8_t work[32],secret[32];
+ memcpy(work,point,32);memcpy(secret,scalar,32);
+ uint32_t ok=br_ec_c25519_m31.mul(work,32,secret,32,29),nonzero=0;
+ for(unsigned i=0;i<32;i++)nonzero|=work[i];
+ ok &= (nonzero != 0);
+ if(ok)memcpy(output,work,32);
+ kebab_x25519_wipe(work,sizeof(work));kebab_x25519_wipe(secret,sizeof(secret));
+ return (int)ok;
+}
+
+/* Provider-owned classB KDF transcript: BE32(1)||Z32||PartyU32||PartyV32.
+ * SHA256, fixed32 public fields, AlgorithmID omitted. This is a declared
+ * backend encoding, not a claim to decode Apple SEP wrapped-key blobs. */
+int
+kebab_class_b_concat_kdf(uint8_t output[32],const uint8_t shared[32],
+    const uint8_t ephemeral_public[32],const uint8_t class_public[32],
+    kebab_class_b_sha256_fn hash)
+{
+ if(!output||!shared||!ephemeral_public||!class_public||!hash)return 0;
+ unsigned nonzero=0;
+ for(unsigned i=0;i<32;i++)nonzero|=shared[i];
+ if(!nonzero)return 0;
+ uint8_t input[100]={0,0,0,1},digest[32]={0};
+ memcpy(input+4,shared,32);memcpy(input+36,ephemeral_public,32);memcpy(input+68,class_public,32);
+ int ok=(hash(input,sizeof(input),digest)==1);
+ if(ok)memcpy(output,digest,32);
+ kebab_x25519_wipe(input,sizeof(input));kebab_x25519_wipe(digest,sizeof(digest));
+ return ok?1:0;
+}
