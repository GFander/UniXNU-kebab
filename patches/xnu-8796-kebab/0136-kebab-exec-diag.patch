+int
+kebab_cs_find_code_directory(const void *sigbuf, size_t siglen,
+    off_t *cd_offset, uint32_t *cd_length, uint8_t *cd_hash_type)
+{
+	const uint8_t *base = (const uint8_t *)sigbuf;
+	const CS_SuperBlob *sb;
+	const CS_CodeDirectory *best = NULL;
+	uint32_t best_offset = 0;
+	uint32_t count, n;
+	unsigned int best_rank = 0;
+
+	if (base == NULL || siglen < sizeof(CS_CodeDirectory)) {
+		return EINVAL;
+	}
+	sb = (const CS_SuperBlob *)sigbuf;
+	if (ntohl(sb->magic) != CSMAGIC_EMBEDDED_SIGNATURE) {
+		return EINVAL;
+	}
+	count = ntohl(sb->count);
+	if (count > (siglen - sizeof(CS_SuperBlob)) / sizeof(CS_BlobIndex)) {
+		return EINVAL;
+	}
+
+	for (n = 0; n < count; n++) {
+		uint32_t type = ntohl(sb->index[n].type);
+		uint32_t offset = ntohl(sb->index[n].offset);
+		const CS_CodeDirectory *cd;
+		uint32_t length;
+		unsigned int rank;
+
+		if (type != CSSLOT_CODEDIRECTORY &&
+		    !(type >= CSSLOT_ALTERNATE_CODEDIRECTORIES &&
+		    type < CSSLOT_ALTERNATE_CODEDIRECTORY_LIMIT)) {
+			continue;
+		}
+		if (offset < sizeof(CS_SuperBlob) ||
+		    offset > siglen - sizeof(CS_CodeDirectory)) {
+			continue;
+		}
+		cd = (const CS_CodeDirectory *)(base + offset);
+		if (ntohl(cd->magic) != CSMAGIC_CODEDIRECTORY) {
+			continue;
+		}
+		length = ntohl(cd->length);
+		if (length < sizeof(CS_CodeDirectory) || length > siglen - offset) {
+			continue;
+		}
+		rank = kebab_cd_hash_rank(cd->hashType);
+		if (rank == 0) {
+			continue;
+		}
+		if (best == NULL || rank > best_rank) {
+			best = cd;
+			best_offset = offset;
+			best_rank = rank;
+		} else if (rank == best_rank) {
+			/* Same rule as cs_validate_csblob(): duplicates are illegal. */
+			return EINVAL;
+		}
+	}
+
+	if (best == NULL) {
+		return ENOENT;
+	}
+	*cd_offset = (off_t)best_offset;
+	*cd_length = ntohl(best->length);
+	*cd_hash_type = best->hashType;
+	return 0;
+}
