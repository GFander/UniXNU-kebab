+/*
+ * Mirror of hash_rank() in bsd/kern/ubc_subr.c: the kernel selects the
+ * CodeDirectory with the strongest supported hash, not the first one in the
+ * superblob.  Keep this in sync when the kernel's hashPriorities change.
+ */
+static unsigned int
+kebab_cd_hash_rank(uint8_t hash_type)
+{
+	switch (hash_type) {
+	case CS_HASHTYPE_SHA1:
+		return 1;
+	case CS_HASHTYPE_SHA256_TRUNCATED:
+		return 2;
+	case CS_HASHTYPE_SHA256:
+		return 3;
+	case CS_HASHTYPE_SHA384:
+		return 4;
+	default:
+		return 0;
+	}
+}
