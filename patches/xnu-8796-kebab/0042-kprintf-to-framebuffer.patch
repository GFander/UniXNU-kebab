--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -598,10 +598,23 @@
  *
  * @param c The character to print.
  */
+#if defined(KEBAB)
+/* The phone exposes no UART; mirror every console character to the panel. */
+extern void kebab_early_putc(char c);
+#endif
+
 void
 console_write_char(char c)
 {
+#if defined(KEBAB)
+	/*
+	 * No UART exists on this phone and no console ops are registered, so the
+	 * generic path would call through a null putc. The panel is the console.
+	 */
+	kebab_early_putc(c);
+#else
 	console_write(&c, 1);
+#endif
 }
 
