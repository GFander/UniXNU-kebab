+/* Explicit boot-thread prerequisite only; never a general key service. */
+#ifndef KEBAB_DATA_ROOT_POLICY_H
+#define KEBAB_DATA_ROOT_POLICY_H
+static int
+kdr_policy(unsigned mode)
+{
+#if DEVELOPMENT || DEBUG
+ if (mode != 1 && mode != 2) return EINVAL;
+ static const char *const disabled[] = { "rootrw", "kebab_owner_fast", "kebab_install",
+     "kebab_owner_startup", "kebab_owner_dsc", "kebab_owner_os", "kebab_dsc", "kebab_dsc_map",
+     "kebab_cryptex_media", "kebab_nonce_root", "kebab_hardware_nonce", "kebab_boot_firmware",
+     "kebab_driver_test", "kebab_aes_key_probe" };
+ unsigned value = 0;
+ for (unsigned i = 0; i < sizeof(disabled) / sizeof(disabled[0]); ++i) {
+  value = 0; PE_parse_boot_argn(disabled[i], &value, sizeof(value));
+  if (value) return EPERM;
+ }
+ const char *const required[] = { "kebab_data_root", "kebab_apfs_probe", "ufsrw",
+     "kebab_qsee_probe", "kebab_keymaster_version", "kebab_wrapped_key_probe", "kebab_qsee_time" };
+ const unsigned expected[] = { mode, mode == 1 ? 8u : 9u, mode == 1 ? 1u : 0u, 1, 1, 1, 1 };
+ for (unsigned i = 0; i < sizeof(required) / sizeof(required[0]); ++i) {
+  value = 0; PE_parse_boot_argn(required[i], &value, sizeof(value));
+  if (value != expected[i]) return EINVAL;
+ }
+ return 0;
+#else
+ (void)mode;
+ return EPERM;
+#endif
+}
+#endif
