+enum {KebabA650RenderNativeQualified = 1};
+static const uint8_t KebabA650RenderSourceContract[32] = {0x1a, 0xb0, 0x29, 0x31, 0x06, 0x50, 0xa9, 0x24, 0xe9, 0xb8, 0xf9, 0x96, 0x1c, 0xca, 0xe9, 0xdf, 0x54, 0x39, 0x35, 0x7d, 0x5b, 0x6a, 0x49, 0x66, 0x05, 0x4a, 0x8c, 0x32, 0x41, 0xb6, 0xdf, 0x2a};
+
+static inline int
+KARSourceBound(void)
+{
+    unsigned any = 0;
+    for (unsigned i = 0; i < sizeof KebabA650RenderSourceContract; ++i) {
+        any |= KebabA650RenderSourceContract[i];
