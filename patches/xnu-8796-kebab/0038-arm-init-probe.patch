--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,8 +347,34 @@
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	/*
+	 * Bring-up probe before anything else: a raw write to the framebuffer
+	 * proves the ret from start.s landed in C code. No globals, no console
+	 * state, no stack beyond the prologue.
+	 */
+	/*
+	 * Three 60x24 blocks at row 2280, x = 400, 500, 600: arm_init was entered.
+	 */
+	for (unsigned int probe_blk = 0; probe_blk < 3; probe_blk++) {
+		volatile uint32_t *probe_fb = (volatile uint32_t *)(0x9c000000u +
+		    2280u * 4320u + (400u + probe_blk * 100u) * 4u);
+		for (unsigned int probe_y = 0; probe_y < 24; probe_y++) {
+			for (unsigned int probe_x = 0; probe_x < 60; probe_x++) {
+				probe_fb[probe_y * 1080u + probe_x] = 0xffffffffu;
+			}
+		}
+	}
+
 	kebab_early_mark(1, "arm_init entered (MMU on)");
 
+	kebab_early_putc('V'); kebab_early_putc('A'); kebab_early_putc('=');
+	kebab_early_hex(args->virtBase);
+	kebab_early_putc(' '); kebab_early_putc('P'); kebab_early_putc('A'); kebab_early_putc('=');
+	kebab_early_hex(args->physBase);
+	kebab_early_putc(' '); kebab_early_putc('S'); kebab_early_putc('Z'); kebab_early_putc('=');
+	kebab_early_hex(args->memSize);
+	kebab_early_putc('\n');
+
 	arm_setup_pre_sign();
 
 	arm_slide_rebase_and_sign_image();
@@ -364,8 +390,83 @@
 	BootCpuData.jop_key = ml_default_jop_pid();
 #endif /* defined(HAS_APPLE_PAC) */
 
+	for (const char *p = "DT="; *p; p++) { kebab_early_putc(*p); }
+	kebab_early_hex((uint64_t)(uintptr_t)args->deviceTreeP);
+	for (const char *p = " LEN="; *p; p++) { kebab_early_putc(*p); }
+	kebab_early_hex(args->deviceTreeLength);
+	kebab_early_putc('\n');
+
+	for (const char *p = "SOC="; *p; p++) { kebab_early_putc(*p); }
+	kebab_early_hex(pe_arm_get_soc_base_phys());
+	kebab_early_putc('\n');
+
+	/*
+	 * kebab: DarwinBoot stores the device tree pointer as a kernel virtual
+	 * address (Kernel.Base + tree PA - kernel PA). While we still run at the
+	 * identity address, rebase it to the physical address, otherwise
+	 * SecureDTInit() reads unmapped memory and every lookup comes back empty.
+	 */
+	if (((uintptr_t)args->deviceTreeP >= (uintptr_t)args->virtBase) &&
+	    ((uintptr_t)args->deviceTreeP < (uintptr_t)args->virtBase + (uintptr_t)args->memSize)) {
+		args->deviceTreeP = (void *)((uintptr_t)args->deviceTreeP -
+		    (uintptr_t)args->virtBase + (uintptr_t)args->physBase);
+	}
+
+	{
+		uint64_t tcr, ttbr0, ttbr1, sctlr;
+		__asm__ volatile("mrs %0, tcr_el1" : "=r"(tcr));
+		__asm__ volatile("mrs %0, ttbr0_el1" : "=r"(ttbr0));
+		__asm__ volatile("mrs %0, ttbr1_el1" : "=r"(ttbr1));
+		__asm__ volatile("mrs %0, sctlr_el1" : "=r"(sctlr));
+		for (const char *p = "TCR="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(tcr);
+		for (const char *p = " TTBR1="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(ttbr1);
+		kebab_early_putc('\n');
+		for (const char *p = "TTBR0="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(ttbr0);
+		for (const char *p = " SCTLR="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(sctlr);
+		kebab_early_putc('\n');
+	}
+
+	{
+		/* Walk the bootstrap tables for the kernel VA and report what we find. */
+		uint64_t ttbr1;
+		__asm__ volatile("mrs %0, ttbr1_el1" : "=r"(ttbr1));
+		uint64_t l1_base = ttbr1 & 0x0000ffffffffc000ULL;
+		uint64_t kva = (uint64_t)(uintptr_t)args->virtBase;
+		uint64_t l1_idx = (kva >> 36) & 0x7ff;
+		uint64_t *l1 = (uint64_t *)(uintptr_t)l1_base;
+		uint64_t l1e = l1[l1_idx];
+		uint64_t l2_base = l1e & 0x0000ffffffffc000ULL;
+		uint64_t l2_idx = (kva >> 25) & 0x7ff;
+		uint64_t *l2 = (uint64_t *)(uintptr_t)l2_base;
+		uint64_t l2e = l2[l2_idx];
+
+		for (const char *p = "WALK L1IDX="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(l1_idx);
+		for (const char *p = " L1E="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(l1e);
+		kebab_early_putc('\n');
+		for (const char *p = "WALK L2IDX="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(l2_idx);
+		for (const char *p = " L2E="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(l2e);
+		for (const char *p = " ->PA="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(l2e & 0x0000ffffffe00000ULL);
+		kebab_early_putc('\n');
+	}
+
 	PE_init_platform(FALSE, args); /* Get platform expert set up */
 	kebab_early_mark(2, "PE_init_platform done");
+	{
+		for (const char *p = "TB="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(gPEClockFrequencyInfo.timebase_frequency_hz);
+		for (const char *p = " CPU="; *p; p++) { kebab_early_putc(*p); }
+		kebab_early_hex(ml_get_cpu_count());
+		kebab_early_putc('\n');
+	}
 
 #if __arm64__
 	configure_timer_apple_regs();
