+static int
+kfp_preservation(mount_t expected, uint8_t *buffer, uint8_t digest[32])
+{
+ SHA256_CTX hash;SHA256_Init(&hash);
+ int error=kdr_read(KEBAB_NONCE_PATH,expected,buffer,vfs_context_current());
+ if(!error)SHA256_Update(&hash,buffer,4096);
