 OSDefineMetaClassAndStructors(KebabPlatformExpert, IODTPlatformExpert);
+
+/* Actual native NVRAM format/controller, backed by two durable encrypted-Data
+ * banks. No Apple hardware NVRAM, firmware variable or rollback claim. */
+extern "C" int kebab_nvram_read(unsigned,unsigned,void *,unsigned);
+extern "C" int kebab_nvram_write(unsigned,const void *,unsigned);
+class KebabNVRAM : public IONVRAMController {
+ OSDeclareDefaultStructors(KebabNVRAM)
+ unsigned bank=0;
+public:
+ IOReturn select(uint32_t n) override {if(n>=2)return kIOReturnBadArgument;bank=n;return kIOReturnSuccess;}
+ IOReturn eraseBank(void) override {return kIOReturnUnsupported;} // File banks are overwritten, not flash-erased.
+ IOReturn read(IOByteCount offset,UInt8 *out,IOByteCount size) override {
+  if(offset>8192||size>8192-offset||!out)return kIOReturnBadArgument;
+  return kebab_nvram_read(bank,(unsigned)offset,out,(unsigned)size)?kIOReturnIOError:kIOReturnSuccess;
+ }
+ IOReturn write(IOByteCount offset,UInt8 *in,IOByteCount size) override {
+  if(offset||size!=8192||!in)return kIOReturnBadArgument;
+  return kebab_nvram_write(bank,in,(unsigned)size)?kIOReturnIOError:kIOReturnSuccess;
+ }
+};
+OSDefineMetaClassAndStructors(KebabNVRAM, IONVRAMController)
+extern "C" int kebab_nvram_publish(const uint8_t *,unsigned);
+int kebab_nvram_publish(const uint8_t *image,unsigned current)
+{
+ static bool published;
+ if(published||!image||current>=2)return EINVAL;
+ IOPlatformExpert *platform=IOService::getPlatform();
+ IORegistryEntry *root=IORegistryEntry::fromPath("/",gIODTPlane);
+ IORegistryEntry *chosen=IORegistryEntry::fromPath("/chosen",gIODTPlane);
+ IORegistryEntry *options=IORegistryEntry::fromPath("/options",gIODTPlane);
+ if(!platform||!root||!chosen||options){OSSafeReleaseNULL(root);OSSafeReleaseNULL(chosen);OSSafeReleaseNULL(options);return EAUTH;}
+ uint32_t size=8192,count=2;
+ bool ok=chosen->setProperty("nvram-bank-size",&size,sizeof(size))&&chosen->setProperty("nvram-bank-count",&count,sizeof(count))&&
+   chosen->setProperty("nvram-current-bank",&current,sizeof(current))&&chosen->setProperty("nvram-proxy-data",const_cast<uint8_t *>(image),size);
+ options=new IORegistryEntry;
+ ok=ok&&options&&options->init();
+ if(ok){options->setName("options");ok=options->attachToParent(root,gIODTPlane);}
+ OSSafeReleaseNULL(options);root->release();chosen->release();if(!ok)return ENOMEM;
+ platform->publishNVRAM();
+ options=IORegistryEntry::fromPath("/options",gIODTPlane);
+ IODTNVRAM *native=OSDynamicCast(IODTNVRAM,options);
+ if(!native){OSSafeReleaseNULL(options);return EAUTH;}
+
+
+
+ options->release();
+ KebabNVRAM *controller=new KebabNVRAM;
+ if(!controller||!controller->init()||!controller->attach(platform)||!controller->start(platform)){OSSafeReleaseNULL(controller);return ENOMEM;}
+ controller->setProperty("HiOSEncryptedDataBacked",true);
+ controller->setProperty("HiOSHardwareRollbackProtection",false);
+ controller->setProperty("HiOSDurableBankBytes",8192,32);
+ controller->setName("KebabNVRAM");controller->registerService();published=true;
+ IOLog("KEBAB NVRAM: native IODTNVRAM/controller published after durable Data banks; bank=%u\n",current);
+ return 0;
+}
 
