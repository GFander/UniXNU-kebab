+static int
+kdp_files(proc_t p,user_addr_t scratch,mount_t mounted,bool create)
+{
+ static const uint8_t uuid[16]={0x61,0x70,0x66,0x73,0x75,0x75,0x69,0x64,0,0x40,0x76,0x6f,0x6c,0x75,0x6d,1};
