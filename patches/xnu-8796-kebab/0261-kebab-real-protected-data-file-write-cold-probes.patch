+ printf("KEBAB DATA CLASSES: authenticated mounted owner; persistent factory C/D activated; no passcode/SEP unlock claim\n");
+ vnode_t preboot=NULLVP;error=vnode_lookup("/private/preboot",VNODE_LOOKUP_NOFOLLOW,&preboot,vfs_context_current());if(error)return error;
+ mount_t saved=vnode_mount(preboot);
+ if(!(vfs_flags(saved)&MNT_RDONLY)||saved==mounted)error=EAUTH;
+ uint8_t *work=kalloc_data(4096,Z_WAITOK|Z_ZERO),before[32]={0},after[32]={0};
