+  int synced=VFS_SYNC(mounted,MNT_WAIT,vfs_context_current());int flushed=kebab_ufs_sync();
+  printf("KEBAB DATA FILE: durable filesystem=%d UFS=%d\n",synced,flushed);if(!error)error=synced?synced:flushed;
+ }
