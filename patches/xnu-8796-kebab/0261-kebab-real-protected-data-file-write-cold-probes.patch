+  printf("KEBAB DATA FILE: original Data RW update error=%d\n",error);
+  if(!error&&(vfs_flags(mounted)&MNT_RDONLY))error=EROFS;
+  if(!error&&!(vfs_flags(vnode_mount(rootvnode))&MNT_RDONLY))error=EAUTH;
+ }
+ if(!error)error=kdp_file(mounted,"/private/var/.hios-cp-c-v1",3,create);
+ if(!error)error=kdp_file(mounted,"/private/var/.hios-cp-d-v1",4,create);
+done:
