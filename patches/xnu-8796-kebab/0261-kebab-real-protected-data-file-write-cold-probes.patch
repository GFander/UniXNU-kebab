+static int
+kdp_preserve(mount_t preboot,uint8_t *scratch,uint8_t digest[32])
+{
+ uint8_t old[32];int error=kfp_preservation(preboot,scratch,old);if(error)return error;
+ error=kdr_read(KDB_PATH,preboot,scratch,vfs_context_current());
+ if(!error){SHA256_CTX hash;SHA256_Init(&hash);SHA256_Update(&hash,old,32);SHA256_Update(&hash,scratch,4096);SHA256_Final(digest,&hash);}
+ bzero(old,sizeof(old));bzero(scratch,4096);return error;
+}
