+  struct mount_args request={.type=scratch+0x100,.path=scratch+0x120,.flags=MNT_UPDATE,.data=scratch+0x200};int32_t result=0;
+  if((error=copyout("apfs",request.type,5))||(error=copyout("/private/var",request.path,13))||
+      (error=copyout("/dev/disk1s2",spec,13))||(error=copyout(payload,request.data,sizeof(payload))))goto done;
