+{
+    static const char prefix[] = "/private/var/containers/Data/System/";
+    static const char suffix[] = "/Library/internal/data_ark.plist";
+    if (strlen(path) != sizeof(prefix)-1 + 36 + sizeof(suffix)-1 ||
+        memcmp(path,prefix,sizeof(prefix)-1) || strcmp(path+sizeof(prefix)-1+36,suffix)) return;
+    const char *uuid = path+sizeof(prefix)-1;
+    for (unsigned i = 0; i < 36; i++) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) { if (uuid[i] != '-') return; }
