+/* Fixed original20H392 shell completion audit. Caller pins original executable
+ * UUID/UID and holds task reference; no arbitrary address, invocation or write.
+ * A repeated pointer/status read is best effort, not suspension/ABA proof. */
+struct kebab_shell_ack_state { uint64_t state; unsigned completed; };
+static bool
+kebab_shell_isa(uint64_t isa, uint64_t expected)
+{
+    return isa == expected || ((isa & 0x3f000000001ULL) == 0x1a000000001ULL &&
+        (isa & 0xffffffff8ULL) == expected);
+}
+static int
+kebab_shell_ack_snapshot(vm_map_t map, struct kebab_shell_ack_state *out)
+{
+    static const uint8_t cache_uuid[16] = {0x8f,0x97,0x04,0x52,0xc9,0xe3,0x3e,0x88,0xb1,0x14,0xfe,0xb1,0x86,0x4b,0xc9,0xe0};
+    uint8_t uuid[16] = {}, signal[16] = {}, again_signal = 0;
+    uint64_t mask = 0, instance = 0, again_instance = 0, service_ptr = 0, signal_ptr = 0;
+    uint64_t shell[6] = {}, service[4] = {}, signal_isa = 0;
+    bzero(out, sizeof(*out));
+    if (!kebab_plugin_user_copy(map, 0x180000058ULL, uuid, sizeof(uuid)) ||
+        memcmp(uuid, cache_uuid, sizeof(uuid))) return 1;
+    if (!kebab_plugin_user_copy(map, 0x1800e8940ULL, &mask, sizeof(mask)) || mask != 0xffffffff8ULL) return 2;
+    if (!kebab_plugin_user_copy(map, 0x1dd5f3668ULL, &instance, sizeof(instance)) || !instance || (instance & 7)) return 3;
+    if (!kebab_plugin_user_copy(map, instance, shell, sizeof(shell)) ||
+        !kebab_shell_isa(shell[0], 0x1dd5f2c50ULL)) return 4;
+    if (!shell[5] || (shell[5] & 7) ||
+        !kebab_plugin_user_copy(map, shell[5], service, sizeof(service)) ||
+        !kebab_shell_isa(service[0], 0x1dcffec08ULL)) return 5;
+    if (!service[3] || (service[3] & 7) ||
+        !kebab_plugin_user_copy(map, service[3], signal, sizeof(signal))) return 6;
+    memcpy(&signal_isa, signal, sizeof(signal_isa));
+    if (!kebab_shell_isa(signal_isa, 0x1e1d7f910ULL) || signal[8] > 1 || shell[2] > 2) return 7;
+    if (!kebab_plugin_user_copy(map, 0x1dd5f3668ULL, &again_instance, sizeof(again_instance)) ||
+        !kebab_plugin_user_copy(map, instance + 0x28, &service_ptr, sizeof(service_ptr)) ||
+        !kebab_plugin_user_copy(map, shell[5] + 0x18, &signal_ptr, sizeof(signal_ptr)) ||
+        !kebab_plugin_user_copy(map, service[3] + 8, &again_signal, sizeof(again_signal)) ||
+        again_instance != instance || service_ptr != shell[5] || signal_ptr != service[3] || again_signal != signal[8]) return 8;
+    out->state = shell[2];out->completed = signal[8];return 0;
+}
+void kebab_shell_ack_task_report(task_t task);
+void
+kebab_shell_ack_task_report(task_t task)
+{
+    extern void kebab_usb_log_flush(void);
+    if (task == TASK_NULL || task == kernel_task || ml_at_interrupt_context() ||
+        get_preemption_level() != 0 || !ml_get_interrupts_enabled()) return;
+    vm_map_t map = VM_MAP_NULL;
+    task_lock(task);
+    if (task->map != VM_MAP_NULL && vm_map_pmap(task->map) != pmap_kernel()) {
+        map = task->map;vm_map_reference(map);
+    }
+    task_unlock(task);
+    struct kebab_shell_ack_state state = {};
+    int result = map == VM_MAP_NULL ? 9 : kebab_shell_ack_snapshot(map, &state);
+    if (map != VM_MAP_NULL) vm_map_deallocate(map);
+    printf("KEBAB SHELL: original20H392 result=%d state=%llu checkin-completed=%u; fixed guarded readonly snapshot, no reply override\n",
+        result, state.state, state.completed);
+    kebab_usb_log_flush();
+}
