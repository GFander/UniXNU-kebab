+ * owner media is already fully measured and immutable. Never fabricate CS
+ * validity, platform status, trust entries, or page hashes. */
 static int
-kebab_dsc_map_plan(struct kebab_dsc_plan *plan, task_t target)
+kebab_dsc_load_signature(vnode_t file, const struct kebab_dsc_header *header,
+    uint64_t file_size, uint32_t platform)
+{
+ int error = kebab_cryptex_vnode_recheck(file);
+ if (error) return error;
+ uint64_t offset = header->code_signature_offset;
+ uint64_t bytes = header->code_signature_size;
+ if (!offset || !bytes || bytes > (40u * 1024u * 1024u) ||
+     offset > file_size || bytes > file_size - offset) return EINVAL;
+ struct cs_blob *blob = ubc_cs_blob_get(file, CPU_TYPE_ANY, CPU_SUBTYPE_ANY, 0);
+ if (!blob) {
+  vm_address_t address = 0;
+  vm_size_t allocated = (vm_size_t)bytes;
+  if (ubc_cs_blob_allocate(&address, &allocated) != KERN_SUCCESS || allocated < bytes) {
+   if (address) ubc_cs_blob_deallocate(address, allocated);
+   return ENOMEM;
+  }
+  memset((void *)address, 0, allocated);
+  error = kebab_dsc_read_at(file, (void *)address, (size_t)bytes, (off_t)offset);
+  if (!error) error = ubc_cs_blob_add(file, platform, CPU_TYPE_ANY, CPU_SUBTYPE_ANY,
+      0, &address, allocated, NULL, 0, &blob);
+  if (address) ubc_cs_blob_deallocate(address, allocated);
+  if (error) return error;
+ }
+ if (!blob || !ubc_cs_is_range_codesigned(file, 0, offset)) return EAUTH;
+ return kebab_cryptex_vnode_recheck(file);
+}
