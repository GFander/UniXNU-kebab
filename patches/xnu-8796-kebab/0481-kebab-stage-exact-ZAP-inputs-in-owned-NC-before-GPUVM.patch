+static int kzs_pages(unsigned index, const kebab_low_dma_nc_observation *parent,
+    uint64_t start)
+{
+    IOMemoryDescriptor *memory = klnc_memory[index];
+    IOMemoryMap *map = klnc_mapping[index];
