+		ud.owner_depth++;
+		return true;            /* IRQs stay masked by the outer hold */
+	}
+	if (!os_atomic_cmpxchg(&ud.owner, 0u, cpu, acquire)) {
 		ml_set_interrupts_enabled(*irq);
