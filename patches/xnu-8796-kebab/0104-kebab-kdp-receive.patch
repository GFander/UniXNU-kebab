+ */
 static bool
 ud_enter(boolean_t *irq)
 {
 	*irq = ml_set_interrupts_enabled(FALSE);
 	uint32_t cpu = (uint32_t)cpu_number() + 1;
 	uint32_t terminal = os_atomic_load(&ud.panic_cpu, acquire);
