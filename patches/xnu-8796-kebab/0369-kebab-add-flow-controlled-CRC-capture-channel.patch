+        ops->report();result=kc_packet(s,KC_INFO,cmd.request,s->ack,0,0);
+    } else if(!s->active || cmd.a!=s->session)err=2;
+    else if(cmd.op==KC_GET) {
+        if(cmd.c || cmd.b!=s->ack || cmd.b>=s->image.total)err=71;
+        else {
+            uint32_t n=s->image.total-s->ack;if(n>KC_CHUNK)n=KC_CHUNK;
+            err=ops->read(&s->image,s->ack,s->response+KC_HEADER,n);
