+        memcpy(s->response,s->cache,s->cached_length);s->touched_ms=now;
+        return s->cached_length;
+    }
+    uint32_t result=0;
+    if(cmd.op==KC_OPEN) {
+        kc_cancel(s,ops);
+        if(cmd.c || cmd.a<1 || cmd.a>5)err=22;
+        else err=ops->open(cmd.a,cmd.b,&s->image);
+        if(!err && (!s->image.total || s->image.total>KC_LIMIT)) {
+            ops->close(&s->image);memset(&s->image,0,sizeof(s->image));err=27;
+        }
+        if(!err) {
+            s->active=1;s->session=++s->next_session;
+            if(!s->session)s->session=++s->next_session;
+            uint32_t crc=~0u;
+            for(uint32_t off=0;off<s->image.total;) {
+                uint32_t n=s->image.total-off;if(n>KC_CHUNK)n=KC_CHUNK;
+                err=ops->read(&s->image,off,s->response+KC_HEADER,n);
+                if(err)break;
+                crc=kc_crc_update(crc,s->response+KC_HEADER,n);off+=n;
+            }
+            if(err)kc_cancel(s,ops);
+            else {
+                s->content_crc=~crc;
+                uint32_t v[12]={1,s->image.source,s->image.argument,s->image.width,s->image.height,s->image.stride,
+                    s->image.format,s->image.total,s->content_crc,s->image.stable,s->image.frame_id,s->image.flags};
+                for(unsigned i=0;i<12;i++)kc_put32(s->response+KC_HEADER+i*4,v[i]);
