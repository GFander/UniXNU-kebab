+        if(!s->have_chunk || cmd.b!=s->last_offset || cmd.c!=s->last_crc)err=74;
+        else if(s->ack!=s->last_offset && s->ack!=s->last_offset+s->last_size)err=71;
+        else {s->ack=s->last_offset+s->last_size;result=kc_packet(s,KC_ACK,cmd.request,s->ack,0,0);}
+    } else if(cmd.op==KC_CLOSE) {
+        if(cmd.b || cmd.c)err=22;
+        else {kc_cancel(s,ops);result=kc_packet(s,KC_CLOSED,cmd.request,0,0,0);}
+    } else err=95;
+    if(err)result=kc_error(s,cmd.request,(uint32_t)err);
+    s->cached=cmd;s->cached_valid=1;s->cached_length=result;s->touched_ms=now;
+    memcpy(s->cache,s->response,result);
+    return result;
+}
