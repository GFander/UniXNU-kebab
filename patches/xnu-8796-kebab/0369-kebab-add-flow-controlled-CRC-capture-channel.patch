+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef KEBAB_CAPTURE_CORE_H
+#define KEBAB_CAPTURE_CORE_H
+#include <kern/kebab_capture.h>
+/* One session and one immutable encoded response; USB publishes a copy only
+ * after this normal-context worker returns. GET never advances the stream. */
+struct kc_core {
+    struct kc_image image;
+    uint32_t session,next_session,ack,last_offset,last_size,last_crc,content_crc;
+    struct kc_command cached;
+    uint32_t cached_length;
+    uint8_t response[KC_HEADER+KC_CHUNK],cache[KC_HEADER+KC_CHUNK];
+    uint64_t touched_ms;
+    int active,cached_valid,have_chunk;
+};
+static uint32_t
+kc_packet(struct kc_core *s,uint32_t kind,uint32_t req,uint32_t offset,uint32_t n,uint32_t flags)
+{
+    uint8_t *p=s->response;
+    static const uint8_t magic[8]={'K','F','B','1',0,0x1a,'\r','\n'};
+    memcpy(p,magic,8);memset(p+8,0,KC_HEADER-8);
+    p[8]=(uint8_t)kind;p[10]=KC_HEADER;
+    kc_put32(p+12,req);kc_put32(p+16,s->session);kc_put32(p+20,offset);
+    kc_put32(p+24,n);kc_put32(p+28,s->image.total);
+    kc_put32(p+32,kc_crc(p+KC_HEADER,n));kc_put32(p+36,flags);
+    kc_put32(p+40,kc_crc(p,KC_HEADER));
+    return KC_HEADER+n;
+}
+static uint32_t
+kc_error(struct kc_core *s,uint32_t req,uint32_t error)
+{
+    kc_put32(s->response+KC_HEADER,error);
+    return kc_packet(s,KC_ERROR,req,s->ack,4,0);
+}
+static void
+kc_cancel(struct kc_core *s,const struct kc_ops *ops)
+{
+    if(s->active)ops->close(&s->image);
+    memset(&s->image,0,sizeof(s->image));
+    s->active=0;s->have_chunk=0;s->cached_valid=0;s->ack=0;
+    memset(s->cache,0,sizeof(s->cache));
+}
+static void
+kc_expire(struct kc_core *s,const struct kc_ops *ops,uint64_t now)
+{
+    if(s->active && now>=s->touched_ms && now-s->touched_ms>=60000)kc_cancel(s,ops);
+}
+static uint32_t
+kc_execute(struct kc_core *s,const struct kc_ops *ops,const char *line,uint32_t length,uint64_t now)
+{
+    struct kc_command cmd;
+    int err=kc_decode(line,length,&cmd);
+    if(err)return kc_error(s,0,(uint32_t)err);
