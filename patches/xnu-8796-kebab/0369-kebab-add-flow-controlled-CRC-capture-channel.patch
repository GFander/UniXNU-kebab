+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef KEBAB_CAPTURE_H
+#define KEBAB_CAPTURE_H
+#include <stdint.h>
+#define KC_HEADER 48u
+#define KC_CHUNK 2048u
+#define KC_LIMIT (16u * 1024u * 1024u)
+#define KC_LINE 112u
+#define KC_META 1u
+#define KC_DATA 2u
+#define KC_ACK 3u
+#define KC_CLOSED 4u
+#define KC_ERROR 5u
+#define KC_INFO 6u
+#define KC_OPEN 1u
+#define KC_GET 2u
+#define KC_COMMIT 3u
+#define KC_CLOSE 4u
+#define KC_REPORT 5u
+/* Sources: 1 deterministic bytes, 2 GOP, 3 IOSurface id, 4 displayed layer,
+ * 5 private known BGRA image. No capture operation writes the panel. */
+struct kc_image {
+    void *handle;
+    uint32_t source, argument, width, height, stride, format, total;
+    uint32_t stable, frame_id, flags;
+};
+struct kc_ops {
+    int (*open)(uint32_t, uint32_t, struct kc_image *);
+    void (*close)(struct kc_image *);
+    int (*read)(const struct kc_image *, uint32_t, void *, uint32_t);
+    void (*report)(void);
+};
+struct kc_command { uint32_t request, op, a, b, c; };
+static inline uint32_t
+kc_crc_update(uint32_t crc, const void *data, uint32_t n)
+{
+    static const uint32_t table[16] = {
+        0,0x1db71064,0x3b6e20c8,0x26d930ac,0x76dc4190,0x6b6b51f4,0x4db26158,0x5005713c,
+        0xedb88320,0xf00f9344,0xd6d6a3e8,0xcb61b38c,0x9b64c2b0,0x86d3d2d4,0xa00ae278,0xbdbdf21c
+    };
+    const uint8_t *p=(const uint8_t *)data;
+    while(n--) { crc^=*p++;crc=(crc>>4)^table[crc&15];crc=(crc>>4)^table[crc&15]; }
+    return crc;
+}
+static inline uint32_t kc_crc(const void *p,uint32_t n) { return ~kc_crc_update(~0u,p,n); }
+static inline void kc_put32(uint8_t *p,uint32_t v) { for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(v>>(i*8)); }
+static inline uint32_t kc_get32(const uint8_t *p) { return p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24; }
+/* Every command has an input CRC too. Decimal fields are bounded uint32,
+ * followed by eight lowercase hexadecimal CRC digits and a newline. */
+static inline int
+kc_decode(const char *s,uint32_t n,struct kc_command *out)
+{
+    if(n<23 || n>KC_LINE || s[0]!='@'||s[1]!='F'||s[2]!='1'||s[3]!=' '||s[n-1]!='\n')return 22;
+    uint32_t pos=4,v[5];
+    for(unsigned i=0;i<5;i++) {
+        uint32_t x=0,start=pos;
+        while(pos<n && s[pos]>='0'&&s[pos]<='9') {
+            unsigned digit=(unsigned)(s[pos]-'0');
+            if(x>(UINT32_MAX-digit)/10)return 22;
+            x=x*10+digit;pos++;
+        }
+        if(start==pos || pos>=n || s[pos++]!=' ')return 22;
+        v[i]=x;
+    }
+    if(n-pos!=9)return 22;
+    uint32_t crc=0;
+    for(unsigned i=0;i<8;i++) {
+        char c=s[pos+i];unsigned d=c>='0'&&c<='9'?(unsigned)(c-'0'):c>='a'&&c<='f'?(unsigned)(c-'a'+10):16;
+        if(d==16)return 22;
+        crc=(crc<<4)|d;
+    }
+    if(crc!=kc_crc(s,pos))return 74;
+    *out=(struct kc_command){v[0],v[1],v[2],v[3],v[4]};
+    return 0;
+}
+#ifdef __cplusplus
+extern "C" {
+#endif
+int kebab_capture_open(uint32_t,uint32_t,struct kc_image *);
+void kebab_capture_close(struct kc_image *);
+int kebab_capture_read(const struct kc_image *,uint32_t,void *,uint32_t);
+void kebab_capture_report(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
