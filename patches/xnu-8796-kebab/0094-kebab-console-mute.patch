Hand console output to the USB log ring, and take console input from it.

The tee used to sit inside the #if !defined(KEBAB) block, so it was compiled
out and the ring stayed empty. With it inside the KEBAB branch the log actually
flows, and the debugger's keyboard now comes back over the same pipe: getc
polls the controller itself, because a panic stops the event thread.

--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -125,6 +125,22 @@
  * console backend straight at the early framebuffer renderer.
  */
 extern void kebab_early_putc(char c);
+extern int kebab_usb_getc(bool wait);
+
+static void
+/*
+ * The keyboard: the kernel debugger reads through here. USB carries it when the
+ * device is configured, otherwise fall back to the stock path.
+ */
+static int
+kebab_console_getc(bool wait)
+{
+	extern bool kebab_usb_console_ready(void);
+	if (kebab_usb_console_ready()) {
+		return kebab_usb_getc(wait);
+	}
+	return _vcgetc(wait);
+}
 
 static void
 kebab_console_putc(char c, __unused bool poll)
@@ -139,7 +155,7 @@
 	},
 	{
 #if defined(KEBAB)
-		.putc = kebab_console_putc, .getc = _vcgetc,
+		.putc = kebab_console_putc, .getc = kebab_console_getc,
 #else
 		.putc = vcputc_options, .getc = _vcgetc,
 #endif
@@ -289,23 +305,30 @@
 {
 	extern int disableConsoleOutput;
 
-#if !defined(KEBAB)
+#if defined(KEBAB)
+	/*
+	 * Two jobs for this port: hand the console bytes to the USB log ring, and
+	 * once the GUI presents, stop drawing over it (a panic draws again).
+	 * This used to sit inside the #if !defined(KEBAB) below, so the compiler
+	 * dropped it and the ring stayed empty no matter what the screen showed.
+	 */
+	{
+		extern void kebab_usb_log(const char *buf, size_t len);
+		extern int kebab_console_muted;
+		kebab_usb_log(c, (size_t)size);
+		if (kebab_console_muted && !panic_active()) {
+			return;
+		}
+	}
+#else
 	/*
 	 * stock code drops console output while the graphics console is paused;
 	 * on this port the panel is the only console, so keep it always on.
 	 */
-#if !defined(KEBAB)
 	if (disableConsoleOutput) {
 		return;
 	}
 #endif
-#if defined(KEBAB)
-	{
-		extern void kebab_usb_log(const char *buf, size_t len);
-		kebab_usb_log(c, (size_t)size);
-	}
-#endif
-#endif
 
 	assert(c != NULL);
 
