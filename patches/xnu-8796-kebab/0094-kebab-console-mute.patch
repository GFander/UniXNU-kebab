Feed the USB log ring from the console's lowest layer, and take console input
back over the same pipe.

The tee hangs off _cnputc rather than _cnputs, because panic reporting takes
the unbuffered path (paniclog_append_noflush -> consdebug_putc_unbuffered ->
console_write_unbuffered -> _cnputc) and never reaches _cnputs. _cnputs funnels
through _cnputc anyway, so one hook covers both without duplicating output.

--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -119,12 +119,45 @@
 #define allow_printf_from_interrupts_disabled_context false
 #endif
 
+#if defined(KEBAB)
+/*
+ * The phone has no UART and the video console is never enabled, so route the
+ * console backend straight at the early framebuffer renderer.
+ */
+extern void kebab_early_putc(char c);
+extern int kebab_usb_getc(bool wait);
+
+/*
+ * The keyboard: the kernel debugger reads through here. USB carries it when the
+ * device is configured, otherwise fall back to the stock path.
+ */
+static int
+kebab_console_getc(bool wait)
+{
+	extern bool kebab_usb_console_ready(void);
+	if (kebab_usb_console_ready()) {
+		return kebab_usb_getc(wait);
+	}
+	return _vcgetc(wait);
+}
+
+static void
+kebab_console_putc(char c, __unused bool poll)
+{
+	kebab_early_putc(c);
+}
+#endif
+
 SECURITY_READ_ONLY_EARLY(struct console_ops) cons_ops[] = {
 	{
 		.putc = serial_putc_options, .getc = _serial_getc,
 	},
 	{
+#if defined(KEBAB)
+		.putc = kebab_console_putc, .getc = kebab_console_getc,
+#else
 		.putc = vcputc_options, .getc = _vcgetc,
+#endif
 	},
 };
 
@@ -254,6 +287,24 @@
 		_cnputc('\r', poll);
 	}
 
+#if defined(KEBAB)
+	/*
+	 * The tee lives here, not in _cnputs, because panic reporting takes the
+	 * unbuffered path: paniclog_append_noflush -> consdebug_putc_unbuffered ->
+	 * console_write_unbuffered -> _cnputc. Hooking _cnputs alone missed all of it.
+	 * _cnputs also funnels through here, one character at a time, so this covers
+	 * both paths without duplicating anything.
+	 */
+	{
+		extern void kebab_usb_log(const char *buf, size_t len);
+		extern int kebab_console_muted;
+		kebab_usb_log(&c, 1);
+		if (kebab_console_muted && !panic_active()) {
+			return;
+		}
+	}
+#endif
+
 	cons_ops[idx].putc(c, poll);
 }
 
@@ -271,9 +322,17 @@
 {
 	extern int disableConsoleOutput;
 
+#if defined(KEBAB)
+	/* The tee now lives in _cnputc, which this loops over. */
+#else
+	/*
+	 * stock code drops console output while the graphics console is paused;
+	 * on this port the panel is the only console, so keep it always on.
+	 */
 	if (disableConsoleOutput) {
 		return;
 	}
+#endif
 
 	assert(c != NULL);
 
