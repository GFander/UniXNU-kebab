+/* Fixed SM8250 affinity contract, from OnePlus kona.dtsi and Arm IHI 0069G. */
+#ifndef KEBAB_CPU_PROTOCOL_H
+#define KEBAB_CPU_PROTOCOL_H
+static inline bool
+kebab_sgi1r_for_mpidr(uint64_t mpidr, unsigned int intid, uint64_t *value)
+{
+	if (value == NULL || intid > 15 || mpidr > 0x700 || (mpidr & 0xff) != 0) {
+		return false;
+	}
+	*value = ((mpidr >> 8) << 16) | ((uint64_t)intid << 24) | 1;
+	return true;
+}
+#endif
