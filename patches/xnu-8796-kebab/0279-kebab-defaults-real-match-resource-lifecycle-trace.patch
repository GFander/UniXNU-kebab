+#if defined(KEBAB)
+/* Bounded RAM-only lifecycle evidence. No refcount, resource, scheduling,
+ * match, deadline or watchdog-policy changes. Early events survive until USB. */
+static thread_t kebab_defaults_thread;
+static uint32_t kebab_defaults_events;
+static struct {uint32_t ready;char text[384];} kebab_defaults_trace[96];
+static void
+kebab_defaults_note(const char *format,...)
+{
+ uint32_t slot=__atomic_fetch_add(&kebab_defaults_events,1,__ATOMIC_RELAXED);
+ if(slot>=96)return;
+ va_list args;va_start(args,format);vsnprintf(kebab_defaults_trace[slot].text,384,format,args);va_end(args);
+ __atomic_store_n(&kebab_defaults_trace[slot].ready,1,__ATOMIC_RELEASE);
+}
+extern "C" void
+kebab_defaults_report(void)
+{
+ uint32_t total=__atomic_load_n(&kebab_defaults_events,__ATOMIC_ACQUIRE);
+ printf("KEBAB DEFAULTS: trace total=%u capacity=96; observations only\n",total);
+ for(uint32_t i=0;i<total&&i<96;i++)if(__atomic_load_n(&kebab_defaults_trace[i].ready,__ATOMIC_ACQUIRE))
+  printf("KEBAB DEFAULTS[%u]: %s\n",i,kebab_defaults_trace[i].text);
+}
+#endif
