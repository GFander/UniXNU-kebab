 _Atomic uint64_t libmalloc_experiment_factors = 0;
 
+#if defined(KEBAB)
+/* Board-owned CPU framebuffer policy. The original retail CoreAnimation
+ * getenv path supports this setting; its preferences path is internal-build
+ * only. Opt in with -cf (CPU framebuffer), within boot_args'607-byte limit.
+ * Apply after the ordinary image loader and security decisions, before the
+ * apple vector. No executable bytes, credentials or security options change.
+ */
+static int
+kebab_fb_exec_environment(struct image_params *imgp, const load_result_t *load_result)
+{
+    static const uint8_t uuid[16] = {0x70,0xb7,0x23,0x40,0x73,0x7a,0x39,0x73,0x8b,0x47,0x4e,0x99,0x70,0xf4,0xec,0xb9};
+    static const char name[] = "backboardd";
+    static const char key[] = "CA_DISABLE_FRAMEBUFFER_COMPRESSION=";
+    static const char entry[] = "CA_DISABLE_FRAMEBUFFER_COMPRESSION=1";
+    unsigned enabled = 0;
+    if (memcmp(load_result->uuid, uuid, sizeof(uuid)) ||
+        !(imgp->ip_flags & IMGPF_IS_64BIT_ADDR) || !imgp->ip_ndp ||
+        imgp->ip_ndp->ni_cnd.cn_namelen != sizeof(name) - 1 ||
+        memcmp(imgp->ip_ndp->ni_cnd.cn_nameptr, name, sizeof(name) - 1) ||
+        !PE_parse_boot_argn("-cf", &enabled, sizeof(enabled)) || enabled != 1) return 0;
+
+    char *cursor = imgp->ip_endargv;
+    if (imgp->ip_envc < 0 || imgp->ip_endenvv < cursor ||
+        imgp->ip_strendp != imgp->ip_endenvv) return EINVAL;
+    for (int i = 0; i < imgp->ip_envc; i++) {
+        size_t space = (size_t)(imgp->ip_endenvv - cursor);
+        size_t length = strnlen(cursor, space);
+        if (length == space) return EINVAL;
+        if (length >= sizeof(key) - 1 && !memcmp(cursor, key, sizeof(key) - 1)) {
+            printf("KEBAB CA ENV: original backboardd explicit framebuffer setting retained\n");
+            return 0;
+        }
+        cursor += length + 1;
+    }
+    /* exec_extract_strings padded the env tail. Insert before that padding,
+     * otherwise the new env pointer would address an empty string. */
+    size_t padding = (size_t)(imgp->ip_endenvv - cursor);
+    if (padding >= sizeof(uint64_t)) return EINVAL;
+    if (imgp->ip_argspace < 0 || imgp->ip_strspace < 0) return E2BIG;
+    size_t string_space = (size_t)imgp->ip_strspace + padding;
+    size_t argument_space = (size_t)imgp->ip_argspace + padding;
+    if (string_space < sizeof(entry)) return E2BIG;
+    size_t new_padding = (string_space - sizeof(entry)) % sizeof(uint64_t);
+    if (string_space < sizeof(entry) + new_padding ||
+        argument_space < sizeof(entry) + sizeof(uint64_t) + new_padding) return E2BIG;
+    imgp->ip_strendp = cursor;
+    imgp->ip_strspace += (int)padding;
+    imgp->ip_argspace += (int)padding;
+    int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(entry), UIO_SYSSPACE, TRUE);
+    if (error) return error;
+    imgp->ip_argspace -= sizeof(uint64_t);
+    imgp->ip_envc++;
+    while (imgp->ip_strspace % sizeof(uint64_t)) {
+        *imgp->ip_strendp++ = '\0';
+        imgp->ip_strspace--;
+        imgp->ip_argspace--;
+    }
+    imgp->ip_endenvv = imgp->ip_strendp;
+    printf("KEBAB CA ENV: original backboardd CPU framebuffer compression disabled through original environment setting\n");
+    return 0;
+}
+#endif
