+/*
+ * kebab bring-up breadcrumbs: a fixed white square per checkpoint, drawn at the
+ * top of the panel where the text console never writes. No locks, no logging.
+ */
+void
+kebab_early_breadcrumb(unsigned int index)
+{
+	if (index > 15) {
+		return;
+	}
+	unsigned int x0 = 40 + index * 40;
+	for (unsigned int y = 8; y < 32; y++) {
+		for (unsigned int x = x0; x < x0 + 28; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = 0xffffffffu;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
