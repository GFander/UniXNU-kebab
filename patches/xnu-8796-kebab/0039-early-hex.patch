+/*
+ * Scroll the text area up by one cell so the newest line is always at the
+ * bottom. Without this the row counter wrapped and new output could appear
+ * above older output, which made boot logs read in the wrong order.
+ */
+static void
+kebab_early_scroll(void)
+{
+	unsigned int cell = EARLY_CELL_H * EARLY_STRIDE;
+	unsigned int top = 4 * EARLY_CELL_H * EARLY_STRIDE;
+	unsigned int end = (EARLY_ROWS - 1) * EARLY_CELL_H * EARLY_STRIDE;
+
+	for (unsigned int i = top; i < end; i++) {
+		EARLY_FB[i] = EARLY_FB[i + cell];
+	}
+	for (unsigned int y = (EARLY_ROWS - 1) * EARLY_CELL_H; y < EARLY_ROWS * EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
