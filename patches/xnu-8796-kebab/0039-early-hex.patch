+/*
+ * kebab bring-up breadcrumbs: a fixed white square per checkpoint, drawn at the
+ * top of the panel where the text console never writes. No locks, no logging.
+ */
+
+
+
+void
+kebab_early_hex(uint64_t value)
+{
+	static const char digits[] = "0123456789abcdef";
+
+	kebab_early_putc('0');
+	kebab_early_putc('x');
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		kebab_early_putc(digits[(value >> shift) & 0xf]);
+	}
+}
