+		 * The sparse index is the only description of where the prelinked
+		 * component headers are.  Without it the KCGEN walk below would
+		 * read the leading padding of __PRELINK_TEXT as a header and then
+		 * assert that the rest of the segment is zero.  Disabling the
+		 * parse therefore disables the kext traversal as a whole and keeps
+		 * the type views from the kernel's own __kalloc_type section,
+		 * exactly as a kernel built without a prelink does.
+		 */
+		if (!kalloc_sparse_prelink_index_enabled()) {
+			kalloc_sparse_prelink_index_active = 0;
+			printf("kebab: prelink index parse disabled "
+			    "(kebab_prelink_index=0); kext kalloc types skipped\n");
+			return cur_count;
