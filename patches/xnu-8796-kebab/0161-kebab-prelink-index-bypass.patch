 __attribute__((used)) const uint32_t kalloc_sparse_prelink_index_version = 1;
 
+/*
+ * Runtime result of the sparse prelink parse: 1 when the component headers
+ * were walked through the index, 0 when "kebab_prelink_index=0" skipped the
+ * walk.  bsd_init reports it once the USB console exists; anything printed
+ * here is dropped, because the console ring is not running this early.
+ */
+uint32_t kalloc_sparse_prelink_index_active = 1;
+
+/*
+ * The ABI symbol above stays unconditional: the native prelink emitter
+ * requires it in the image.  This switch only controls the runtime parse and
+ * defaults to on, so an ordinary boot is unchanged.
+ */
+static boolean_t
+kalloc_sparse_prelink_index_enabled(void)
+{
+	uint32_t enabled = 1;
+
+	if (PE_parse_boot_argn("kebab_prelink_index", &enabled, sizeof(enabled))) {
+		return enabled != 0;
+	}
+	return TRUE;
+}
