+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Synaptics TCM continued-read transactions, per the matched oncell driver.
+ * Every I2C continuation has its own a5/03 prefix. The final one-byte pad is
+ * omitted by the protocol when it would require a transfer by itself. It is
+ * never treated as application data. Caller serializes the complete message. */
+#ifndef KEBAB_TCM_WIRE_H
+#define KEBAB_TCM_WIRE_H
+#include "kebab_touch_tcm.h"
+#define KEBAB_TCM_WIRE_CHUNK 64u
+typedef int (*kebab_tcm_wire_read)(void *,uint8_t *,uint32_t);
+static inline int
+kebab_tcm_wire_body(uint32_t length,uint8_t *out,uint32_t capacity,
+    kebab_tcm_wire_read read,void *context)
+{
+    uint8_t chunk[KEBAB_TCM_WIRE_CHUNK];
+    if (!out || !read || length>KEBAB_TCM_MAX_PAYLOAD || capacity<length+1) return -1;
+    uint32_t offset=0,remaining=length+1;
+    while (remaining) {
+        uint32_t bytes=remaining>KEBAB_TCM_WIRE_CHUNK-2?KEBAB_TCM_WIRE_CHUNK-2:remaining;
+        if (bytes==1) {
+            /* This can only be the trailing pad, never a payload byte. */
+            if (offset!=length) return -1;
+            out[offset]=KEBAB_TCM_PADDING;return 0;
+        }
+        if (read(context,chunk,bytes+2) || chunk[0]!=KEBAB_TCM_MARKER || chunk[1]!=0x03) return -1;
+        for (uint32_t i=0;i<bytes;i++) out[offset+i]=chunk[i+2];
+        offset+=bytes;remaining-=bytes;
+    }
+    return out[length]==KEBAB_TCM_PADDING?0:-1;
+}
+#endif
