+/* IOMemoryDescriptor.h requires prepared memory for readBytes/writeBytes.
+ * The descriptor is borrowed from this MIG call; no extra retain or mapping.
+ * Complete every successful prepare, including a short transfer, and return
+ * real prepare/copy/complete failures before publishing an output size. */
+static IOReturn
+kebab_surface_descriptor_copy(IOMemoryDescriptor *memory, void *buffer,
+    IOByteCount length, bool toDescriptor)
+{
+	IOReturn ret = memory->prepare();
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	IOByteCount copied = toDescriptor ? memory->writeBytes(0, buffer, length) :
+	    memory->readBytes(0, buffer, length);
+	IOReturn completed = memory->complete();
+	return copied == length ? completed : kIOReturnVMError;
+}
