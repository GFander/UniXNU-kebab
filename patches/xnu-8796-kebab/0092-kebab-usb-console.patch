Wire the USB console in, and start it at the top of bsd_init.

The VM and the kernel thread machinery are already up when bsd_init runs, so
the log ring, the DMA page and the event thread all work there; starting the
console at the top means a panic anywhere after that point - UFS, the
filesystem, launchd - can be read from the host instead of photographed.

--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -105,6 +105,7 @@
 
 bsd/dev/memdev.c			standard
 bsd/dev/kebab_ufs.c			standard
+bsd/dev/kebab_usb.c			standard
 bsd/dev/mem.c				standard
 bsd/dev/munge.c 			optional config_requires_u32_munging
 bsd/dev/unix_startup.c			standard
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -491,6 +491,19 @@
 #endif
 
 #if defined(KEBAB)
+	/*
+	 * Bring up the device-mode USB console as early as it is safe: the VM and the
+	 * kernel thread machinery are up by the time bsd_init runs, so the log ring,
+	 * the DMA page and the event thread all work, and a panic anywhere after this
+	 * point can be read from the host instead of photographed.
+	 */
+	{
+		extern void kebab_usb_start(void);
+		kebab_usb_start();
+	}
+#endif
+
+#if defined(KEBAB)
 /* Panic reports arrive through the panel console, so the bsd_init trace is
  * worth its output on this port. */
 #define DEBUG_BSDINIT 1
