+/* Original generic report parsing does not associate each digitizer event
+ * with the built-in panel. Backboardd tests event field0xb0019 separately
+ * from the service registry property and otherwise routes it as a touchpad.
+ * This subclass adds that physical association to real reports only. */
+class KebabTouchEventDriver : public IOHIDEventDriver {
+    OSDeclareDefaultStructors(KebabTouchEventDriver);
+    uint64_t integratedEvents=0;
+public:
+    bool handleStart(IOService *provider) override;
+    void dispatchEvent(IOHIDEvent *event,IOOptionBits options=0) override;
+};
+OSDefineMetaClassAndStructors(KebabTouchEventDriver,IOHIDEventDriver);
+bool KebabTouchEventDriver::handleStart(IOService *provider)
+{
+    IOService *device=provider?provider->getProvider():nullptr;
+    OSNumber *role=device?OSDynamicCast(OSNumber,device->getProperty("kebab,hid-role")):nullptr;
+    if (!provider || !provider->metaCast("IOHIDInterface") ||
+        !device || !device->metaCast("KebabHIDDevice") || !role ||
+        role->unsigned32BitValue()!=KEBAB_HID_TOUCH) return false;
+    bool result=IOHIDEventDriver::handleStart(provider);
+    IOLog("KEBAB HID PANEL: original translator start=%u; physical touch only\n",result);
+    return result;
+}
+void KebabTouchEventDriver::dispatchEvent(IOHIDEvent *event,IOOptionBits options)
+{
+    if (event && event->getType()==11) {
+        SInt32 before=event->getIntegerValue(0xb0019,0);
+        event->setIntegerValue(0xb0019,1,0);
+        integratedEvents++;
+        if (integratedEvents<=16 || !(integratedEvents&(integratedEvents-1)))
+            IOLog("KEBAB HID PANEL: digitizer=%llu display-integrated=%d->%d; same original event\n",
+                integratedEvents,before,event->getIntegerValue(0xb0019,0));
+    }
+    IOHIDEventDriver::dispatchEvent(event,options);
+}
 
