+			uint64_t base = oldest->kernel_stack, top = base + kernel_stack_size;
+			int i = 0;
+			kprintf("KEBAB BT OLDEST tid %llu st %x\n", oldest->thread_id, oldest->state);
+			kprintf("KEBAB BT %d %08x\n", i++, (uint32_t)ks->machine.ss.lr);
