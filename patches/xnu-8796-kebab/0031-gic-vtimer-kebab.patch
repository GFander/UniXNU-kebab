+		if (is_main) {
+			found_main = 1;
+			kprintf("KEBAB BT MAIN tid %llu st %x\n", th->thread_id, th->state);
+			for (int i = 0; i < depth; i++) {
+				kprintf("KEBAB BT %d %08x\n", i, (uint32_t)pcs[i]);
+			}
+		}
+	}
+	if (!found_main) {
+		kprintf("KEBAB BT: no thread through PE_lockdown_iokit\n");
+		nth = 0;
+		queue_iterate(&kernel_task->threads, th, thread_t, task_threads) {
+			if (++nth > 96) {
+				break;
+			}
+			if (th == current_thread() || th->kernel_stack == 0) {
+				continue;
+			}
