+static int
+kdi_lookup(const char *path,vnode_t *file,mount_t wanted,bool source)
+{
+ int error;
+ if(source)error=koos_lookup(path,file,vfs_context_current());
+ else{
+  struct nameidata nd;
+  NDINIT(&nd,LOOKUP,OP_LOOKUP,NOFOLLOW,UIO_SYSSPACE,CAST_USER_ADDR_T(path),vfs_context_current());
+  nd.ni_flag|=NAMEI_NOFOLLOW_ANY;error=namei(&nd);
