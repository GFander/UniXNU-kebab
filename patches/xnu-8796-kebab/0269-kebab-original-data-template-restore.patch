+ NDINIT(nd,LOOKUP,OP_OPEN,NOFOLLOW,UIO_SYSSPACE,CAST_USER_ADDR_T(path),vfs_context_current());
+ nd->ni_flag|=NAMEI_NOFOLLOW_ANY;
+ int error=vn_open_auth(nd,&flags,&a,NULLVP);*file=error?NULLVP:nd->ni_vp;kfree_type(struct nameidata,nd);return error;
