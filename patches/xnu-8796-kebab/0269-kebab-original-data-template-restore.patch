+static int
+kdi_apply(vnode_t file,const struct kdi_entry *e)
+{
+ struct vnode_attr a;VATTR_INIT(&a);VATTR_SET(&a,va_uid,e->uid);VATTR_SET(&a,va_gid,e->gid);
