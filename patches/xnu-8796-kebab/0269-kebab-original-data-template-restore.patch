+static int
+kdi_metadata(vnode_t file,const struct kdi_entry *e,bool source)
+{
+ vfs_context_t ctx=vfs_context_current();struct vnode_attr a;VATTR_INIT(&a);
+ VATTR_WANTED(&a,va_mode);VATTR_WANTED(&a,va_uid);VATTR_WANTED(&a,va_gid);
+ VATTR_WANTED(&a,va_flags);VATTR_WANTED(&a,va_data_size);VATTR_WANTED(&a,va_nlink);
+ VATTR_WANTED(&a,va_dataprotect_class);
+ int error=vnode_getattr(file,&a,ctx);if(error)return error;
+ if(!VATTR_IS_SUPPORTED(&a,va_mode)||!VATTR_IS_SUPPORTED(&a,va_uid)||!VATTR_IS_SUPPORTED(&a,va_gid)||
+     !VATTR_IS_SUPPORTED(&a,va_flags)||!VATTR_IS_SUPPORTED(&a,va_data_size)||
+     (a.va_mode&07777)!=e->mode||a.va_uid!=e->uid||a.va_gid!=e->gid||
+     a.va_flags!=(source?e->flags:(e->flags&~UF_COMPRESSED)))return EAUTH;
+ if(vnode_vtype(file)!=(e->kind==1?VDIR:(e->kind==2?VREG:VLNK)))return EAUTH;
+ if(e->kind!=1&&a.va_data_size!=e->bytes)return EAUTH;
+ if(!source&&e->kind==2&&(!VATTR_IS_SUPPORTED(&a,va_nlink)||a.va_nlink!=1||
+     !VATTR_IS_SUPPORTED(&a,va_dataprotect_class)||a.va_dataprotect_class!=4))return EAUTH;
+ return 0;
+}
