+
+static int
+kdi_path(user_addr_t scratch,const char *path,user_addr_t offset)
+{
+ size_t n=strlen(path)+1;if(n>MAXPATHLEN||scratch>UINT64_MAX-4096||offset>4096-n)return EINVAL;
