--- a/bsd/kern/sys_generic.c
+++ b/bsd/kern/sys_generic.c
@@ -701,6 +701,11 @@
 int
 write_nocancel(struct proc *p, struct write_nocancel_args *uap, user_ssize_t *retval)
 {
+#if defined(KEBAB)
+	/* Bring-up probe: is userland reaching the console at all? */
+	printf("KEBAB: write fd=%d n=%llu pid=%d\n", uap->fd,
+	    (unsigned long long)uap->nbyte, proc_pid(p));
+#endif
 	return write_internal(p, uap->fd, uap->cbuf, uap->nbyte, (off_t)-1, 0,
 	           NULL, retval);
 }
