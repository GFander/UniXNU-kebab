 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
+/* The tested encoder, whitelist and TCS state machine (kebab_rpmh_vrm.c). */
+#include "kebab_rpmh_vrm.h"
+
 /*
  * bsd/dev/kebab_usb.c.  The reset path has to push the diagnostic lines out
  * before the PMIC is allowed to reset the SoC, and the console owns that ring.
@@ -75,6 +87,12 @@ extern void kebab_usb_log_flush(void);
