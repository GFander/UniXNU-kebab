 int kebab_spmi_pon_reason_write(void);
 
+/* bsd/dev/kebab_usb.c: VROMON, gated by kebab_vrm_write; TCS? is read-only. */
+bool kebab_spmi_vrm_writes_enabled(void);
+int kebab_spmi_vrm_enable(const char *rail);
+void kebab_spmi_vrm_init(void);
+void kebab_tcs_report(void);
+
 /* ------------------------------------------------------------ board facts */
 
 #define KEBAB_SPMI_CORE_PA      0x0c440000u
@@ -623,6 +641,13 @@ kebab_spmi_init(void)
 	printf("KEBAB SPMI: version core+0x0000 = 0x%08x (%s); intr 0x%08x not mapped\n",
 	    version, kebab_spmi_version_known(version) ? kebab_spmi_family(version) : "unrecognised",
 	    0x0e700000u);
+	/*
+	 * The RPMh VRM path is independent of the SPMI write gate and of the
+	 * arbiter version: it reaches the RSC, not a PMIC.  Map its TCS1
+	 * window here, before the early return below, so a boot with only
+	 * kebab_vrm_write set can still use VROMON.
+	 */
