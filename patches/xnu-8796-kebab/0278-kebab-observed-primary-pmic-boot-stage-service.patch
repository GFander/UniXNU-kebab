+/* IOPMUBootStage is a real volatile boot-progress property here. It is not
+ * translated into Apple AON or a guessed PMIC register. Only privileged
+ * callers may change the one supported, bounded property. */
+IOReturn
+KebabPon::setProperties(OSObject *properties)
+{
+ IOReturn privilege=IOUserClient::clientHasPrivilege(current_task(),kIOClientPrivilegeAdministrator);
+ if(privilege!=kIOReturnSuccess)return privilege;
+ OSDictionary *dictionary=OSDynamicCast(OSDictionary,properties);
+ if(!dictionary)return kIOReturnBadArgument;
+ if(dictionary->getCount()!=1||!dictionary->getObject("IOPMUBootStage"))return kIOReturnUnsupported;
+ OSNumber *number=OSDynamicCast(OSNumber,dictionary->getObject("IOPMUBootStage"));
+ if(!number||number->unsigned64BitValue()>255)return kIOReturnBadArgument;
+ OSNumber *primary=OSDynamicCast(OSNumber,getProperty("IOPMUPrimary"));
+ if(!primary||primary->unsigned32BitValue()!=1)return kIOReturnNotReady;
+ uint8_t state[2]={};IOReturn observed=getState(state);
+ if(observed!=kIOReturnSuccess)return observed;
+ if(state[0]!=4&&state[0]!=5)return kIOReturnNoDevice;
+ uint32_t stage=number->unsigned32BitValue();
+ if(!setProperty("IOPMUBootStage",stage,32))return kIOReturnNoMemory;
+ IOLog("KEBAB PMU: boot stage=%u recorded in live PM8150 service (volatile/no PMIC write)\n",stage);
+ return kIOReturnSuccess;
+}
+
+void
+KebabPon::stop(IOService *provider)
+{
+ removeProperty("IOPMUPrimary");
+ IOService::stop(provider);
 }
 
