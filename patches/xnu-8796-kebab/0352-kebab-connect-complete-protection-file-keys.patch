+ if(!error)error=kdp_metadata(file,expected,1,KDP_BYTES,context);
+ /* Fill the normal cached path before locking: a driver-only denial is
+  * insufficient if existing cached reads can still return plaintext. */
+ if(!error)error=kap_read(file,w->back,0,context);
+ if(!error&&memcmp(w->plain,w->back,KDP_BYTES))error=EAUTH;
+ if(!error)error=kebab_device_keybag_set_locked(true);
+ uint32_t state=0;if(!error)error=kebab_device_keybag_get_lock_state(&state);
+ if(!error&&state!=5)error=EAUTH;
+ for(unsigned kind=0;!error&&kind<3;kind++){
+  int denied,residual=0;memset(w->back,0xa5,KDP_BYTES);
+  if(kind<2)denied=vn_rdwr(UIO_READ,file,(caddr_t)w->back,KDP_BYTES,0,UIO_SYSSPACE,
+      kind?IO_NOCACHE:0,vfs_context_ucred(context),&residual,NULL);
+  else denied=vn_rdwr(UIO_WRITE,file,(caddr_t)w->plain,KDP_BYTES,0,UIO_SYSSPACE,
+      IO_SYNC|IO_NOCACHE,vfs_context_ucred(context),&residual,NULL);
+  printf("KEBAB A PROBE: locked already-open %s result=%d residual=%d; expected EPERM/EACCES, zero transferred\n",
+      kind==0?"cached-read":(kind==1?"nocache-read":"write"),denied,residual);
+  if((denied!=EPERM&&denied!=EACCES)||residual!=KDP_BYTES)error=EAUTH;
+  if(kind<2)for(unsigned i=0;i<KDP_BYTES;i++)if(w->back[i]!=0xa5){error=EAUTH;break;}
+ }
+ if(file){int closed=vnode_close(file,FREAD|FWRITE,context);file=NULLVP;if(!error)error=closed;}
+ if(!error){
+  int denied=vnode_open(path,O_NOFOLLOW|FREAD,0,0,&file,context);
+  printf("KEBAB A PROBE: locked closed reopen=%d; expected EPERM/EACCES\n",denied);
+  if(file){int closed=vnode_close(file,FREAD,context);file=NULLVP;(void)closed;}
+  if(denied!=EPERM&&denied!=EACCES)error=EAUTH;
+ }
+ if(!error){
+  int denied=kdp_create("/private/var/.hios-cp-a-locked-denied-v1",1,&file,context);
+  printf("KEBAB A PROBE: locked exclusive create=%d; expected EPERM/EACCES\n",denied);
+  if(file){int closed=vnode_close(file,FREAD|FWRITE,context);file=NULLVP;(void)closed;}
+  if(denied!=EPERM&&denied!=EACCES)error=EAUTH;
+ }
+ int unlocked=kebab_device_keybag_set_locked(false);if(!error)error=unlocked;
+ if(!error)error=kdp_file(expected,path,1,false,false);
+ printf("KEBAB A PROBE: private file lifecycle %s (%d), unlock=%x; original cached I/O checks retained\n",error?"FAIL":"PASS",error,unlocked);
+ bzero(w,sizeof(*w));kfree_data(w,sizeof(*w));return error;
+}
