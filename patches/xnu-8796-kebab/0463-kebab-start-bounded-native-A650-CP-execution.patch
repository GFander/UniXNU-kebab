+ KCP_TRY(KCPGpuRead(c,KCP_CP_RB_CNTL,&v));if(v!=0x209){e=5;goto failed;}
+ KCP_TRY(KCPGpuWrite(c,KCP_CP_SQE_CNTL,1));r->SQE_start_requested=1;
+ KCP_TRY(KCPGpuRead(c,KCP_CP_SQE_CNTL,&v));if((v&3)!=1){e=5;goto failed;}
