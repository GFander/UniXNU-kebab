+
+/* init is called only after the owner-fixed image has passed full SHA/RO
+ * checks. No supplied path, writable media or dynamically supplied hash. */
+extern "C" int
+kebab_cryptex_blockstorage_start(void)
+{
+	int error = kebab_cryptex_media_prepare();
+	if (error) return error;
+	if (kebab_cryptex_device) return 0;
+	IOService *provider = IOService::getServiceRoot();
+	OSDictionary *properties = OSDictionary::withCapacity(1);
+	KebabBlockStorageDevice *device = new KebabBlockStorageDevice;
+	if (!provider || !properties || !device) {
+		OSSafeReleaseNULL(properties); OSSafeReleaseNULL(device); return ENOMEM;
+	}
+	bool initialized = properties->setObject("KebabCryptex", kOSBooleanTrue) && device->init(properties);
+	properties->release();
+	if (!initialized) { device->release(); return ENXIO; }
+	device->setName("kebab-systemos0");
+	device->setProperty(kIOBlockStorageDeviceTypeKey, kIOBlockStorageDeviceTypeGeneric);
+	if (!device->attach(provider)) { device->release(); return ENXIO; }
+	if (!device->start(provider)) { device->detach(provider); device->release(); return ENXIO; }
+	kebab_cryptex_device = device;
+	device->registerService();
+	IOLog("KEBAB CRYPTEX MEDIA: registered original SystemOS read-only worker-backed media\n");
+	return 0;
+}
+
+extern "C" int
+kebab_cryptex_blockstorage_volume(dev_t *device, char *name, size_t capacity)
+{
+	if (!device || !name || !capacity || !kebab_cryptex_device) return EINVAL;
+	*device = NODEV; name[0] = 0;
+	if (kebab_cryptex_device->waitQuiet(10ULL * kSecondScale) != kIOReturnSuccess) return ETIMEDOUT;
+	IORegistryIterator *iterator = IORegistryIterator::iterateOver(kebab_cryptex_device,
+	    gIOServicePlane, kIORegistryIterateRecursively);
+	if (!iterator) return ENOMEM;
+	IORegistryEntry *entry;
+	unsigned int count = 0;
+	int error = ENOENT;
+	while ((entry = iterator->getNextObject()) != NULL) {
+		if (!entry->metaCast("IOMedia")) continue;
+		OSString *uuid = OSDynamicCast(OSString, entry->getProperty("UUID"));
+		if (!uuid || !uuid->isEqualTo(KEBAB_CRYPTEX_VOLUME_UUID)) continue;
+		if (++count != 1) { error = EINVAL; break; }
+		OSString *bsd = OSDynamicCast(OSString, entry->getProperty(kIOBSDNameKey));
+		OSNumber *maj = OSDynamicCast(OSNumber, entry->getProperty(kIOBSDMajorKey));
+		OSNumber *min = OSDynamicCast(OSNumber, entry->getProperty(kIOBSDMinorKey));
+		OSBoolean *writable = OSDynamicCast(OSBoolean, entry->getProperty("Writable"));
+		if (!bsd || !maj || !min || !writable || writable->isTrue() ||
+		    maj->unsigned64BitValue() > 255 || min->unsigned64BitValue() > 0xffffff ||
+		    bsd->getLength() == 0 || bsd->getLength() >= capacity) { error = EINVAL; break; }
+		const char *text = bsd->getCStringNoCopy();
+		bool valid = true;
+		for (unsigned int i = 0; i < bsd->getLength(); i++) {
+			char c = text[i];
+			if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) valid = false;
+		}
+		if (!valid) { error = EINVAL; break; }
+		*device = makedev(maj->unsigned32BitValue(), min->unsigned32BitValue());
+		strlcpy(name, text, capacity); error = 0;
+	}
+	if (!iterator->isValid() || count != 1) error = EINVAL;
+	iterator->release();
+	if (error) { *device = NODEV; name[0] = 0; }
 	return error;
