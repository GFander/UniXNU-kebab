+/* A fixed original image is an owner policy input, not an Apple IM4M result.
+ * Publish only after full SHA on the actual, pinned read-only Preboot mount. */
+#include <pexpert/arm64/board_config.h>
+#if defined(KEBAB)
+#include <pexpert/pexpert.h>
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/mount_internal.h>
+#include <sys/vnode_internal.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/ubc.h>
+#include <sys/namei.h>
+#include <sys/proc_internal.h>
+#include <sys/sysproto.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <libkern/crypto/sha2.h>
+#include "kebab_cryptex_media.h"
+#include "kebab_cryptex_stage.h"
+#include "../kern/kebab_apfs_probe.h"
+
+#define KCM_CHUNK (64u * 1024u)
+static vnode_t kcm_file;
+static mount_t kcm_backing, kcm_system;
+static uint32_t kcm_vid, kcm_ready;
+static LCK_GRP_DECLARE(kcm_group, "kebab_cryptex");
+static LCK_MTX_DECLARE(kcm_prepare_lock, &kcm_group);
+
+static dev_t
+kcm_device(mount_t mounted)
+{
+ vnode_t device = vfs_devvp(mounted);
+ dev_t number = device ? vnode_specrdev(device) : NODEV;
+ if (device) vnode_put(device);
+ return number;
+}
+
+static bool
+kcm_mount_readonly(mount_t mounted)
+{
+ return mounted && (vfs_flags(mounted) & MNT_RDONLY) &&
+     !strcmp(vfs_statfs(mounted)->f_fstypename, "apfs");
+}
+
+static int
+kcm_open_verify(void)
+{
+ uint32_t enabled = 0, rw = 0;
+ PE_parse_boot_argn("kebab_cryptex_media", &enabled, sizeof(enabled));
+ PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+ if (enabled != 1 || rw || rootvnode == NULLVP) return EROFS;
+ struct kebab_volume_identity system, preboot;
+ int error = kebab_lookup_apfs_preboot(&system, &preboot);
+ if (error) return error;
+ mount_t system_mount = vnode_mount(rootvnode);
+ if (!kcm_mount_readonly(system_mount) ||
+     kcm_device(system_mount) != makedev(system.major_number, system.minor_number)) return EINVAL;
+ vfs_context_t context = vfs_context_current();
+ vnode_t anchor = NULLVP, file = NULLVP;
+ error = vnode_lookup("/private/preboot", VNODE_LOOKUP_NOFOLLOW, &anchor, context);
+ if (error) return error;
+ mount_t backing = vnode_mount(anchor);
+ if (!vnode_isdir(anchor) || !kcm_mount_readonly(backing) || backing == system_mount ||
+     kcm_device(backing) != makedev(preboot.major_number, preboot.minor_number)) error = EINVAL;
+ if (!error) error = vnode_open(KEBAB_CRYPTEX_STAGE_PATH, O_NOFOLLOW | FREAD, 0, 0, &file, context);
+ uint8_t *buffer = NULL;
+ if (!error) {
+  struct vnode_attr attributes;
+  VATTR_INIT(&attributes);
+  VATTR_WANTED(&attributes, va_data_size);
+  VATTR_WANTED(&attributes, va_uid);
+  VATTR_WANTED(&attributes, va_gid);
+  VATTR_WANTED(&attributes, va_nlink);
+  VATTR_WANTED(&attributes, va_mode);
+  error = vnode_getattr(file, &attributes, context);
+  if (!error && (!vnode_isreg(file) || vnode_mount(file) != backing ||
+      !VATTR_IS_SUPPORTED(&attributes, va_data_size) || !VATTR_IS_SUPPORTED(&attributes, va_uid) ||
+      !VATTR_IS_SUPPORTED(&attributes, va_gid) || !VATTR_IS_SUPPORTED(&attributes, va_nlink) ||
+      !VATTR_IS_SUPPORTED(&attributes, va_mode) || attributes.va_uid || attributes.va_gid ||
+      attributes.va_nlink != 1 || !kebab_cryptex_stage_contract(KEBAB_CRYPTEX_STAGE_PATH,
+          attributes.va_data_size, attributes.va_data_size, attributes.va_mode & 07777,
+          0, kebab_cryptex_stage_sha256))) error = EINVAL;
+ }
+ if (!error) {
+  buffer = kalloc_data(KCM_CHUNK, Z_WAITOK);
+  if (!buffer) error = ENOMEM;
+ }
+ if (!error) {
+  SHA256_CTX hash;
+  uint8_t digest[32];
+  SHA256_Init(&hash);
+  for (uint64_t offset = 0; !error && offset < KEBAB_CRYPTEX_STAGE_BYTES; offset += KCM_CHUNK) {
+   uint64_t left = KEBAB_CRYPTEX_STAGE_BYTES - offset;
+   int count = left < KCM_CHUNK ? (int)left : (int)KCM_CHUNK, residual = 0;
+   error = vn_rdwr(UIO_READ, file, (caddr_t)buffer, count, (off_t)offset,
+       UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(context), &residual, NULL);
+   if (!error && residual) error = EIO;
+   if (error) break;
+   SHA256_Update(&hash, buffer, (size_t)count);
+   if (!offset && (*(const uint32_t *)(const void *)(buffer + 32) != 0x4253584e ||
+       *(const uint32_t *)(const void *)(buffer + 36) != 4096 ||
+       *(const uint64_t *)(const void *)(buffer + 40) != KEBAB_CRYPTEX_STAGE_BYTES / 4096)) error = EINVAL;
+   if (offset && !(offset & ((256u << 20) - 1)))
+    printf("KEBAB CRYPTEX MEDIA: verified %llu MiB of original SystemOS\n", offset >> 20);
+  }
+  SHA256_Final(digest, &hash);
+  if (!error && memcmp(digest, kebab_cryptex_stage_sha256, sizeof(digest))) error = EAUTH;
+  bzero(digest, sizeof(digest));
+ }
+ if (!error && (vnode_mount(file) != backing || vnode_mount(rootvnode) != system_mount ||
+     !kcm_mount_readonly(backing) || !kcm_mount_readonly(system_mount) ||
+     ubc_getsize(file) != (off_t)KEBAB_CRYPTEX_STAGE_BYTES)) error = EINVAL;
+ if (!error) {
+  /* Keep the FREAD open and its iocount for this immutable boot lifetime.
+   * Each worker read additionally obtains/relinquishes an iocount by vid. */
+  kcm_file = file; kcm_vid = vnode_vid(file);
+  kcm_backing = backing; kcm_system = system_mount; file = NULLVP;
+  __atomic_store_n(&kcm_ready, 1, __ATOMIC_RELEASE);
+ }
+ if (buffer) kfree_data(buffer, KCM_CHUNK);
+ if (file != NULLVP) (void)vnode_close(file, FREAD, context);
+ vnode_put(anchor);
+ return error;
+}
+
+int
+kebab_cryptex_media_prepare(void)
+{
+ lck_mtx_lock(&kcm_prepare_lock);
+ int error = __atomic_load_n(&kcm_ready, __ATOMIC_ACQUIRE) ? 0 : kcm_open_verify();
+ lck_mtx_unlock(&kcm_prepare_lock);
+ printf("KEBAB CRYPTEX MEDIA: fixed original SystemOS full SHA/RO identity %s (%d)\n", error ? "FAIL" : "PASS", error);
+ return error;
+}
+
+uint64_t
+kebab_cryptex_media_bytes(void)
+{
+ return __atomic_load_n(&kcm_ready, __ATOMIC_ACQUIRE) ? KEBAB_CRYPTEX_STAGE_BYTES : 0;
+}
+
+int
+kebab_cryptex_media_read(uint64_t offset, void *buffer, uint32_t length)
+{
+ if (!buffer || !length || length > KCM_CHUNK || offset > KEBAB_CRYPTEX_STAGE_BYTES ||
+     length > KEBAB_CRYPTEX_STAGE_BYTES - offset) return EINVAL;
+ if (!__atomic_load_n(&kcm_ready, __ATOMIC_ACQUIRE)) return ENXIO;
+ int error = vnode_getwithvid(kcm_file, kcm_vid);
+ if (error) return error;
+ if (rootvnode == NULLVP || vnode_mount(rootvnode) != kcm_system ||
+     vnode_mount(kcm_file) != kcm_backing || !kcm_mount_readonly(kcm_backing) ||
+     !kcm_mount_readonly(kcm_system) || ubc_getsize(kcm_file) != (off_t)KEBAB_CRYPTEX_STAGE_BYTES) error = EROFS;
+ if (!error) {
+  int residual = 0;
+  vfs_context_t context = vfs_context_current();
+  error = vn_rdwr(UIO_READ, kcm_file, (caddr_t)buffer, (int)length, (off_t)offset,
+      UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(context), &residual, NULL);
+  if (!error && residual) error = EIO;
+ }
+ vnode_put(kcm_file);
+ return error;
+}
+
+static int
+kcm_directory_identity(vnode_t directory, mount_t expected, vfs_context_t context)
+{
+ if (!vnode_isdir(directory) || vnode_mount(directory) != expected) return EINVAL;
+ struct vnode_attr attributes;
+ VATTR_INIT(&attributes);
+ VATTR_WANTED(&attributes, va_uid);
+ VATTR_WANTED(&attributes, va_gid);
+ VATTR_WANTED(&attributes, va_mode);
+ int error = vnode_getattr(directory, &attributes, context);
+ if (!error && (!VATTR_IS_SUPPORTED(&attributes, va_uid) || !VATTR_IS_SUPPORTED(&attributes, va_gid) ||
+     !VATTR_IS_SUPPORTED(&attributes, va_mode) || attributes.va_uid || attributes.va_gid ||
+     (attributes.va_mode & 07777) != 0755)) error = EINVAL;
+ return error;
+}
+
+static int
+kcm_mkdir_fixed(const char *path, mount_t expected, vfs_context_t context)
+{
+ vnode_t directory = NULLVP;
+ int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &directory, context);
+ if (!error) {
+  error = kcm_directory_identity(directory, expected, context);
+  vnode_put(directory); return error;
+ }
+ if (error != ENOENT) return error;
+ struct nameidata name;
+ NDINIT(&name, CREATE, OP_MKDIR, LOCKPARENT, UIO_SYSSPACE, CAST_USER_ADDR_T(path), context);
+ name.ni_cnd.cn_flags |= WILLBEDIR;
+ error = namei(&name);
+ if (error) return error;
+ vnode_t parent = name.ni_dvp;
+ directory = name.ni_vp;
+ if (!parent || vnode_mount(parent) != expected || !vnode_isdir(parent)) error = EINVAL;
+ if (!error && directory) error = kcm_directory_identity(directory, expected, context);
+ else if (!error) {
+  struct vnode_attr attributes;
+  VATTR_INIT(&attributes);
+  VATTR_SET(&attributes, va_type, VDIR);
+  VATTR_SET(&attributes, va_mode, 0755);
+  VATTR_SET(&attributes, va_uid, 0);
+  VATTR_SET(&attributes, va_gid, 0);
+  error = vn_create(parent, &directory, &name, &attributes, 0, 0, NULL, context);
+  if (!error && directory) error = kcm_directory_identity(directory, expected, context);
+  if (!error && !directory) error = EIO;
+ }
+ if (directory) vnode_put(directory);
+ nameidone(&name);
+ if (parent) vnode_put(parent);
+ return error;
+}
+
+int kebab_cryptex_prepare_directories(mount_t);
+int
+kebab_cryptex_prepare_directories(mount_t expected)
+{
+ uint32_t enabled = 0, rw = 0;
+ PE_parse_boot_argn("kebab_cryptex_dirs", &enabled, sizeof(enabled));
+ if (!enabled) return 0;
+ PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+ if (enabled != 1 || rw != 1 || !expected || (vfs_flags(expected) & MNT_RDONLY) ||
+     rootvnode == NULLVP || !kcm_mount_readonly(vnode_mount(rootvnode))) return EROFS;
+ struct kebab_volume_identity system, preboot;
+ int error = kebab_lookup_apfs_preboot(&system, &preboot);
+ if (error) return error;
+ if (kcm_device(vnode_mount(rootvnode)) != makedev(system.major_number, system.minor_number) ||
+     kcm_device(expected) != makedev(preboot.major_number, preboot.minor_number) ||
+     expected == vnode_mount(rootvnode) || strcmp(vfs_statfs(expected)->f_fstypename, "apfs")) return EINVAL;
+ vfs_context_t context = vfs_context_current();
+ error = kcm_mkdir_fixed("/private/preboot/Cryptexes", expected, context);
+ if (!error) error = kcm_mkdir_fixed(KEBAB_CRYPTEX_MOUNT_PATH, expected, context);
+ printf("KEBAB CRYPTEX: fixed mount directories %s (%d)\n", error ? "FAIL" : "PASS", error);
+ return error;
+}
+
+int kebab_cryptex_mount_prepare(proc_t, user_addr_t);
+int
+kebab_cryptex_mount_prepare(proc_t process, user_addr_t scratch)
+{
+ uint32_t enabled = 0;
+ PE_parse_boot_argn("kebab_cryptex_media", &enabled, sizeof(enabled));
+ if (!enabled) return 0;
+ if (enabled != 1 || !scratch || rootvnode == NULLVP) return EINVAL;
+ mount_t system = vnode_mount(rootvnode);
+ if (!kcm_mount_readonly(system)) return EROFS;
+ int error = kebab_cryptex_blockstorage_start();
+ if (error) return error;
+ dev_t selected = NODEV;
+ char name[32] = {0}, device_path[64] = {0};
+ error = kebab_cryptex_blockstorage_volume(&selected, name, sizeof(name));
+ if (error || selected == NODEV) return error ? error : ENXIO;
+ snprintf(device_path, sizeof(device_path), "/dev/%s", name);
+ vnode_t destination = NULLVP;
+ vfs_context_t context = vfs_context_current();
+ error = vnode_lookup(KEBAB_CRYPTEX_MOUNT_PATH, VNODE_LOOKUP_NOFOLLOW, &destination, context);
+ if (error) return error;
+ error = kcm_directory_identity(destination, kcm_backing, context);
+ vnode_put(destination);
+ if (error) return error;
+ /* Exact payload qualified against the unchanged 20H392 APFS mount syscall. */
+ uint8_t payload[0x150] = {0};
+ user64_addr_t spec = scratch + 0x180;
+ uint16_t normal_mount = 1;
+ uint64_t readonly = MNT_RDONLY;
+ uint32_t anonymous_owner = UINT32_MAX;
+ memcpy(payload, &spec, sizeof(spec));
+ memcpy(payload + 8, &readonly, sizeof(readonly));
+ memcpy(payload + 16, &normal_mount, sizeof(normal_mount));
+ memcpy(payload + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+ memcpy(payload + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+ struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+     .flags = MNT_RDONLY | MNT_NOSUID | MNT_NODEV, .data = scratch + 0x200};
+ int32_t result = 0;
+ if ((error = copyout("apfs", request.type, 5)) ||
+     (error = copyout(KEBAB_CRYPTEX_MOUNT_PATH, request.path, sizeof(KEBAB_CRYPTEX_MOUNT_PATH))) ||
+     (error = copyout(device_path, spec, strlen(device_path) + 1)) ||
+     (error = copyout(payload, request.data, sizeof(payload)))) return error;
+ error = mount(process, &request, &result);
+ printf("KEBAB CRYPTEX: original APFS mount uuid=%s dev=%s status=%d\n", KEBAB_CRYPTEX_VOLUME_UUID, device_path, error);
+ if (error) return error;
+ destination = NULLVP;
+ error = vnode_lookup(KEBAB_CRYPTEX_MOUNT_PATH, VNODE_LOOKUP_NOFOLLOW, &destination, context);
+ if (!error) {
+  mount_t actual = vnode_mount(destination);
+  if (!kcm_mount_readonly(actual) || actual == kcm_backing || kcm_device(actual) != selected ||
+      vnode_mount(rootvnode) != system || !kcm_mount_readonly(system) ||
+      !kcm_mount_readonly(kcm_backing) || !kebab_cryptex_media_bytes()) error = EAUTH;
+  vnode_put(destination);
+ }
+ printf("KEBAB CRYPTEX: mounted fixed original SystemOS UUID/dev_t/RO %s (%d)\n", error ? "FAIL" : "PASS", error);
+ return error;
+}
