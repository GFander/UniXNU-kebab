+/* Canonical original-OS Merkle encoding, independent of C struct padding.
+ * Caller supplies SHA256_CTX and SHA256_Init/Update/Final, uint types. */
+#ifndef KEBAB_OWNER_OS_CONTRACT_H
+#define KEBAB_OWNER_OS_CONTRACT_H
+struct koos_metadata {
+ uint32_t kind, mode, uid, gid, flags;
+ uint64_t size, rdev;
+};
+static inline void
+koos_u32(SHA256_CTX *hash, uint32_t value)
+{
+ uint8_t data[4];
+ for (unsigned i = 0; i < 4; ++i) data[i] = value >> (i * 8);
+ SHA256_Update(hash, data, sizeof(data));
+}
+static inline void
+koos_u64(SHA256_CTX *hash, uint64_t value)
+{
+ uint8_t data[8];
+ for (unsigned i = 0; i < 8; ++i) data[i] = value >> (i * 8);
+ SHA256_Update(hash, data, sizeof(data));
+}
+static inline void
+koos_node(const struct koos_metadata *node, const uint8_t content[32],
+    const uint8_t attributes[32], const uint8_t children[32], uint8_t digest[32])
+{
+ static const char domain[] = "HiOS original OS node v1";
+ SHA256_CTX hash;
+ SHA256_Init(&hash);
+ SHA256_Update(&hash, domain, sizeof(domain));
+ koos_u32(&hash, node->kind); koos_u32(&hash, node->mode);
+ koos_u32(&hash, node->uid); koos_u32(&hash, node->gid);
+ koos_u32(&hash, node->flags);
+ koos_u64(&hash, node->size); koos_u64(&hash, node->rdev);
+ SHA256_Update(&hash, content, 32);
+ SHA256_Update(&hash, attributes, 32);
+ SHA256_Update(&hash, children, 32);
+ SHA256_Final(digest, &hash);
+}
+#endif
