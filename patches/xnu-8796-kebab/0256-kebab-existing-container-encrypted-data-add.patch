+/* After failed original newfs removed old Data, allow only the one pinned
+ * container with precisely the surviving System and Preboot volumes. */
+extern "C" int
+kebab_lookup_apfs_empty_data_target(struct kebab_volume_identity *system,
+    struct kebab_volume_identity *preboot,struct kebab_volume_identity *container)
+{
+ if(!system||!preboot||!container)return EINVAL;
+ int error=kebab_lookup_apfs_preboot(system,preboot);if(error)return error;
+ OSDictionary *matching=IOService::serviceMatching("IOMedia");if(!matching)return ENOMEM;
+ OSIterator *iterator=IOService::getMatchingServices(matching);matching->release();if(!iterator)return ENOENT;
+ unsigned volumes=0;bool bad=false;
+ while(IOService *media=OSDynamicCast(IOService,iterator->getNextObject())){
+  if(kebab_backing_id(media)!=system->backing_id)continue;
+  OSString *name=OSDynamicCast(OSString,media->getProperty("BSD Name"));
+  OSString *uuid=OSDynamicCast(OSString,media->getProperty("UUID"));
+  OSString *content=OSDynamicCast(OSString,media->getProperty("Content"));
+  const char *text=name?name->getCStringNoCopy():"-",*identity=uuid?uuid->getCStringNoCopy():"-";
+  IOLog("KEBAB DATA INVENTORY: %s UUID=%s Content=%s active=%u backing=%llx\n",text,identity,
+      content?content->getCStringNoCopy():"-",!media->isInactive(),(unsigned long long)system->backing_id);
+  if(strncmp(text,"disk1s",6))continue;
+  ++volumes;
+  bool known=(!strcmp(text,system->bsd_name)&&!strcmp(identity,"DADD93F8-DBBF-4B17-A1DF-0F11E64172F7"))||
+      (!strcmp(text,preboot->bsd_name)&&!strcmp(identity,"EF45F98E-9F6C-43DB-B7C6-F418CA77429B"));
+  if(!known||media->isInactive())bad=true;
+ }
+ if(!iterator->isValid())bad=true;iterator->release();
+ if(bad||volumes!=2)return EAUTH;
+ error=kebab_lookup_uuid("0E25F331-6279-458A-9CFE-F39598DA17AA",container);
+ if(!error&&(strcmp(container->bsd_name,"disk1")||container->backing_id!=system->backing_id||
+     container->backing_id!=preboot->backing_id||container->major_number!=1||container->minor_number!=1))error=EAUTH;
+ return error;
+}
 #endif
