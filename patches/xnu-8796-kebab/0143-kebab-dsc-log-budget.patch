+/*
+ * The one line every boot gets, whether or not kebab_dsc_verbose is set.  It
+ * has to be enough to tell a built plan from an empty one: how many mappings
+ * were produced, how far they reach, where they start, how much they are slid
+ * and whether the synthetic dynamic-config page was added.  The per-file and
+ * per-mapping table is proof for a human reading a log, not something the next
+ * boot needs, so it stays behind the boot argument.
+ */
+static void
+kebab_dsc_log_plan_summary(const struct kebab_dsc_plan *plan)
+{
+	printf("KEBAB DSC: plan %u files / %u mappings, 0x%llx mapped, extent "
+	    "0x%llx (end 0x%llx), base 0x%llx, slide 0x%llx, dynamic config "
+	    "page %s\n",
+	    plan->file_count, plan->total_mappings,
+	    (unsigned long long)plan->total_mapped,
+	    (unsigned long long)(plan->highest_end - plan->region_start),
+	    (unsigned long long)plan->highest_end,
+	    (unsigned long long)plan->region_start,
+	    (unsigned long long)plan->slide,
+	    plan->dynamic_config_size != 0 ? "appended" : "absent");
+}
+
+static void
+kebab_dsc_log_plan(const struct kebab_dsc_plan *plan)
+{
+	kebab_dsc_log_plan_summary(plan);
+	if (kebab_dsc_verbose) {
+		kebab_dsc_log_plan_detail(plan);
+	}
+}
+
+/*
+ * A failure needs the tables that the happy path skips, so print them unless
+ * kebab_dsc_verbose already did.  Called for a rejected plan (where the plan is
+ * only partly filled in) and for a failed map; the caller decides whether the
+ * detail is already on the ring.
+ */
+static void
+kebab_dsc_log_plan_failure(const struct kebab_dsc_plan *plan)
+{
+	printf("KEBAB DSC: plan detail follows (failure path):\n");
+	kebab_dsc_log_plan_detail(plan);
+}
