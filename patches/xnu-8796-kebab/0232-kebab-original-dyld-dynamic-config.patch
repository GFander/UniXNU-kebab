+/* Target dyld-1042 v0 ABI; also checked against the shipped dyld. */
+struct kebab_dsc_dynamic_header {
+ char magic[16];
+ uint64_t fs_id;
+ uint64_t fs_object_id;
+};
+_Static_assert(sizeof(struct kebab_dsc_dynamic_header) == 32, "dyld v0 size");
+_Static_assert(offsetof(struct kebab_dsc_dynamic_header, fs_id) == 16, "dyld v0 fsid");
+_Static_assert(offsetof(struct kebab_dsc_dynamic_header, fs_object_id) == 24, "dyld v0 inode");
+
+static int
+kebab_dsc_prepare_dynamic(struct kebab_dsc_plan *plan, vnode_t main_vnode,
+    struct shared_file_mapping_slide_np *mapping, mach_vm_offset_t *scratch)
+{
+ struct kebab_dsc_file *main_file = &plan->files[0];
+ struct kebab_dsc_dynamic_header header = { .magic = "dyld_data    v0" };
+ struct stat64 st;
+ kern_return_t kr;
+ int error;
+
+ *scratch = 0;
+ if (!plan->file_count || main_file->mapping_count < 2 ||
+     main_file->mapping_count > KEBAB_DSC_MAX_MAPPINGS ||
+     plan->dynamic_config_size != KEBAB_DSC_PAGE_SIZE) return EINVAL;
+ *mapping = main_file->mappings[main_file->mapping_count - 1];
+ if (mapping->sms_address != plan->dynamic_config_addr ||
+     (mapping->sms_address & (KEBAB_DSC_PAGE_SIZE - 1)) ||
+     mapping->sms_size != KEBAB_DSC_PAGE_SIZE || mapping->sms_file_offset ||
+     mapping->sms_slide_size || mapping->sms_slide_start ||
+     mapping->sms_max_prot != VM_PROT_READ ||
+     mapping->sms_init_prot != (VM_PROT_READ | VM_PROT_ZF)) return EINVAL;
+ error = kebab_cryptex_vnode_recheck(main_vnode);
+ if (error) return error;
+ memset(&st, 0, sizeof(st));
+ error = vn_stat(main_vnode, &st, NULL, 1, 0, vfs_context_current());
+ if (error) return error;
+ /* dyld stores signed st_dev in uint64_t, not the distinct va_fsid64. */
+ if (!st.st_dev || !st.st_ino) return EINVAL;
+ header.fs_id = (uint64_t)(int64_t)st.st_dev;
+ header.fs_object_id = st.st_ino;
+ error = kebab_cryptex_vnode_recheck(main_vnode);
+ if (error) return error;
+
+ /* Fresh anonymous user pages are zeroed; fd=-1 copies the entire page. */
+ kr = mach_vm_allocate_kernel(current_map(), scratch, KEBAB_DSC_PAGE_SIZE,
+     VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
+ if (kr != KERN_SUCCESS) return ENOMEM;
+ error = copyout(&header, (user_addr_t)*scratch, sizeof(header));
+ if (error) {
+  (void)mach_vm_deallocate(current_map(), *scratch, KEBAB_DSC_PAGE_SIZE);
+  *scratch = 0;
+  return error;
+ }
+ mapping->sms_file_offset = *scratch;
+ mapping->sms_init_prot = VM_PROT_READ;
+ return 0;
+}
