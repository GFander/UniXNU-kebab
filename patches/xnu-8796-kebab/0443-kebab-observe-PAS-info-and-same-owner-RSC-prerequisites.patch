+/* SPDX-License-Identifier: MIT */
+#ifndef KERN_KEBAB_GPU_PAS_H
+#define KERN_KEBAB_GPU_PAS_H
+#include <stdint.h>
+
+/* Fixed little-endian ARM64 wire receipt; all reserved words are zero.
+ * INFO availability is NOT PAS13 support, PA64 or authenticated firmware.
+ * Each raw pair is unmodified x0/x1, split low word first. attempts==0 means
+ * that record was not called; a zero status with attempts==0 is NOT success. */
+#define KEBAB_GPU_PAS_MAGIC 0x31534150U
+#define KEBAB_GPU_PAS_SCHEMA 1U
+#define KEBAB_GPU_PAS_BYTES 256U
+enum {
+	KEBAB_GPU_PAS_OK = 0, KEBAB_GPU_PAS_NOT_RUN = 1,
+	KEBAB_GPU_PAS_BUSY = 2, KEBAB_GPU_PAS_UNSAFE = 3,
+	KEBAB_GPU_PAS_VERSION_UNKNOWN = 4, KEBAB_GPU_PAS_NO_CONVENTION = 5,
+	KEBAB_GPU_PAS_TRANSPORT_ERROR = 6, KEBAB_GPU_PAS_VALUE_UNKNOWN = 7,
+	KEBAB_GPU_PAS_INTERRUPTED_LIMIT = 8, KEBAB_GPU_PAS_ARGUMENT = 9
+};
+enum {
+	KEBAB_GPU_PAS_STATE_NOT_RUN = 0, KEBAB_GPU_PAS_STATE_BUSY = 1,
+	KEBAB_GPU_PAS_STATE_DONE = 2
+};
+enum {
+	KEBAB_GPU_PAS_F_READ_ONLY = 1U << 0,
+	KEBAB_GPU_PAS_F_VERSION_RETURNED = 1U << 1,
+	KEBAB_GPU_PAS_F_CONVENTION = 1U << 2,
+	KEBAB_GPU_PAS_F_COMPLETE = 1U << 3,
+	KEBAB_GPU_PAS_F_STOPPED = 1U << 4
+};
+struct kebab_gpu_pas_record {
+	uint32_t function, status_low, status_high, value_low, value_high, attempts;
+};
+struct kebab_gpu_pas_observation {
+	/* Words 0..15. convention is 0/32/64; pas_invoked is always zero. */
+	uint32_t magic, schema, bytes, flags, result, state, attempted_once;
+	uint32_t convention, smccc_low, smccc_high, pas_id, pas_invoked;
+	uint32_t record_count, completed_records, reserved_header[2];
+	/* Words 16..27: INFO64, INFO32; target is fixed 0x02000601. */
+	struct kebab_gpu_pas_record conventions[2];
+	/* Words 28..57: INIT, MEM_SETUP, AUTH_RESET, SHUTDOWN, IS_SUPPORTED.
+	 * These are targets in x2 of INFO, never functions sent as x0. */
+	struct kebab_gpu_pas_record records[5];
+	uint32_t reserved[6]; /* Words 58..63. */
+};
+typedef char kebab_gpu_pas_record_size[(sizeof(struct kebab_gpu_pas_record) == 24) ? 1 : -1];
+typedef char kebab_gpu_pas_observation_size[(sizeof(struct kebab_gpu_pas_observation) == KEBAB_GPU_PAS_BYTES) ? 1 : -1];
+
+/* Fixed PASQUERY normal worker only. One safe claim per boot, including
+ * failures. Unsafe entry returns UNSAFE without consuming the claim.
+ * Re-entry during work returns BUSY; later entries return the cached result. */
+int kebab_gpu_pas_query(void);
+/* No allocation, firmware call or triggering side effect. Exact 256B only.
+ * NOT_RUN/BUSY receipts contain no partially published firmware results.
+ * Return 0 for a copied receipt; ARGUMENT for a null/wrong-sized destination. */
+int kebab_gpu_pas_snapshot(struct kebab_gpu_pas_observation *, uint32_t bytes);
+#endif
