+/* BEGIN KEBAB_GPU_PAS_OBSERVER -- appended before the original KEBAB endif.
+ * INFO-only candidate. The legacy raw/query/survey above are unchanged.
+ * No PIL/IS_SUPPORTED operation, PA, buffer, allocation or MMIO is issued. */
+#include <kern/kebab_gpu_pas.h>
+
+static uint32_t kebab_gpu_pas_state;
+static struct kebab_gpu_pas_observation kebab_gpu_pas_cache;
+static const uint32_t kebab_gpu_pas_targets[5] = {
+	0x02000201, 0x02000202, 0x02000205, 0x02000206, 0x02000207
+};
+
+static int
+kebab_gpu_pas_safe(void)
+{
+	return !panic_active() && !ml_at_interrupt_context() &&
+	    !get_preemption_level() && ml_get_interrupts_enabled();
+}
+
+struct kebab_gpu_pas_raw_result {
+	uint64_t status, value;
+	uint32_t attempts;
+	int refused;
+};
+
+/* Same fixed INFO frames/cookie contract as the existing query, but raw64
+ * status==1 is the ONLY resumable status. Keeping this separate preserves
+ * the legacy survey's int32 status behavior exactly. No busy/WAITQ retry.
+ * 32 returns bound interrupted resumes, NOT a nonreturning EL3 call. */
+static struct kebab_gpu_pas_raw_result
+kebab_gpu_pas_query_strict(uint32_t function, uint32_t target)
+{
+	uint64_t cookie = 0;
+	struct kebab_gpu_pas_raw_result result = {};
+	for (unsigned i = 0; i < 32; i++) {
+		if (!kebab_gpu_pas_safe()) { result.refused = 1; break; }
+		struct kebab_scm_regs r = { .x = { i ? 1 : function, 1, target, 0, 0, 0, cookie, 0 } };
+		kebab_scm_raw(&r);
+		result.status = r.x[0]; result.value = r.x[1];
+		result.attempts = i + 1;
+		if (result.status != 1) break;
+		cookie = r.x[6];
+	}
+	return result;
+}
+
+static void
+kebab_gpu_pas_init(struct kebab_gpu_pas_observation *out)
+{
+	memset(out, 0, sizeof(*out));
+	out->magic = KEBAB_GPU_PAS_MAGIC; out->schema = KEBAB_GPU_PAS_SCHEMA;
+	out->bytes = sizeof(*out); out->flags = KEBAB_GPU_PAS_F_READ_ONLY;
+	out->result = KEBAB_GPU_PAS_NOT_RUN; out->pas_id = 13;
+	out->record_count = 5;
+	out->conventions[0].function = 0xc2000601;
+	out->conventions[1].function = 0x82000601;
+	for (unsigned i = 0; i < 5; i++) out->records[i].function = kebab_gpu_pas_targets[i];
+}
+
+static int
+kebab_gpu_pas_save(struct kebab_gpu_pas_record *out,
+    struct kebab_gpu_pas_raw_result result)
+{
+	out->status_low = (uint32_t)result.status;
+	out->status_high = (uint32_t)(result.status >> 32);
+	out->value_low = (uint32_t)result.value;
+	out->value_high = (uint32_t)(result.value >> 32);
+	out->attempts = result.attempts;
+	if (result.refused) return KEBAB_GPU_PAS_UNSAFE;
+	if (result.status == 1 && result.attempts == 32) return KEBAB_GPU_PAS_INTERRUPTED_LIMIT;
+	if (result.status != 0) return KEBAB_GPU_PAS_TRANSPORT_ERROR;
+	if (result.value > 1) return KEBAB_GPU_PAS_VALUE_UNKNOWN;
+	return KEBAB_GPU_PAS_OK;
+}
+
+int
+kebab_gpu_pas_query(void)
+{
+	if (!kebab_gpu_pas_safe()) return KEBAB_GPU_PAS_UNSAFE;
+	uint32_t expected = KEBAB_GPU_PAS_STATE_NOT_RUN;
+	if (!__atomic_compare_exchange_n(&kebab_gpu_pas_state, &expected,
+	    KEBAB_GPU_PAS_STATE_BUSY, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		return expected == KEBAB_GPU_PAS_STATE_DONE ?
+		    (int)kebab_gpu_pas_cache.result : KEBAB_GPU_PAS_BUSY;
+	}
+	struct kebab_gpu_pas_observation out;
+	kebab_gpu_pas_init(&out);
+	out.attempted_once = 1; out.state = KEBAB_GPU_PAS_STATE_DONE;
+	if (!kebab_gpu_pas_safe()) { out.result = KEBAB_GPU_PAS_UNSAFE; goto done; }
+	struct kebab_scm_regs version = { .x = { 0x80000000, 0, 0, 0, 0, 0, 0, 0 } };
+	kebab_scm_raw(&version);
+	out.smccc_low = (uint32_t)version.x[0]; out.smccc_high = (uint32_t)(version.x[0] >> 32);
+	out.flags |= KEBAB_GPU_PAS_F_VERSION_RETURNED;
+	/* Only SMCCC 1.x is interpreted by this fixed observer. Preserve any
+	 * unsupported/unknown raw value and stop without INFO fallback. */
+	if ((version.x[0] >> 16) != 1) { out.result = KEBAB_GPU_PAS_VERSION_UNKNOWN; goto done; }
+	uint32_t function = 0xc2000601;
+	struct kebab_gpu_pas_raw_result result = kebab_gpu_pas_query_strict(function, 0x02000601);
+	out.result = kebab_gpu_pas_save(&out.conventions[0], result);
+	if (out.result != KEBAB_GPU_PAS_OK) goto done;
+	if (result.value == 0) {
+		/* Only explicit transport-success/unavailable permits fallback.
+		 * -1 is ambiguous (SMCCC unsupported vs Qualcomm generic error). */
+		function = 0x82000601;
+		result = kebab_gpu_pas_query_strict(function, 0x02000601);
+		out.result = kebab_gpu_pas_save(&out.conventions[1], result);
+		if (out.result != KEBAB_GPU_PAS_OK) goto done;
+	}
+	if (result.value != 1) { out.result = KEBAB_GPU_PAS_NO_CONVENTION; goto done; }
+	out.convention = function == 0xc2000601 ? 64 : 32;
+	out.flags |= KEBAB_GPU_PAS_F_CONVENTION;
+	for (unsigned i = 0; i < 5; i++) {
+		result = kebab_gpu_pas_query_strict(function, kebab_gpu_pas_targets[i]);
+		out.result = kebab_gpu_pas_save(&out.records[i], result);
+		if (out.result != KEBAB_GPU_PAS_OK) goto done;
+		out.completed_records++;
+	}
+	out.flags |= KEBAB_GPU_PAS_F_COMPLETE;
+done:
+	if (out.result != KEBAB_GPU_PAS_OK) out.flags |= KEBAB_GPU_PAS_F_STOPPED;
+	kebab_gpu_pas_cache = out;
+	__atomic_store_n(&kebab_gpu_pas_state, KEBAB_GPU_PAS_STATE_DONE, __ATOMIC_RELEASE);
+	return (int)out.result;
+}
+
+int
+kebab_gpu_pas_snapshot(struct kebab_gpu_pas_observation *out, uint32_t bytes)
+{
+	if (!out || bytes != sizeof(*out)) return KEBAB_GPU_PAS_ARGUMENT;
+	uint32_t state = __atomic_load_n(&kebab_gpu_pas_state, __ATOMIC_ACQUIRE);
+	if (state == KEBAB_GPU_PAS_STATE_DONE) {
+		memcpy(out, &kebab_gpu_pas_cache, sizeof(*out));
+	} else {
+		kebab_gpu_pas_init(out);
+		out->state = state;
+		if (state == KEBAB_GPU_PAS_STATE_BUSY) {
+			out->attempted_once = 1; out->result = KEBAB_GPU_PAS_BUSY;
+		}
+	}
+	return KEBAB_GPU_PAS_OK;
+}
+/* END KEBAB_GPU_PAS_OBSERVER */
 #endif /* KEBAB */
