+/* Fixed SM8250 read-only resources. All fields are raw register observations;
+ * flags do not grant ownership, IRQ readiness, scanout or DMA completion. */
+struct KebabNativePlatformSnapshot {
+    uint32_t magic,schema,bytes,flags,result,reads,reserved[2];
+    uint32_t clocks[8],gic[12],ctl[6][3],pingpong[2][6],dsc[4][3],context[4];
+};
+static_assert(sizeof(KebabNativePlatformSnapshot)==296,"platform snapshot schema1");
+struct KebabPlatformRead {
+    KebabNativeDisplayMaps *maps;KebabNativePlatformSnapshot *out;
+};
+static int kebab_platform_read(void *cookie,unsigned region,size_t offset,uint32_t *value)
+{
+    KebabPlatformRead *r=(KebabPlatformRead *)cookie;
+    static const size_t spans[]={0x10000,0x4000,0x84208,0x100000,0x10000};
+    if(region>=5 || !value || (offset&3) || offset>spans[region]-4 || !r->maps->address[region])return -1;
+    if(region==1 || region==2 || region==3) {
+        uint32_t gcc=kebab_display_load(r->maps->address[0],0xb00c);
+        if(!(gcc&1) || (gcc&0x80000000u))return -1;
+    }
+    if(region==2 || region==3) {
+        uint32_t gdsc=kebab_display_load(r->maps->address[1],0x3000);
+        if(!(gdsc&0x80000000u) || (gdsc&1) ||
+           (kebab_display_load(r->maps->address[1],0x2080)&0x80000000u) ||
+           (kebab_display_load(r->maps->address[1],0x200c)&0x80000000u))return -1;
+    }
+    *value=kebab_display_load(r->maps->address[region],offset);r->out->reads++;return 0;
+}
+static int kebab_platform_smmu_read(void *cookie,size_t offset,uint32_t *value)
+{ return kebab_platform_read(cookie,3,offset,value); }
