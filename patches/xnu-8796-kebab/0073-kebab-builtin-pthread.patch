diff --git a/bsd/pthread/kebab_pthread_compat.h b/bsd/pthread/kebab_pthread_compat.h
new file mode 100644
--- /dev/null
+++ b/bsd/pthread/kebab_pthread_compat.h
+@@ -0,0 +1,51 @@
+/*
+ * Compile the matching libpthread provider with its kext view of BSD headers.
+ * It owns its full ksyn_waitq_element layout; the kernel's opaque counterpart
+ * reserves this layout. All communication with private BSD state uses callbacks.
+ */
+#ifndef KEBAB_PTHREAD_COMPAT_H
+#define KEBAB_PTHREAD_COMPAT_H
+#if defined(KEBAB)
+#undef BSD_KERNEL_PRIVATE
+#undef XNU_KERNEL_PRIVATE
+#define __PTHREAD_EXPOSE_INTERNALS__ 1
+#define NEEDS_SCHED_CALL_T 1
+
+/* The seven-argument kext API forwards to the eight-argument kernel vm_fault. */
+#define vm_fault vm_fault_external
+/* Kext export aliases are not applied when linking into the kernel itself. */
+#define mach_vm_allocate mach_vm_allocate_external
+#define mach_vm_map mach_vm_map_external
+
+/* The provider passes a pointer; 8796's KPI takes the integer address type. */
+#include <vm/vm_kern.h>
+#define vm_kernel_unslide_or_perm_external(addr, out) \
+    vm_kernel_unslide_or_perm_external((vm_offset_t)(addr), (out))
+
+/* The ABI uses integer queue keys; upstream passes its queue pointers. */
+#include <sys/pthread_shims.h>
+#define psynch_wait_prepare(kwq, ...) \
+    psynch_wait_prepare((uintptr_t)(kwq), __VA_ARGS__)
+#define psynch_wait_complete(kwq, ...) \
+    psynch_wait_complete((uintptr_t)(kwq), __VA_ARGS__)
+#define psynch_wait_update_owner(kwq, ...) \
+    psynch_wait_update_owner((uintptr_t)(kwq), __VA_ARGS__)
+#define psynch_wait_wakeup(kwq, ...) \
+    psynch_wait_wakeup((uintptr_t)(kwq), __VA_ARGS__)
+
+/* Upstream also uses NULL for integer user addresses. C's 0 serves both. */
+#undef NULL
+#define NULL 0
+
+/* Avoid collisions with the kernel side of the callback interface. */
+#define pthread_internal_functions kebab_pthread_internal_functions
+#define pthread_kern kebab_pthread_kern
+#define current_uthread kebab_pthread_current_uthread
+#define pthread_start kebab_pthread_start
+#define pthread_stop kebab_pthread_stop
+
+/* os/log passes &__dso_handle as the containing Mach-O image address. */
+extern void *kebab_pthread_log_image __asm("__mh_execute_header");
+#define __dso_handle kebab_pthread_log_image
+#endif /* KEBAB */
+#endif /* KEBAB_PTHREAD_COMPAT_H */
diff --git a/bsd/pthread/kebab_pthread_init.c b/bsd/pthread/kebab_pthread_init.c
new file mode 100644
--- /dev/null
+++ b/bsd/pthread/kebab_pthread_init.c
+@@ -0,0 +1,26 @@
+/* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
+#if defined(KEBAB)
+#include "kebab_pthread_compat.h"
+#include "kebab_libpthread/kern/kern_init.c"
+
+/* Keep the provider's full layout within the kernel's reserved storage. */
+_Static_assert(sizeof(struct ksyn_waitq_element) == 56,
+    "update KEBAB ksyn storage in sys/pthread_internal.h");
+
+/* Restore the startup interface after compiling the provider's kext code. */
+#define XNU_KERNEL_PRIVATE 1
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+__startup_func
+static void
+kebab_pthread_register(void)
+{
+    kern_return_t kr = kebab_pthread_start(NULL, NULL);
+    if (kr != KERN_SUCCESS || kebab_pthread_kern == NULL) {
+        panic("KEBAB: pthread provider registration failed: %d", kr);
+    }
+    kprintf("KEBAB pthread: libpthread-514.100.2 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, kebab_pthread_register);
+#endif /* KEBAB */
