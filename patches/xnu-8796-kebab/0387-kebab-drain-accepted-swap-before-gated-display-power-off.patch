+
+/* Apply power changes on the same gate as the present timer. In particular,
+ * complete the already accepted transaction before blanking; dropping its ID
+ * strands the original SwapWait/CA lifecycle. New concurrent swaps stay queued. */
+IOReturn
+AppleCLCD::requestPower(bool off)
+{
+    return fWorkLoop->runAction(&AppleCLCD::powerChangeAction, this,
+        (void *)(uintptr_t)off);
+}
+
+IOReturn
+AppleCLCD::powerChangeAction(OSObject *owner, void *request, void *, void *, void *)
+{
+    AppleCLCD *fb = static_cast<AppleCLCD *>(owner);
+    bool off = (uintptr_t)request != 0;
+    uint8_t pending[KEBAB_FB_SWAP_REC_SIZE];
+    uint32_t id = 0;
+    bool drain = false;
+    IOLockLock(fb->fLock);
+    if (fb->fStopping || panic_active()) {
+        IOLockUnlock(fb->fLock);
+        return kIOReturnNotReady;
+    }
+    if (off && !fb->fPowerOff && fb->fPendingValid) {
+        memcpy(pending, fb->fPending, sizeof(pending));
+        id = fb->fPendingID;
+        fb->fPendingValid = false;
+        drain = true;
+    }
+    IOLockUnlock(fb->fLock);
+    if (drain) {
+        fb->present(pending, id);
+        if (panic_active()) return kIOReturnNotReady;
+        IOLockLock(fb->fLock);
+        if (id > fb->fCompletedID) fb->fCompletedID = id;
+        fb->fCompletedTime = mach_absolute_time();
+        IOLockWakeup(fb->fLock, &fb->fCompletedID, false);
+        IOLockUnlock(fb->fLock);
+        IOLog("KEBAB FB POWER QUEUE: actually completed pending swap %u before off\n", id);
+    }
+    IOLockLock(fb->fLock);
+    if (off != fb->fPowerOff) {
+        fb->fPowerOff = off;
+        if (!off && !fb->fPendingValid && fb->fHaveFrame) fb->fPendingValid = true;
+        fb->fBlanked = false;
+    }
+    IOLockUnlock(fb->fLock);
+    if (off && !fb->fBlanked) {
+        if (panic_active()) return kIOReturnNotReady;
+        fb->blank();
+        fb->fBlanked = true;
+    }
+    IOLog("KEBAB FB: display %s\n", off ? "off" : "on");
+    return kIOReturnSuccess;
 }
 
