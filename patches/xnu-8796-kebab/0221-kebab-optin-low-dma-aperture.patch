--- /dev/null
+++ b/bsd/dev/kebab_dma_limits.h
@@ -0,0 +1,24 @@
+/* Conservative firmware DMA aperture; no SMMU ownership or mapping change. */
+#ifndef KEBAB_DMA_LIMITS_H
+#define KEBAB_DMA_LIMITS_H
+#include <pexpert/pexpert.h>
+#include <mach/vm_param.h>
+static inline bool
+kebab_dma32_requested(void)
+{
+ uint32_t enabled = 0;
+ return PE_parse_boot_argn("kebab_dma32", &enabled, sizeof(enabled)) && enabled == 1;
+}
+static inline ppnum_t
+kebab_dma32_max_pnum(void)
+{
+ return kebab_dma32_requested() ? (ppnum_t)atop_64(UINT32_MAX) : 0;
+}
+static inline bool
+kebab_dma_fits(uint64_t address, uint64_t bytes, unsigned bits)
+{
+ if (!address || !bytes || (bits != 32 && bits != 64)) return false;
+ uint64_t maximum = bits == 32 ? UINT32_MAX : UINT64_MAX;
+ return address <= maximum && bytes - 1 <= maximum - address;
+}
+#endif
