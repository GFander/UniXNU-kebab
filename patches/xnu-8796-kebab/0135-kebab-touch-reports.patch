index 0000000..c54fd97
--- /dev/null
+++ b/bsd/dev/kebab_touch_tcm.c
@@ -0,0 +1,660 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * bsd/dev/kebab_touch_tcm.c -- the TCM protocol and report decoder, compiled
+ * into the kernel.
+ *
+ * This file is a generated copy of package/KebabTouchTcm.c from the kebab-dev
+ * repository.  That copy is the one KebabTouchTcmHostTests.c drives; this one is
+ * what the touch driver calls, and the two are byte-identical apart from this
+ * banner and the two lines below.  Do not edit here: change
+ * package/KebabTouchTcm.c and re-run
+ *
+ *     python scripts/sync-touch-tcm.py --out <xnu>/bsd/dev
+ *
+ * so that the kernel cannot drift away from what the host tests prove.
+ */
+#define KEBAB_TOUCH_KERNEL 1
+#include "kebab_touch_tcm.h"
+/*
+ * The TCM framing, payload layouts, report program and report decoder.
+ *
+ * The protocol facts are from the vendor headers this part's driver compiles
+ * against (synaptics_tcm_core.h, synaptics_tcm_touch.c): MESSAGE_HEADER_SIZE 4,
+ * MESSAGE_MARKER 0xa5, MESSAGE_PADDING 0x5a, enum command, enum status_code,
+ * enum report_type, enum touch_report_code, struct syna_tcm_identification,
+ * struct syna_tcm_app_info, and touch_get_report_data()'s LSB-first bit order.
+ * Where this firmware differs from the vendor struct (the two bytes before the
+ * identify part number) the decoder anchors on the part string instead of
+ * assuming the vendor offset, and says so in the prefix it keeps.
+ */
+
+const char *
+kebab_tcm_status_name(kebab_tcm_status status)
+{
+	switch (status) {
+	case KEBAB_TCM_OK:
+		return "ok";
+	case KEBAB_TCM_ERR_SHORT:
+		return "short";
+	case KEBAB_TCM_ERR_MARKER:
+		return "no marker";
+	case KEBAB_TCM_ERR_LENGTH:
+		return "bad length";
+	case KEBAB_TCM_ERR_PADDING:
+		return "bad padding";
+	case KEBAB_TCM_ERR_CODE:
+		return "unexpected code";
+	case KEBAB_TCM_ERR_LAYOUT:
+		return "bad layout";
+	case KEBAB_TCM_ERR_PROGRAM:
+		return "program does not fit";
+	case KEBAB_TCM_ERR_ARGUMENT:
+		return "bad argument";
+	default:
+		return "unknown";
+	}
+}
+
+/* --------------------------------------------------------------- framing */
+
+kebab_tcm_status
+kebab_tcm_header_parse(const uint8_t raw[KEBAB_TCM_HEADER_SIZE],
+    kebab_tcm_header *out)
+{
+	if (raw == NULL || out == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	out->code = 0;
+	out->payload_len = 0;
+	if (raw[0] != KEBAB_TCM_MARKER) {
+		return KEBAB_TCM_ERR_MARKER;
+	}
+	out->payload_len = (uint16_t)kebab_tcm_le16(&raw[2]);
+	out->code = raw[1];
+	if (out->payload_len > KEBAB_TCM_MAX_PAYLOAD) {
+		return KEBAB_TCM_ERR_LENGTH;
+	}
+	return KEBAB_TCM_OK;
+}
+
+uint32_t
+kebab_tcm_message_bytes(const kebab_tcm_header *header)
+{
+	if (header == NULL) {
+		return 0;
+	}
+	return KEBAB_TCM_HEADER_SIZE + (uint32_t)header->payload_len + 1u;
+}
+
+kebab_tcm_status
+kebab_tcm_message_parse(const uint8_t *buf, uint32_t len,
+    kebab_tcm_header *header, uint32_t *consumed)
+{
+	kebab_tcm_header h;
+	kebab_tcm_status status;
+	uint32_t total;
+
+	if (buf == NULL || header == NULL || consumed == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	*consumed = 0;
+	if (len < KEBAB_TCM_HEADER_SIZE) {
+		return KEBAB_TCM_ERR_SHORT;
+	}
+	status = kebab_tcm_header_parse(buf, &h);
+	if (status != KEBAB_TCM_OK) {
+		return status;
+	}
+	total = kebab_tcm_message_bytes(&h);
+	if (len < total) {
+		return KEBAB_TCM_ERR_SHORT;
+	}
+	if (buf[total - 1] != KEBAB_TCM_PADDING) {
+		return KEBAB_TCM_ERR_PADDING;
+	}
+	*header = h;
+	*consumed = total;
+	return KEBAB_TCM_OK;
+}
+
+uint32_t
+kebab_tcm_find_marker(const uint8_t *buf, uint32_t len, uint32_t from)
+{
+	uint32_t i;
+
+	if (buf == NULL) {
+		return len;
+	}
+	for (i = from; i < len; i++) {
+		if (buf[i] == KEBAB_TCM_MARKER) {
+			return i;
+		}
+	}
+	return len;
+}
+
+uint32_t
+kebab_tcm_build_command(uint8_t *out, uint32_t cap, uint8_t command,
+    const uint8_t *payload, uint32_t len)
+{
+	if (out == NULL || cap < len + 3u || len > 0xffffu) {
+		return 0;
+	}
+	if (len != 0 && payload == NULL) {
+		return 0;
+	}
+	out[0] = command;
+	out[1] = (uint8_t)(len & 0xffu);
+	out[2] = (uint8_t)((len >> 8) & 0xffu);
+	if (len != 0) {
+		memcpy(&out[3], payload, len);
+	}
+	return len + 3u;
+}
+
+kebab_tcm_status
+kebab_tcm_expect_report(const kebab_tcm_header *header, uint8_t id)
+{
+	if (header == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	if (header->code != id) {
+		return KEBAB_TCM_ERR_CODE;
+	}
+	return KEBAB_TCM_OK;
+}
+
+kebab_tcm_status
+kebab_tcm_expect_status(const kebab_tcm_header *header)
+{
+	if (header == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	/*
+	 * A command answer carries a status below 0x10.  A code from 0x10 up is a
+	 * report, and a code that merely echoes the command byte (0x20, 0x26) is
+	 * neither: it must not be read as "OK".
+	 */
+	if (header->code >= KEBAB_TCM_REPORT_IDENTIFY) {
+		return KEBAB_TCM_ERR_CODE;
+	}
+	return KEBAB_TCM_OK;
+}
+
+/* -------------------------------------------------------- payload layouts */
+
+kebab_tcm_status
+kebab_tcm_parse_identify(const uint8_t *payload, uint32_t len,
+    kebab_tcm_identify *out)
+{
+	uint32_t anchor;
+	uint32_t i;
+
+	if (payload == NULL || out == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	memset(out, 0, sizeof(*out));
+
+	/*
+	 * Anchor on four printable bytes: the part number is the only field in
+	 * this payload whose position is self-evident.  On the vendor struct that
+	 * lands at 2; on the measured S3908 payload it lands at 4.
+	 */
+	anchor = len;
+	for (i = 0; i + 4u <= len; i++) {
+		if (payload[i] >= 0x20u && payload[i] < 0x7fu &&
+		    payload[i + 1] >= 0x20u && payload[i + 1] < 0x7fu &&
+		    payload[i + 2] >= 0x20u && payload[i + 2] < 0x7fu &&
+		    payload[i + 3] >= 0x20u && payload[i + 3] < 0x7fu) {
+			anchor = i;
+			break;
+		}
+	}
+	if (anchor == len) {
+		return KEBAB_TCM_ERR_LAYOUT;
+	}
+	if (anchor < 2u) {
+		/* No room for version and mode in front of the part number. */
+		return KEBAB_TCM_ERR_LAYOUT;
+	}
+	out->version = payload[anchor - 2u];
+	out->mode = payload[anchor - 1u];
+	out->prefix_len = anchor - 2u;
+	for (i = 0; i < out->prefix_len && i < sizeof(out->prefix); i++) {
+		out->prefix[i] = payload[i];
+	}
+	for (i = 0; i < 16u && anchor + i < len; i++) {
+		uint8_t c = payload[anchor + i];
+
+		if (c == 0) {
+			/* The vendor part_number is NUL padded; the string ends here. */
+			break;
+		}
+		out->part[i] = (c >= 0x20u && c < 0x7fu) ? (char)c : '.';
+	}
+	out->part[i] = '\0';
+	if (len >= anchor + 20u) {
+		out->build = kebab_tcm_le32(&payload[anchor + 16u]);
+		out->build_known = 1;
+	}
+	return KEBAB_TCM_OK;
+}
+
+kebab_tcm_status
+kebab_tcm_parse_app_info(const uint8_t *payload, uint32_t len,
+    kebab_tcm_app_info *out)
+{
+	if (payload == NULL || out == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	if (len < KEBAB_TCM_APP_INFO_SIZE) {
+		return KEBAB_TCM_ERR_LAYOUT;
+	}
+	memset(out, 0, sizeof(*out));
+	out->version = (uint16_t)kebab_tcm_le16(&payload[0]);
+	out->status = (uint16_t)kebab_tcm_le16(&payload[2]);
+	out->static_config_size = (uint16_t)kebab_tcm_le16(&payload[4]);
+	out->dynamic_config_size = (uint16_t)kebab_tcm_le16(&payload[6]);
+	out->app_config_start_write_block = (uint16_t)kebab_tcm_le16(&payload[8]);
+	out->app_config_size = (uint16_t)kebab_tcm_le16(&payload[10]);
+	out->max_touch_report_config_size = (uint16_t)kebab_tcm_le16(&payload[12]);
+	out->max_touch_report_payload_size = (uint16_t)kebab_tcm_le16(&payload[14]);
+	memcpy(out->customer_config_id, &payload[16], 16);
+	out->max_x = (uint16_t)kebab_tcm_le16(&payload[32]);
+	out->max_y = (uint16_t)kebab_tcm_le16(&payload[34]);
+	out->max_objects = (uint16_t)kebab_tcm_le16(&payload[36]);
+	out->num_of_buttons = (uint16_t)kebab_tcm_le16(&payload[38]);
+	out->num_of_image_rows = (uint16_t)kebab_tcm_le16(&payload[40]);
+	out->num_of_image_cols = (uint16_t)kebab_tcm_le16(&payload[42]);
+	out->has_hybrid_data = (uint16_t)kebab_tcm_le16(&payload[44]);
+	return KEBAB_TCM_OK;
+}
+
+/* --------------------------------------------------------- report program */
+
+uint32_t
+kebab_tcm_program_build(uint8_t *out, uint32_t cap, int pressure)
+{
+	uint32_t n = 0;
+
+	if (out == NULL) {
+		return 0;
+	}
+	/* FOREACH_END + END, plus the fields below; 13 with pressure, 11 without. */
+	if (cap < (pressure ? 13u : 11u)) {
+		return 0;
+	}
+	out[n++] = KEBAB_TCM_TOUCH_FOREACH_ACTIVE_OBJECT;
+	out[n++] = KEBAB_TCM_TOUCH_OBJECT_N_INDEX;
+	out[n++] = 4;
+	out[n++] = KEBAB_TCM_TOUCH_OBJECT_N_CLASSIFICATION;
+	out[n++] = 4;
+	out[n++] = KEBAB_TCM_TOUCH_OBJECT_N_X_POSITION;
+	out[n++] = 12;
+	out[n++] = KEBAB_TCM_TOUCH_OBJECT_N_Y_POSITION;
+	out[n++] = 12;
+	if (pressure) {
+		out[n++] = KEBAB_TCM_TOUCH_OBJECT_N_Z;
+		out[n++] = 8;
+	}
+	out[n++] = KEBAB_TCM_TOUCH_FOREACH_END;
+	out[n++] = KEBAB_TCM_TOUCH_END;
+	return n;
+}
+
+/*
+ * Find the foreach body and add up the field widths inside it.  The decoder
+ * only implements the program this driver writes, and the body has to be a flat
+ * sequence of object fields for the "bits per contact" to be a constant; a
+ * program that is anything else is rejected here rather than misread later.
+ */
+static kebab_tcm_status
+kebab_tcm_program_scan(const uint8_t *program, uint32_t len, uint32_t *body_out,
+    uint32_t *bits_out)
+{
+	uint32_t idx = 0;
+	uint32_t body;
+	uint32_t bits = 0;
+
+	if (program == NULL || body_out == NULL || bits_out == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	while (idx < len) {
+		uint8_t code = program[idx++];
+
+		if (code == KEBAB_TCM_TOUCH_END) {
+			return KEBAB_TCM_ERR_LAYOUT;   /* no foreach at all */
+		}
+		if (code != KEBAB_TCM_TOUCH_FOREACH_ACTIVE_OBJECT &&
+		    code != KEBAB_TCM_TOUCH_FOREACH_OBJECT) {
+			return KEBAB_TCM_ERR_LAYOUT;   /* top-level field not supported */
+		}
+		body = idx;
+		while (idx < len) {
+			uint8_t field = program[idx++];
+			uint32_t width;
+
+			if (field == KEBAB_TCM_TOUCH_FOREACH_END) {
+				*body_out = body;
+				*bits_out = bits;
+				return bits == 0 ? KEBAB_TCM_ERR_LAYOUT :
+				    KEBAB_TCM_OK;
+			}
+			if (field == KEBAB_TCM_TOUCH_END || idx >= len) {
+				return KEBAB_TCM_ERR_LAYOUT;
+			}
+			width = program[idx++];
+			switch (field) {
+			case KEBAB_TCM_TOUCH_OBJECT_N_INDEX:
+			case KEBAB_TCM_TOUCH_OBJECT_N_CLASSIFICATION:
+				if (width > 8u) {
+					return KEBAB_TCM_ERR_LAYOUT;
+				}
+				break;
+			case KEBAB_TCM_TOUCH_OBJECT_N_X_POSITION:
+			case KEBAB_TCM_TOUCH_OBJECT_N_Y_POSITION:
+				if (width > 16u) {
+					return KEBAB_TCM_ERR_LAYOUT;
+				}
+				break;
+			case KEBAB_TCM_TOUCH_OBJECT_N_Z:
+				if (width > 8u) {
+					return KEBAB_TCM_ERR_LAYOUT;
+				}
+				break;
+			default:
+				return KEBAB_TCM_ERR_LAYOUT;
+			}
+			bits += width;
+			if (bits > 64u) {
+				return KEBAB_TCM_ERR_LAYOUT;
+			}
+		}
+		return KEBAB_TCM_ERR_LAYOUT;           /* missing FOREACH_END */
+	}
+	return KEBAB_TCM_ERR_LAYOUT;
+}
+
+uint32_t
+kebab_tcm_program_object_bits(const uint8_t *program, uint32_t len)
+{
+	uint32_t body = 0;
+	uint32_t bits = 0;
+
+	if (kebab_tcm_program_scan(program, len, &body, &bits) != KEBAB_TCM_OK) {
+		return 0;
+	}
+	return bits;
+}
+
+uint32_t
+kebab_tcm_report_payload_build(uint8_t *out, uint32_t cap,
+    const uint8_t *program, uint32_t program_len, uint32_t firmware_max)
+{
+	uint32_t total;
+
+	if (out == NULL || program == NULL || program_len == 0) {
+		return 0;
+	}
+	if (firmware_max > KEBAB_TCM_REPORT_CONFIG_MAX) {
+		/* Not a size this driver carries a buffer for; send the program. */
+		firmware_max = 0;
+	}
+	if (firmware_max != 0 && firmware_max < program_len) {
+		/*
+		 * The firmware says its report program buffer is smaller than the
+		 * program: sending the program anyway would overrun the very
+		 * buffer the app info just described.  The caller has to fall
+		 * back to a shorter program or report the mismatch.
+		 */
+		return 0;
+	}
+	total = (firmware_max != 0) ? firmware_max : program_len;
+	if (total > cap) {
+		return 0;
+	}
+	/*
+	 * Zero padding is not filler: the vendor driver sends the whole
+	 * max_touch_report_config_size buffer and the firmware's program parser
+	 * stops at TOUCH_END, which is a zero byte.
+	 */
+	memset(out, 0, total);
+	memcpy(out, program, program_len);
+	return total;
+}
+
+/* --------------------------------------------------------------- decoding */
+
+uint32_t
+kebab_tcm_bits(const uint8_t *data, uint32_t offset, uint32_t bits)
+{
+	uint32_t out = 0;
+	uint32_t remaining = bits;
+	uint32_t bit_offset = offset & 7u;
+	uint32_t byte = offset >> 3;
+
+	while (remaining != 0) {
+		uint32_t available = 8u - bit_offset;
+		uint32_t take = (available < remaining) ? available : remaining;
+		uint32_t mask = (1u << take) - 1u;
+		uint32_t v = ((uint32_t)data[byte] >> bit_offset) & mask;
+
+		out |= v << (bits - remaining);
+		bit_offset = 0;
+		byte++;
+		remaining -= take;
+	}
+	return out;
+}
+
+static kebab_tcm_status
+kebab_tcm_walk_object(const uint8_t *program, uint32_t len, uint32_t body,
+    const uint8_t *payload, uint32_t payload_bits, uint32_t *offset,
+    kebab_tcm_object *object)
+{
+	uint32_t idx = body;
+
+	memset(object, 0, sizeof(*object));
+	while (idx < len) {
+		uint8_t field = program[idx++];
+		uint32_t width;
+
+		if (field == KEBAB_TCM_TOUCH_FOREACH_END) {
+			return KEBAB_TCM_OK;
+		}
+		if (idx >= len) {
+			return KEBAB_TCM_ERR_LAYOUT;
+		}
+		width = program[idx++];
+		if (*offset + width > payload_bits) {
+			return KEBAB_TCM_ERR_SHORT;
+		}
+		switch (field) {
+		case KEBAB_TCM_TOUCH_OBJECT_N_INDEX:
+			object->index = (uint8_t)kebab_tcm_bits(payload, *offset,
+			    width);
+			break;
+		case KEBAB_TCM_TOUCH_OBJECT_N_CLASSIFICATION:
+			object->classification = (uint8_t)kebab_tcm_bits(payload,
+			    *offset, width);
+			break;
+		case KEBAB_TCM_TOUCH_OBJECT_N_X_POSITION:
+			object->x = (uint16_t)kebab_tcm_bits(payload, *offset,
+			    width);
+			break;
+		case KEBAB_TCM_TOUCH_OBJECT_N_Y_POSITION:
+			object->y = (uint16_t)kebab_tcm_bits(payload, *offset,
+			    width);
+			break;
+		case KEBAB_TCM_TOUCH_OBJECT_N_Z:
+			object->z = (uint8_t)kebab_tcm_bits(payload, *offset,
+			    width);
+			break;
+		default:
+			return KEBAB_TCM_ERR_LAYOUT;
+		}
+		*offset += width;
+	}
+	return KEBAB_TCM_ERR_LAYOUT;
+}
+
+kebab_tcm_status
+kebab_tcm_decode_report(const uint8_t *program, uint32_t program_len,
+    const uint8_t *payload, uint32_t payload_len, uint32_t max_objects,
+    kebab_tcm_report *out)
+{
+	uint32_t body = 0;
+	uint32_t object_bits = 0;
+	uint32_t offset = 0;
+	kebab_tcm_status status;
+
+	if (program == NULL || payload == NULL || out == NULL) {
+		return KEBAB_TCM_ERR_ARGUMENT;
+	}
+	status = kebab_tcm_program_scan(program, program_len, &body,
+	    &object_bits);
+	if (status != KEBAB_TCM_OK) {
+		return status;
+	}
+	memset(out, 0, sizeof(*out));
+	out->payload_bits = payload_len * 8u;
+	if (max_objects == 0 || max_objects > KEBAB_TCM_MAX_OBJECTS) {
+		max_objects = KEBAB_TCM_MAX_OBJECTS;
+	}
+
+	/*
+	 * A contact is decoded only when all of its bits are there.  A tail that
+	 * is too short for another contact is counted, not decoded: decoding it
+	 * would read a contact out of the next message's bytes.
+	 */
+	while (out->objects < max_objects &&
+	    offset + object_bits <= out->payload_bits) {
+		kebab_tcm_object object;
+
+		status = kebab_tcm_walk_object(program, program_len, body, payload,
+		    out->payload_bits, &offset, &object);
+		if (status != KEBAB_TCM_OK) {
+			return status;
+		}
+		out->object[out->objects++] = object;
+	}
+	out->bits = offset;
+	out->truncated_bits = out->payload_bits - offset;
+	if (out->truncated_bits != 0) {
+		/*
+		 * All-zero tails are byte padding, not a cut contact: a report
+		 * that ends on a zero byte boundary must not lift every finger.
+		 * A non-zero tail is a truncated contact and the caller drops the
+		 * whole report.
+		 */
+		uint32_t bit;
+
+		for (bit = offset; bit < out->payload_bits; bit++) {
+			if (((payload[bit >> 3] >> (bit & 7u)) & 1u) != 0) {
+				out->truncated_nonzero = 1;
+				break;
+			}
+		}
+	}
+	return KEBAB_TCM_OK;
+}
+
+/* --------------------------------------------------------------- tracking */
+
+uint32_t
+kebab_tcm_track(kebab_tcm_tracker *tracker, const kebab_tcm_report *report,
+    kebab_tcm_event *events, uint32_t max_events)
+{
+	uint16_t seen = 0;
+	uint32_t stored = 0;
+	uint32_t i;
+
+	if (tracker == NULL || report == NULL) {
+		return 0;
+	}
+	for (i = 0; i < report->objects; i++) {
+		const kebab_tcm_object *object = &report->object[i];
+		kebab_tcm_event event;
+		uint8_t phase;
+
+		if (object->classification != KEBAB_TCM_CLASS_FINGER &&
+		    object->classification != KEBAB_TCM_CLASS_GLOVED_FINGER) {
+			continue;
+		}
+		if (object->index >= KEBAB_TCM_MAX_OBJECTS) {
+			continue;
+		}
+		phase = (tracker->active & (1u << object->index)) ?
+		    KEBAB_TCM_PHASE_MOVE : KEBAB_TCM_PHASE_DOWN;
+		seen |= (uint16_t)(1u << object->index);
+		tracker->last_x[object->index] = object->x;
+		tracker->last_y[object->index] = object->y;
+		event.phase = phase;
+		event.slot = object->index;
+		event.raw_x = object->x;
+		event.raw_y = object->y;
+		event.pressure = object->z;
+		if (events != NULL && stored < max_events) {
+			events[stored++] = event;
+		}
+	}
+	/* A slot that was active and is missing from this report has lifted. */
+	for (i = 0; i < KEBAB_TCM_MAX_OBJECTS; i++) {
+		kebab_tcm_event event;
+
+		if (!(tracker->active & (1u << i)) || (seen & (1u << i))) {
+			continue;
+		}
+		event.phase = KEBAB_TCM_PHASE_UP;
+		event.slot = (uint8_t)i;
+		event.raw_x = tracker->last_x[i];
+		event.raw_y = tracker->last_y[i];
+		event.pressure = 0;
+		if (events != NULL && stored < max_events) {
+			events[stored++] = event;
+		}
+	}
+	tracker->active = seen;
+	return stored;
+}
+
+/* -------------------------------------------------------------- transform */
+
+kebab_tcm_point
+kebab_tcm_transform(uint32_t raw_x, uint32_t raw_y, uint32_t max_x,
+    uint32_t max_y)
+{
+	kebab_tcm_point p;
+
+	if (max_x == 0 || max_x > KEBAB_TCM_SENSOR_LIMIT) {
+		max_x = KEBAB_TCM_SENSOR_MAX_X;
+	}
+	if (max_y == 0 || max_y > KEBAB_TCM_SENSOR_LIMIT) {
+		max_y = KEBAB_TCM_SENSOR_MAX_Y;
+	}
+	memset(&p, 0, sizeof(p));
+	if (raw_x > max_x) {
+		raw_x = max_x;
+		p.clamped = 1;
+	}
+	if (raw_y > max_y) {
+		raw_y = max_y;
+		p.clamped = 1;
+	}
+	p.panel_x = (int32_t)(((uint64_t)raw_x * (KEBAB_TCM_PANEL_W - 1) +
+	    max_x / 2u) / max_x);
+	p.panel_y = (int32_t)(((uint64_t)raw_y * (KEBAB_TCM_PANEL_H - 1) +
+	    max_y / 2u) / max_y);
+	p.logical_x = p.panel_x + KEBAB_TCM_LOGICAL_ORIGIN_X;
+	p.logical_y = p.panel_y + KEBAB_TCM_LOGICAL_ORIGIN_Y;
+	/* Defensive only: with the origin above these cannot fire. */
+	if (p.logical_x >= KEBAB_TCM_LOGICAL_W) {
+		p.logical_x = KEBAB_TCM_LOGICAL_W - 1;
+		p.clamped = 1;
+	}
+	if (p.logical_y >= KEBAB_TCM_LOGICAL_H) {
+		p.logical_y = KEBAB_TCM_LOGICAL_H - 1;
+		p.clamped = 1;
+	}
+	return p;
+}
diff --git a/bsd/dev/kebab_touch_tcm.h b/bsd/dev/kebab_touch_tcm.h
new file mode 100644
index 0000000..b560378
--- /dev/null
+++ b/bsd/dev/kebab_touch_tcm.h
@@ -0,0 +1,362 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * bsd/dev/kebab_touch_tcm.h -- header of the TCM protocol and report decoder.
+ *
+ * Generated copy of package/KebabTouchTcm.h from the kebab-dev repository; see
+ * bsd/dev/kebab_touch_tcm.c.  With KEBAB_TOUCH_KERNEL set it selects the kernel
+ * headers instead of the host ones.  Do not edit: re-run
+ * scripts/sync-touch-tcm.py.
+ */
+/*
+ * The Synaptics TCM protocol the S3908 on SE13 speaks, and the touch report
+ * decoder on top of it.
+ *
+ * The module is free of I2C, of MMIO and of kernel dependencies.  It owns three
+ * things the driver used to spell out inline:
+ *
+ *   - the message framing: marker, code, 16-bit length, payload, padding;
+ *   - the two application-mode commands whose payloads are laid out by the
+ *     vendor headers (identify, application info) and the report program whose
+ *     layout the driver itself chooses (SET_TOUCH_REPORT_CONFIG);
+ *   - the bitfield walk that turns a report into contacts, the contact state
+ *     machine that turns a stream of reports into down/move/up, and the
+ *     sensor -> panel -> logical transform.
+ *
+ * The bitfield walk is driven by the report program, not by a fixed 5-byte
+ * stride: the same bytes the driver sends to the chip are the bytes the decoder
+ * reads, so a program the firmware accepted is a layout the decoder knows.
+ *
+ * Every length that comes off the wire is checked against the buffer before it
+ * is used.  A message whose declared length is implausible is rejected with the
+ * four header bytes intact so the caller can print them; nothing is decoded
+ * from a message that did not pass the framing checks.
+ */
+#ifndef KEBAB_TOUCH_TCM_H
+#define KEBAB_TOUCH_TCM_H
+
+#ifdef KEBAB_TOUCH_KERNEL
+#include <sys/types.h>
+#include <libkern/libkern.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#endif
+
+/* ------------------------------------------------------------ framing */
+
+#define KEBAB_TCM_MARKER       0xa5u
+#define KEBAB_TCM_PADDING      0x5au
+#define KEBAB_TCM_HEADER_SIZE  4u
+
+/*
+ * The largest payload this decoder will look at.  The touch report is the only
+ * message that can be large: ten objects of five bytes is 50 bytes, and the
+ * application info is 46.  A header that claims more than this is not a header
+ * this driver can trust, which is exactly the check the measured 0x5a00 needed.
+ */
+#define KEBAB_TCM_MAX_PAYLOAD  128u
+
+/* Command set (enum command in syna_tcm_core.h). */
+#define KEBAB_TCM_CMD_IDENTIFY          0x02u
+#define KEBAB_TCM_CMD_GET_BOOT_INFO     0x10u
+#define KEBAB_TCM_CMD_GET_APP_INFO      0x20u
+#define KEBAB_TCM_CMD_SET_REPORT_CONFIG 0x26u
+
+/* Report ids and status codes (enum report_type, enum status_code). */
+#define KEBAB_TCM_REPORT_IDENTIFY 0x10u
+#define KEBAB_TCM_REPORT_TOUCH    0x11u
+#define KEBAB_TCM_REPORT_STATUS   0x1bu
+#define KEBAB_TCM_STATUS_OK       0x01u
+
+/* Boot modes (enum boot_mode). */
+#define KEBAB_TCM_MODE_APPLICATION      0x01u
+#define KEBAB_TCM_MODE_HOST_DOWNLOAD    0x02u
+#define KEBAB_TCM_MODE_BOOTLOADER       0x0bu
+#define KEBAB_TCM_MODE_TDDI_BOOTLOADER  0x0cu
+#define KEBAB_TCM_MODE_PRODUCTION_TEST  0x0eu
+
+/* Touch report program codes (enum touch_report_code). */
+#define KEBAB_TCM_TOUCH_END                    0u
+#define KEBAB_TCM_TOUCH_FOREACH_ACTIVE_OBJECT  1u
+#define KEBAB_TCM_TOUCH_FOREACH_OBJECT         2u
+#define KEBAB_TCM_TOUCH_FOREACH_END            3u
+#define KEBAB_TCM_TOUCH_PAD_TO_NEXT_BYTE       4u
+#define KEBAB_TCM_TOUCH_TIMESTAMP              5u
+#define KEBAB_TCM_TOUCH_OBJECT_N_INDEX         6u
+#define KEBAB_TCM_TOUCH_OBJECT_N_CLASSIFICATION 7u
+#define KEBAB_TCM_TOUCH_OBJECT_N_X_POSITION    8u
+#define KEBAB_TCM_TOUCH_OBJECT_N_Y_POSITION    9u
+#define KEBAB_TCM_TOUCH_OBJECT_N_Z             10u
+
+/* Object classification (enum touch_status). */
+#define KEBAB_TCM_CLASS_LIFT         0u
+#define KEBAB_TCM_CLASS_FINGER       1u
+#define KEBAB_TCM_CLASS_GLOVED_FINGER 2u
+
+/* ------------------------------------------------------------- geometry */
+
+#define KEBAB_TCM_PANEL_W          1080
+#define KEBAB_TCM_PANEL_H          2400
+#define KEBAB_TCM_LOGICAL_W        1125
+#define KEBAB_TCM_LOGICAL_H        2436
+#define KEBAB_TCM_LOGICAL_ORIGIN_X 22   /* (1125 - 1080) / 2, truncated */
+#define KEBAB_TCM_LOGICAL_ORIGIN_Y 18   /* (2436 - 2400) / 2 */
+
+/* The two fallbacks the device tree fixes when the app info has no answer. */
+#define KEBAB_TCM_SENSOR_MAX_X     1079
+#define KEBAB_TCM_SENSOR_MAX_Y     2399
+#define KEBAB_TCM_SENSOR_LIMIT     0x0fffu  /* the report field is 12 bits */
+
+/* The device tree's touchpanel,max-num-support. */
+#define KEBAB_TCM_MAX_OBJECTS      10u
+
+/* --------------------------------------------------------------- types */
+
+typedef enum {
+	KEBAB_TCM_OK = 0,
+	KEBAB_TCM_ERR_SHORT,    /* fewer bytes than the header claims */
+	KEBAB_TCM_ERR_MARKER,   /* no 0xa5 where a message should start */
+	KEBAB_TCM_ERR_LENGTH,   /* declared payload length is not plausible */
+	KEBAB_TCM_ERR_PADDING,  /* trailing byte is not 0x5a */
+	KEBAB_TCM_ERR_CODE,     /* message code is not the one expected */
+	KEBAB_TCM_ERR_LAYOUT,   /* payload too short, or a program code not known */
+	KEBAB_TCM_ERR_PROGRAM,  /* report program does not fit the buffer */
+	KEBAB_TCM_ERR_ARGUMENT, /* caller handed in a null or a bad size */
+} kebab_tcm_status;
+
+const char *kebab_tcm_status_name(kebab_tcm_status status);
+
+typedef struct {
+	uint8_t  code;
+	uint16_t payload_len;
+} kebab_tcm_header;
+
+/* The vendor struct syna_tcm_identification, plus what the firmware prepends.
+ *
+ * The measured S3908 payload is 24 bytes with the part number at offset 4, so
+ * version and mode sit at 2 and 3 and two bytes are left over in front of them.
+ * The two bytes are kept and printed rather than interpreted: on a payload that
+ * matches the vendor struct they are simply the version and the mode, and on
+ * this firmware they are not. */
+typedef struct {
+	uint8_t  version;
+	uint8_t  mode;
+	char     part[17];      /* NUL terminated, always */
+	uint32_t build;         /* little endian packrat number, when present */
+	int      build_known;
+	uint32_t prefix_len;    /* bytes in front of the version/mode pair */
+	uint8_t  prefix[8];     /* first eight of them, for the log */
+} kebab_tcm_identify;
+
+/* The vendor struct syna_tcm_app_info: 46 bytes, every field a 16-bit
+ * little-endian value.  The two report sizes are what the report program has to
+ * fit; max_x/max_y are the sensor geometry the transform uses. */
+#define KEBAB_TCM_APP_INFO_SIZE 46u
+typedef struct {
+	uint16_t version;
+	uint16_t status;
+	uint16_t static_config_size;
+	uint16_t dynamic_config_size;
+	uint16_t app_config_start_write_block;
+	uint16_t app_config_size;
+	uint16_t max_touch_report_config_size;
+	uint16_t max_touch_report_payload_size;
+	uint8_t  customer_config_id[16];
+	uint16_t max_x;
+	uint16_t max_y;
+	uint16_t max_objects;
+	uint16_t num_of_buttons;
+	uint16_t num_of_image_rows;
+	uint16_t num_of_image_cols;
+	uint16_t has_hybrid_data;
+} kebab_tcm_app_info;
+
+/* One contact as the report program describes it. */
+typedef struct {
+	uint8_t  index;
+	uint8_t  classification;
+	uint16_t x;
+	uint16_t y;
+	uint8_t  z;             /* pressure proxy: 0..255, 0 when not reported */
+} kebab_tcm_object;
+
+typedef struct {
+	uint32_t objects;
+	uint32_t bits;             /* payload bits consumed by whole contacts */
+	uint32_t payload_bits;
+	uint32_t truncated_bits;   /* tail that could not form another contact */
+	int      truncated_nonzero;
+	kebab_tcm_object object[KEBAB_TCM_MAX_OBJECTS];
+} kebab_tcm_report;
+
+typedef enum {
+	KEBAB_TCM_PHASE_DOWN = 1,
+	KEBAB_TCM_PHASE_MOVE = 2,
+	KEBAB_TCM_PHASE_UP   = 3,
+} kebab_tcm_phase;
+
+typedef struct {
+	uint8_t  phase;         /* kebab_tcm_phase */
+	uint8_t  slot;
+	uint16_t raw_x;
+	uint16_t raw_y;
+	uint8_t  pressure;
+} kebab_tcm_event;
+
+typedef struct {
+	uint16_t active;        /* one bit per contact index, previous report */
+	uint16_t last_x[KEBAB_TCM_MAX_OBJECTS];
+	uint16_t last_y[KEBAB_TCM_MAX_OBJECTS];
+} kebab_tcm_tracker;
+
+typedef struct {
+	int32_t panel_x;
+	int32_t panel_y;
+	int32_t logical_x;
+	int32_t logical_y;
+	int     clamped;
+} kebab_tcm_point;
+
+/* ------------------------------------------------------------- helpers */
+
+static inline uint32_t
+kebab_tcm_le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static inline uint32_t
+kebab_tcm_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* ------------------------------------------------------------- framing */
+
+/*
+ * Validate four bytes as a message header.  A wrong marker and a length that no
+ * message this driver can read would have are both rejected here, before
+ * anything is read for them.
+ */
+kebab_tcm_status kebab_tcm_header_parse(
+    const uint8_t raw[KEBAB_TCM_HEADER_SIZE], kebab_tcm_header *out);
+
+/* Header, payload and padding: 4 + payload_len + 1. */
+uint32_t kebab_tcm_message_bytes(const kebab_tcm_header *header);
+
+/*
+ * Parse one complete message out of a buffer.  buf[0] must be the marker.  On
+ * success *consumed is the whole message including the padding byte, so the
+ * caller can advance.  A trailing byte that is not 0x5a is an error: a stream
+ * without it is one byte out of phase and nothing after it can be trusted.
+ */
+kebab_tcm_status kebab_tcm_message_parse(const uint8_t *buf, uint32_t len,
+    kebab_tcm_header *header, uint32_t *consumed);
+
+/* Offset of the next 0xa5 at or after from, or len when there is none. */
+uint32_t kebab_tcm_find_marker(const uint8_t *buf, uint32_t len, uint32_t from);
+
+/*
+ * Build the bytes of one command: {command, length_lo, length_hi, payload}.
+ * Returns the byte count, or 0 when it does not fit.  This is the write side of
+ * the framing, and the only place the little-endian length is assembled.
+ */
+uint32_t kebab_tcm_build_command(uint8_t *out, uint32_t cap, uint8_t command,
+    const uint8_t *payload, uint32_t len);
+
+/* Is this the answer the caller is waiting for?  Reports arrive with a code
+ * from 0x10 up; command answers carry a status below 0x10. */
+kebab_tcm_status kebab_tcm_expect_report(const kebab_tcm_header *header,
+    uint8_t id);
+kebab_tcm_status kebab_tcm_expect_status(const kebab_tcm_header *header);
+
+/* ------------------------------------------------------- payload layouts */
+
+/*
+ * Decode the identify payload.  The part number is the only field whose offset
+ * is self-evident (printable ASCII), so the decoder anchors on it and takes the
+ * version and mode as the two bytes in front, exactly as the vendor struct
+ * orders them.  Anything before those two is kept as an uninterpreted prefix.
+ */
+kebab_tcm_status kebab_tcm_parse_identify(const uint8_t *payload,
+    uint32_t len, kebab_tcm_identify *out);
+
+/* Decode the 46-byte application info at the vendor struct's offsets. */
+kebab_tcm_status kebab_tcm_parse_app_info(const uint8_t *payload, uint32_t len,
+    kebab_tcm_app_info *out);
+
+/* ------------------------------------------------------- report program */
+
+/*
+ * The program this driver asks the firmware for.  With pressure set the layout
+ * is, per active object:
+ *
+ *   index 4, classification 4, x 12, y 12, z 8   -> 40 bits, five bytes
+ *
+ * and without it the vendor's own default, four bits less z:
+ *
+ *   index 4, classification 4, x 12, y 12        -> 32 bits, four bytes
+ *
+ * Returns the program length, or 0 when cap is too small.
+ */
+#define KEBAB_TCM_PROGRAM_MAX 32u
+uint32_t kebab_tcm_program_build(uint8_t *out, uint32_t cap, int pressure);
+
+/* Bits one object occupies in this program, or 0 when it is not a program this
+ * decoder can walk. */
+uint32_t kebab_tcm_program_object_bits(const uint8_t *program, uint32_t len);
+
+/*
+ * The SET_TOUCH_REPORT_CONFIG payload.  The vendor driver sends
+ * max_touch_report_config_size bytes, not the program length: the buffer is
+ * zero padded and the firmware's program parser stops at TOUCH_END.  When the
+ * application info did not provide a usable size, firmware_max is 0 and the
+ * program alone is returned.  Returns the byte count, or 0 when it does not fit.
+ */
+#define KEBAB_TCM_REPORT_CONFIG_MAX 128u
+uint32_t kebab_tcm_report_payload_build(uint8_t *out, uint32_t cap,
+    const uint8_t *program, uint32_t program_len, uint32_t firmware_max);
+
+/* ------------------------------------------------------------- decoding */
+
+/*
+ * LSB-first bit reader, matching touch_get_report_data(): inside a byte the
+ * first field bit is bit 0, and the first chunk of a multi-byte field is its
+ * least significant byte.  The caller must keep offset + bits inside the
+ * buffer; the decoder below does.
+ */
+uint32_t kebab_tcm_bits(const uint8_t *data, uint32_t offset, uint32_t bits);
+
+/*
+ * Walk the report program over one payload.  Contacts are emitted until the
+ * payload runs out, at most max_objects of them.  A tail too short to hold
+ * another contact is reported in truncated_bits instead of being decoded: a
+ * report cut mid-contact must not turn into a contact at the wrong offset, and
+ * a report that is all fingers up (an empty payload) must stay distinguishable
+ * from a truncated one.
+ */
+kebab_tcm_status kebab_tcm_decode_report(const uint8_t *program,
+    uint32_t program_len, const uint8_t *payload, uint32_t payload_len,
+    uint32_t max_objects, kebab_tcm_report *out);
+
+/* ------------------------------------------------------------- tracking */
+
+/*
+ * Compare one decoded report with the previous one.  A contact that was not
+ * active is a down, one that was is a move, and a slot that was active and is
+ * missing from this report is an up, reported at the last coordinates it had.
+ * The tracker is updated whether or not the caller's event array had room.
+ */
+uint32_t kebab_tcm_track(kebab_tcm_tracker *tracker,
+    const kebab_tcm_report *report, kebab_tcm_event *events,
+    uint32_t max_events);
+
+/* Sensor -> panel -> logical, with the panel-edge clamp.  max_x/max_y are the
+ * largest sensor values the chip advertises; an implausible one falls back to
+ * the device tree's 1079/2399 rather than dividing by it. */
+kebab_tcm_point kebab_tcm_transform(uint32_t raw_x, uint32_t raw_y,
+    uint32_t max_x, uint32_t max_y);
+
+#endif /* KEBAB_TOUCH_TCM_H */
