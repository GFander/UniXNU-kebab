--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -53,6 +53,25 @@
 #define LWOpDone 1
 #define BWOpDone 3
 
+#if defined(KEBAB)
+void kebab_invalidate_physical_icache(addr64_t, unsigned int);
+void
+kebab_invalidate_physical_icache(addr64_t pa, unsigned int length)
+{
+	/* A physical range may cross distinct aperture entries. Preserve the
+	 * original length while translating and invalidating each mapped piece. */
+	while (length) {
+		vm_size_t count=length;
+		if (!isphysmem(pa)) panic("KEBAB XRAM: icache range outside owned RAM");
+		vm_offset_t va=phystokv_range((pmap_paddr_t)pa,&count);
+		if (!count || count>length) panic("KEBAB XRAM: invalid icache aperture span");
+		InvalidatePoU_IcacheRegion(va,(unsigned int)count);
+		pa+=count;
+		length-=(unsigned int)count;
+	}
+}
+#endif
+
