+     (parameters&&(kfk_overlap(parameters,sizeof(*parameters),wrapped,sizeof(*wrapped))||
+     kfk_overlap(parameters,sizeof(*parameters),wrapped->key,96))))return (int)kIOReturnBadArgument;
