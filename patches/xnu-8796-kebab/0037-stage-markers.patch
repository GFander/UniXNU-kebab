--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,73 @@
  *  arg8 - scratch
  *  arg9 - scratch
  */
+
+/*
+ * kebab bring-up post code: one 16x16 white square per completed stage on row
+ * 2380 of the panel, at x = 200, 272, 344, 416. Together with the wide band at
+ * x = 0 the squares tell us how far start.s got when the kernel hangs.
+ */
+.macro KEBAB_STAGE_MARK stage
+#if defined(KEBAB)
+	/* Stage N draws a 60x24 block at x = 100 + N*100 on row 2380. */
+	MOV64	x9, (0x9c000000 + 2280 * 4320 + 100 * 4 + (\stage) * 400)
+	mov	w10, #-1
+	mov	x12, #24
+97:	mov	x11, #60
+96:	str	w10, [x9], #4
+	subs	x11, x11, #1
+	b.ne	96b
+	mov	x13, #(4320 - 240)
+	add	x9, x9, x13
+	subs	x12, x12, #1
+	b.ne	97b
+	dsb	sy
+#endif
+.endm
+
+
+/*
+ * kebab bring-up: draw through the KVA alias of the framebuffer. If this block
+ * appears the TTBR1 mapping is usable and the ret into arm_init should work.
+ */
+.macro KEBAB_KVA_PROBE
+#if defined(KEBAB)
+	/* x=100: V=P block — we reached the hand-off point. */
+	MOV64	x9, (0x9c000000 + 2280 * 4320 + 100 * 4)
+	mov	w10, #-1
+	mov	x12, #24
+93:	mov	x11, #60
+92:	str	w10, [x9], #4
+	subs	x11, x11, #1
+	b.ne	92b
+	mov	x13, #(4320 - 240)
+	add	x9, x9, x13
+	subs	x12, x12, #1
+	b.ne	93b
+	dsb	sy
+
+	/* Touch the stack: SP is a KVA, so this only works if TTBR1 is usable. */
+	sub	sp, sp, #16
+	str	xzr, [sp]
+	ldr	xzr, [sp]
+	add	sp, sp, #16
+
+	/* x=200: the stack round-trip survived, so KVA works. */
+	MOV64	x9, (0x9c000000 + 2280 * 4320 + 200 * 4)
+	mov	w10, #-1
+	mov	x12, #24
+93:	mov	x11, #60
+92:	str	w10, [x9], #4
+	subs	x11, x11, #1
+	b.ne	92b
+	mov	x13, #(4320 - 240)
+	add	x9, x9, x13
+	subs	x12, x12, #1
+	b.ne	93b
+	dsb	sy
+#endif
+.endm
+
 .macro create_bootstrap_mapping
 	/* calculate entries left in this page */
 	and	$5, $0, #(ARM_TT_L2_INDEX_MASK)
