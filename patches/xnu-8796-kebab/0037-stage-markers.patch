+/*
+ * kebab bring-up: a minimal exception vector. If anything faults after this is
+ * installed, the handler paints a red block at row 2300 and spins, which tells
+ * us the fault happened instead of silently hanging.
+ */
+	.align 2
+LEXT(kebab_fault_handler)
+	/*
+	 * Same shape as the entry band, in red. Read the framebuffer address from
+	 * the console variable: once arm_vm_init drops TTBR0 the identity mapping of
+	 * 0x9C000000 is gone, and painting through it would fault again.
+	 */
+	adrp	x9, EXT(early_fb)@page
+	add	x9, x9, EXT(early_fb)@pageoff
+	ldr	x9, [x9]
+	mov	x4, #(2200 * 4320 & 0xffff)
+	movk	x4, #(2200 * 4320 >> 16), lsl #16
+	add	x9, x9, x4
+	mov	w10, #0x000000ff
+	mov	x12, #32
+	mov	x4, #4320
+Lkebab_fault_row:
+	mov	x3, #64
+	mov	x5, x9
+Lkebab_fault_pixel:
+	str	w10, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lkebab_fault_pixel
+	add	x9, x9, x4
+	subs	x12, x12, #1
+	b.ne	Lkebab_fault_row
+	dsb	sy
+82:	wfi
+	b	82b
+
+	.align 11
+LEXT(kebab_vectors)
+	.rept 16
+	b	EXT(kebab_fault_handler)
+	.space 0x7c
+	.endr
