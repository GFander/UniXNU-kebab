+/* PM8150: a read-only RTC counter, with a Data-persisted calendar offset.
+ * Register contract: mainline rtc-pm8xxx.c and pm8150.dtsi (pm8941 layout).
+ * Offset model: upstream ArmDTPlatform/QcomPmicRtc. This is not secure time. */
+static IOLock *krtc_lock;
+static int64_t krtc_offset;
+static bool krtc_initialized;
+extern "C" int kebab_rtc_offset_store(int64_t);
+
+extern "C" int
+kebab_rtc_counter(uint32_t *seconds)
+{
+ if(!seconds)return EINVAL;
+ uint32_t apid=0,raw=0;uint8_t ctrl=0,bytes[4]={},low=0;
+ int error=ENXIO;
+ kebab_spmi_bus_lock();
+ if(kebab_spmi_bus_ready()&&kebab_spmi_reader(0x060,&apid)==0){
+  error=kebab_spmi_obs_read_ex(apid,0,0x6046,kebab_spmi_bus_next_attempt(),false,true,&ctrl);
+  if(!error&&!(ctrl&0x80))error=ENXIO;
+  for(unsigned retry=0;!error&&retry<3;retry++){
+   for(unsigned i=0;i<4&&!error;i++)error=kebab_spmi_obs_read_ex(apid,0,0x6048+i,kebab_spmi_bus_next_attempt(),false,true,&bytes[i]);
+   if(!error)error=kebab_spmi_obs_read_ex(apid,0,0x6048,kebab_spmi_bus_next_attempt(),false,true,&low);
+   if(error||low>=bytes[0])break;
+   if(retry==2)error=EAGAIN;
+  }
+  for(unsigned i=0;i<4;i++)raw|=(uint32_t)bytes[i]<<(8*i);
+ }
+ kebab_spmi_bus_unlock();
+ if(error)return EIO;
+ *seconds=raw;return 0;
+}
+
+void
+KebabPlatformExpert::getUTCTimeOfDay(clock_sec_t *seconds,clock_nsec_t *ns)
+{
+ *seconds=0;*ns=0;
+ if(!krtc_initialized)return;
+ uint32_t counter=0;if(kebab_rtc_counter(&counter))return;
+ IOLockLock(krtc_lock);int64_t wall=(int64_t)counter+krtc_offset;IOLockUnlock(krtc_lock);
+ if(wall>=1577836800LL&&wall<4102444800LL)*seconds=(clock_sec_t)wall;
+}
+
+void
+KebabPlatformExpert::setUTCTimeOfDay(clock_sec_t seconds,clock_nsec_t)
+{
+ if(!krtc_initialized||seconds<1577836800ULL||seconds>=4102444800ULL)return;
+ uint32_t counter=0;if(kebab_rtc_counter(&counter))return;
+ int64_t next=(int64_t)seconds-counter;
+ IOLockLock(krtc_lock);int64_t delta=next-krtc_offset;
+ bool changed=delta>1||delta< -1;if(changed)krtc_offset=next;IOLockUnlock(krtc_lock);
+ /* XNU explicitly permits PESetUTCTimeOfDay to block. Do not hold our state
+  * lock across VFS or modify the read-only PMIC counter. */
+ if(changed){int result=kebab_rtc_offset_store(next);
+  IOLog("KEBAB RTC: calendar set counter=%u offset=%lld persist=%d (no PMIC write)\n",counter,next,result);
+ }
+}
+
+extern "C" int
+kebab_rtc_offset_snapshot(int64_t *offset,uint32_t *counter)
+{
+ if(!krtc_initialized||!offset||!counter)return ENXIO;
+ int error=kebab_rtc_counter(counter);if(error)return error;
+ IOLockLock(krtc_lock);*offset=krtc_offset;IOLockUnlock(krtc_lock);return 0;
+}
+
+extern "C" int
+kebab_rtc_offset_apply(int64_t offset,uint32_t saved)
+{
+ uint32_t counter=0;if(!krtc_initialized||kebab_rtc_counter(&counter))return ENXIO;
+ /* A stopped/reset/wrapped counter needs explicit recalibration. Never turn
+  * a saved delta into a silently wrong date after loss of PMIC power. */
+ int64_t wall=(int64_t)counter+offset;
+ if(counter<saved||wall<1577836800LL||wall>=4102444800LL)return ESTALE;
+ IOLockLock(krtc_lock);krtc_offset=offset;IOLockUnlock(krtc_lock);
+ clock_set_calendar_microtime((clock_sec_t)wall,0);
+ IOLog("KEBAB RTC: restored PM8150 offset=%lld saved-counter=%u counter=%u wall=%lld\n",offset,saved,counter,wall);
+ return 0;
+}
+
+extern "C" void
+kebab_rtc_initialize(void)
+{
+ kebab_spmi_init();
+ uint32_t counter=0;int error=kebab_rtc_counter(&counter);
+ uint64_t epoch=0;PE_parse_boot_argn("kebab_qsee_utc",&epoch,sizeof(epoch));
+ if(error||epoch<1577836800ULL||epoch>=4102444800ULL)panic("KEBAB RTC: PM8150/host calibration unavailable %d",error);
+ krtc_lock=IOLockAlloc();if(!krtc_lock)panic("KEBAB RTC: lock allocation failed");
+ clock_sec_t uptime=0;clock_usec_t us=0;absolutetime_to_microtime(mach_absolute_time(),&uptime,&us);
+ /* Existing fresh owner UTC is an initial development calibration, not a
+  * hardware UTC source. A saved Data offset supersedes it before any RW. */
+ krtc_offset=(int64_t)(epoch+uptime)-counter;krtc_initialized=true;
+ clock_set_calendar_microtime((clock_sec_t)(epoch+uptime),0);
+ IOLog("KEBAB RTC: initial owner-host calibration counter=%u offset=%lld wall=%llu; read-only PM8150, persisted offset takes precedence\n",counter,krtc_offset,epoch+uptime);
+}
