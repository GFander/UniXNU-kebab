+/* Fixed root-owned class-D record on the already qualified encrypted Data.
+ * Two independent 64-byte SHA256 records tolerate a torn replacement. SHA is
+ * a corruption check, not a MAC; authority is normal root-only VFS access.
+ * This does not claim a rollback-resistant or Apple secure clock. */
+#include <kern/clock.h>
+#define KRC_PATH "/private/var/db/hios-rtc-offset-v1"
+struct krc_record {uint8_t magic[8];uint64_t generation;int64_t offset;uint64_t counter;uint8_t digest[32];};
+_Static_assert(sizeof(struct krc_record)==64,"RTC offset record");
+static LCK_MTX_DECLARE(krc_lock,&kcm_group);
+static bool krc_writable;
+extern int kebab_rtc_offset_snapshot(int64_t *,uint32_t *);
+extern int kebab_rtc_offset_apply(int64_t,uint32_t);
+int kebab_rtc_offset_restore(void);
+int kebab_rtc_offset_enable_store(void);
+int kebab_rtc_offset_store(int64_t);
+
+static bool
+krc_valid(const struct krc_record *record)
+{
+ uint8_t digest[32];SHA256_CTX h;SHA256_Init(&h);SHA256_Update(&h,record,32);SHA256_Final(digest,&h);
+ if(memcmp(record->magic,"HRTC01\0\0",8)||!record->generation||record->counter>UINT32_MAX||
+     record->offset< -4294967295LL||record->offset>4102444800LL)return false;
+ int64_t wall=(int64_t)record->counter+record->offset;
+ return wall>=1577836800LL&&wall<4102444800LL&&!memcmp(digest,record->digest,32);
+}
+
+static int
+krc_metadata(vnode_t file)
+{
+ mount_t data=vnode_mount(file);
+ if(!vnode_isreg(file)||data==kcm_system||!(vfs_flags(data)&MNT_CPROTECT)||
+     strcmp(vfs_statfs(data)->f_fstypename,"apfs")||kcm_device(data)!=makedev(1,3))return EAUTH;
+ struct vnode_attr a;VATTR_INIT(&a);VATTR_WANTED(&a,va_uid);VATTR_WANTED(&a,va_gid);VATTR_WANTED(&a,va_mode);
+ VATTR_WANTED(&a,va_flags);VATTR_WANTED(&a,va_nlink);VATTR_WANTED(&a,va_data_size);VATTR_WANTED(&a,va_dataprotect_class);
+ int error=vnode_getattr(file,&a,vfs_context_current());if(error)return error;
+ if(!VATTR_IS_SUPPORTED(&a,va_uid)||!VATTR_IS_SUPPORTED(&a,va_gid)||!VATTR_IS_SUPPORTED(&a,va_mode)||
+     !VATTR_IS_SUPPORTED(&a,va_flags)||!VATTR_IS_SUPPORTED(&a,va_nlink)||!VATTR_IS_SUPPORTED(&a,va_data_size)||
+     !VATTR_IS_SUPPORTED(&a,va_dataprotect_class)||a.va_uid||a.va_gid||(a.va_mode&07777)!=0600||
+     a.va_flags||a.va_nlink!=1||a.va_data_size!=128||a.va_dataprotect_class!=4)return EAUTH;
+ return 0;
+}
+
+static int
+krc_open(vnode_t *file,bool write)
+{
+ vnode_t point=NULLVP;int error=vnode_lookup("/private/var",VNODE_LOOKUP_NOFOLLOW,&point,vfs_context_current());if(error)return error;
+ mount_t data=vnode_mount(point);vnode_put(point);
+ error=kdi_lookup(KRC_PATH,file,data,false);if(error)return error;
+ error=krc_metadata(*file);
+ if(!error&&write&&(vfs_flags(data)&MNT_RDONLY))error=EROFS;
+ if(!error)error=VNOP_OPEN(*file,FREAD|(write?FWRITE:0),vfs_context_current());
+ if(error){vnode_put(*file);*file=NULLVP;}return error;
+}
+
+static int
+krc_read(vnode_t file,struct krc_record records[2],unsigned *latest)
+{
+ int residual=0;int error=vn_rdwr(UIO_READ,file,(caddr_t)records,128,0,UIO_SYSSPACE,IO_NOCACHE,vfs_context_ucred(vfs_context_current()),&residual,NULL);
+ if(error||residual)return error?error:EIO;
+ bool a=krc_valid(&records[0]),b=krc_valid(&records[1]);
+ if(!a&&!b)return EAUTH;
+ if(a&&b&&records[0].generation==records[1].generation&&memcmp(&records[0],&records[1],64))return EAUTH;
+ *latest=b&&(!a||records[1].generation>records[0].generation)?1:0;return 0;
+}
+
+static void
+krc_make(struct krc_record *record,uint64_t generation,int64_t offset,uint32_t counter)
+{
+ bzero(record,sizeof(*record));memcpy(record->magic,"HRTC01\0\0",8);record->generation=generation;record->offset=offset;record->counter=counter;
+ SHA256_CTX h;SHA256_Init(&h);SHA256_Update(&h,record,32);SHA256_Final(record->digest,&h);
+}
+
+int
+kebab_rtc_offset_restore(void)
+{
+ lck_mtx_lock(&krc_lock);vnode_t file=NULLVP;struct krc_record records[2];unsigned latest=0;
+ int error=krc_open(&file,false);
+ if(error==ENOENT){printf("KEBAB RTC: no saved Data offset; initial host calibration retained, first provisioning pending\n");error=0;}
+ else if(!error){error=krc_read(file,records,&latest);if(!error)error=kebab_rtc_offset_apply(records[latest].offset,(uint32_t)records[latest].counter);}
+ if(file){int closed=VNOP_CLOSE(file,FREAD,vfs_context_current());vnode_put(file);if(!error)error=closed;}
+ bzero(records,sizeof(records));lck_mtx_unlock(&krc_lock);return error;
+}
+
+int
+kebab_rtc_offset_store(int64_t offset)
+{
+ lck_mtx_lock(&krc_lock);if(!krc_writable){lck_mtx_unlock(&krc_lock);return EROFS;}
+ int64_t active=0;uint32_t counter=0;int error=kebab_rtc_offset_snapshot(&active,&counter);
+ if(!error&&active!=offset)error=EAGAIN;
+ vnode_t file=NULLVP;struct krc_record records[2];unsigned latest=0;
+ if(!error)error=krc_open(&file,true);
+ if(!error)error=krc_read(file,records,&latest);
+ bool changed=!error&&records[latest].offset!=offset;
+ if(changed){
+  if(records[latest].generation==UINT64_MAX)error=EOVERFLOW;
+  if(!error){unsigned target=latest^1;krc_make(&records[target],records[latest].generation+1,offset,counter);int residual=0;
+   error=vn_rdwr(UIO_WRITE,file,(caddr_t)&records[target],64,target*64,UIO_SYSSPACE,IO_SYNC|IO_NOCACHE,vfs_context_ucred(vfs_context_current()),&residual,NULL);
+   if(!error&&residual)error=EIO;if(!error)error=VNOP_FSYNC(file,MNT_WAIT,vfs_context_current());
+   if(!error)error=kebab_ufs_sync();
+  }
+ }
+ if(file){int closed=VNOP_CLOSE(file,FREAD|FWRITE,vfs_context_current());vnode_put(file);if(!error)error=closed;}
+ if(!error&&changed)printf("KEBAB RTC: changed offset durable counter=%u offset=%lld\n",counter,offset);
+ bzero(records,sizeof(records));lck_mtx_unlock(&krc_lock);return error;
+}
+
+int
+kebab_rtc_offset_enable_store(void)
+{
+ lck_mtx_lock(&krc_lock);vnode_t file=NULLVP;int error=krc_open(&file,true);bool created=false;
+ if(error==ENOENT){
+  error=kdi_new(KRC_PATH,&file);created=!error;
+  int64_t offset=0;uint32_t counter=0;struct krc_record records[2]={};
+  if(!error)error=kebab_rtc_offset_snapshot(&offset,&counter);
+  if(!error){krc_make(&records[0],1,offset,counter);krc_make(&records[1],2,offset,counter);int residual=0;
+   if(kcm_device(vnode_mount(file))!=makedev(1,3)||(vfs_flags(vnode_mount(file))&MNT_RDONLY))error=EAUTH;
+   if(!error)error=vn_rdwr(UIO_WRITE,file,(caddr_t)records,128,0,UIO_SYSSPACE,IO_SYNC|IO_NOCACHE,vfs_context_ucred(vfs_context_current()),&residual,NULL);
+   if(!error&&residual)error=EIO;if(!error)error=VNOP_FSYNC(file,MNT_WAIT,vfs_context_current());
+   if(!error)error=VFS_SYNC(vnode_mount(file),MNT_WAIT,vfs_context_current());if(!error)error=kebab_ufs_sync();
+  }
+  bzero(records,sizeof(records));
+ }
+ if(file){if(!error)error=krc_metadata(file);int closed=created?vnode_close(file,FREAD|FWRITE,vfs_context_current()):VNOP_CLOSE(file,FREAD|FWRITE,vfs_context_current());if(!created)vnode_put(file);if(!error)error=closed;}
+ if(!error)krc_writable=true;lck_mtx_unlock(&krc_lock);
+ printf("KEBAB RTC: encrypted Data offset %s error=%d; 128B classD root0600, PMIC counter untouched\n",created?"durably initialized":"reused",error);return error;
+}
