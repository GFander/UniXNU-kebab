+/* Shared validation and call serialization for the built-in iOS16 clients. */
+#ifndef _KEBAB_USER_CLIENT_CONTRACT_H
+#define _KEBAB_USER_CLIENT_CONTRACT_H
+
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOLocks.h>
+
+struct KebabUserClientMethod {
+	uint32_t selector;
+	uint32_t minimumInput;
+	uint32_t minimumOutput;
+};
+
+/* Keep accepted trailing scalars and variable-size structure replies. The
+ * per-selector handlers retain their existing wire-layout/size checks. */
+static inline IOReturn
+kebab_user_client_validate(uint32_t selector, IOExternalMethodArguments *args,
+    const KebabUserClientMethod *methods, size_t count)
+{
+	if (args == NULL ||
+	    args->scalarInputCount > kIOExternalMethodScalarInputCountMax ||
+	    args->scalarOutputCount > kIOExternalMethodScalarOutputCountMax ||
+	    (args->scalarInputCount != 0 && args->scalarInput == NULL) ||
+	    (args->scalarOutputCount != 0 && args->scalarOutput == NULL) ||
+	    (args->structureInputDescriptor == NULL &&
+	    args->structureInputSize != 0 && args->structureInput == NULL) ||
+	    (args->structureOutputDescriptor == NULL &&
+	    args->structureOutputSize != 0 && args->structureOutput == NULL) ||
+	    (args->structureInputDescriptor != NULL &&
+	    args->structureInputDescriptor->getLength() > UINT32_MAX) ||
+	    (args->structureOutputDescriptor != NULL &&
+	    args->structureOutputDescriptor->getLength() > UINT32_MAX)) {
+		return kIOReturnBadArgument;
+	}
+	for (size_t i = 0; i < count; i++) {
+		if (methods[i].selector == selector) {
+			return args->scalarInputCount >= methods[i].minimumInput &&
+			       args->scalarOutputCount >= methods[i].minimumOutput ?
+			       kIOReturnSuccess : kIOReturnBadArgument;
+		}
+	}
+	return kIOReturnUnsupported;
+}
+
+/* Client methods and close share this gate, independently of provider locks.
+ * In particular, a close cannot destroy a Surface mapping while it is returned. */
+class KebabUserClientCall {
+	IOLock *fLock;
+public:
+	explicit KebabUserClientCall(IOLock *lock) : fLock(lock) { IOLockLock(fLock); }
+	~KebabUserClientCall() { IOLockUnlock(fLock); }
+	KebabUserClientCall(const KebabUserClientCall &) = delete;
+	KebabUserClientCall &operator=(const KebabUserClientCall &) = delete;
+};
+
+#endif /* _KEBAB_USER_CLIENT_CONTRACT_H */
