+
+/* The work-loop gate excludes a timer already in flight. No provider/client
+ * lock is held while waiting for it, and waiters keep their state until free. */
+void
+AppleCLCD::stopEvents()
+{
+	if (fWorkLoop != NULL) {
+		fWorkLoop->runAction(&AppleCLCD::stopEventsAction, this);
+	} else {
+		stopEventsAction(this, NULL, NULL, NULL, NULL);
+	}
+}
+
+IOReturn
+AppleCLCD::stopEventsAction(OSObject *owner, void *, void *, void *, void *)
+{
+	AppleCLCD *fb = static_cast<AppleCLCD *>(owner);
+	if (fb->fLock != NULL) {
+		IOLockLock(fb->fLock);
+	}
+	fb->fStopping = true;
+	fb->fPendingValid = false;
+	if (fb->fLock != NULL) {
+		IOLockWakeup(fb->fLock, &fb->fCompletedID, false);
+		IOLockUnlock(fb->fLock);
+	}
+	if (fb->fVsync != NULL) {
+		fb->fVsync->cancelTimeout();
+		if (fb->fVsyncAdded) {
+			fb->fWorkLoop->removeEventSource(fb->fVsync);
+			fb->fVsyncAdded = false;
+		}
+	}
+	return kIOReturnSuccess;
+}
+
+void
+AppleCLCD::releaseResources()
+{
+	stopEvents();
+	OSSafeReleaseNULL(fVsync);
+	OSSafeReleaseNULL(fWorkLoop);
+	OSArray *clients = fClients;
+	fClients = NULL;
+	OSSafeReleaseNULL(clients);
+	OSSafeReleaseNULL(fMap);
+	if (fSurface != NULL) {
+		kebab_surface_release_physical(fSurface);
+		fSurface = NULL;
+	}
+	fPixels = 0;
+	if (fLock != NULL) {
+		if (fConsolePaused) {
+			kebab_console_muted = 0;
+			fConsolePaused = false;
+		}
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+}
+
+void
+AppleCLCD::stop(IOService *provider)
+{
+	stopEvents();
+	IOMobileFramebuffer::stop(provider);
+}
+
+void
+AppleCLCD::free()
+{
+	releaseResources();
+	IOMobileFramebuffer::free();
+}
 
