+enum {KGB_OTA_HFI_CM3_FAULT=0x8000};
+enum {KGB_BW_REQUIRE_QUALIFIED=0,KGB_BW_RETAIN_INHERITED_NO_WRITE=1};
+enum {KGB_GCC=0,KGB_CC=1,KGB_GMU=2,KGB_RSCC=3};
+typedef struct {
+ void *cookie;
