+ if(!e)e=kagb_pins_locked();KGUnlock(&kagb_domain);return e;
+}
+extern "C" int kebab_a650_gmu_tcm_begin(KebabA650GmuBackingToken *token,KebabA650GmuTcmManifest *out)
+{
