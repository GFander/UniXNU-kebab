+ int (*mark_started)(void *);
+ /* Concrete mapper opens the two finite TCM/CSR windows only after clocks. */
+ int (*open_gmu)(void *);
+ int (*source_check)(void *);
+ int (*tcm_word)(void *,uint32_t,uint32_t *,uint32_t *);
