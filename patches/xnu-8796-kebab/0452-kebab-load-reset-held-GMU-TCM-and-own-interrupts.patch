+   if((e=KebabGmuBootRaw(c,2,off,&actual))){c->r->failed_word=i;return e;}
+   if(actual!=value){c->r->failed_word=i;return 11;}c->r->tcm_verified_words++;read_crc=KebabGmuBootCrcWord(read_crc,actual);
