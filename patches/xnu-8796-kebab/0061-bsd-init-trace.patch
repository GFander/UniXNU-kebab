--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -490,7 +490,13 @@
 	platform_stall_panic_or_spin(PLATFORM_STALL_XNU_LOCATION_BSD_INIT);
 #endif
 
+#if defined(KEBAB)
+/* Panic reports arrive through the panel console, so the bsd_init trace is
+ * worth its output on this port. */
+#define DEBUG_BSDINIT 1
+#else
 #define DEBUG_BSDINIT 0
+#endif
 
 #if DEBUG_BSDINIT
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
@@ -498,6 +504,7 @@
 #define bsd_init_kprintf(x, ...)
 #endif
 
+	printf("KEBAB BSD: boot-args = \"%s\"\n", PE_boot_args());
 	throttle_init();
 
 	printf(copyright);
@@ -728,6 +735,13 @@
 	bsd_init_kprintf("calling aio_init\n");
 	aio_init();
 
+#if defined(KEBAB)
+	/* Register the built-in libpthread provider before the shims are used. */
+	{
+		extern void kebab_pthread_bringup(void);
+		kebab_pthread_bringup();
+	}
+#endif
 	pthread_init();
 	/* POSIX Shm and Sem */
 	bsd_init_kprintf("calling pshm_cache_init\n");
@@ -884,7 +898,16 @@
 			/*NOTREACHED*/
 		}
 #endif
-		printf("cannot mount root, errno = %d\n", err);
+		printf("cannot mount root, errno = %d, rootdevice \"%s\"\n",
+		    err, rootdevice);
+#if defined(KEBAB)
+		/*
+		 * Retrying in a tight loop only buries the first attempt's output,
+		 * which is the diagnostic we actually need. Stop here instead.
+		 */
+		panic("KEBAB: cannot mount root, errno = %d, rootdevice \"%s\", args \"%s\"",
+		    err, rootdevice, PE_boot_args());
+#endif
 	}
 
 	IOSecureBSDRoot(rootdevice);
