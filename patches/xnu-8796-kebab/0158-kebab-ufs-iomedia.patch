+    virtual IOReturn	setWriteCacheState(bool enabled);
+
+    /*!
+     * @function doAsyncReadWrite
+     * @abstract
+     * Start an asynchronous read or write operation.
+     * @param buffer
+     * An IOMemoryDescriptor describing the data-transfer buffer. The data direction
