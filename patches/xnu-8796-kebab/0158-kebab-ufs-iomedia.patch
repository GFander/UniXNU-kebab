+     */
+    virtual IOReturn	getWriteCacheState(bool *enabled);
+
+    /*!
+     * @function setWriteCacheState
+     * @abstract
+     * Sets the write cache state of the device.
+     * @discussion
+     * Sets the write cache state of the device.  The write cache state
