 }
 
+uint32_t
+kebab_ufs_block_size(void)
+{
+	uint32_t bytes = 0;
+
+	lck_mtx_lock(&kebab_ufs_lock);
+	if (su.ready) {
+		bytes = UFS_BLOCK;
+	}
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return bytes;
+}
+
 bool
 kebab_ufs_writable(void)
 {
@@ -1101,6 +1119,16 @@ kebab_ufs_rootdev(dev_t *dev)
 		*dev = su.bdev;
 	}
 	lck_mtx_unlock(&kebab_ufs_lock);
+#if defined(KEBAB_BLOCKSTORAGE)
+	if (!error) {
+		/*
+		 * Publish the IOKit view of the same partition for APFS.  This is
+		 * gated by boot-arg ufsmedia=1 and never fails the boot; the lock
+		 * above must not be held because the callback reads the geometry.
+		 */
+		kebab_blockstorage_start();
+	}
+#endif
 	return error;
 }
