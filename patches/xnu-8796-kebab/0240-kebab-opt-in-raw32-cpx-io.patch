+/* Opt-in raw32 AES128-XTS path. Never interpret SEP/composite/raw ciphertext. */
+struct KebabBlockCrypto {
+ uint8_t key[32];
+ UInt64 unit;
+ bool active;
+ KebabBlockCrypto() : unit(0), active(false) { bzero(key,sizeof(key)); }
+ ~KebabBlockCrypto() {
+  volatile uint8_t *bytes=key;
+  for(unsigned i=0;i<sizeof(key);++i)bytes[i]=0;
+  unit=0;active=false;
+ }
+};
+
+static IOReturn
+kebab_block_crypto_prepare(const IOStorageAttributes *attributes, UInt64 length,
+    bool enabled, KebabBlockCrypto &crypto)
+{
+ if(!attributes || !attributes->bufattr)return kIOReturnSuccess;
+ bufattr_t attr=attributes->bufattr;
+ if(bufattr_rawencrypted(attr))return kIOReturnUnsupported;
+ cpx_t cpx=bufattr_cpx(attr);
+ if(!cpx)return kIOReturnSuccess;
+ if(!enabled || cpx_is_sep_wrapped_key(cpx) || cpx_is_composite_key(cpx) ||
+     cpx_synthetic_offset_for_iv(cpx) || !cpx_use_offset_for_iv(cpx) ||
+     cpx_key_len(cpx)!=32 || cpx_max_key_len(cpx)<32 || !cpx_key(cpx))
+  return kIOReturnUnsupported;
+ UInt64 base=bufattr_cpoff(attr);
+ if(!length || (length&4095) || base>UINT64_MAX-attributes->adjustedOffset)
+  return kIOReturnBadArgument;
+ base+=attributes->adjustedOffset;
+ if((base&4095) || length-1>UINT64_MAX-base)return kIOReturnBadArgument;
+ /* Copy before any backend operation. The original CPX/attributes are never
+  * retained across I/O or completion; this bridge executes synchronously. */
+ memcpy(crypto.key,cpx_key(cpx),32);crypto.unit=base>>12;crypto.active=true;
+ return kIOReturnSuccess;
+}
