+   error=result==kIOReturnSuccess?0:EIO;
+   if(!error)memcpy(plain,buffer->getBytesNoCopy(),4096);
+  } else error=result==kIOReturnSuccess?EAUTH:EIO;
+ }
+ if(attr){bufattr_setcpx(attr,NULL);bufattr_free(attr);}
+ if(cpx){cpx_flush(cpx);cpx_free(cpx);}
+ if(buffer){bzero(buffer->getBytesNoCopy(),4096);buffer->release();}
+ return error;
+}
