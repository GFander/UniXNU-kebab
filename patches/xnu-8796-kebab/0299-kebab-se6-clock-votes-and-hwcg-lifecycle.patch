+  * mode clk-branch.c intentionally does not wait for its CLK_OFF bit:
+  * the bus ungates on demand. Do not apply this exception to SE6. */
+ if((slave&KBH_CLOCK_OFF)&&!(slave&(1u<<1)))return false;
+ return true;
+}
