+static bool
+kbh_clocks_running(uint32_t vote,uint32_t master,uint32_t slave,uint32_t serial)
+{
+ if((vote&KBH_REQUIRED_VOTES)!=KBH_REQUIRED_VOTES)return false;
+ if((master|serial)&KBH_CLOCK_OFF)return false;
