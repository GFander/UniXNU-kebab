+/* Bounded first-frame storage diagnosis: ranges only, no pixels or addresses.
+ * Caller holds validated mappings. This observes raw producer storage and
+ * does not infer or silently change its declared pixel format. */
+static void
+ksc_report_storage(const struct ksc_image *im,const uint8_t *base,const char *role)
+{
+    if(im->format!=KPF_W40A)return;
+    uint16_t minimum[4]={65535,65535,65535,65535},maximum[4]={};uint64_t low_bits=0;
+    for(uint32_t y=0;y<im->height;y++)for(uint32_t x=0;x<im->width;x++) {
+        const uint8_t *pixel=base+im->offset+(uint64_t)y*im->stride+(uint64_t)x*8;
+        for(unsigned ch=0;ch<4;ch++) {
+            uint16_t word=kpf_word(pixel+ch*2);
+            if(word<minimum[ch])minimum[ch]=word;if(word>maximum[ch])maximum[ch]=word;
+            if(word&63)low_bits++;
+        }
+    }
+    IOLog("KEBAB SCALER STORAGE: %s declared=w40a raw-min=%04x,%04x,%04x,%04x raw-max=%04x,%04x,%04x,%04x low-six-nonzero=%llu; best-effort ranges, not producer-format inference\n",
+        role,minimum[0],minimum[1],minimum[2],minimum[3],maximum[0],maximum[1],maximum[2],maximum[3],low_bits);
 }
