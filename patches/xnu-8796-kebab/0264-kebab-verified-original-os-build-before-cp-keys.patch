+extern int kernel_sysctlbyname(const char *,void *,size_t *,void *,size_t);
+int
+kebab_cryptex_system_version_prepare(void)
+{
+ static const uint8_t expected[32]={0x52,0x6d,0xe9,0xe2,0x6c,0x80,0xf9,0x3f,0xae,0x30,0x89,0x72,0x5f,0x9e,0x24,0xcf,
