+ char build[]="20H392";
+ int error=kebab_cryptex_mount_recheck();
+ if(!error)error=kcm_verify_boot_file("/System/Library/CoreServices/SystemVersion.plist",574,expected);
+ if(!error&&osversion[0]&&strcmp(osversion,build))error=EAUTH;
+ if(!error&&!osversion[0])error=kernel_sysctlbyname("kern.osversion",NULL,NULL,build,sizeof(build));
+ if(!error&&(strcmp(osversion,build)||cp_os_version()!=0x14480188u))error=EAUTH;
+ printf("KEBAB DATA VERSION: verified SystemVersion20H392 -> original kern.osversion/CP version14480188 %s (%d)\n",error?"FAIL":"PASS",error);
+ return error;
+}
