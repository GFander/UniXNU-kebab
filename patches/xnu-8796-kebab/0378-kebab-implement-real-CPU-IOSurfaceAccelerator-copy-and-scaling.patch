+/* Original iOS16 IOSurfaceAccelerator API, explicitly backed by CPU pixels.
+ * Matching-family names express a wire ABI, not an Apple hardware device. */
+#include <pexpert/arm64/board_config.h>
+#if defined(KEBAB)
+#include "KebabSurface.h"
+#include "KebabUserClientContract.h"
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <sys/proc.h>
+#include <sys/kauth.h>
+#include <kern/task.h>
+#include "KebabScalerCore.h"
+extern "C" int kebab_scaler_start(IOService *provider);
+
+class AppleM2ScalerCSCDriver : public IOService {
+    OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver,IOService);
+class KebabSoftwareScaler : public AppleM2ScalerCSCDriver {
+    OSDeclareDefaultStructors(KebabSoftwareScaler);
+public:
+    bool start(IOService *) APPLE_KEXT_OVERRIDE;
+    IOReturn newUserClient(task_t,void *,UInt32,OSDictionary *,IOUserClient **) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(KebabSoftwareScaler,AppleM2ScalerCSCDriver);
+
+static bool
+ksc_authorized(task_t task)
+{
+    static const uint8_t uuid[16]={0x70,0xb7,0x23,0x40,0x73,0x7a,0x39,0x73,0x8b,0x47,0x4e,0x99,0x70,0xf4,0xec,0xb9};
+    if(task==TASK_NULL || task!=current_task())return false;
+    proc_t p=current_proc();uint8_t actual[16]={};
+    if(p==NULL || proc_task(p)!=task || kauth_cred_getuid(proc_ucred(p))!=501)return false;
+    proc_getexecutableuuid(p,actual,sizeof(actual));
+    return !memcmp(actual,uuid,sizeof(uuid));
+}
+
+class IOSurfaceAcceleratorClient : public IOUserClient {
+    OSDeclareDefaultStructors(IOSurfaceAcceleratorClient);
+    IOLock *fLock;
+    task_t fTask;
+    mach_port_t fPort;
+    bool fClosed;
+    uint64_t fCompleted;
+    void closeConnection();
+    IOReturn transform(const uint8_t *,size_t);
+public:
+    bool initWithTask(task_t,void *,UInt32) APPLE_KEXT_OVERRIDE;
+    IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+    void stop(IOService *) APPLE_KEXT_OVERRIDE;
+    void free() APPLE_KEXT_OVERRIDE;
+    IOReturn registerNotificationPort(mach_port_t,UInt32,io_user_reference_t) APPLE_KEXT_OVERRIDE;
+    IOReturn externalMethod(uint32_t,IOExternalMethodArguments *,IOExternalMethodDispatch *,OSObject *,void *) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IOSurfaceAcceleratorClient,IOUserClient);
+
+bool
+KebabSoftwareScaler::start(IOService *provider)
+{
+    if(!AppleM2ScalerCSCDriver::start(provider))return false;
+    setName("KebabSoftwareScaler");
+    setProperty("KebabBackend","CPU BGRA8 bilinear/nearest, iOS16 IOSurfaceAccelerator ABI");
+    setProperty("KebabHardwareAccelerated",kOSBooleanFalse);
+    OSDictionary *caps=OSDictionary::withCapacity(12);
+    if(!caps){AppleM2ScalerCSCDriver::stop(provider);return false;}
+    const char *names[]={"MinSourceWidth","MinSourceHeight","MinDestWidth","MinDestHeight",
+        "MaxSourceWidth","MaxSourceHeight","MaxDestWidth","MaxDestHeight"};
+    bool valid=true;
+    for(unsigned i=0;i<8;i++) {
+        char key[96];snprintf(key,sizeof(key),"IOSurfaceAcceleratorCapabilities%s",names[i]);
+        OSNumber *n=OSNumber::withNumber(i<4?1:KSC_MAX_DIM,32);
+        if(!n){valid=false;break;}valid=caps->setObject(key,n)&&valid;n->release();
+    }
+    if(valid)valid=setProperty("IOSurfaceAcceleratorCapabilitiesDict",caps);
+    caps->release();
+    if(!valid){AppleM2ScalerCSCDriver::stop(provider);return false;}
+    IOLog("KEBAB SCALER: CPU linear BGRA8 copy/scale registered, no GPU/compressed/HDR capability\n");
+    registerService();return true;
+}
+IOReturn
+KebabSoftwareScaler::newUserClient(task_t task,void *security,UInt32 type,OSDictionary *,IOUserClient **out)
+{
+    if(!out)return kIOReturnBadArgument;*out=NULL;
+    if(type || isInactive())return kIOReturnUnsupported;
+    if(!ksc_authorized(task))return kIOReturnNotPermitted;
+    IOSurfaceAcceleratorClient *c=new IOSurfaceAcceleratorClient;
+    if(!c)return kIOReturnNoMemory;
+    if(!c->initWithTask(task,security,type) || !c->attach(this)){c->release();return kIOReturnError;}
+    if(!c->start(this)){c->detach(this);c->release();return kIOReturnError;}
+    *out=c;IOLog("KEBAB SCALER: original backboardd CPU client opened\n");return kIOReturnSuccess;
+}
+bool
+IOSurfaceAcceleratorClient::initWithTask(task_t task,void *security,UInt32 type)
+{
+    if(!IOUserClient::initWithTask(task,security,type))return false;
+    fTask=task;fPort=MACH_PORT_NULL;fClosed=false;fCompleted=0;fLock=IOLockAlloc();return fLock!=NULL;
+}
+void
+IOSurfaceAcceleratorClient::closeConnection()
+{
+    if(!fLock)return;
+    KebabUserClientCall call(fLock);
+    if(fClosed)return;fClosed=true;
+    if(fPort!=MACH_PORT_NULL){releaseNotificationPort(fPort);fPort=MACH_PORT_NULL;}
+}
+IOReturn IOSurfaceAcceleratorClient::clientClose(){closeConnection();terminate();return kIOReturnSuccess;}
+void IOSurfaceAcceleratorClient::stop(IOService *p){closeConnection();IOUserClient::stop(p);}
+void IOSurfaceAcceleratorClient::free(){closeConnection();if(fLock){IOLockFree(fLock);fLock=NULL;}IOUserClient::free();}
+IOReturn
+IOSurfaceAcceleratorClient::registerNotificationPort(mach_port_t port,UInt32 type,io_user_reference_t refcon)
+{
+    KebabUserClientCall call(fLock);
+    if(fClosed || isInactive())return kIOReturnNoDevice;
+    if(!ksc_authorized(fTask))return kIOReturnNotPermitted;
+    if(type || refcon)return kIOReturnBadArgument;
+    mach_port_t old=fPort;fPort=port;
+    if(old!=MACH_PORT_NULL)releaseNotificationPort(old);
+    return kIOReturnSuccess;
+}
+static struct ksc_image
+ksc_description(KebabSurface *s)
+{
+    return {s->width,s->height,s->bytesPerRow,s->pixelFormat,s->offset,s->allocSize,s->planeCount,
+        s->bytesPerElement,s->elementWidth,s->elementHeight,s->memory?s->memory->getLength():0};
+}
+IOReturn
+IOSurfaceAcceleratorClient::transform(const uint8_t *q,size_t size)
+{
+    if(size!=KSC_REQUEST_BYTES)return kIOReturnBadArgument;
+    KebabSurface *s=kebab_surface_copy(ksc_u32(q)),*d=kebab_surface_copy(ksc_u32(q+4));
+    IOMemoryMap *sm=NULL,*dm=NULL;IOReturn ret=kIOReturnNotFound;
+    struct ksc_plan plan={};struct ksc_image si={},di={};
+    if(!s || !d)goto done;
+    si=ksc_description(s);di=ksc_description(d);
+    {int err=ksc_prepare(q,size,&si,&di,&plan);
+    if(err){ret=err==KSC_UNSUPPORTED?kIOReturnUnsupported:kIOReturnBadArgument;goto done;}}
+    /* Both global IDs are only exposed to the exact original compositor task;
+     * normal IOServiceOpen and per-method MACF/filter checks still run. */
+    if(!s->memory || !d->memory || s->memory==d->memory || s->parentID || d->parentID){ret=kIOReturnUnsupported;goto done;}
+    if(plan.callback && !(plan.flags&0x400) && fPort==MACH_PORT_NULL){ret=kIOReturnNotReady;goto done;}
+    sm=s->memory->createMappingInTask(kernel_task,0,kIOMapAnywhere|kIOMapReadOnly|s->mapCache);
+    dm=d->memory->createMappingInTask(kernel_task,0,kIOMapAnywhere|d->mapCache);
+    if(!sm || !dm || !sm->getVirtualAddress() || !dm->getVirtualAddress() ||
+        sm->getLength()<si.memory_length || dm->getLength()<di.memory_length){ret=kIOReturnVMError;goto done;}
+    OSMemoryBarrier();
+    ksc_run(&plan,&si,&di,(const uint8_t *)(uintptr_t)sm->getVirtualAddress(),(uint8_t *)(uintptr_t)dm->getVirtualAddress());
+    OSMemoryBarrier();
+    kebab_surface_did_write(d);
+    ret=kIOReturnSuccess;
+    if(plan.callback && !(plan.flags&0x400)) {
+        OSAsyncReference64 ref={};io_user_reference_t arg=plan.argument;
+        setAsyncReference64(ref,fPort,plan.callback,plan.refcon,fTask);
+        /* One bounded completion message after the real CPU write, never a
+         * timer-based fabricated GPU completion. A full queue is an error. */
+        ret=sendAsyncResult64WithOptions(ref,kIOReturnSuccess,&arg,1,kIOUserNotifyOptionCanDrop);
+    }
+    if(ret==kIOReturnSuccess)fCompleted++;
+done:
+    if(fCompleted<4 || ret!=kIOReturnSuccess || !(fCompleted%120))
+        IOLog("KEBAB SCALER: transfer source=%u destination=%u flags=0x%llx src=%ux%u dst=%ux%u result=0x%x completed=%llu\n",
+            ksc_u32(q),ksc_u32(q+4),ksc_u64(q+0x20),s?s->width:0,s?s->height:0,d?d->width:0,d?d->height:0,ret,fCompleted);
+    OSSafeReleaseNULL(dm);OSSafeReleaseNULL(sm);OSSafeReleaseNULL(d);OSSafeReleaseNULL(s);return ret;
+}
+IOReturn
+IOSurfaceAcceleratorClient::externalMethod(uint32_t selector,IOExternalMethodArguments *a,
+    IOExternalMethodDispatch *,OSObject *,void *)
+{
+    KebabUserClientCall call(fLock);
+    if(fClosed || isInactive())return kIOReturnNoDevice;
+    if(!ksc_authorized(fTask))return kIOReturnNotPermitted;
+    if(!a || a->scalarInputCount || a->scalarOutputCount || a->structureOutputSize ||
+        a->structureOutputDescriptor || a->asyncReferenceCount)return kIOReturnBadArgument;
+    /* Closed and deliberately narrow selector contract: unsupported filters,
+     * counters, swap/fill and hardware controls never receive fake success. */
+    if(selector==2) {
+        if(a->structureInputDescriptor || a->structureInputSize)return kIOReturnBadArgument;
+        return kIOReturnSuccess; /* Calls are synchronous; no pending DMA to abort. */
+    }
+    if(selector!=1){IOLog("KEBAB SCALER: unsupported selector=%u input=%u\n",selector,a->structureInputSize);return kIOReturnUnsupported;}
+    if(a->structureInputDescriptor || !a->structureInput || a->structureInputSize!=KSC_REQUEST_BYTES)return kIOReturnBadArgument;
+    return transform((const uint8_t *)a->structureInput,a->structureInputSize);
+}
+extern "C" int
+kebab_scaler_start(IOService *provider)
+{
+    KebabSoftwareScaler *service=new KebabSoftwareScaler;
+    if(!service)return 0;
+    if(!service->init() || !service->attach(provider)){service->release();return 0;}
+    if(!service->start(provider)){service->detach(provider);service->release();return 0;}
+    service->release();return 1;
+}
+#endif
