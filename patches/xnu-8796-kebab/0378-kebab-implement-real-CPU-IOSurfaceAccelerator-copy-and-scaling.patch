+/* CPU implementation of the pinned iOS16 IOSurfaceAccelerator linear subset.
+ * No GPU, compressed-surface decoder, color converter or hardware fence. */
+#ifndef _KEBAB_SCALER_CORE_H
+#define _KEBAB_SCALER_CORE_H
+
+#define KSC_REQUEST_BYTES 0x170u
+#define KSC_MAX_DIM 4096u
+#define KSC_BGRA 0x42475241u
+enum ksc_result { KSC_OK, KSC_ARGUMENT, KSC_UNSUPPORTED, KSC_BOUNDS };
+struct ksc_image {
+    uint32_t width, height, stride, format, offset, allocation, planes;
+    uint16_t bpe;
+    uint8_t element_width, element_height;
+    uint64_t memory_length;
+};
+struct ksc_plan {
+    uint32_t source, destination, dx, dy, dw, dh;
+    uint64_t sx, sy, sw, sh, callback, refcon, argument, flags;
+};
+static uint32_t ksc_u32(const uint8_t *p) { uint32_t v; memcpy(&v,p,4); return v; }
+static uint64_t ksc_u64(const uint8_t *p) { uint64_t v; memcpy(&v,p,8); return v; }
+static int
+ksc_extent(const struct ksc_image *im)
+{
+    if (!im || !im->width || !im->height || im->width>KSC_MAX_DIM || im->height>KSC_MAX_DIM)
+        return KSC_ARGUMENT;
+    if (im->format!=KSC_BGRA || im->bpe!=4 || im->element_width!=1 || im->element_height!=1 || im->planes)
+        return KSC_UNSUPPORTED;
+    uint64_t n=(uint64_t)(im->height-1)*im->stride+(uint64_t)im->width*4;
+    if (im->stride<(uint64_t)im->width*4 || im->offset>im->allocation ||
+        n>im->allocation-im->offset || im->offset>im->memory_length || n>im->memory_length-im->offset)
+        return KSC_BOUNDS;
+    return KSC_OK;
+}
+static int
+ksc_prepare(const uint8_t *q, size_t n, const struct ksc_image *s,
+    const struct ksc_image *d, struct ksc_plan *out)
+{
+    if (!q || n!=KSC_REQUEST_BYTES || !out) return KSC_ARGUMENT;
+    struct ksc_plan p={};
+    p.source=ksc_u32(q);p.destination=ksc_u32(q+4);
+    p.callback=ksc_u64(q+8);p.refcon=ksc_u64(q+0x10);p.argument=ksc_u64(q+0x18);p.flags=ksc_u64(q+0x20);
+    if (!p.source || !p.destination || p.source==p.destination) return KSC_ARGUMENT;
+    /* Transform=identity, DitherControl=0/1 (no quantization for BGRA8),
+     * nearest or ordinary bilinear, SkipAsyncCallback. Other flags require
+     * an actual implementation before accepting them. */
+    if (p.flags & ~UINT64_C(0x3480)) return KSC_UNSUPPORTED;
+    if ((p.flags & 0x6000)>0x2000) return KSC_UNSUPPORTED;
+    for (size_t i=0x48;i<0x58;i++) if(q[i]) return KSC_UNSUPPORTED;
+    for (size_t i=0x68;i<n;i++) if(q[i]) return KSC_UNSUPPORTED;
+    int err=ksc_extent(s);if(err)return err;err=ksc_extent(d);if(err)return err;
+    p.sx=ksc_u64(q+0x28);p.sy=ksc_u64(q+0x30);p.sw=ksc_u64(q+0x38);p.sh=ksc_u64(q+0x40);
+    p.dx=ksc_u32(q+0x58);p.dy=ksc_u32(q+0x5c);p.dw=ksc_u32(q+0x60);p.dh=ksc_u32(q+0x64);
+    if (!(p.sx|p.sy|p.sw|p.sh)) { p.sw=(uint64_t)s->width<<16;p.sh=(uint64_t)s->height<<16; }
+    if (!(p.dx|p.dy|p.dw|p.dh)) { p.dw=d->width;p.dh=d->height; }
+    uint64_t sxmax=(uint64_t)s->width<<16,symax=(uint64_t)s->height<<16;
+    if (!p.sw || !p.sh || p.sx>=sxmax || p.sy>=symax || p.sw>sxmax-p.sx || p.sh>symax-p.sy ||
+        !p.dw || !p.dh || p.dx>=d->width || p.dy>=d->height || p.dw>d->width-p.dx || p.dh>d->height-p.dy)
+        return KSC_BOUNDS;
+    *out=p;return KSC_OK;
+}
+/* Pixel-center sampling, clamp to the requested source ROI and image bounds.
+ * Integer arithmetic only: callable with the kernel FP/SIMD context disabled. */
+static uint64_t
+ksc_coordinate(uint64_t origin, uint64_t span, uint32_t position, uint32_t count)
+{
+    uint64_t center=origin+((uint64_t)(2*position+1)*span)/(2*count);
+    uint64_t lo=origin,hi=span>=65536?origin+span-65536:origin;
+    uint64_t x=center>=32768?center-32768:0;
+    if(x<lo)x=lo;
+    if(x>hi)x=hi;
+    return x;
+}
+static void
+ksc_run(const struct ksc_plan *p,const struct ksc_image *s,const struct ksc_image *d,
+    const uint8_t *source,uint8_t *destination)
+{
+    /* The wrapper retains both surfaces and independent CPU mappings, rejects
+     * aliasing and validates every byte extent before entering this function. */
+    for(uint32_t y=0;y<p->dh;y++) {
+        uint64_t fy=ksc_coordinate(p->sy,p->sh,y,p->dh);
+        uint32_t y0=(uint32_t)(fy>>16),y1=y0+1<s->height?y0+1:y0,wy=(uint32_t)fy&65535;
+        if(p->flags&0x80){y0=(uint32_t)((fy+32768)>>16);if(y0>=s->height)y0=s->height-1;y1=y0;wy=0;}
+        uint8_t *row=destination+d->offset+(uint64_t)(p->dy+y)*d->stride+(uint64_t)p->dx*4;
+        for(uint32_t x=0;x<p->dw;x++) {
+            uint64_t fx=ksc_coordinate(p->sx,p->sw,x,p->dw);
+            uint32_t x0=(uint32_t)(fx>>16),x1=x0+1<s->width?x0+1:x0,wx=(uint32_t)fx&65535;
+            if(p->flags&0x80){x0=(uint32_t)((fx+32768)>>16);if(x0>=s->width)x0=s->width-1;x1=x0;wx=0;}
+            const uint8_t *a=source+s->offset+(uint64_t)y0*s->stride+(uint64_t)x0*4;
+            const uint8_t *b=source+s->offset+(uint64_t)y0*s->stride+(uint64_t)x1*4;
+            const uint8_t *c=source+s->offset+(uint64_t)y1*s->stride+(uint64_t)x0*4;
+            const uint8_t *e=source+s->offset+(uint64_t)y1*s->stride+(uint64_t)x1*4;
+            for(unsigned ch=0;ch<4;ch++) {
+                uint64_t top=(uint64_t)a[ch]*(65536-wx)+(uint64_t)b[ch]*wx;
+                uint64_t bottom=(uint64_t)c[ch]*(65536-wx)+(uint64_t)e[ch]*wx;
+                row[4*x+ch]=(uint8_t)((top*(65536-wy)+bottom*wy+UINT64_C(0x80000000))>>32);
+            }
+        }
+    }
+}
+#endif
