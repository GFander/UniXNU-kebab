+static int KGValidOps(const KGOps *o)
+{
+ return o && o->worker && o->acquire && o->check && o->quiesce && o->end && o->map &&
+  o->unmap && o->read32 && o->read64 && o->write32 && o->write64 && o->barrier &&
+  o->delay && o->alloc && o->pin_check && o->clean_poc && o->free_pool;
