+ if(__atomic_exchange_n(&kebab_rpmh_global_lock.busy,1,__ATOMIC_ACQ_REL))return 16;
+ if(!KFPolicyBound(&KebabGpuFirstNativePolicy) || !KebabGpuFirstColdBootContract || kebab_gpu_cold_quarantined)goto done;
