+ if(!(p&KG_WRITE))a|=0x80;
+ if(!(p&KG_EXEC))a|=0x0060000000000000ULL;
+ return a;
+}
+static uint64_t *KGChild(KGPool *p,uint64_t e)
+{
+ uint64_t a=e&KG_PTE_PA;
