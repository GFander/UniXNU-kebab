+  e=d->ops.clean_poc(d->ops.cookie,&d->pool[i]);if(e)return KGFinish(d,e);
+ }
+ d->ops.barrier(d->ops.cookie);
+ e=KGDiscoverLocked(d,&d->work);if(e)return KGFinish(d,e);
+ e=KGRouteCheck(&d->work,&d->lease,1);if(e)return KGFinish(d,e);
