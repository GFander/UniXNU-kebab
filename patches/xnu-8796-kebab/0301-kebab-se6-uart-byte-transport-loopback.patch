+ KBU_SET(KBU_GCC,0x17738,(root[1]&0xffff0000u)|384u);
+ KBU_SET(KBU_GCC,0x1773c,(root[2]&0xffff0000u)|0xc476u);
+ KBU_SET(KBU_GCC,0x17740,(root[3]&0xffff0000u)|0xc2f6u);
+ KBU_SET(KBU_GCC,0x17734,(root[0]&~0x10371fu)|0x102601u);
