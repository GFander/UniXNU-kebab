+ (void)ctx;vm_offset_t addr;int e=kbu_native_address(space,off,true,&addr);if(e)return e;
+ __asm__ volatile("dsb sy" ::: "memory");*(volatile uint32_t *)addr=v;
+ __asm__ volatile("dsb sy" ::: "memory");return 0;
