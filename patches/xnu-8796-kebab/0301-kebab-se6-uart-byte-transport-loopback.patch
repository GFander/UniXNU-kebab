+static int
+kbu_native_read(void *ctx,enum kbu_space space,uint32_t off,uint32_t *v)
+{
+ (void)ctx;if(!v)return EINVAL;vm_offset_t addr;int e=kbu_native_address(space,off,false,&addr);if(e)return e;
+ __asm__ volatile("dsb sy" ::: "memory");*v=*(volatile uint32_t *)addr;
+ __asm__ volatile("dsb sy" ::: "memory");return 0;
