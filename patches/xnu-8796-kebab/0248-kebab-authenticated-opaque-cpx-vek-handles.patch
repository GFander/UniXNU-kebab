+{
+ if(!kfk_ready || !g_crypto_funcs || !g_crypto_funcs->ccsha256_di ||
+    !g_crypto_funcs->cchmac_fn)return (int)kIOReturnNotReady;
+ static const uint8_t domain[]="UniXNU.kebab.cpx-VEK-handle.v1";
