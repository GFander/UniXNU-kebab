diff --git a/bsd/dev/kebab_usb.c b/bsd/dev/kebab_usb.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/kebab_usb.c
@@ -0,0 +1,811 @@
+/*
+ * KEBAB USB: DWC3 device mode with a CDC-ACM interface, and a kernel log pipe.
+ *
+ * The bootloader leaves the Synopsys DWC3 powered, clocked, in device mode and
+ * halted, with the PHY configured, so only the device controller is restarted:
+ * reset, event buffer, endpoint 0, then run with device-event enables. Events
+ * are polled from a kernel thread - no interrupt - like the UFS driver. DMA is
+ * not cache coherent, so buffers are handed over with explicit cache
+ * maintenance.
+ *
+ * The class is CDC-ACM so the host just sees a serial port: kernel log text is
+ * streamed out of the bulk IN endpoint, and anything the host writes to the
+ * bulk OUT endpoint is echoed to the kernel console.
+ *
+ * Physical endpoint numbering follows DWC3: ep = 2 * usb_number + direction,
+ * even is OUT, odd is IN. Endpoint 0 is physical 0 (OUT) and 1 (IN).
+ *
+ * Off unless boot-arg kebabusb=1 is given.
+ */
+#if defined(KEBAB)
+
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <os/atomic_private.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+
+#include <arm/machine_routines.h>
+
+/* Declared in arm/machine_routines.h, behind a guard this build does not
+ * satisfy; the negroni port spells it out for the same reason. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* ---------------------------------------------------------------- registers */
+
+#define GCTL            0xc110
+#define GEVTEN          0xc114
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+/* DCFG: bits 2:0 device speed (0 = high speed), bits 9:3 device address */
+#define DCFG_SPEED_MASK (0x7u << 0)
+#define DCFG_ADDR_MASK  (0x7fu << 3)
+#define DCFG_ADDR(a)    (((uint32_t)(a) << 3) & DCFG_ADDR_MASK)
+
+/* DEVTEN: disconnect, connect done, reset */
+#define DEVTEN_DEVICE   0x7u
+
+#define DEPCMD_SETEPCONFIG       1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL          4
+#define DEPCMD_CLEARSTALL        5
+#define DEPCMD_STARTTRANSFER     6
+#define DEPCMD_DEPSTARTCFG       9
+#define DEPCMD_CMDACT            (1u << 10)
+
+/* SetEndpointConfig parameters: type in 2:1, packet size in 13:3, FIFO in 21:17;
+ * transfer-complete in 8, transfer-not-ready in 10, endpoint number in 29:26 and
+ * direction in 25 of the second parameter. */
+#define DEPCFG_PARAM0(type, maxpkt, fifo) \
+	(((uint32_t)(type) << 1) | ((uint32_t)(maxpkt) << 3) | ((uint32_t)(fifo) << 17))
+#define DEPCFG_PARAM1(ep) \
+	((1u << 8) | (1u << 10) | (((uint32_t)(ep)) << 25))
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_NORMAL   (1u << 4)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+#define EP_TYPE_CONTROL 0
+#define EP_TYPE_BULK    2
+#define EP_TYPE_INTR    3
+
+/* Port facts: DWC3 at 0x0A600000, Qualcomm QSCRATCH above it. */
+#define DWC3_PA        0x0a600000
+#define DWC3_SIZE      0x0000d000
+#define QSCRATCH_PA    0x0a6f8800
+#define QSCRATCH_HS    0x10    /* HS_PHY_CTRL */
+#define QSCRATCH_SS    0x30    /* SS_PHY_CTRL */
+#define UTMI_OTG_VBUS_VALID  (1u << 20)
+#define SW_SESSVLD_SEL       (1u << 28)
+#define LANE0_PWR_PRESENT    (1u << 24)
+
+/* ------------------------------------------------------------- DMA layout */
+
+/*
+ * One 4 KiB page is physically contiguous, which is all the controller needs.
+ * Every object the controller writes on its own gets its own cache line, so a
+ * clean of one never writes back stale bytes over another.
+ */
+#define UD_SIZE        4096
+#define UD_EVT         0x0000      /* 1 KiB event buffer */
+#define UD_EVT_SIZE    1024
+#define UD_TRB_OUT     0x0400
+#define UD_TRB_IN      0x0440
+#define UD_TRB_NOTIFY  0x0480
+#define UD_TRB_BULKIN  0x04c0
+#define UD_TRB_BULKOUT 0x0500
+#define UD_SETUP       0x0580
+#define UD_DATA        0x0600      /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY      0x0800
+#define UD_BULKIN      0x0900      /* 512 bytes */
+#define UD_BULKOUT     0x0b00      /* 512 bytes */
+
+/* physical endpoints: ep = 2 * usb_number + direction */
+#define EP0_OUT        0
+#define EP0_IN         1
+#define EP_NOTIFY      5           /* usb 2, IN  -> descriptor 0x82 */
+#define EP_BULK_OUT    2           /* usb 1, OUT -> descriptor 0x01 */
+#define EP_BULK_IN     3           /* usb 1, IN  -> descriptor 0x81 */
+#define EP_MASK        ((1u << EP0_OUT) | (1u << EP0_IN) | (1u << EP_NOTIFY) | \
+    (1u << EP_BULK_OUT) | (1u << EP_BULK_IN))
+
+/* --------------------------------------------------------------- state */
+
+#define LOG_RING_SIZE  16384
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t qs;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	uint32_t    events;
+	int         state;
+	bool        data_in;
+	bool        configured;
+	bool        running;
+	bool        bulk_in_busy;
+	uint32_t    tx_bytes;
+	lck_grp_t  *lock_grp;
+	lck_mtx_t  *lock;
+	uint32_t    log_head;
+	uint32_t    log_tail;
+	uint32_t    log_busy;
+	char        log_ring[LOG_RING_SIZE];
+} ud;
+
+enum { EP0_SETUP, EP0_DATA, EP0_STATUS };
+
+/* --------------------------------------------------------------- helpers */
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(ud.dwc + off);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return v;
+}
+
+static inline vm_size_t
+ud_cache_line(void)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	return (vm_size_t)4 << ((ctr >> 16) & 0xf);
+}
+
+/* hand memory to the device: clean + invalidate */
+static void
+ud_to_dev(uint32_t off, uint32_t len)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	vm_size_t line = ud_cache_line();
+	for (vm_offset_t va = (ud.dma + off) & ~(line - 1);
+	    va < ud.dma + off + len; va += line) {
+		__asm__ volatile ("dc civac, %0" :: "r"(va) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* take memory back from the device: invalidate */
+static void
+ud_from_dev(uint32_t off, uint32_t len)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	vm_size_t line = ud_cache_line();
+	for (vm_offset_t va = (ud.dma + off) & ~(line - 1);
+	    va < ud.dma + off + len; va += line) {
+		__asm__ volatile ("dc ivac, %0" :: "r"(va) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	delay(ms * 1000);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("KEBAB USB: ep%u cmd 0x%x status %u\n", ep, cmd, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("KEBAB USB: ep%u cmd 0x%x timeout\n", ep, cmd);
+	return -1;
+}
+
+/* submit one TRB; returns the endpoint command result */
+static int
+ud_start(uint32_t trb_off, unsigned ep, uint32_t buf_off, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb_off);
+	uint64_t bpa = ud.dma_pa + buf_off;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_to_dev(trb_off, 16);
+	if (len && (ctl == TRBCTL_DATA || ctl == TRBCTL_NORMAL)) {
+		ud_to_dev(buf_off, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb_off;
+	return ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(UD_TRB_OUT, EP0_OUT, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_ep_stall(unsigned ep)
+{
+	ud_epcmd(ep, DEPCMD_SETSTALL, 0, 0, 0);
+	if (ep == EP0_OUT) {
+		ud_start_setup();
+	}
+}
+
+/* ----------------------------------------------------------- descriptors */
+
+/* VID 0x1209 / PID 0x0001 is the pid.codes test pool, not a product. */
+static const uint8_t ud_dev_desc[] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+
+/*
+ * One configuration, two interfaces, 67 bytes:
+ *   CDC control: interrupt IN 0x82 (physical 5)
+ *   CDC data:    bulk OUT 0x01 (physical 2), bulk IN 0x81 (physical 3)
+ */
+static const uint8_t ud_cfg_desc[] = {
+	/* configuration: 2 interfaces, 500 mA, bus powered */
+	9, 2, 67, 0, 2, 1, 0, 0x80, 250,
+	/* interface 0: CDC control */
+	9, 4, 0, 0, 1, 0x02, 0x02, 0x01, 0,
+	/* header functional: CDC 1.10 */
+	5, 0x24, 0x00, 0x10, 0x01,
+	/* call management: no data class interface, no device call mgmt */
+	5, 0x24, 0x01, 0x00, 0x01,
+	/* abstract control management: line coding + control line state */
+	4, 0x24, 0x02, 0x02,
+	/* union: control interface 0, data interface 1 */
+	5, 0x24, 0x06, 0x00, 0x01,
+	/* notification endpoint: interrupt IN, 8 bytes, 32 ms at high speed */
+	7, 5, 0x82, 0x03, 8, 0, 9,
+	/* interface 1: CDC data */
+	9, 4, 1, 0, 2, 0x0a, 0x00, 0x00, 0,
+	/* bulk OUT */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,
+	/* bulk IN */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,
+};
+
+static const char *const ud_strings[] = {
+	NULL, "OnePlus 8T", "UniXNU kebab console", "0001",
+};
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0]) || ud_strings[idx] == NULL) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+/* --------------------------------------------------------- endpoint setup */
+
+static int
+ud_ep_config(unsigned ep, uint32_t type, uint32_t maxpkt)
+{
+	bool in = (ep & 1) != 0;
+	uint32_t fifo = in ? (ep >> 1) : 0;
+	uint32_t p0 = DEPCFG_PARAM0(type, maxpkt, fifo);
+	uint32_t p1 = DEPCFG_PARAM1(ep);
+
+	if (ud_epcmd(ep, DEPCMD_SETEPCONFIG, p0, p1, 0)) {
+		return -1;
+	}
+	return ud_epcmd(ep, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+}
+
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	/* reset non-control resource allocation, keeping endpoint 0 */
+	ud_epcmd(EP0_OUT, DEPCMD_DEPSTARTCFG, 0, 0, 0);
+
+	if (ud_ep_config(EP_NOTIFY, EP_TYPE_INTR, 8) ||
+	    ud_ep_config(EP_BULK_OUT, EP_TYPE_BULK, 512) ||
+	    ud_ep_config(EP_BULK_IN, EP_TYPE_BULK, 512)) {
+		printf("KEBAB USB: endpoint configuration failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | EP_MASK);
+	ud.configured = true;
+	printf("KEBAB USB: configured, notify=%u bulk_out=%u bulk_in=%u\n",
+	    EP_NOTIFY, EP_BULK_OUT, EP_BULK_IN);
+	ud_to_dev(UD_BULKOUT, 512);
+	ud_start(UD_TRB_BULKOUT, EP_BULK_OUT, UD_BULKOUT, 512, TRBCTL_NORMAL);
+}
+
+/* ------------------------------------------------------------- log ring */
+
+/*
+ * The console hook can run from interrupt context, where taking a mutex would
+ * assert. This is a bounded, non-blocking handoff: whoever cannot take the flag
+ * drops its bytes instead of waiting.
+ */
+void
+kebab_usb_log(const char *buf, size_t len)
+{
+	uint32_t expected = 0;
+
+	if (!ud.running) {
+		return;
+	}
+	if (!os_atomic_cmpxchg(&ud.log_busy, expected, 1u, acquire)) {
+		return;
+	}
+	for (size_t i = 0; i < len; i++) {
+		uint32_t next = (ud.log_head + 1) % LOG_RING_SIZE;
+		if (next == ud.log_tail) {
+			break;
+		}
+		ud.log_ring[ud.log_head] = buf[i];
+		ud.log_head = next;
+	}
+	os_atomic_store(&ud.log_busy, 0u, release);
+}
+
+static uint32_t
+ud_log_take(char *out, uint32_t max)
+{
+	uint32_t n = 0;
+	uint32_t expected = 0;
+
+	if (!os_atomic_cmpxchg(&ud.log_busy, expected, 1u, acquire)) {
+		return 0;
+	}
+	while (n < max && ud.log_tail != ud.log_head) {
+		out[n++] = ud.log_ring[ud.log_tail];
+		ud.log_tail = (ud.log_tail + 1) % LOG_RING_SIZE;
+	}
+	os_atomic_store(&ud.log_busy, 0u, release);
+	return n;
+}
+
+/* ------------------------------------------------------- control requests */
+
+/*
+ * A request with no data stage acknowledges with a two-stage status (IN). When a
+ * data stage happened, the status goes the other way: STATUS3 after an IN data
+ * stage means OUT, STATUS2 after an OUT data stage means IN.
+ */
+static void
+ud_status_stage(bool had_data_stage)
+{
+	ud.state = EP0_STATUS;
+	if (!had_data_stage) {
+		ud_start(UD_TRB_IN, EP0_IN, UD_DATA, 0, TRBCTL_STATUS2);
+	} else if (ud.data_in) {
+		ud_start(UD_TRB_OUT, EP0_OUT, UD_DATA, 0, TRBCTL_STATUS3);
+	} else {
+		ud_start(UD_TRB_IN, EP0_IN, UD_DATA, 0, TRBCTL_STATUS2);
+	}
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | (st[3] << 8));
+	uint16_t length = (uint16_t)(st[6] | (st[7] << 8));
+	uint32_t n = 0;
+	bool ok = true, had_data_stage = false;
+
+	ud.data_in = (type & 0x80) != 0;
+
+	if ((type & 0x60) == 0x20) {                    /* class */
+		switch (req) {
+		case 0x20:                              /* SET_LINE_CODING, 7 bytes OUT */
+			ok = (length == 7);
+			had_data_stage = ok;
+			break;
+		case 0x21:                              /* GET_LINE_CODING, 7 bytes IN */
+			memset(data, 0, 7);
+			data[0] = 0x80; data[1] = 0x25; data[2] = 0;   /* 9600 baud */
+			n = 7;
+			break;
+		case 0x22:                              /* SET_CONTROL_LINE_STATE */
+			break;
+		default:
+			ok = false;
+			break;
+		}
+	} else if ((type & 0x60) != 0) {                /* vendor */
+		ok = false;
+	} else {
+		switch (req) {
+		case 5:                                 /* SET_ADDRESS */
+			if (value > 127) {
+				ok = false;
+			} else {
+				dwc_wr(DCFG, (dwc_rd(DCFG) & ~DCFG_ADDR_MASK) | DCFG_ADDR(value));
+			}
+			break;
+		case 6:                                 /* GET_DESCRIPTOR */
+			switch (value >> 8) {
+			case 1:
+				memcpy(data, ud_dev_desc, sizeof(ud_dev_desc));
+				n = sizeof(ud_dev_desc);
+				break;
+			case 2:
+				memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc));
+				n = sizeof(ud_cfg_desc);
+				break;
+			case 3:
+				n = ud_string(value & 0xff, data);
+				if (n == 0) {
+					ok = false;
+				}
+				break;
+			default:
+				ok = false;
+				break;
+			}
+			break;
+		case 8:                                 /* GET_CONFIGURATION */
+			data[0] = ud.configured ? 1 : 0;
+			n = 1;
+			break;
+		case 9:                                 /* SET_CONFIGURATION */
+			if (value == 1) {
+				ud_configure();
+			} else if (value != 0) {
+				ok = false;
+			}
+			break;
+		case 10:                                /* GET_INTERFACE */
+			data[0] = 0;
+			n = 1;
+			break;
+		case 11:                                /* SET_INTERFACE */
+			if (value > 1) {
+				ok = false;
+			}
+			break;
+		case 0:                                 /* GET_STATUS */
+			data[0] = 0; data[1] = 0;
+			n = 2;
+			break;
+		case 1:                                 /* CLEAR_FEATURE */
+		case 3:                                 /* SET_FEATURE */
+			break;
+		default:
+			ok = false;
+			break;
+		}
+	}
+
+	if (!ok) {
+		printf("KEBAB USB: unsupported request %02x/%02x len %u\n", type, req, length);
+		ud_ep_stall(EP0_OUT);
+		return;
+	}
+	if (ud.data_in && n > 0) {
+		uint32_t chunk = (length < n) ? length : n;
+		ud.state = EP0_DATA;
+		ud_start(UD_TRB_IN, EP0_IN, UD_DATA, chunk, TRBCTL_DATA);
+		return;
+	}
+	ud_status_stage(had_data_stage);
+}
+
+/* ---------------------------------------------------------------- events */
+
+static void
+ud_bulk_out_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_BULKOUT);
+	char *buf = (char *)(ud.dma + UD_BULKOUT);
+
+	ud_from_dev(UD_TRB_BULKOUT, 16);
+	uint32_t left = t[2] & 0x00ffffff;
+	uint32_t received = (left < 512) ? 512 - left : 0;
+	ud_from_dev(UD_BULKOUT, 512);
+	if (received > 0) {
+		char tmp[64];
+		uint32_t show = (received < sizeof(tmp) - 1) ? received : sizeof(tmp) - 1;
+		memcpy(tmp, buf, show);
+		tmp[show] = 0;
+		printf("KEBAB USB: host said %s\n", tmp);
+	}
+	t[3] = 0;
+	ud_to_dev(UD_TRB_BULKOUT, 16);
+	ud_to_dev(UD_BULKOUT, 512);
+	ud_start(UD_TRB_BULKOUT, EP_BULK_OUT, UD_BULKOUT, 512, TRBCTL_NORMAL);
+}
+
+static void
+ud_bulk_in_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_BULKIN);
+	ud_from_dev(UD_TRB_BULKIN, 16);
+	t[3] = 0;                        /* clear HWO so a new transfer can start */
+	ud_to_dev(UD_TRB_BULKIN, 16);
+	ud.bulk_in_busy = false;
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                           /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {                /* reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~DCFG_ADDR_MASK);
+			dwc_wr(DALEPENA, (1u << EP0_OUT) | (1u << EP0_IN));
+			ud.configured = false;
+			ud.bulk_in_busy = false;
+			printf("KEBAB USB: bus reset\n");
+			ud_start_setup();
+		} else if (type == 2) {         /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			uint32_t maxpkt = 64;
+			char desc[24];
+			desc[0] = 18;               /* keep the descriptor in step */
+			desc[7] = (char)maxpkt;
+			ud_epcmd(EP0_OUT, DEPCMD_SETEPCONFIG,
+			    DEPCFG_PARAM0(EP_TYPE_CONTROL, maxpkt, 0) | (2u << 30),
+			    DEPCFG_PARAM1(EP0_OUT), 0);
+			ud_epcmd(EP0_IN, DEPCMD_SETEPCONFIG,
+			    DEPCFG_PARAM0(EP_TYPE_CONTROL, maxpkt, 0) | (2u << 30),
+			    DEPCFG_PARAM1(EP0_IN), 0);
+			printf("KEBAB USB: connected, speed %u, ep0 packet %u\n", speed, maxpkt);
+		} else if (type == 0) {         /* disconnect */
+			ud.configured = false;
+			ud.bulk_in_busy = false;
+			printf("KEBAB USB: disconnect\n");
+		}
+		return;
+	}
+
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+
+	if (ep == EP_BULK_OUT && type == 1) {
+		if (ud.configured) {
+			ud_bulk_out_done();
+		}
+		return;
+	}
+	if (ep == EP_BULK_IN && type == 1) {
+		ud_bulk_in_done();
+		return;
+	}
+	if (ep != EP0_OUT && ep != EP0_IN) {
+		return;
+	}
+
+	if (type == 1) {                        /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_from_dev(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud_status_stage(true);
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		}
+	}
+}
+
+/* ----------------------------------------------------------------- thread */
+
+static void
+ud_pump_log(void)
+{
+	uint32_t n;
+
+	if (!ud.configured || ud.bulk_in_busy) {
+		return;
+	}
+	n = ud_log_take((char *)(ud.dma + UD_BULKIN), 512);
+	if (n == 0) {
+		return;
+	}
+	if (ud_start(UD_TRB_BULKIN, EP_BULK_IN, UD_BULKIN, n, TRBCTL_NORMAL) == 0) {
+		ud.bulk_in_busy = true;
+		ud.tx_bytes += n;
+	}
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_from_dev(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 40) {
+					printf("KEBAB USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		ud_pump_log();
+		ud_sleep_ms(2);
+	}
+}
+
+/* ------------------------------------------------------------------ start */
+
+void
+kebab_usb_start(void)
+{
+	uint32_t enabled = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("kebabusb", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	ud.dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (ud.dwc == 0) {
+		printf("KEBAB USB: cannot map the controller\n");
+		return;
+	}
+	ud.qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (kmem_alloc(kernel_map, &ud.dma, UD_SIZE, KMA_NONE, VM_KERN_MEMORY_NONE) != KERN_SUCCESS) {
+		printf("KEBAB USB: no DMA memory\n");
+		return;
+	}
+	ud.dma_pa = (uint64_t)ml_vtophys(ud.dma);
+	if (ud.dma_pa == 0) {
+		printf("KEBAB USB: DMA page has no physical backing\n");
+		return;
+	}
+	bzero((void *)ud.dma, UD_SIZE);
+	/* hand the whole arena to the device once, before anything else uses it */
+	ud_to_dev(0, UD_SIZE);
+
+	ud.lock_grp = lck_grp_alloc_init("kebabusb", LCK_GRP_ATTR_NULL);
+	if (ud.lock_grp == NULL) {
+		printf("KEBAB USB: no lock group\n");
+		return;
+	}
+	ud.lock = lck_mtx_alloc_init(ud.lock_grp, LCK_ATTR_NULL);
+	if (ud.lock == NULL) {
+		printf("KEBAB USB: no lock\n");
+		return;
+	}
+
+	dwc_wr(DEVTEN, DEVTEN_DEVICE);
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("KEBAB USB: reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x GSNPSID 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i,
+	    dwc_rd(GCTL), dwc_rd(DCFG), dwc_rd(0xc120));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+	/* high speed, address 0 */
+	dwc_wr(DCFG, dwc_rd(DCFG) & ~(DCFG_SPEED_MASK | DCFG_ADDR_MASK));
+	dwc_wr(DEVTEN, DEVTEN_DEVICE);
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);      /* bit 31 masks the interrupt */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+	printf("KEBAB USB: event buffer at 0x%llx\n", (unsigned long long)(ud.dma_pa + UD_EVT));
+
+	if (ud_epcmd(EP0_OUT, DEPCMD_SETEPCONFIG, DEPCFG_PARAM0(EP_TYPE_CONTROL, 512, 0),
+	    DEPCFG_PARAM1(EP0_OUT), 0) ||
+	    ud_epcmd(EP0_OUT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP0_IN, DEPCMD_SETEPCONFIG, DEPCFG_PARAM0(EP_TYPE_CONTROL, 512, 0),
+	    DEPCFG_PARAM1(EP0_IN), 0) ||
+	    ud_epcmd(EP0_IN, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("KEBAB USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, (1u << EP0_OUT) | (1u << EP0_IN));
+	ud_start_setup();
+
+	/* tell the controller VBUS is present; the board does not wire OTG here */
+	if (ud.qs != 0) {
+		uint32_t hs = *(volatile uint32_t *)(ud.qs + QSCRATCH_HS);
+		uint32_t ss = *(volatile uint32_t *)(ud.qs + QSCRATCH_SS);
+		*(volatile uint32_t *)(ud.qs + QSCRATCH_HS) =
+		    hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(ud.qs + QSCRATCH_SS) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("KEBAB USB: VBUS override, HS 0x%08x -> 0x%08x, SS 0x%08x -> 0x%08x\n",
+		    hs, *(volatile uint32_t *)(ud.qs + QSCRATCH_HS),
+		    ss, *(volatile uint32_t *)(ud.qs + QSCRATCH_SS));
+	} else {
+		printf("KEBAB USB: QSCRATCH not mapped, no VBUS override\n");
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	if (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) {
+		printf("KEBAB USB: controller did not start (DSTS 0x%08x)\n", dwc_rd(DSTS));
+		return;
+	}
+	printf("KEBAB USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n",
+	    dwc_rd(DSTS), i, (unsigned long long)ud.dma_pa);
+
+	if (kernel_thread_start((thread_continue_t)ud_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("KEBAB USB: no event thread, halting\n");
+		dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+		return;
+	}
+	thread_deallocate(thread);
+	ud.running = true;
+	printf("KEBAB USB: event thread started, waiting for the host\n");
+}
+
+#endif /* KEBAB */
