diff --git a/bsd/dev/kebab_usb.c b/bsd/dev/kebab_usb.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/kebab_usb.c
@@ -0,0 +1,664 @@
+/*
+ * KEBAB USB: DWC3 device mode with a CDC-ACM interface, and a kernel log pipe.
+ *
+ * The bootloader leaves the Synopsys DWC3 powered, clocked, in device mode and
+ * halted, with the PHY set up, so only the device controller is restarted: soft
+ * reset, an event buffer in our memory, endpoint 0, run. Events are polled from
+ * a kernel thread - no interrupt - like the UFS driver on this port. DMA is not
+ * cache coherent, so buffers are cleaned and invalidated around every transfer.
+ *
+ * The class is CDC-ACM so the host just sees /dev/ttyACM0: kernel log text is
+ * streamed out of the bulk IN endpoint, and anything the host writes to the
+ * bulk OUT endpoint is echoed to the kernel console.
+ *
+ * Off unless boot-arg kebabusb=1 is given, so a broken controller cannot affect
+ * a normal boot.
+ */
+#if defined(KEBAB)
+
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <os/atomic_private.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+
+#include <arm/machine_routines.h>   /* ml_io_map */
+#include <arm/pmap.h>                 /* kvtophys */
+
+/* ---------------------------------------------------------------- registers */
+
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG       1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL          4
+#define DEPCMD_CLEARSTALL        5
+#define DEPCMD_STARTTRANSFER     6
+#define DEPCMD_DEPSTARTCFG       9
+#define DEPCMD_CMDACT            (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* endpoint types, in the DEPCFG parameter */
+#define EP_TYPE_CONTROL   0
+#define EP_TYPE_BULK      2
+#define EP_TYPE_INTR      3
+
+/* Port facts (kebab device tree): DWC3 at 0x0A600000, USB2 PHY just below. */
+#define DWC3_PA        0x0a600000
+#define DWC3_SIZE      0x0000d000
+#define QUSB2_PA       0x088e2000
+#define QUSB2_SIZE     0x00000400
+#define QSCRATCH_OFF   0x0c100
+#define QSCRATCH_HS_PHY_CTRL 0x14
+#define QSCRATCH_SS_PHY_CTRL 0x18
+#define UTMI_OTG_VBUS_VALID  (1u << 20)
+#define SW_SESSVLD_SEL       (1u << 28)
+#define LANE0_PWR_PRESENT    (1u << 2)
+
+/* ------------------------------------------------------------- DMA layout */
+
+/* One page is physically contiguous, which is all the controller needs. */
+#define UD_SIZE        4096
+#define UD_EVT         0x0000
+#define UD_EVT_SIZE    1024
+#define UD_TRB_OUT     0x0400
+#define UD_TRB_IN      0x0410
+#define UD_TRB_NOTIFY  0x0420
+#define UD_TRB_BULKIN  0x0430
+#define UD_TRB_BULKOUT 0x0440
+#define UD_SETUP       0x0480
+#define UD_DATA        0x0500      /* EP0 data stage, 512 bytes */
+#define UD_NOTIFY      0x0700      /* CDC notification, 8 bytes */
+#define UD_BULKIN      0x0800      /* 512 bytes */
+#define UD_BULKOUT     0x0a00      /* 512 bytes */
+
+/* endpoint numbers as the controller sees them */
+#define EP0_OUT        0
+#define EP0_IN         1
+#define EP_NOTIFY      2
+#define EP_BULK_OUT    3
+#define EP_BULK_IN     4
+#define EP_MASK        ((1u << EP0_OUT) | (1u << EP0_IN) | (1u << EP_NOTIFY) | \
+    (1u << EP_BULK_OUT) | (1u << EP_BULK_IN))
+
+/* ------------------------------------------------------------------ state */
+
+#define LOG_RING_SIZE  16384
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	uint32_t    events;
+	int         state;          /* EP0 state machine */
+	int         sleep_chan;
+	bool        data_in;
+	bool        configured;
+	bool        running;
+	uint32_t    tx_bytes;
+	/* log ring, filled by kebab_usb_log() from any context */
+	lck_mtx_t  *lock;
+	uint32_t    log_head;
+	uint32_t    log_tail;
+	char        log_ring[LOG_RING_SIZE];
+} ud;
+
+enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS };
+
+/* --------------------------------------------------------------- helpers */
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(ud.dwc + off);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return v;
+}
+
+/* clean (to device) or invalidate (from device) the lines of one DMA buffer */
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	vm_size_t line = (vm_size_t)4 << ((ctr >> 16) & 0xf);
+	vm_offset_t start = ud.dma + off;
+	vm_offset_t end = start + len;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (vm_offset_t va = start & ~(line - 1); va < end; va += line) {
+		__asm__ volatile ("dc civac, %0" :: "r"(va) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	delay(ms * 1000);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("KEBAB USB: ep%u cmd 0x%x status %u\n", ep, cmd, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("KEBAB USB: ep%u cmd 0x%x timeout\n", ep, cmd);
+	return -1;
+}
+
+/* submit one TRB for physical endpoint ep */
+static void
+ud_start(uint32_t trb_off, unsigned ep, uint32_t buf_off, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb_off);
+	uint64_t bpa = ud.dma_pa + buf_off;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb_off, 16);
+	uint64_t tpa = ud.dma_pa + trb_off;
+	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(UD_TRB_OUT, EP0_OUT, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(EP0_OUT, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/* ----------------------------------------------------------- descriptors */
+
+/* VID 0x1209 / PID 0x0001 is the pid.codes test pool, not a product. */
+static const uint8_t ud_dev_desc[] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+
+/*
+ * One configuration, two interfaces: CDC control (interrupt IN notification)
+ * and CDC data (bulk OUT + bulk IN). 67 bytes total.
+ */
+static const uint8_t ud_cfg_desc[] = {
+	/* configuration */
+	9, 2, 67, 0, 2, 1, 0, 0x80, 250,
+	/* interface 0: CDC control */
+	9, 4, 0, 0, 1, 0x02, 0x02, 0x01, 0,
+	/* header functional descriptor */
+	5, 0x24, 0x00, 0x10, 0x01,
+	/* call management */
+	5, 0x24, 0x01, 0x00, 0x01,
+	/* abstract control management */
+	4, 0x24, 0x02, 0x02,
+	/* union: control interface 0, data interface 1 */
+	5, 0x24, 0x06, 0x00, 0x01,
+	/* notification endpoint, interrupt IN, 8 bytes */
+	7, 5, 0x80 | EP_NOTIFY, 0x03, 8, 0, 16,
+	/* interface 1: CDC data */
+	9, 4, 1, 0, 2, 0x0a, 0x00, 0x00, 0,
+	/* bulk OUT */
+	7, 5, EP_BULK_OUT, 0x02, 0x00, 0x02, 0,
+	/* bulk IN */
+	7, 5, 0x80 | EP_BULK_IN, 0x02, 0x00, 0x02, 0,
+};
+
+static const char *const ud_strings[] = {
+	NULL, "OnePlus 8T", "UniXNU kebab console", "0001",
+};
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0]) || ud_strings[idx] == NULL) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+/* --------------------------------------------------------- endpoint setup */
+
+static int
+ud_ep_config(unsigned ep, uint32_t type, uint32_t maxpkt, bool in)
+{
+	uint32_t p0 = (ep << 1) | (maxpkt << 3);
+	uint32_t p1 = (1u << 8) | (1u << 10) | (type << 1) | (in ? (1u << 25) : 0);
+	if (ud_epcmd(ep, DEPCMD_SETEPCONFIG, p0, p1, 0)) {
+		return -1;
+	}
+	return ud_epcmd(ep, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+}
+
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	if (ud_ep_config(EP_NOTIFY, EP_TYPE_INTR, 8, true) ||
+	    ud_ep_config(EP_BULK_OUT, EP_TYPE_BULK, 512, false) ||
+	    ud_ep_config(EP_BULK_IN, EP_TYPE_BULK, 512, true)) {
+		printf("KEBAB USB: endpoint configuration failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | EP_MASK);
+	ud.configured = true;
+	printf("KEBAB USB: configured, endpoints notify=%u bulk_out=%u bulk_in=%u\n",
+	    EP_NOTIFY, EP_BULK_OUT, EP_BULK_IN);
+	/* arm the first host->device transfer */
+	ud_start(UD_TRB_BULKOUT, EP_BULK_OUT, UD_BULKOUT, 512, 0);
+}
+
+/* ------------------------------------------------------------- log ring */
+
+void
+kebab_usb_log(const char *buf, size_t len)
+{
+	/*
+	 * This is called from the console path, which the USB thread itself uses
+	 * for its progress prints. Taking the ring lock recursively would deadlock,
+	 * so a second entry while one is in progress is simply dropped.
+	 */
+	static uint32_t in_log;
+	uint32_t expected = 0;
+
+	if (!ud.running || ud.lock == NULL) {
+		return;
+	}
+	if (os_atomic_cmpxchg(&in_log, expected, 1u, relaxed) == false) {
+		return;
+	}
+	lck_mtx_lock(ud.lock);
+	for (size_t i = 0; i < len; i++) {
+		uint32_t next = (ud.log_head + 1) % LOG_RING_SIZE;
+		if (next == ud.log_tail) {
+			break;                  /* drop when the host is not reading */
+		}
+		ud.log_ring[ud.log_head] = buf[i];
+		ud.log_head = next;
+	}
+	lck_mtx_unlock(ud.lock);
+	os_atomic_store(&in_log, 0u, relaxed);
+}
+
+static uint32_t
+ud_log_take(char *out, uint32_t max)
+{
+	uint32_t n = 0;
+
+	if (ud.lock == NULL) {
+		return 0;
+	}
+	lck_mtx_lock(ud.lock);
+	while (n < max && ud.log_tail != ud.log_head) {
+		out[n++] = ud.log_ring[ud.log_tail];
+		ud.log_tail = (ud.log_tail + 1) % LOG_RING_SIZE;
+	}
+	lck_mtx_unlock(ud.lock);
+	return n;
+}
+
+/* ------------------------------------------------------- control requests */
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | (st[3] << 8));
+	uint16_t length = (uint16_t)(st[6] | (st[7] << 8));
+	uint32_t n = 0;
+	bool ok = true;
+
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {            /* class request */
+		/* CDC SET_LINE_CODING etc: acknowledge and ignore */
+		if (req == 0x20 && !ud.data_in) {
+			length = 0;
+		} else {
+			ok = false;
+		}
+	} else if ((type & 0x60) != 0) {        /* vendor: not supported */
+		ok = false;
+	} else if (req == 6) {                  /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1:
+			memcpy(data, ud_dev_desc, sizeof(ud_dev_desc));
+			n = sizeof(ud_dev_desc);
+			break;
+		case 2:
+			memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc));
+			n = sizeof(ud_cfg_desc);
+			break;
+		case 3:
+			n = ud_string(value & 0xff, data);
+			break;
+		default:
+			ok = false;
+			break;
+		}
+	} else if (req == 9) {                  /* SET_CONFIGURATION */
+		ud_configure();
+	} else if (req == 11) {                 /* SET_INTERFACE: no-op */
+	} else if (req == 5 || req == 7 || req == 8) {  /* SET/CLEAR addr/feature */
+	} else {
+		ok = false;
+	}
+
+	if (!ok) {
+		printf("KEBAB USB: unsupported request %02x/%02x\n", type, req);
+		ud_stall();
+		return;
+	}
+	if (ud.data_in && n > 0) {
+		uint32_t chunk = (length < n) ? length : n;
+		ud.state = EP0_DATA;
+		ud_start(UD_TRB_IN, EP0_IN, UD_DATA, chunk, TRBCTL_DATA);
+	} else if (!ud.data_in && length > 0) {
+		/* no out-of-band data stages are used by these requests */
+		ud_stall();
+	} else {
+		ud.state = EP0_STATUS;
+		ud_start(UD_TRB_IN, EP0_IN, UD_DATA, 0, TRBCTL_STATUS3);
+	}
+}
+
+/* ---------------------------------------------------------------- events */
+
+static void
+ud_bulk_out_done(void)
+{
+	char *buf = (char *)(ud.dma + UD_BULKOUT);
+	ud_sync(UD_BULKOUT, 512);
+	buf[511] = 0;
+	if (buf[0] != 0) {
+		printf("KEBAB USB: host said %s\n", buf);
+	}
+	ud_start(UD_TRB_BULKOUT, EP_BULK_OUT, UD_BULKOUT, 512, 0);
+}
+
+static void
+ud_bulk_in_done(void)
+{
+	/* the transfer completed; a new one is armed by the pump */
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                           /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			ud.configured = false;
+			printf("KEBAB USB: bus reset\n");
+		} else if (type == 2) {
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* EP0 packet size becomes 64 once the host sets the speed */
+			ud_epcmd(EP0_OUT, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(EP0_IN, DEPCMD_SETEPCONFIG, (1u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("KEBAB USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			ud.configured = false;
+			printf("KEBAB USB: disconnect\n");
+		}
+		return;
+	}
+
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (ep == EP_BULK_OUT && type == 1) {
+		if (ud.configured) {
+			ud_bulk_out_done();
+		}
+		return;
+	}
+	if (ep == EP_BULK_IN && type == 1) {
+		ud_bulk_in_done();
+		return;
+	}
+	if (ep != EP0_OUT && ep != EP0_IN) {
+		return;
+	}
+
+	if (type == 1) {                        /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) {          /* XferNotReady, status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = (ud.state == EP0_WAIT_STATUS3) ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(UD_TRB_IN, EP0_IN, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+/* ----------------------------------------------------------------- thread */
+
+static void
+ud_pump_log(void)
+{
+	static bool in_flight;
+	uint32_t n;
+
+	if (!ud.configured || in_flight) {
+		return;
+	}
+	n = ud_log_take((char *)(ud.dma + UD_BULKIN), 512);
+	if (n == 0) {
+		return;
+	}
+	ud_sync(UD_BULKIN, n);
+	in_flight = true;
+	ud_start(UD_TRB_BULKIN, EP_BULK_IN, UD_BULKIN, n, 0);
+	ud.tx_bytes += n;
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 40) {
+					printf("KEBAB USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		ud_pump_log();
+		ud_sleep_ms(2);
+	}
+}
+
+/* ------------------------------------------------------------------ start */
+
+void
+kebab_usb_start(void)
+{
+	uint32_t enabled = 0;
+
+	if (!PE_parse_boot_argn("kebabusb", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	ud.dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (ud.dwc == 0) {
+		printf("KEBAB USB: cannot map the controller\n");
+		return;
+	}
+	if (kmem_alloc(kernel_map, &ud.dma, UD_SIZE, KMA_NONE, VM_KERN_MEMORY_NONE) != KERN_SUCCESS) {
+		printf("KEBAB USB: no DMA memory\n");
+		return;
+	}
+	ud.dma_pa = (uint64_t)kvtophys(ud.dma);
+	if (ud.dma_pa == 0) {
+		printf("KEBAB USB: DMA page has no physical backing\n");
+		return;
+	}
+	bzero((void *)ud.dma, UD_SIZE);
+	ud.lock = lck_mtx_alloc_init(0, 0);
+	if (ud.lock == NULL) {
+		printf("KEBAB USB: no lock\n");
+		return;
+	}
+
+	/* soft reset the device controller; the PHY stays as the loader left it */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("KEBAB USB: reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x GHWPARAMS0 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i,
+	    dwc_rd(GCTL), dwc_rd(DCFG), dwc_rd(0xc140));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);      /* bit 31: interrupt masked */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+	printf("KEBAB USB: event buffer at 0x%llx\n", (unsigned long long)(ud.dma_pa + UD_EVT));
+
+	if (ud_epcmd(EP0_OUT, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(EP0_OUT, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3),
+	    (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(EP0_OUT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP0_IN, DEPCMD_SETEPCONFIG, (1u << 1) | (512u << 3),
+	    (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(EP0_IN, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("KEBAB USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, (1u << EP0_OUT) | (1u << EP0_IN));
+
+	/* tell the controller VBUS is present; the board does not wire OTG here */
+	vm_offset_t qs = ml_io_map(DWC3_PA + QSCRATCH_OFF, 0x100);
+	if (qs != 0) {
+		uint32_t hs = *(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL);
+		uint32_t ss = *(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL);
+		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) =
+		    hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("KEBAB USB: VBUS override, HS_PHY_CTRL 0x%08x\n",
+		    *(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL));
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("KEBAB USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n",
+	    dwc_rd(DSTS), i, (unsigned long long)ud.dma_pa);
+
+	ud.running = true;
+	ud_start_setup();
+
+	thread_t thread;
+	if (kernel_thread_start((thread_continue_t)ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("KEBAB USB: event thread started, waiting for the host\n");
+	} else {
+		printf("KEBAB USB: no thread\n");
+	}
+}
+
+#endif /* KEBAB */
