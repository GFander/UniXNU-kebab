+// Pinned original table: selector 2201 -> base 2000, distinct public seed.
+// Same target one-block CBC KDF as 2212, with the preserved HiOS Root.
+static bool deriveFairPlayKey(const unsigned char root[32], unsigned char output[16])
+{
+  const unsigned char seed[16] = {0xd1,0xe8,0xfc,0xb5,0x39,0x37,0xbf,0x8d,0xef,0xc7,0x4c,0xd1,0xd0,0xf1,0xd4,0xb0};
+  IOAESKeyData key = {256, {}, 0};
+  unsigned char iv[16] = {};
+  memcpy(key.bytes, root, 32);
+  bool ok = !cbc(seed, output, 16, iv, key, IOAESEncrypt);
+  cc_clear(sizeof(key), &key); cc_clear(sizeof(iv), iv);
+  return ok;
+}
+
+static bool fairPlayKnownAnswerTest(NativeAES *provider)
+{
+  unsigned char root[32], derived[16] = {}, input[32], output[32] = {};
+  for (unsigned i=0;i<32;i++) root[i]=input[i]=static_cast<unsigned char>(i);
+  const unsigned char expectedKey[16] = {0x38,0x3d,0x71,0x55,0x85,0x45,0x4a,0x68,0x11,0xa2,0xd8,0x06,0x08,0x43,0xfe,0xeb};
+  const unsigned char expected[32] = {0xb3,0x70,0x7a,0xd4,0xbc,0x04,0xbd,0x4f,0xd8,0x1a,0x5b,0x2f,0xb8,0x00,0x74,0xbd,0x4c,0xfc,0x79,0x24,0x12,0x1e,0x3f,0x25,0xff,0xea,0x2a,0x95,0x54,0xec,0x03,0x0c};
+  bool ok=deriveFairPlayKey(root,derived) && !memcmp(derived,expectedKey,16);
+  IOBufferMemoryDescriptor *source=IOBufferMemoryDescriptor::withCapacity(96,kIODirectionInOut);
+  IOBufferMemoryDescriptor *destination=IOBufferMemoryDescriptor::withCapacity(96,kIODirectionInOut);
+  IOAESKeyData key={128,{},2201}; IOAESIV iv={};
+  struct Completion { unsigned count;int status; } completion={};
+  auto callback=[](void *p,int status){Completion *s=static_cast<Completion *>(p);s->count++;s->status=status;};
+  if(ok && source && destination) {
+    memcpy(native_fairplay_key,derived,16);native_fairplay_selftest=true;
+    ok=!provider->isKeySupported(2201) && source->writeBytes(16,input,32)==32 &&
+      !provider->performAES(source,destination,32,&iv,IOAESEncrypt,&key,16,32,callback,&completion) &&
+      destination->readBytes(32,output,32)==32 && !memcmp(output,expected,32) &&
+      !memcmp(iv.bytes,expected+16,16) && completion.count==1 && completion.status==0;
+    cc_clear(sizeof(iv),&iv);
+    ok=ok && !provider->performAES(destination,destination,32,&iv,IOAESDecrypt,&key,32,32,nullptr,nullptr) &&
+      destination->readBytes(32,output,32)==32 && !memcmp(output,input,32) && !memcmp(iv.bytes,expected+16,16);
+    for(unsigned bits=192;bits<=256;bits+=64) {
+      key.bits=bits;
+      ok=ok && provider->performAES(source,destination,32,&iv,IOAESEncrypt,&key,16,32,callback,&completion)==kIOReturnBadArgument && completion.count==1;
+    }
+  } else ok=false;
+  native_fairplay_selftest=false;
+  cc_clear(sizeof(native_fairplay_key),native_fairplay_key);
+  cc_clear(sizeof(root),root);cc_clear(sizeof(derived),derived);cc_clear(sizeof(output),output);
+  if(source)source->release();if(destination)destination->release();
+  IOLog("KEBAB AES FAIRPLAY: public KDF/selector/CBC/invalid-bits KAT %s\n",ok?"PASS":"FAIL");
+  return ok;
+}
