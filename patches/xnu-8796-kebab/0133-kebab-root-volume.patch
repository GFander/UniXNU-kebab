diff --git a/bsd/dev/kebab_vol.c b/bsd/dev/kebab_vol.c
new file mode 100644
index 0000000..72c2b9b
--- /dev/null
+++ b/bsd/dev/kebab_vol.c
@@ -0,0 +1,813 @@
+/*
+ * KEBAB VOL: write a host-made HFS+ volume onto the userdata partition.
+ *
+ * The host (scripts/make-root-volume.py) runs newfs_hfs and ships the blocks
+ * the new volume allocates as a VEXT v1 stream:
+ *
+ *   32-byte stream header, little endian
+ *     0   4  magic 'VEXT'            4   2  version 1
+ *     6   2  header size 32          8   8  volume size in bytes
+ *    16   4  allocation block size  20   4  extent count
+ *    24   8  sum of extent lengths
+ *   16-byte extent header, then length bytes of data, repeated
+ *     0   8  byte offset in the volume (block aligned)
+ *     8   4  length in bytes (block aligned, non-zero)
+ *    12   4  reserved, zero
+ *   zero padding to a 64 KiB boundary
+ *
+ * The parser only moves forward, every field is bounded before it is used,
+ * each extent must be ordered and inside the declared volume, and the volume
+ * itself must fit inside the userdata partition.  The primary volume header is
+ * captured from the stream and validated before the first block is written, so
+ * a stream whose header and size disagree cannot destroy the old volume.
+ *
+ * The host owns the transport: bsd/dev/kebab_usb.c takes one 64 KiB chunk per
+ * bulk-OUT completion and this file answers "VOL ACK <cumulative bytes>".
+ * Nothing here sleeps, panics or retries a failed write.
+ */
+#if defined(KEBAB)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/kernel.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+#include "kebab_ufs.h"
+#include "kebab_vol.h"
+
+#define KV_HDR          32u
+#define KV_EXT_HDR      16u
+#define KV_BLOCK        4096u
+#define KV_VH_OFF       1024u
+#define KV_VH_SIZE      512u
+#define KV_TIMEOUT_NS   60000000000ull  /* 60 s with no chunk */
+
+#define KV_MAGIC        0x54584556u     /* 'VEXT' */
+#define KV_VERSION      1u
+
+enum kv_state {
+	KV_S_HDR = 0,
+	KV_S_EXT_HDR,
+	KV_S_DATA,
+	KV_S_PAD,
+	KV_S_DONE,
+};
+
+static struct {
+	bool        gate_checked;
+	bool        gated;
+	bool        active;
+	bool        dry;
+
+	uint32_t    state;
+	uint32_t    hdr_got;
+	uint8_t     hdr[KV_HDR];
+
+	uint64_t    wire_total;
+	uint64_t    wire_seen;
+	uint64_t    wire_left;
+	uint64_t    volume_bytes;
+	uint32_t    block_size;
+	uint32_t    extent_total;
+	uint32_t    extent_done;
+	uint64_t    data_total;
+	uint64_t    data_seen;
+
+	uint64_t    extent_off;      /* current extent, absolute */
+	uint64_t    extent_len;
+	uint64_t    extent_left;
+	uint64_t    extent_written;  /* flushed bytes of the current extent */
+	uint8_t    *io;              /* KV_CHUNK staging buffer */
+	uint32_t    io_fill;
+
+	uint8_t     vh[KV_VH_SIZE];  /* captured from the stream */
+	bool        vh_seen;
+	uint64_t    prev_end;
+
+	uint32_t    failed;
+	uint64_t    ns_start;
+	uint64_t    ns_last;
+} kv;
+
+static uint16_t
+kv_le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static uint32_t
+kv_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t
+kv_le64(const uint8_t *p)
+{
+	return (uint64_t)kv_le32(p) | ((uint64_t)kv_le32(p + 4) << 32);
+}
+
+static uint32_t
+kv_be16(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 8 | p[1];
+}
+
+static uint32_t
+kv_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 |
+	    (uint32_t)p[2] << 8 | p[3];
+}
+
+static uint64_t
+kv_now_ns(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+/* --------------------------------------------------------------- gating */
+
+bool
+kebab_vol_gated(void)
+{
+	uint32_t on = 0;
+
+	if (!kv.gate_checked) {
+		kv.gate_checked = true;
+		kv.gated = PE_parse_boot_argn("kebab_vol", &on, sizeof(on)) && on != 0;
+	}
+	return kv.gated;
+}
+
+static bool
+kv_gate(void)
+{
+	if (!kebab_vol_gated()) {
+		printf("VOL disabled: boot with kebab_vol=1 to enable the volume "
+		    "writer\n");
+		return false;
+	}
+	return true;
+}
+
+/* ------------------------------------------------------- volume header */
+
+/*
+ * Decode and print one volume header.  The raw bytes are printed too: the old
+ * header is about to stop existing, and "print it, do not save it" only works
+ * if the bytes themselves appear in the log.
+ */
+static void
+kv_print_vh(const char *tag, const uint8_t *vh, bool hex)
+{
+	char line[16 * 3 + 1];
+	static const char digits[] = "0123456789abcdef";
+	uint32_t i, j;
+
+	printf("VOL %s vh sig 0x%04x version %u attributes 0x%08x "
+	    "lastMount 0x%08x journal 0x%08x\n", tag,
+	    kv_be16(vh), kv_be16(vh + 2), kv_be32(vh + 4), kv_be32(vh + 8),
+	    kv_be32(vh + 12));
+	printf("VOL %s vh created %u modified %u checked %u files %u "
+	    "folders %u nextcnid %u\n", tag, kv_be32(vh + 16),
+	    kv_be32(vh + 20), kv_be32(vh + 28), kv_be32(vh + 32),
+	    kv_be32(vh + 36), kv_be32(vh + 64));
+	printf("VOL %s vh bsize %u blocks %u free %u freebytes %llu "
+	    "volbytes %llu\n", tag, kv_be32(vh + 40), kv_be32(vh + 44),
+	    kv_be32(vh + 48),
+	    (unsigned long long)kv_be32(vh + 48) * kv_be32(vh + 40),
+	    (unsigned long long)kv_be32(vh + 44) * kv_be32(vh + 40));
+	if (!hex) {
+		return;
+	}
+	for (i = 0; i < KV_VH_SIZE; i += 16) {
+		for (j = 0; j < 16; j++) {
+			line[j * 3] = digits[vh[i + j] >> 4];
+			line[j * 3 + 1] = digits[vh[i + j] & 15];
+			line[j * 3 + 2] = j == 15 ? 0 : ' ';
+		}
+		printf("VOL %s bytes %03x %s\n", tag, i, line);
+	}
+}
+
+static int
+kv_check_vh(const uint8_t *vh, uint64_t volume_bytes)
+{
+	uint32_t sig = kv_be16(vh);
+	uint32_t ver = kv_be16(vh + 2);
+	uint32_t bsize = kv_be32(vh + 40);
+	uint32_t blocks = kv_be32(vh + 44);
+
+	if (sig != 0x482b || ver != 4) {
+		printf("VOL ABORT volume header signature 0x%04x version %u\n",
+		    sig, ver);
+		return EINVAL;
+	}
+	if (bsize != KV_BLOCK) {
+		printf("VOL ABORT volume header block size %u, this writer "
+		    "writes %u-byte blocks\n", bsize, KV_BLOCK);
+		return EINVAL;
+	}
+	if ((uint64_t)blocks * bsize != volume_bytes) {
+		printf("VOL ABORT volume header says %u blocks of %u = %llu "
+		    "bytes, stream declares %llu\n", blocks, bsize,
+		    (unsigned long long)blocks * bsize,
+		    (unsigned long long)volume_bytes);
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+kv_read_vh(uint8_t *vh)
+{
+	int error = kebab_ufs_raw_read(KV_VH_OFF, vh, KV_VH_SIZE);
+	if (error) {
+		printf("VOL: cannot read the on-disk volume header (error %d)\n",
+		    error);
+	}
+	return error;
+}
+
+/* ------------------------------------------------------------- session */
+
+static void
+kv_reset(void)
+{
+	kv.active = false;
+	kv.state = KV_S_DONE;
+	kv.hdr_got = 0;
+	kv.io_fill = 0;
+}
+
+static void
+kv_abort(const char *why, int error)
+{
+	if (error) {
+		printf("VOL ABORT %s (error %d)\n", why, error);
+	} else {
+		printf("VOL ABORT %s\n", why);
+	}
+	kv.failed++;
+	kv_reset();
+}
+
+void
+kebab_vol_begin(bool dry, uint64_t wire_bytes, uint64_t volume_bytes,
+    bool confirmed)
+{
+	uint64_t partition;
+	uint8_t old[KV_VH_SIZE];
+	bool have_old;
+
+	if (!kv_gate()) {
+		return;
+	}
+	if (kv.active) {
+		printf("VOL busy: %llu of %llu bytes already consumed\n",
+		    (unsigned long long)kv.wire_seen,
+		    (unsigned long long)kv.wire_total);
+		return;
+	}
+	if (!dry && !kebab_ufs_writable()) {
+		printf("VOL refused: userdata is read-only; boot with ufsrw=1\n");
+		return;
+	}
+	partition = kebab_ufs_partition_bytes();
+	if (partition == 0) {
+		printf("VOL refused: the userdata partition is not available\n");
+		return;
+	}
+	if (wire_bytes == 0 || (wire_bytes % KEBAB_VOL_CHUNK) != 0) {
+		printf("VOL refused: the stream must be a non-zero multiple of "
+		    "%u bytes, not %llu\n", KEBAB_VOL_CHUNK,
+		    (unsigned long long)wire_bytes);
+		return;
+	}
+	if (!dry) {
+		if (!confirmed) {
+			printf("VOL refused: a real write needs the confirmation "
+			    "argument (VOL BEGIN <wire> <volume> CONFIRM)\n");
+			return;
+		}
+		if (volume_bytes == 0 || (volume_bytes % KV_BLOCK) != 0) {
+			printf("VOL refused: volume size %llu is not a non-zero "
+			    "multiple of %u\n", (unsigned long long)volume_bytes,
+			    KV_BLOCK);
+			return;
+		}
+		if (volume_bytes > partition) {
+			printf("VOL refused: requested volume %llu bytes exceeds "
+			    "the %llu-byte userdata partition\n",
+			    (unsigned long long)volume_bytes,
+			    (unsigned long long)partition);
+			return;
+		}
+	} else {
+		volume_bytes = 0;
+	}
+	if (kv.io == NULL) {
+		kv.io = kalloc_data(KEBAB_VOL_CHUNK, Z_WAITOK);
+		if (kv.io == NULL) {
+			printf("VOL refused: no %u-byte buffer\n",
+			    KEBAB_VOL_CHUNK);
+			return;
+		}
+	}
+
+	/*
+	 * Read and print the old header before VOL BEGIN is announced.  The
+	 * host starts sending only when it sees that line, so the old bytes are
+	 * already in the log before the first block can move, and a header that
+	 * cannot be read aborts the write without taking the stream.
+	 */
+	have_old = (kv_read_vh(old) == 0);
+	if (!have_old && !dry) {
+		printf("VOL refused: the old volume header cannot be read\n");
+		return;
+	}
+
+	kv.active = true;
+	kv.dry = dry;
+	kv.state = KV_S_HDR;
+	kv.hdr_got = 0;
+	kv.wire_total = wire_bytes;
+	kv.wire_seen = 0;
+	kv.wire_left = wire_bytes;
+	kv.volume_bytes = volume_bytes;
+	kv.block_size = KV_BLOCK;
+	kv.extent_total = 0;
+	kv.extent_done = 0;
+	kv.data_total = 0;
+	kv.data_seen = 0;
+	kv.extent_off = 0;
+	kv.extent_len = 0;
+	kv.extent_left = 0;
+	kv.extent_written = 0;
+	kv.io_fill = 0;
+	kv.vh_seen = false;
+	kv.prev_end = 0;
+	kv.failed = 0;
+	kv.ns_start = kv.ns_last = kv_now_ns();
+
+	printf("VOL partition %llu bytes (%llu MiB), writable %d\n",
+	    (unsigned long long)partition, (unsigned long long)(partition >> 20),
+	    kebab_ufs_writable() ? 1 : 0);
+	if (have_old) {
+		kv_print_vh("OLD", old, true);
+	}
+	printf("VOL BEGIN %llu volume %llu %s chunk %u\n",
+	    (unsigned long long)wire_bytes,
+	    (unsigned long long)volume_bytes, dry ? "dry" : "write",
+	    KEBAB_VOL_CHUNK);
+}
+
+/* --------------------------------------------------------------- output */
+
+static int
+kv_flush(void)
+{
+	int error;
+
+	if (kv.io_fill == 0) {
+		return 0;
+	}
+	if ((kv.io_fill % KV_BLOCK) != 0) {
+		printf("VOL ABORT extent at 0x%llx has a %u-byte tail that is "
+		    "not block aligned\n", (unsigned long long)kv.extent_off,
+		    kv.io_fill);
+		return EINVAL;
+	}
+	if (!kv.dry) {
+		error = kebab_ufs_raw_write(kv.extent_off + kv.extent_written,
+		    kv.io, kv.io_fill);
+		if (error) {
+			printf("VOL FAIL write 0x%llx+0x%x (error %d)\n",
+			    (unsigned long long)(kv.extent_off +
+			    kv.extent_written), kv.io_fill, error);
+			return error;
+		}
+	}
+	kv.extent_written += kv.io_fill;
+	kv.io_fill = 0;
+	return 0;
+}
+
+/*
+ * The volume header is captured from the stream itself, and checked before the
+ * staging buffer that holds it is flushed.  A stream whose header disagrees
+ * with the declared volume therefore stops before it overwrites block 0.
+ */
+static int
+kv_capture_vh(void)
+{
+	uint64_t have;
+
+	if (kv.vh_seen || kv.extent_off != 0) {
+		return 0;
+	}
+	have = kv.extent_written + kv.io_fill;
+	if (have < KV_VH_OFF + KV_VH_SIZE) {
+		return 0;
+	}
+	if (kv.extent_written > KV_VH_OFF) {
+		printf("VOL ABORT volume header is no longer in the staging "
+		    "buffer\n");
+		return EINVAL;
+	}
+	memcpy(kv.vh, kv.io + KV_VH_OFF - kv.extent_written, KV_VH_SIZE);
+	kv.vh_seen = true;
+	return kv_check_vh(kv.vh, kv.volume_bytes);
+}
+
+/* ------------------------------------------------------------ parsing */
+
+static void
+kv_stream_hdr(void)
+{
+	uint64_t expected;
+	uint64_t pad;
+	uint32_t count;
+	uint32_t bsize;
+
+	if (kv_le32(kv.hdr) != KV_MAGIC || kv_le16(kv.hdr + 4) != KV_VERSION) {
+		kv_abort("bad stream header", 0);
+		return;
+	}
+	if (kv_le16(kv.hdr + 6) != KV_HDR) {
+		kv_abort("unexpected stream header size", 0);
+		return;
+	}
+	bsize = kv_le32(kv.hdr + 16);
+	count = kv_le32(kv.hdr + 20);
+	if (bsize != KV_BLOCK) {
+		printf("VOL ABORT stream block size %u, this writer writes %u\n",
+		    bsize, KV_BLOCK);
+		kv.failed++;
+		kv_reset();
+		return;
+	}
+	if (kv.volume_bytes != 0 && kv_le64(kv.hdr + 8) != kv.volume_bytes) {
+		printf("VOL ABORT stream volume %llu != command volume %llu\n",
+		    (unsigned long long)kv_le64(kv.hdr + 8),
+		    (unsigned long long)kv.volume_bytes);
+		kv.failed++;
+		kv_reset();
+		return;
+	}
+	kv.volume_bytes = kv_le64(kv.hdr + 8);
+	if (kv.volume_bytes == 0 || (kv.volume_bytes % KV_BLOCK) != 0 ||
+	    kv.volume_bytes > kebab_ufs_partition_bytes()) {
+		printf("VOL ABORT volume %llu does not fit the partition\n",
+		    (unsigned long long)kv.volume_bytes);
+		kv.failed++;
+		kv_reset();
+		return;
+	}
+	kv.extent_total = count;
+	kv.data_total = kv_le64(kv.hdr + 24);
+	/* Every data byte has to fit in the stream, so this cannot overflow. */
+	if (kv.data_total > kv.wire_total ||
+	    (uint64_t)count * KV_EXT_HDR > kv.wire_total ||
+	    kv.data_total > kv.wire_total - (uint64_t)count * KV_EXT_HDR) {
+		kv_abort("stream declares more data than it carries", 0);
+		return;
+	}
+	expected = (uint64_t)KV_HDR + (uint64_t)count * KV_EXT_HDR +
+	    kv.data_total;
+	if (expected > kv.wire_total) {
+		kv_abort("stream declares more data than it carries", 0);
+		return;
+	}
+	pad = kv.wire_total - expected;
+	if (pad >= KEBAB_VOL_CHUNK) {
+		kv_abort("stream padding is larger than one chunk", 0);
+		return;
+	}
+	if (count == 0) {
+		kv_abort("stream has no extents", 0);
+		return;
+	}
+	printf("VOL STREAM volume %llu bytes (%llu MiB), block %u, "
+	    "extents %u, data %llu bytes, wire %llu\n",
+	    (unsigned long long)kv.volume_bytes,
+	    (unsigned long long)(kv.volume_bytes >> 20), kv.block_size,
+	    count, (unsigned long long)kv.data_total,
+	    (unsigned long long)kv.wire_total);
+	kv.state = KV_S_EXT_HDR;
+}
+
+static void
+kv_extent_hdr(void)
+{
+	uint64_t off = kv_le64(kv.hdr);
+	uint32_t len = kv_le32(kv.hdr + 8);
+	uint32_t rsvd = kv_le32(kv.hdr + 12);
+
+	if (rsvd != 0 || len == 0 || (off % KV_BLOCK) != 0 ||
+	    (len % KV_BLOCK) != 0) {
+		kv_abort("malformed extent header", 0);
+		return;
+	}
+	if (off < kv.prev_end) {
+		kv_abort("extents are not ordered or overlap", 0);
+		return;
+	}
+	if (off > kv.volume_bytes || len > kv.volume_bytes - off) {
+		kv_abort("extent lies outside the volume", 0);
+		return;
+	}
+	if (kv.extent_done == 0 && off != 0) {
+		kv_abort("first extent does not start at block 0", 0);
+		return;
+	}
+	if (kv.data_seen + len > kv.data_total) {
+		kv_abort("extents carry more data than the stream declares", 0);
+		return;
+	}
+	kv.prev_end = off + len;
+	kv.extent_off = off;
+	kv.extent_len = len;
+	kv.extent_left = len;
+	kv.extent_written = 0;
+	kv.io_fill = 0;
+	printf("VOL EXTENT %u/%u off 0x%llx len 0x%x\n",
+	    kv.extent_done + 1, kv.extent_total, (unsigned long long)off, len);
+	kv.state = KV_S_DATA;
+}
+
+static void
+kv_data(const uint8_t *p, uint32_t n)
+{
+	while (n > 0 && kv.active) {
+		uint32_t room = KEBAB_VOL_CHUNK - kv.io_fill;
+		uint32_t take = n;
+		int error;
+
+		if ((uint64_t)take > kv.extent_left) {
+			take = (uint32_t)kv.extent_left;
+		}
+		if (take > room) {
+			take = room;
+		}
+		memcpy(kv.io + kv.io_fill, p, take);
+		kv.io_fill += take;
+		kv.extent_left -= take;
+		kv.data_seen += take;
+		p += take;
+		n -= take;
+
+		error = kv_capture_vh();
+		if (error) {
+			kv.failed++;
+			kv_reset();
+			return;
+		}
+		if (kv.io_fill == KEBAB_VOL_CHUNK) {
+			error = kv_flush();
+			if (error) {
+				kv_abort("write failed", error);
+				return;
+			}
+		}
+		if (kv.extent_left == 0) {
+			error = kv_flush();
+			if (error) {
+				kv_abort("write failed", error);
+				return;
+			}
+			if (kv.extent_written != kv.extent_len) {
+				kv_abort("extent length mismatch", 0);
+				return;
+			}
+			kv.extent_done++;
+			if (!kv.vh_seen) {
+				kv_abort("the stream does not contain block 0", 0);
+				return;
+			}
+			if (kv.extent_done == kv.extent_total) {
+				kv.state = KV_S_PAD;
+			} else {
+				kv.state = KV_S_EXT_HDR;
+			}
+		}
+	}
+}
+
+static void
+kv_finish(void)
+{
+	uint8_t disk[KV_VH_SIZE];
+	uint64_t ms = (kv_now_ns() - kv.ns_start) / 1000000ull;
+	int error;
+
+	if (kv.extent_done != kv.extent_total ||
+	    kv.data_seen != kv.data_total || kv.wire_seen != kv.wire_total) {
+		printf("VOL ABORT stream ended after %u/%u extents, %llu/%llu "
+		    "data, %llu/%llu wire\n", kv.extent_done, kv.extent_total,
+		    (unsigned long long)kv.data_seen,
+		    (unsigned long long)kv.data_total,
+		    (unsigned long long)kv.wire_seen,
+		    (unsigned long long)kv.wire_total);
+		kv.failed++;
+		kv_reset();
+		return;
+	}
+	if (!kv.vh_seen) {
+		kv_abort("no volume header in the stream", 0);
+		return;
+	}
+	if (kv.dry) {
+		kv_print_vh("PLAN", kv.vh, false);
+		printf("VOL PLAN extents %u bytes %llu wire %llu volume %llu\n",
+		    kv.extent_done, (unsigned long long)kv.data_seen,
+		    (unsigned long long)kv.wire_seen,
+		    (unsigned long long)kv.volume_bytes);
+		kv_reset();
+		return;
+	}
+	error = kebab_ufs_sync();
+	if (error) {
+		kv_abort("the new volume cannot be flushed to the device", error);
+		return;
+	}
+	error = kebab_ufs_raw_read(KV_VH_OFF, disk, KV_VH_SIZE);
+	if (error) {
+		kv_abort("the new volume header cannot be read back", error);
+		return;
+	}
+	if (memcmp(disk, kv.vh, KV_VH_SIZE) != 0) {
+		printf("VOL FAIL the header read back from the device differs "
+		    "from the stream\n");
+		kv.failed++;
+		kv_reset();
+		return;
+	}
+	kv_print_vh("NEW", disk, true);
+	printf("VOL DONE extents %u bytes %llu wire %llu ms %llu\n",
+	    kv.extent_done, (unsigned long long)kv.data_seen,
+	    (unsigned long long)kv.wire_seen, (unsigned long long)ms);
+	kv_reset();
+}
+
+/*
+ * One bulk-OUT chunk.  Called by the USB event thread with no transport lock
+ * held; the endpoint stays unarmed until this returns and the ACK is printed.
+ */
+void
+kebab_vol_bytes(const void *buf, uint32_t len)
+{
+	const uint8_t *p = buf;
+	uint32_t n = len;
+
+	if (!kv.active) {
+		return;
+	}
+	if ((uint64_t)len > kv.wire_left) {
+		printf("VOL ABORT chunk of %u bytes exceeds the %llu bytes "
+		    "left\n", len, (unsigned long long)kv.wire_left);
+		kv.failed++;
+		kv_reset();
+		return;
+	}
+	kv.ns_last = kv_now_ns();
+
+	while (n > 0 && kv.active) {
+		switch (kv.state) {
+		case KV_S_HDR: {
+			uint32_t need = KV_HDR - kv.hdr_got;
+			uint32_t take = MIN(need, n);
+
+			memcpy(kv.hdr + kv.hdr_got, p, take);
+			kv.hdr_got += take;
+			p += take;
+			n -= take;
+			kv.wire_seen += take;
+			kv.wire_left -= take;
+			if (kv.hdr_got == KV_HDR) {
+				kv.hdr_got = 0;
+				kv_stream_hdr();
+			}
+			break;
+		}
+		case KV_S_EXT_HDR: {
+			uint32_t need = KV_EXT_HDR - kv.hdr_got;
+			uint32_t take = MIN(need, n);
+
+			memcpy(kv.hdr + kv.hdr_got, p, take);
+			kv.hdr_got += take;
+			p += take;
+			n -= take;
+			kv.wire_seen += take;
+			kv.wire_left -= take;
+			if (kv.hdr_got == KV_EXT_HDR) {
+				kv.hdr_got = 0;
+				kv_extent_hdr();
+			}
+			break;
+		}
+		case KV_S_DATA: {
+			uint64_t left = kv.extent_left;
+			uint32_t take = left > n ? n : (uint32_t)left;
+
+			kv_data(p, take);
+			if (!kv.active) {
+				return;
+			}
+			p += take;
+			n -= take;
+			kv.wire_seen += take;
+			kv.wire_left -= take;
+			break;
+		}
+		case KV_S_PAD:
+			for (uint32_t i = 0; i < n; i++) {
+				if (p[i] != 0) {
+					kv_abort("non-zero stream padding", 0);
+					return;
+				}
+			}
+			kv.wire_seen += n;
+			kv.wire_left -= n;
+			p += n;
+			n = 0;
+			break;
+		default:
+			return;
+		}
+	}
+	if (!kv.active) {
+		return;
+	}
+	printf("VOL ACK %llu\n", (unsigned long long)kv.wire_seen);
+	if (kv.wire_left == 0) {
+		kv_finish();
+	}
+}
+
+void
+kebab_vol_poll(void)
+{
+	if (!kv.active) {
+		return;
+	}
+	if (kv_now_ns() - kv.ns_last < KV_TIMEOUT_NS) {
+		return;
+	}
+	printf("VOL TIMEOUT after %llu of %llu bytes\n",
+	    (unsigned long long)kv.wire_seen,
+	    (unsigned long long)kv.wire_total);
+	kv.failed++;
+	kv_reset();
+}
+
+bool
+kebab_vol_active(void)
+{
+	return kv.active;
+}
+
+void
+kebab_vol_status(void)
+{
+	uint8_t vh[KV_VH_SIZE];
+	struct vfsstatfs *sfs;
+
+	printf("VOL? gated %d active %d dry %d chunk %u writable %d\n",
+	    kebab_vol_gated() ? 1 : 0, kv.active ? 1 : 0, kv.dry ? 1 : 0,
+	    KEBAB_VOL_CHUNK, kebab_ufs_writable() ? 1 : 0);
+	printf("VOL? partition %llu bytes (%llu MiB)\n",
+	    (unsigned long long)kebab_ufs_partition_bytes(),
+	    (unsigned long long)(kebab_ufs_partition_bytes() >> 20));
+	if (kv_read_vh(vh) == 0) {
+		kv_print_vh("DISK", vh, false);
+	}
+	if (rootvnode != NULLVP && rootvnode->v_mount != NULL) {
+		sfs = vfs_statfs(rootvnode->v_mount);
+		if (sfs != NULL && sfs->f_bsize) {
+			printf("VOL? root %s space %llu free of %llu bytes "
+			    "bsize %u blocks %llu free %llu\n",
+			    (vfs_flags(rootvnode->v_mount) & MNT_RDONLY) ?
+			    "ro" : "rw",
+			    (unsigned long long)sfs->f_bavail * sfs->f_bsize,
+			    (unsigned long long)sfs->f_blocks * sfs->f_bsize,
+			    sfs->f_bsize,
+			    (unsigned long long)sfs->f_blocks,
+			    (unsigned long long)sfs->f_bavail);
+		}
+	}
+}
+
+#endif /* KEBAB */
diff --git a/bsd/dev/kebab_vol.h b/bsd/dev/kebab_vol.h
new file mode 100644
index 0000000..7aae017
--- /dev/null
+++ b/bsd/dev/kebab_vol.h
@@ -0,0 +1,51 @@
+/*
+ * KEBAB VOL: replace the userdata HFS+ volume from a host-made extent stream.
+ *
+ * The kernel has no HFS+ implementation and should not grow one.  The volume is
+ * built on the host with newfs_hfs, and only the blocks the new volume actually
+ * allocates travel over the console.  This module is the receiving end: it
+ * validates the VEXT v1 stream, writes every extent to the userdata partition
+ * through the UFS block path, prints the old and the new volume header, and
+ * reads the header back from the device before declaring success.
+ *
+ * The transport is the one the installer already proved: one 64 KiB bulk-OUT
+ * chunk per console command, one "VOL ACK <cumulative bytes>" line per chunk.
+ * bsd/dev/kebab_usb.c owns the endpoint and the buffer; this file owns the
+ * state machine and never touches the controller.
+ *
+ * Gating is deliberately paranoid: the command family is behind the boot
+ * argument kebab_vol=1 (default off), and a real write additionally requires
+ * the literal confirmation argument CONFIRM and a volume size that fits inside
+ * the userdata partition.  A dry run validates the same stream without writing.
+ */
+#ifndef _KEBAB_VOL_H_
+#define _KEBAB_VOL_H_
+
+#include <sys/types.h>
+
+/* Same chunk as the installer: one bulk-OUT TRB, one ACK line. */
+#define KEBAB_VOL_CHUNK     65536u
+
+/* Boot argument kebab_vol=1; everything below is a no-op without it. */
+bool kebab_vol_gated(void);
+
+/*
+ * VOL BEGIN <wire_bytes> <volume_bytes> CONFIRM  (confirmed = true)
+ * VOL DRY <wire_bytes>                          (dry = true)
+ * Prints VOL BEGIN only when the stream is really taken.
+ */
+void kebab_vol_begin(bool dry, uint64_t wire_bytes, uint64_t volume_bytes,
+    bool confirmed);
+
+/* One bulk-OUT completion.  Must run with no transport lock held. */
+void kebab_vol_bytes(const void *buf, uint32_t len);
+
+/* Inactivity watchdog, called from the event thread. */
+void kebab_vol_poll(void);
+
+bool kebab_vol_active(void);
+
+/* VOL?: gate, partition size, on-disk header, mounted root's free space. */
+void kebab_vol_status(void);
+
+#endif /* _KEBAB_VOL_H_ */
diff --git a/bsd/kebab_hfs/core/hfs_vfsops.c b/bsd/kebab_hfs/core/hfs_vfsops.c
index bfc5247..8cd20eb 100644
--- a/bsd/kebab_hfs/core/hfs_vfsops.c
+++ b/bsd/kebab_hfs/core/hfs_vfsops.c
@@ -1858,6 +1858,19 @@ hfs_mountfs(struct vnode *devvp, struct mount *mp, struct hfs_mount_args *args,
 		   (hfsmp->vcbVN[0] ? (const char*) hfsmp->vcbVN : "unknown"),
 		   dev_name ?: "unknown device");
 
+	/*
+	 * The mount log is the acceptance test for a re-imprinted root volume:
+	 * the old KebabRoot was 64 MiB, and a bigger one has to be visible here
+	 * without any other tool.
+	 */
+	printf("KEBAB HFS: %s: block size %u, total blocks %u (%llu MiB), "
+	    "free blocks %u (%llu MiB)\n",
+	    (hfsmp->vcbVN[0] ? (const char*) hfsmp->vcbVN : "unknown"),
+	    hfsmp->blockSize, hfsmp->totalBlocks,
+	    (unsigned long long)hfsmp->totalBlocks * hfsmp->blockSize >> 20,
+	    hfsmp->freeBlocks,
+	    (unsigned long long)hfsmp->freeBlocks * hfsmp->blockSize >> 20);
+
 	if (dev_name)
 		vnode_putname_printable(dev_name);
 
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index d90dd17..dea0ca6 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1173,6 +1173,31 @@ bsdinit_task(void)
 	kebab_dsc_boot();
 #endif /* KEBAB */
 
+#if defined(KEBAB)
+	/*
+	 * Bring-up escape hatch: launchd is killed by the code-signing model on
+	 * this port (CS_KILLED), and a panic in the middle of a volume imprint
+	 * or a large install reboots the board and strands the transfer.  With
+	 * kebab_noinit=1 the init thread parks in the kernel instead of
+	 * launching PID 1, so the console and the filesystem paths remain usable
+	 * for as long as the test needs.  It must block, not return: this runs
+	 * from the init task's BSD AST, and returning would resume a user thread
+	 * that has no user context.  Default off: an ordinary boot is unchanged.
+	 */
+	{
+		uint32_t noinit = 0;
+		if (PE_parse_boot_argn("kebab_noinit", &noinit, sizeof(noinit)) &&
+		    noinit != 0) {
+			printf("KEBAB: kebab_noinit=1: staying in the kernel, no "
+			    "init program\n");
+			lock_trace = 1;
+			for (;;) {
+				(void)thread_block(THREAD_CONTINUE_NULL);
+			}
+		}
+	}
+#endif /* KEBAB */
+
 	load_init_program(p);
 	lock_trace = 1;
 }
