+/*
+ * Raw block path for bsd/dev/kebab_vol.c.  It deliberately bypasses the buffer
+ * cache: the caller writes a new filesystem over the one that is mounted, so a
+ * cached block must never be allowed to reach the device afterwards.  The old
+ * root is mounted read-only for that boot (kebab_vol=1), and the next boot
+ * reads everything from the device.
+ */
+int
+kebab_ufs_raw_write(uint64_t offset, const void *data, uint32_t length)
+{
+	int error = 0;
+	uint64_t part_bytes;
+
+	if (data == NULL || length == 0 ||
+	    (offset & (UFS_BLOCK - 1)) || (length & (UFS_BLOCK - 1)) ||
+	    length > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&kebab_ufs_lock);
+	if (!su.ready) {
+		error = ENXIO;
+		goto out;
+	}
+	if (!su.writable) {
+		error = EROFS;
+		goto out;
+	}
+	part_bytes = su.nblocks * UFS_BLOCK;
+	if (offset > part_bytes || length > part_bytes - offset) {
+		error = EINVAL;
+		goto out;
+	}
+	memcpy((void *)(su.dma + DMA_BOUNCE), data, length);
+	error = ufs_write_blocks(su.first_block + offset / UFS_BLOCK,
+	    length / UFS_BLOCK);
+out:
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return error;
+}
+
+int
+kebab_ufs_raw_read(uint64_t offset, void *data, uint32_t length)
+{
+	int error = 0;
+	uint64_t part_bytes, first;
+	uint32_t skip, blocks;
+
+	if (data == NULL || length == 0 || length > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&kebab_ufs_lock);
+	if (!su.ready) {
+		error = ENXIO;
+		goto out;
+	}
+	part_bytes = su.nblocks * UFS_BLOCK;
+	if (offset > part_bytes || length > part_bytes - offset) {
+		error = EINVAL;
+		goto out;
+	}
+	first = offset & ~(uint64_t)(UFS_BLOCK - 1);
+	skip = (uint32_t)(offset - first);
+	blocks = (skip + length + UFS_BLOCK - 1) / UFS_BLOCK;
+	if (blocks > BOUNCE_SIZE / UFS_BLOCK) {
+		error = EINVAL;
+		goto out;
+	}
+	error = ufs_read_blocks(su.first_block + first / UFS_BLOCK, blocks);
+	if (!error) {
+		memcpy(data, (const void *)(su.dma + DMA_BOUNCE + skip), length);
+	}
+out:
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return error;
+}
+
+uint64_t
+kebab_ufs_partition_bytes(void)
+{
+	uint64_t bytes = 0;
+
+	lck_mtx_lock(&kebab_ufs_lock);
+	if (su.ready) {
+		bytes = su.nblocks * UFS_BLOCK;
+	}
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return bytes;
+}
+
+bool
+kebab_ufs_writable(void)
+{
+	bool writable;
+
+	lck_mtx_lock(&kebab_ufs_lock);
+	writable = su.ready && su.writable;
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return writable;
+}
+
+/* SYNCHRONIZE CACHE(10), so the volume survives the reboot that follows. */
+int
+kebab_ufs_sync(void)
+{
+	int error;
+
+	lck_mtx_lock(&kebab_ufs_lock);
+	if (!su.ready) {
+		error = ENXIO;
+	} else if (!su.writable) {
+		error = EROFS;
+	} else {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&kebab_ufs_lock);
+	return error;
+}
+
 static int
 kebab_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
     __unused struct proc *p, int is_char)
diff --git a/bsd/dev/kebab_ufs.h b/bsd/dev/kebab_ufs.h
new file mode 100644
index 0000000..bd8a79f
--- /dev/null
+++ b/bsd/dev/kebab_ufs.h
@@ -0,0 +1,32 @@
+/*
+ * KEBAB UFS: the block path behind the console volume writer.
+ *
+ * The installer goes through the mounted filesystem; the volume writer cannot,
+ * because it replaces the filesystem that is mounted.  These calls talk to the
+ * userdata partition directly: whole 4 KiB device blocks, bounds-checked
+ * against the partition on every call, and only when boot-arg ufsrw=1 made the
+ * disk writable.  There is no buffer cache in this path, so the caller must
+ * never use it while the old volume is mounted writable; kebab_vol=1 forces the
+ * root mount read-only for exactly that reason.
+ */
+#ifndef _KEBAB_UFS_H_
+#define _KEBAB_UFS_H_
+
+#include <sys/types.h>
+
+/* Write whole blocks.  offset and length must both be 4 KiB aligned. */
+int kebab_ufs_raw_write(uint64_t offset, const void *data, uint32_t length);
+
+/* Read arbitrary bytes.  Used for the volume header before and after a write. */
+int kebab_ufs_raw_read(uint64_t offset, void *data, uint32_t length);
+
+/* userdata's size in bytes, zero when the disk did not come up. */
+uint64_t kebab_ufs_partition_bytes(void);
+
+/* True when the disk is up and boot-arg ufsrw=1 allowed writes. */
+bool kebab_ufs_writable(void);
+
+/* Flush the device's write cache after a batch of raw writes. */
+int kebab_ufs_sync(void);
+
+#endif /* _KEBAB_UFS_H_ */
