--- a/bsd/kern/sys_work_interval.c
+++ b/bsd/kern/sys_work_interval.c
@@ -37,6 +37,32 @@
 #include <kern/work_interval.h>
 
 #include <libkern/libkern.h>
+#if defined(KEBAB)
+#include <sys/proc.h>
+#include <kern/policy_internal.h>
+#endif
+
+#if defined(KEBAB)
+/* Bounded CREATE2 evidence only; retain original authorization and errors. */
+static void
+kebab_work_interval_create_evidence(proc_t p, const char *phase,
+    uint32_t flags, int result)
+{
+    static uint32_t reported;
+    unsigned slot;
+    if ((flags & WORK_INTERVAL_TYPE_MASK) != WORK_INTERVAL_TYPE_CA_CLIENT) return;
+    slot = __atomic_load_n(&reported, __ATOMIC_RELAXED);
+    do {
+        if (slot >= 32) return;
+    } while (!__atomic_compare_exchange_n(&reported, &slot, slot + 1, false,
+        __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+    char name[32] = {};
+    proc_name(proc_pid(p), name, sizeof(name));
+    printf("KEBAB WORK INTERVAL: pid=%d name=%.31s phase=%s flags=0x%x result=%d app=%u; original create and permission checks retained\n",
+        proc_pid(p), name, phase, flags, result, task_is_app(current_task()));
+}
+#endif
+
 
