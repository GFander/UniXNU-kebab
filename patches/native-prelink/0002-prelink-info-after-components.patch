 class EmitTests(unittest.TestCase):
+    def test_prelink_info_bounds_components_above_native_kernel(self):
+        native, original = images()
+        output, report = emit(native, original, ['test.component'], 0x200000)
+        segments = macho(output)['segments']
+        info = next(s for s in segments if s['name'] == '__PRELINK_INFO')
+        other_top = max(s['va'] + s['size'] for s in segments
+                        if s['size'] and s['name'] != '__PRELINK_INFO')
+        # arm_vm_init uses the end of __PRELINK_INFO as vm_kernel_slid_top.
+        # ml_static_slide returns zero for any address outside that range.
+        self.assertGreaterEqual(info['va'], other_top)
+        header = report['sparse_index']['headers'][0]
+        component = macho(output, backed_offset(segments, header, 32, len(output)))
+        for seg in component['segments']:
+            if seg['size']:
+                self.assertLess(seg['va'] + seg['size'] - 1,
+                                info['va'] + info['size'])
+
