+int
+kebab_spmi_keys_sample(uint8_t raw[4])
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	int result = kebab_spmi_keys_sample_unserialized(raw);
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+	return result;
+}
+
+int
+kebab_spmi_keys_config(uint8_t gpio6[3], uint8_t gpio7[3])
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	int result = kebab_spmi_keys_config_unserialized(gpio6, gpio7);
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+	return result;
+}
+
+void
+kebab_spmi_report(void)
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	kebab_spmi_report_unserialized();
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+}
+
+void
+kebab_spmi_pon_report(void)
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	kebab_spmi_pon_report_unserialized();
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+}
+
+void
+kebab_spmi_power_report(void)
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	kebab_spmi_power_report_unserialized();
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+}
+
+int
+kebab_spmi_vrm_boot_power(void)
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	int result = kebab_spmi_vrm_boot_power_unserialized();
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+	return result;
+}
+
+int
+kebab_spmi_pon_reason_write_normal(void)
+{
+	lck_mtx_lock(&kebab_spmi_normal_lock);
+	int result = kebab_spmi_pon_reason_write();
+	lck_mtx_unlock(&kebab_spmi_normal_lock);
+	return result;
+}
+
+/* Default-off failure injection: PANIC! invokes this on the normal console
+ * thread. Holding the ordinary bus mutex across the panic proves that the
+ * independent panic FASTBOOT path cannot wait on the interrupted owner. */
+void
+kebab_spmi_test_panic_lock(void)
+{
+	uint32_t enabled = 0;
+	if (PE_parse_boot_argn("kebab_spmi_lockpanic", &enabled, sizeof(enabled)) && enabled) {
+		lck_mtx_lock(&kebab_spmi_normal_lock);
+		printf("KEBAB SPMI TEST: normal bus mutex held for intentional panic\n");
+		panic("kebab usb console test (normal SPMI lock held)");
+	}
+}
+
 #endif /* KEBAB */
