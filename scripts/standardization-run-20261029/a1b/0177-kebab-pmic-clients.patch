+/* PM8150 board register facts retained from kebab_spmi.c: vendor DT,
+ * qpnp-power-on.c and pinctrl-spmi-gpio.c. These are PMIC addresses, not VAs. */
+#ifndef _KEBAB_PMIC_REGS_H
+#define _KEBAB_PMIC_REGS_H
