+	if (status == NULL) { return -1; }
+	kebab_geni_transaction_lock();
+	bzero(status, sizeof(*status));
+	kebab_geni_get_info(&status->info);
+	if (!status->info.mapped) { kebab_geni_transaction_unlock(); return -1; }
